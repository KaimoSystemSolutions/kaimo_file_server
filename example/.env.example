# Required application secrets
JWT_SECRET=
NT_HASH_ENCRYPTION_KEY=

# Initial admin password (username = password)
SEED_ADMIN_PASSWORD=

# Database (set POSTGRES_PASSWORD before starting the stack)
POSTGRES_DB=kaimo_file_server
POSTGRES_USER=kaimo
POSTGRES_PASSWORD=
POSTGRES_VERSION=17-alpine
LOCATION_DB=./data/postgres

# Database backups (host folder for automatic + manual backups)
LOCATION_BACKUP=./data/backups
# One-shot startup restore: point at a dump inside /data/kaimo-backups to restore
# it once on the next start (a "<file>.done" marker then prevents a repeat).
# Leave empty for normal operation.
KAIMO_DB_RESTORE_FROM=

# Values shared by multiple services
KAIMO_IMAGE_TAG=latest
TZ=Europe/Berlin
KAIMO_SMB_CONTROL_PKI=./data/smb-control-plane
