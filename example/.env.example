# Required application secrets
JWT_SECRET=
NT_HASH_ENCRYPTION_KEY=

# Initial admin password (username = password)
SEED_ADMIN_PASSWORD=

# Database (set POSTGRES_PASSWORD before starting the stack)
POSTGRES_DB=kaimo_file_server
POSTGRES_USER=kaimo
POSTGRES_PASSWORD=
POSTGRES_VERSION=17-alpine
LOCATION_DB=./data/postgres

# Database backups (host folder for automatic + manual backups)
LOCATION_BACKUP=./data/backups
# One-shot startup restore: set this to the FILE NAME of a backup that lives in
# the backup folder above (e.g. kaimo_20260820-0300_manual.dump). The Host
# restores it once on the next start; a "<file>.done" marker then prevents a
# repeat. The ".dump" extension is optional and a full path also works. If the
# file cannot be found the Host stops with an error listing the available
# backups instead of starting normally. Leave empty for normal operation.
KAIMO_DB_RESTORE_FROM=

# Search (Elasticsearch)
ELASTIC_VERSION=9.4.2
LOCATION_ES=./data/elasticsearch
ELASTIC_JAVA_OPTS=-Xms512m -Xmx512m

# Values shared by multiple services
KAIMO_IMAGE_TAG=latest
TZ=Europe/Berlin
KAIMO_SMB_CONTROL_PKI=./data/smb-control-plane
