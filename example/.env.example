# Required: replace all three empty values before starting the stack.
POSTGRES_PASSWORD=
JWT_SECRET=
NT_HASH_ENCRYPTION_KEY=

# Optional overrides (the Compose file provides these defaults).
KAIMO_IMAGE_TAG=latest
TZ=Europe/Berlin
SAMBA_PORT=445
WEB_HTTP_PORT=8081
WEB_HTTPS_PORT=8443
# KAIMO_LOG_LEVEL=Information
              #  =Debug
              #  =Warning
              #  =Error

POSTGRES_DB=kaimo_file_server
POSTGRES_USER=kaimo
POSTGRES_VERSION=17-alpine

LOCATION_STORAGE_01=./data/storage/pool01
LOCATION_APP_DATA=./data/kaimo-system
LOCATION_LOGS=./data/logs
LOCATION_DB=./data/postgres
KAIMO_SMB_CONTROL_PKI=./data/smb-control-plane
