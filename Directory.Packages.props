<Project>
  <!-- Central Package Management: every NuGet version for the whole solution lives here.
       Individual projects reference packages by name only (no Version attribute), so a
       dependency update happens in one place and cannot drift out of sync between projects.
       See https://learn.microsoft.com/nuget/consume-packages/central-package-management -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Allow the floating xunit/Moq versions (2.* / 4.*) that the test project already used. -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    <!-- Let PackageVersion entries pin transitive dependencies too (e.g. AngleSharp via bunit). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- ASP.NET Core / runtime (kept on the net10.0 line: 10.0.x) -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <!-- Transitive pin: MimeKit (via MailKit) only requires Pkcs >= 10.0.0, which has known
         vulnerabilities (NU1902/NU1903, GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Microsoft.OpenApi must stay on 2.x: the AspNetCore.OpenApi 10.0.x XML-comment source
         generator targets the 2.x API (settable IOpenApiMediaType.Example); 3.x makes it
         read-only and breaks the build (CS0200). 2.12.2 is patched (NU1903, GHSA-v5pm-xwqc-g5wc).
         Do not bump to 3.x until AspNetCore.OpenApi requires it. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.2" />
    <!-- Entity Framework Core -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Patched native SQLite bundle (NU1903, GHSA-2m69-gcr7-jv3q on the 2.1.11 transitive). -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- Identity / JWT -->
    <PackageVersion Include="Microsoft.IdentityModel.Protocols" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageVersion Include="BCrypt.Net-Next" Version="4.2.0" />
    <!-- gRPC (SMB bridge) -->
    <PackageVersion Include="Grpc.AspNetCore" Version="2.84.0" />
    <PackageVersion Include="Grpc.Core.Api" Version="2.84.0" />
    <!-- Search: Elasticsearch + document text extraction -->
    <PackageVersion Include="Elastic.Clients.Elasticsearch" Version="9.5.3" />
    <PackageVersion Include="ExcelDataReader" Version="3.9.0" />
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <!-- Cloud / remote access -->
    <PackageVersion Include="Google.Apis.Auth" Version="1.77.0" />
    <PackageVersion Include="Google.Apis.Drive.v3" Version="1.77.0.4276" />
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <!-- Mail notifications: SMTP transport (MIT) and sandboxed Liquid templates (MIT) -->
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <PackageVersion Include="Fluid.Core" Version="2.40.0" />
    <!-- Build / tooling -->
    <PackageVersion Include="Microsoft.Build.Tasks.Git" Version="10.0.402" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <!-- Native TypeScript 7 compiler (per-RID binaries in the package; no Node.js needed) for Web/Scripts/*.ts -->
    <PackageVersion Include="Microsoft.TypeScript.MSBuild" Version="7.0.1" />
    <!-- Test-only -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.*" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Moq" Version="4.*" />
    <PackageVersion Include="bunit" Version="2.11.3" />
    <!-- Pin the transitive AngleSharp bunit pulls in. -->
    <PackageVersion Include="AngleSharp" Version="1.8.2" />
  </ItemGroup>
</Project>