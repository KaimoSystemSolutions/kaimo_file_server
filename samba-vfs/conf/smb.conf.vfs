[global]
    workgroup = WORKGROUP
    server string = Kaimo Samba Spike (VFS)
    server role = standalone server
    map to guest = never
    log level = 2
    logging = stdout

    # SMB2/3 fallback defaults. They apply until the config sync (sync-config.sh)
    # writes values from the Kaimo DB (ISmbConfigStore) to the registry. Because
    # `include = registry` comes at the END of this section, DB values set via
    # `net conf setparm global` override these inline defaults.
    server min protocol = SMB2_10
    access based share enum = yes

    # Phase 1: local NTLMv2 verification against tdbsam. NT-Hashes are fed in
    # from the Kaimo DB via gRPC bridge (kaimo_authsync -> sync-users.sh).
    passdb backend = tdbsam

    # --- Storage write permissions: force new files/directories to be group-writable ---
    # smbd does file I/O as the authenticated user (own UID). So Web
    # (uid 1654) and SMB users can read/write each other, new objects must
    # be group-writable to the shared group (kaimo, gid 1654). `force
    # create/directory mode` enforces group bits regardless of client wish;
    # the setgid bit (2xxx) lets new files inherit the group. Group assignment
    # + g+w on share dirs is set by entrypoint/sync-shares.sh.
    create mask          = 0664
    force create mode    = 0060
    directory mask       = 2775
    force directory mode = 0070

    # --- Phase-0 core step B: enable custom VFS module globally ---
    # Applies to all shares (including dynamic ones from registry). The gRPC
    # bridge to the .NET Control Plane lives in the kaimo_authd sidecar.
    vfs objects = kaimo_bridge

    # --- Phase 4: dynamic shares + global protocol settings from DB ---
    # `registry shares = yes` -> smbd reads share definitions live from registry
    # (create/remove without reload/restart; populated by sync-shares.sh).
    # `include = registry` (at the end!) -> global parameters also come from
    # registry and override the inline defaults above (populated by
    # sync-config.sh: server min/max protocol, server signing, smb encrypt).
    registry shares = yes
    include = registry
