# Intermediate image: unpacked Samba source tree 4.19.5 (matching distro ABI 49).
# Serves only to cache the source download so module iterations are fast.
#   docker build -f Dockerfile.src -t kaimo-samba-src:4.19.5 .
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y -qq wget && rm -rf /var/lib/apt/lists/*
WORKDIR /build
RUN wget -q https://download.samba.org/pub/samba/stable/samba-4.19.5.tar.gz \
    && tar xf samba-4.19.5.tar.gz \
    && rm samba-4.19.5.tar.gz
