<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>dotnet-Kaimo_File_server.Search-1ae611b7-ea46-4731-8b6c-34f544d867a0</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Elastic.Clients.Elasticsearch" Version="8.17.0" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
        <PackageReference Include="Mime-Detective" Version="25.8.1" />
        <PackageReference Include="Mime-Detective.Definitions.Exhaustive" Version="25.8.1" />
        <PackageReference Include="NPOI" Version="2.8.0" />
        <PackageReference Include="PdfPig" Version="0.1.3" />
        <!-- Pin up a vulnerable transitive dependency (NU1903, GHSA-w3x6-4m5h-cxqf /
             GHSA-37gx-xxp4-5rgx). 8.0.2 is pulled in transitively; 10.0.8 is patched and
             aligns with the net10.0 runtime. Unifies the version for all downstream projects. -->
        <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.8" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Kaimo_File_Server.Core\Kaimo_File_Server.Core.csproj" />
    </ItemGroup>

	<ItemGroup>
		<Content Update="appsettings.json" CopyToPublishDirectory="Never" CopyToOutputDirectory="Never" />
		<Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" CopyToOutputDirectory="Never" />
	</ItemGroup>
</Project>
