@*
    Inline form for adding a scoped role assignment ("principal X gets role Y within scope Z").
    Used on the role detail (role fixed), the user detail (principal fixed) and the department
    detail (scope fixed). Each part is shown only when its items are supplied; a fixed part is
    left out and its value is set by the caller. Pure presentation: validation and the
    authorization gate stay in the owning ViewModel.

    The scope is picked as one of three categories: "System wide" (the Global department,
    stored system-wide), a department, or a share. Their explanations sit in an info popover.
    Roles with system-level permissions only make sense system wide: outside it they are not
    offered, and a fixed role of that kind locks the scope to "System wide".
*@
@inherits AppComponentBase
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Core.Helpers
@using Kaimo_File_Server.Core.Security
@using Kaimo_File_Server.Web.DynamicHelpers

<div class="assignment-form">
    @if (Roles is not null)
    {
        <div class="form-group">
            <label>@Resources.Web_Admin_Label_Role</label>
            <PrincipalPickerField Mode="SelectionMode.Single"
                                  Items="OfferedRoles(Roles, RolePermissionsById, IsGlobalScope)"
                                  SelectedIds="RoleId.AsSelection()"
                                  SelectedIdsChanged="ids => RoleIdChanged.InvokeAsync(ids.FirstOrNull())"
                                  Title="@Resources.Web_Admin_Label_Role"
                                  Placeholder="@Resources.Web_Common_Select" />
        </div>
    }
    @if (Principals is not null)
    {
        <div class="form-group">
            <label>@Resources.Web_Admin_AssignTo</label>
            <PrincipalPickerField Mode="SelectionMode.Single"
                                  Items="Principals"
                                  SelectedIds="PrincipalId.AsSelection()"
                                  SelectedIdsChanged="ids => PrincipalIdChanged.InvokeAsync(ids.FirstOrNull())"
                                  Title="@Resources.Web_Admin_AssignTo"
                                  Placeholder="@Resources.Web_Common_Select" />
        </div>
    }
    @if (Departments is not null)
    {
        @* Three plain categories; "System wide" stores the Global department, which the
           department picker therefore leaves out. The explanations live in the info popover. *@
        <div class="form-group">
            <div class="label-with-info">
                <label id="assignment-scope-label">@R("Web_Admin_Label_AppliesTo", "Applies to")</label>
                <InfoButton Title="@R("Web_Admin_ScopeInfo_Title", "Where does the role apply?")"
                            AriaLabel="@R("Web_Admin_ScopeInfo_Title", "Where does the role apply?")">
                    <ul>
                        <li><strong>@SystemLabel:</strong> @R("Web_Admin_GlobalScopeHint", "Everywhere, including system settings. Same as an assignment in the Global department.")</li>
                        <li><strong>@Resources.Web_Admin_Scope_Department:</strong> @R("Web_Admin_ScopeInfo_Department", "In the chosen department and all of its sub-departments.")</li>
                        @if (Shares is not null)
                        {
                            <li><strong>@Resources.Web_Admin_Scope_Share:</strong> @Resources.Web_Admin_ShareScopeHint</li>
                        }
                    </ul>
                    <p>@R("Web_Admin_SystemBitsHint", "Roles with system-level permissions (e.g. settings, logs, backups, mail) can only be assigned system wide.")</p>
                </InfoButton>
            </div>
            <div class="toggle-button-group" role="radiogroup" aria-labelledby="assignment-scope-label">
                @ScopeChoice(ScopeMode.System, SystemLabel)
                @ScopeChoice(ScopeMode.Department, Resources.Web_Admin_Scope_Department)
                @if (Shares is not null)
                {
                    @ScopeChoice(ScopeMode.Share, Resources.Web_Admin_Scope_Share)
                }
            </div>
        </div>
        @if (Mode == ScopeMode.Department)
        {
            <div class="form-group">
                <label>@Resources.Web_Admin_Label_Department</label>
                <PrincipalPickerField Mode="SelectionMode.Single"
                                      Items="Departments.Where(d => d.Id != WellKnownGUIDs.DEPARTMENT_GLOBAL).ToList()"
                                      SelectedIds="ScopeId.AsSelection()"
                                      SelectedIdsChanged="ids => ScopeIdChanged.InvokeAsync(ids.FirstOrNull())"
                                      Title="@Resources.Web_Admin_Label_Department"
                                      Placeholder="@Resources.Web_Common_Select" />
            </div>
        }
        else if (Mode == ScopeMode.Share && Shares is not null)
        {
            <div class="form-group">
                <label>@Resources.Web_Admin_Label_Share</label>
                <PrincipalPickerField Mode="SelectionMode.Single"
                                      Items="Shares"
                                      SelectedIds="ScopeId.AsSelection()"
                                      SelectedIdsChanged="ids => ScopeIdChanged.InvokeAsync(ids.FirstOrNull())"
                                      Title="@Resources.Web_Admin_Label_Share"
                                      Placeholder="@Resources.Web_Common_Select" />
            </div>
        }
    }
    @if (Error is not null)
    {
        <div class="error-banner">@Error</div>
    }
    <div class="create-form-actions">
        <button class="btn-primary" type="button" @onclick="OnSubmit" disabled="@IsSaving">
            @(IsSaving ? Resources.Web_Common_Saving : Resources.Web_Common_Assign)
        </button>
        <button class="btn-secondary" type="button" @onclick="OnCancel" disabled="@IsSaving">@Resources.Web_Common_Cancel</button>
    </div>
</div>

@code {
    /// <summary>Selectable roles; null when the role is fixed by the caller.</summary>
    [Parameter] public IReadOnlyList<PrincipalPickerItem>? Roles { get; set; }
    [Parameter] public Guid? RoleId { get; set; }
    [Parameter] public EventCallback<Guid?> RoleIdChanged { get; set; }

    /// <summary>Selectable users and groups; null when the principal is fixed by the caller.</summary>
    [Parameter] public IReadOnlyList<PrincipalPickerItem>? Principals { get; set; }
    [Parameter] public Guid? PrincipalId { get; set; }
    [Parameter] public EventCallback<Guid?> PrincipalIdChanged { get; set; }

    /// <summary>Selectable departments; null hides the whole scope part (scope fixed by the caller).</summary>
    [Parameter] public IReadOnlyList<PrincipalPickerItem>? Departments { get; set; }

    /// <summary>Selectable shares; null hides the Share scope option.</summary>
    [Parameter] public IReadOnlyList<PrincipalPickerItem>? Shares { get; set; }

    /// <summary>Permissions of the role fixed by the caller (<see cref="Roles"/> null). A role with
    /// system-level permissions locks the scope to "System wide".</summary>
    [Parameter] public ManagementPermission? RolePermissions { get; set; }

    /// <summary>Permissions per selectable role; roles with system-level permissions are only
    /// offered while the scope is system wide. Null offers every role.</summary>
    [Parameter] public IReadOnlyDictionary<Guid, ManagementPermission>? RolePermissionsById { get; set; }

    [Parameter] public ScopeType ScopeType { get; set; }
    [Parameter] public EventCallback<ScopeType> ScopeTypeChanged { get; set; }
    [Parameter] public Guid? ScopeId { get; set; }
    [Parameter] public EventCallback<Guid?> ScopeIdChanged { get; set; }

    [Parameter] public string? Error { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    // Permissions that are only evaluated system-wide (settings, logs, backups, mail, ...).
    // ponytail: hand-picked from the "System / Global Settings" area; it only steers the form,
    // the authorization engine stays the source of truth.
    private const ManagementPermission SystemLevelPermissions =
        ManagementPermission.SystemAdmin | ManagementPermission.ViewSecurityMonitor
        | ManagementPermission.ManageClientDevices | ManagementPermission.ManageMailServer | ManagementPermission.ManageNotifications
        | ManagementPermission.ManageBackupRepositories;

    private bool IsGlobalScope => ScopeType == ScopeType.Global
        || (ScopeType == ScopeType.Department && ScopeId == WellKnownGUIDs.DEPARTMENT_GLOBAL);

    /// <summary>Whether a role's permissions include system-level ones, which only take effect
    /// when the role is assigned system wide.</summary>
    public static bool IsSystemOnly(ManagementPermission permissions) => (permissions & SystemLevelPermissions) != 0;

    /// <summary>The roles that make sense at the chosen scope: all of them system wide, otherwise
    /// only those without system-level permissions.</summary>
    public static IReadOnlyList<PrincipalPickerItem> OfferedRoles(IReadOnlyList<PrincipalPickerItem> roles,
        IReadOnlyDictionary<Guid, ManagementPermission>? permissions, bool systemWide)
        => systemWide || permissions is null
            ? roles
            : roles.Where(r => !(permissions.TryGetValue(r.Id, out var p) && IsSystemOnly(p))).ToList();

    private bool FixedRoleIsSystemOnly => Roles is null && RolePermissions is { } perms && IsSystemOnly(perms);

    // A fixed system-level role leaves only "System wide"; select it right away.
    protected override async Task OnParametersSetAsync()
    {
        if (FixedRoleIsSystemOnly && Departments is not null && Mode != ScopeMode.System)
            await SelectModeAsync(ScopeMode.System);
    }

    private static string R(string key, string fallback) => Resources.ResourceManager.GetString(key) ?? fallback;

    private enum ScopeMode { System, Department, Share }

    private ScopeMode Mode => IsGlobalScope ? ScopeMode.System
        : ScopeType == ScopeType.Share ? ScopeMode.Share : ScopeMode.Department;

    private static string SystemLabel => R("Web_Admin_ScopeChoice_System", "System wide");

    private RenderFragment ScopeChoice(ScopeMode mode, string label) => __builder =>
    {
        <button type="button" role="radio" aria-checked="@(Mode == mode ? "true" : "false")"
                class="toggle-btn @(Mode == mode ? "toggle-btn--active" : null)"
                disabled="@(IsSaving || (mode != ScopeMode.System && FixedRoleIsSystemOnly))" @onclick="() => SelectModeAsync(mode)">@label</button>
    };

    // Switching the category invalidates the chosen scope object, and a chosen role that is not
    // offered at the new scope. "System wide" is the Global department, which the ViewModel
    // stores as a system-wide assignment.
    private async Task SelectModeAsync(ScopeMode mode)
    {
        if (mode == Mode)
            return;
        await ScopeTypeChanged.InvokeAsync(mode == ScopeMode.Share ? ScopeType.Share : ScopeType.Department);
        await ScopeIdChanged.InvokeAsync(mode == ScopeMode.System ? WellKnownGUIDs.DEPARTMENT_GLOBAL : null);
        if (mode != ScopeMode.System && Roles is not null && RoleId is { } roleId
            && OfferedRoles(Roles, RolePermissionsById, systemWide: false).All(r => r.Id != roleId))
            await RoleIdChanged.InvokeAsync(null);
    }
}
