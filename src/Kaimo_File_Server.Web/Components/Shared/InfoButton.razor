@*
    Central info affordance (shared UI library).

    One button that explains a complex input or operation, replacing the
    hand-rolled "i"/info-circle widgets that were scattered across the app.

    Always a hover/focus tooltip (role="tooltip"); a tap/click pins it for touch
    and pointer-leave, blur or Escape release it. `Text` is the plain hint;
    `ChildContent` (+ optional `Title`) renders rich, non-interactive content
    (paragraphs, lists) in the same tooltip look.

    The trigger is deliberately a <span role="button">, not a <button>: the info
    button sits inside <label> elements across the app, and a label forwards hover
    and clicks to its first labelable descendant. A <button> trigger would open
    the tooltip whenever the label or its field is hovered or clicked, and would
    steal the field's label. The trigger also cancels its click, so a surrounding
    <label> or <summary> never reacts to it.

    The icon is the shared info.svg tinted with the semantic --info
    token so info buttons read the same everywhere.
*@
@inherits AppComponentBase
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Web.DynamicHelpers

<span class="info-btn @(_open ? "info-btn--open" : null) @Class" @attributes="AdditionalAttributes">
    <span class="info-btn__trigger"
          role="button"
          tabindex="0"
          aria-label="@(AriaLabel ?? DefaultLabel)"
          aria-describedby="@_id"
          @onclick="Toggle"
          @onclick:stopPropagation="true"
          @onclick:preventDefault="true"
          @onkeydown="OnKeyDown"
          @onmouseleave="Close"
          @onfocusout="Close">
        @* Round caps are what make info.svg's zero-length dot render — without them the
           "i" is just a thin bar. Stroke 2 matches the icon's 24×24 grid for a thin outline. *@
        @Assets.SVG("info.svg", new SvgOptions(Width: IconSize, Height: IconSize, StrokeWidth: 2f,
            Style: "stroke-linecap:round;stroke-linejoin:round"))
    </span>
    @* Positioned (position: fixed) by infoPopover.js when the trigger is hovered or focused. *@
    <span id="@_id" class="info-btn__tip" role="tooltip">
        @if (!string.IsNullOrEmpty(Title))
        {
            <strong class="info-btn__tip-title">@Title</strong>
        }
        @if (ChildContent is not null)
        {
            <span class="info-btn__tip-body">@ChildContent</span>
        }
        else
        {
            @Text
        }
    </span>
</span>

@code {
    /// <summary>Short localized hint shown in the tooltip. Ignored when <see cref="ChildContent"/> is set.</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>Rich, non-interactive body (e.g. paragraphs or a bullet list) shown in the tooltip.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Optional heading shown at the top of the tooltip.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Accessible label for the trigger. Defaults to the localized "More information".</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Icon size in pixels. Defaults to 20.</summary>
    [Parameter] public int IconSize { get; set; } = 20;

    /// <summary>Extra CSS classes appended to the host, for local overrides.</summary>
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly string _id = "info-" + Guid.NewGuid().ToString("N")[..8];
    private bool _open;

    private string DefaultLabel => Text2("Web_Common_Info", "More information");

    // A tap/click pins the tooltip open (touch support); it is released as soon as
    // the pointer or focus leaves, so it never stays behind after moving away.
    private void Toggle() => _open = !_open;
    private void Close() => _open = false;

    // Keyboard parity with a native button (Space is kept from scrolling by infoPopover.js).
    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") { Toggle(); }
        else if (e.Key == "Escape") { Close(); }
    }

    // Runtime lookup so newly added keys need no Resources.Designer regeneration.
    private static string Text2(string key, string fallback)
        => Resources.ResourceManager.GetString(key) ?? fallback;
}
