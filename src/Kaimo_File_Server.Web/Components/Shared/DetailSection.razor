@*
    Titled group of properties in a detail pane (shared UI library, see DESIGN_SPEC §9.2).
    Holds <PropertyRow> children (rendered as a <dl>).

    Every section can be collapsed via its title band. It uses native <details>/<summary>,
    so keyboard and screen-reader support come for free. The open/closed state lives only
    in the DOM: a reload or reopened page starts from the default again (open, or closed
    with InitiallyCollapsed for secondary groups such as technical IDs).
*@

<details class="detail-section-group @Class" open="@(!InitiallyCollapsed)">
    <summary class="detail-section-title"><h4 class="detail-section-heading">@Title</h4></summary>
    <dl class="property-list">@ChildContent</dl>
</details>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Start closed; for secondary groups such as technical IDs.</summary>
    [Parameter] public bool InitiallyCollapsed { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public string? Class { get; set; }
}
