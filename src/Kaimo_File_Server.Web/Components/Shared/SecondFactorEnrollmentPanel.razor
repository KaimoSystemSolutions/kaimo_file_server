@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Web.Services.SecondFactor
@inherits AppComponentBase

@*
    TOTP enrollment: QR code, the same secret as a key to type in, and the first code that
    activates the factor. Used inside the login (forced enrollment) and on the own profile.
    The QR image is a PNG with its own white quiet zone, so it scans in both themes.
*@

<div class="second-factor-enroll">
    <ol class="second-factor-steps">
        <li>@Text("Web_SecondFactor_Enroll_Step1", "Install an authenticator app on your phone.")</li>
        <li>@Text("Web_SecondFactor_Enroll_Step2", "Scan the QR code with the app.")</li>
        <li>@Text("Web_SecondFactor_Enroll_Step3", "Enter the 6-digit code the app shows.")</li>
    </ol>

    <img class="second-factor-qr" src="@Enrollment.QrCodeDataUri" width="200" height="200"
         alt="@Text("Web_SecondFactor_QrAlt", "QR code for the authenticator app")" />

    <div class="form-group">
        <span class="form-hint" id="@($"{IdPrefix}-key-label")">@Text("Web_SecondFactor_ManualKey", "Cannot scan? Enter this key in the app:")</span>
        <code class="second-factor-key" aria-labelledby="@($"{IdPrefix}-key-label")">@Enrollment.ManualKey</code>
    </div>

    <div class="form-group">
        <label for="@($"{IdPrefix}-code")">@Text("Web_SecondFactor_Label_Code", "Verification code")</label>
        <input id="@($"{IdPrefix}-code")" class="edit-input" type="text" inputmode="numeric" autocomplete="one-time-code"
               maxlength="9" spellcheck="false" value="@Code" disabled="@Disabled"
               @oninput="e => CodeChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty)"
               @onkeydown="HandleKeyDown" />
    </div>
</div>

@code {
    [Parameter, EditorRequired] public SecondFactorEnrollment Enrollment { get; set; } = default!;
    [Parameter] public string Code { get; set; } = "";
    [Parameter] public EventCallback<string> CodeChanged { get; set; }

    /// <summary>Raised on Enter in the code field.</summary>
    [Parameter] public EventCallback OnSubmit { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Prefix of the element ids, unique per page.</summary>
    [Parameter] public string IdPrefix { get; set; } = "second-factor";

    private Task HandleKeyDown(KeyboardEventArgs e) => e.Key == "Enter" ? OnSubmit.InvokeAsync() : Task.CompletedTask;

    private static string Text(string key, string fallback) => Resources.ResourceManager.GetString(key) ?? fallback;
}
