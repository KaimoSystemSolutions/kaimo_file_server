@*
    One read-only label/value pair inside a <DetailSection> (shared UI library, see DESIGN_SPEC §9.2).

    Label left, value right (stacked on narrow screens). A missing value always reads "–".
    Mono is for paths, IDs, URLs and hashes; Copyable adds a copy button for them.
    Entity sets the value in semibold when it names a real object (department, share …).
*@
@inherits AppComponentBase
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Web.DynamicHelpers
@inject IJSRuntime JS
@inject ToastService Toasts

<div class="property-row">
    <dt>@Label</dt>
    <dd class="@(Mono ? "property-value--mono" : null) @(Entity ? "property-value--entity" : null)">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else if (string.IsNullOrEmpty(Value))
        {
            <span class="property-empty">–</span>
        }
        else
        {
            <span class="property-value-text">@Value</span>
            @if (Copyable)
            {
                <button type="button" class="btn-icon btn-icon--small property-copy"
                        aria-label="@CopyLabel" title="@CopyLabel" @onclick="CopyAsync">
                    @Assets.SVG("copy.svg", new SvgOptions(Width: 13, Height: 13, StrokeWidth: 2f))
                </button>
            }
        }
    </dd>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    /// <summary>Plain value; null or empty shows "–". Ignored when <see cref="ChildContent"/> is set.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Rich value (badges, links, …); the caller handles its own empty state.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public bool Mono { get; set; }

    /// <summary>
    /// The value names a real object (department, share, connection, repository …) and is set
    /// in semibold; plain values such as descriptions, dates or counts stay regular.
    /// </summary>
    [Parameter] public bool Entity { get; set; }

    /// <summary>Adds a copy-to-clipboard button for <see cref="Value"/>.</summary>
    [Parameter] public bool Copyable { get; set; }

    private static string CopyLabel => Text("Web_Detail_Copy", "Copy to clipboard");

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Value);
            Toasts.Show(Text("Web_Detail_Copied", "Copied to clipboard"), ToastType.Success);
        }
        catch (JSException)
        {
            // Clipboard access needs a secure context and permission.
            Toasts.Show(Text("Web_Detail_CopyFailed", "Could not copy to the clipboard"), ToastType.Error);
        }
    }

    private static string Text(string key, string fallback) => Resources.ResourceManager.GetString(key) ?? fallback;
}
