@*
    Central tab strip (shared UI library).

    Renders the container for a set of <Tab> buttons. Orientation switches
    between the horizontal underline bar (default) and the vertical sidebar.
    The canonical `.detail-tabs` class is emitted so existing page-level
    scoped overrides (via ::deep) keep working. Callers can layer extra
    classes through `Class` (e.g. "detail-tabs--panel") and pass any other
    attributes (aria-label, ...) straight through.
*@
<div class="detail-tabs @OrientationClass @Class" role="tablist" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter] public TabOrientation Orientation { get; set; } = TabOrientation.Horizontal;

    /// <summary>Extra CSS classes appended to the strip, for local overrides.</summary>
    [Parameter] public string? Class { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    private string OrientationClass => Orientation == TabOrientation.Vertical
        ? "detail-tabs--vertical"
        : "detail-tabs--horizontal";
}
