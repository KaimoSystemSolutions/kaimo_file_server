<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="css/app.css" />
    <link href="Kaimo_File_Server.Web.styles.css" rel="stylesheet" />
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />

    @* Theme wird sofort gesetzt, damit kein Flash sichtbar ist *@
    <script>
            (function() {
                var t = localStorage.getItem('kaimo_theme') || 'dark';
                document.documentElement.setAttribute('data-theme', t);
            })();
    </script>
</head>
<body>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <script src="_framework/blazor.server.js"></script>
    <script src="js/columnResize.js"></script>
    <script src="js/filePreview.js"></script>
    <script src="js/fileUpload.js"></script>
</body>
</html>
