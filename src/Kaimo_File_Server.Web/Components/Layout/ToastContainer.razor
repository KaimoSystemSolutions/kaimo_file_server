@using Kaimo_File_Server.Web.DynamicHelpers
@implements IDisposable
@inject ToastService Toasts
@inherits AppComponentBase

<div class="toast-container">
    @foreach (var toast in Toasts.Toasts)
    {
        <div class="toast toast--@toast.Type.ToString().ToLower() @(_removing.Contains(toast.Id) ? "toast--removing" : "")"
             title="@toast.Tooltip">
            @(toast.Type switch
            {
                ToastType.Success  => Assets.SVG("check.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2, CssClass: "toast-icon")),
                ToastType.Error    => Assets.SVG("circle_x.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2, CssClass: "toast-icon")),
                ToastType.Progress => Assets.SVG("upload.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2, CssClass: "toast-icon")),
                _                 => Assets.SVG("info.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2, CssClass: "toast-icon")),
            })
            <span class="toast-text">@toast.Text</span>
            <button class="toast-close" @onclick="() => DismissManual(toast.Id)">
                @Assets.SVG("close.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
            </button>
            @if (toast.Type == ToastType.Progress)
            {
                <div class="toast-progress-bar">
                    <div class="toast-progress-bar-fill" style="width: @(toast.Progress)%"></div>
                </div>
            }
        </div>
    }
</div>


@code {
    private HashSet<string> _removing = new();
    private Dictionary<string, Timer> _timers = new();

    protected override void OnInitialized()
    {
        Toasts.OnChanged += OnToastsChanged;
    }

    private void OnToastsChanged()
    {
        InvokeAsync(() =>
        {
            foreach (var toast in Toasts.Toasts)
            {
                if (toast.Type == ToastType.Progress)
                    continue;

                if(toast.Type == ToastType.State)
                    continue;
                
                var delay = toast.Type == ToastType.Error ? 6000 : 4000;
                var elapsed = (int)(DateTime.Now - toast.CreatedAt).TotalMilliseconds;
                var remaining = Math.Max(delay - elapsed, 0);

                var id = toast.Id;
                if (_timers.TryGetValue(id, out var existing))
                    existing.Change(remaining, Timeout.Infinite);
                else
                    _timers[id] = new Timer(_ => InvokeAsync(() => Dismiss(id)), null, remaining, Timeout.Infinite);
            }
            StateHasChanged();
        });
    }

    private async Task DismissManual(string id)
    {
        var toast = Toasts.Toasts.FirstOrDefault(t => t.Id == id);
        if (toast?.OnDismiss is not null)
            await toast.OnDismiss();

        await Dismiss(id);
    }

    private async Task Dismiss(string id)
    {
        if (_removing.Contains(id)) return;

        _removing.Add(id);
        StateHasChanged();

        await Task.Delay(300);

        _removing.Remove(id);
        if (_timers.Remove(id, out var timer))
            timer.Dispose();
        Toasts.Remove(id);
        StateHasChanged();
    }

    public void Dispose()
    {
        Toasts.OnChanged -= OnToastsChanged;
        foreach (var timer in _timers.Values)
            timer.Dispose();
        _timers.Clear();
    }
}
