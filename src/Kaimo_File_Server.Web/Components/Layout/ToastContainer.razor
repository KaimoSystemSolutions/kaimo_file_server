@implements IDisposable
@inject ToastService Toasts

<div class="toast-container">
    @foreach (var toast in Toasts.Toasts)
    {
        <div class="toast toast--@toast.Type.ToString().ToLower() @(_removing.Contains(toast.Id) ? "toast--removing" : "")">
            <svg class="toast-icon" width="16" height="16" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2">
                @switch (toast.Type)
                {
                    case ToastType.Success:
                        <path d="M20 6L9 17l-5-5" />
                        break;
                    case ToastType.Error:
                        <circle cx="12" cy="12" r="10" />
                        <line x1="15" y1="9" x2="9" y2="15" />
                        <line x1="9" y1="9" x2="15" y2="15" />
                        break;
                    default:
                        <circle cx="12" cy="12" r="10" />
                        <line x1="12" y1="16" x2="12" y2="12" />
                        <line x1="12" y1="8" x2="12.01" y2="8" />
                        break;
                }
            </svg>
            <span class="toast-text">@toast.Text</span>
            <button class="toast-close" @onclick="() => Dismiss(toast.Id)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
            </button>
        </div>
    }
</div>

@code {
    private HashSet<string> _removing = new();
    private Dictionary<string, Timer> _timers = new();

    protected override void OnInitialized()
    {
        Toasts.OnChanged += OnToastsChanged;
    }

    private void OnToastsChanged()
    {
        InvokeAsync(() =>
        {
            // start auto-dismiss timer for any new toasts
            foreach (var toast in Toasts.Toasts)
            {
                if (!_timers.ContainsKey(toast.Id))
                {
                    var id = toast.Id;
                    var delay = toast.Type == ToastType.Error ? 6000 : 4000;
                    var timer = new Timer(_ => InvokeAsync(() => Dismiss(id)), null, delay, Timeout.Infinite);
                    _timers[id] = timer;
                }
            }
            StateHasChanged();
        });
    }

    private async Task Dismiss(string id)
    {
        if (_removing.Contains(id)) return;

        _removing.Add(id);
        StateHasChanged();

        // wait for the fade-out animation
        await Task.Delay(300);

        _removing.Remove(id);
        if (_timers.Remove(id, out var timer))
            timer.Dispose();
        Toasts.Remove(id);
        StateHasChanged();
    }

    public void Dispose()
    {
        Toasts.OnChanged -= OnToastsChanged;
        foreach (var timer in _timers.Values)
            timer.Dispose();
        _timers.Clear();
    }
}