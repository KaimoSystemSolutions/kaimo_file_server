@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="app-shell" data-theme="@_theme">
    <nav class="sidebar">
        <div class="sidebar-brand">
            <svg width="28" height="28" viewBox="0 0 48 48" fill="none">
                <rect width="48" height="48" rx="10" fill="var(--accent)" />
                <path d="M14 20h20v2H14zM14 26h20v2H14zM14 32h14v2H14z" fill="#fff" />
            </svg>
            <span class="brand-text">Kaimo Files</span>
        </div>

        <div class="sidebar-nav">
            <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                </svg>
                Shares
            </NavLink>
            <NavLink class="nav-item" href="/users" Match="NavLinkMatch.All">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" />
                </svg>
                Benutzer
            </NavLink>
        </div>

        <div class="sidebar-footer">
            <button class="theme-toggle" @onclick="ToggleTheme" title="Theme wechseln">
                @if (_theme == "dark")
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <circle cx="12" cy="12" r="5" />
                        <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
                    </svg>
                }
                else
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
                    </svg>
                }
            </button>
        </div>
    </nav>

    <main class="main">
        @Body
    </main>
</div>

@code {
    private string _theme = "dark";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "kaimo_theme");
                if (saved is "dark" or "light")
                {
                    _theme = saved;
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    private async Task ToggleTheme()
    {
        _theme = _theme == "dark" ? "light" : "dark";
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "kaimo_theme", _theme);
            await JS.InvokeVoidAsync("eval", $"document.documentElement.setAttribute('data-theme','{_theme}')");
        }
        catch { }
    }
}