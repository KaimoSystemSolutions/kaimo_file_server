@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Core.Repositories
@using Kaimo_File_Server.Core.Security
@using Kaimo_File_Server.Core.Services
@using Kaimo_File_Server.Web.Components.Search
@using Kaimo_File_Server.Web.DynamicHelpers
@inherits AppLayoutComponentBase
@inject ThemeService Theme
@inject DateFormatService DateFmt
@inject NavigationManager Nav
@inject JwtAuthenticationStateProvider AuthState
@inject AuthenticationStateProvider AuthStateProvider
@inject FileUploadCoordinator UploadCoordinator
@inject IUserContextFactory UserContextFactory
@inject IManagementAuthService ManagementAuthService
@inject DemoModeOptions Demo


<div class="app-shell" data-theme="@Theme.Current">
    <nav class="sidebar">
        <div class="sidebar-brand">
            @* Don't replace this with an Assets.SVG call, cuz this a lil too complicated for it *@
            @* <svg width="28" height="28" viewBox="0 0 48 48" fill="none">
                <rect width="48" height="48" rx="10" fill="var(--accent)" />
                <path d="M14 20h20v2H14zM14 26h20v2H14zM14 32h14v2H14z" fill="#fff" />
            </svg> *@
            @Assets.RawSVG("icon_kaimo.svg", 40, 40)
            <span class="brand-text">Kaimo File Server</span>
        </div>

        <div class="sidebar-nav">
            <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">
                @Assets.SVG("folder.svg", new SvgOptions())
                <span class="nav-label">@Resources.Web_Nav_Shares</span>
            </NavLink>
            <NavLink class="nav-item" href="/users" Match="NavLinkMatch.All">
                @Assets.SVG("users.svg", new SvgOptions())
                <span class="nav-label">@Resources.Web_Nav_Users</span>
            </NavLink>
            <NavLink class="nav-item" href="/departments" Match="NavLinkMatch.All">
                @Assets.SVG("building.svg", new SvgOptions())
                <span class="nav-label">@Resources.Web_Nav_Departments</span>
            </NavLink>
            @* Keep the File Browser selected while navigating within a share. *@
            <NavLink class="nav-item" href="/files" Match="NavLinkMatch.Prefix">
                @Assets.SVG("compass.svg", new SvgOptions())
                <span class="nav-label">@Resources.Web_Nav_BrowseFiles</span>
            </NavLink>

            @if (canManageSyncs() || _canManageCloudAccess)
            {
                <NavLink class="nav-item" href="/external-storage" Match="NavLinkMatch.Prefix">
                    @Assets.SVG("cloud-download.svg", new SvgOptions())
                    <span class="nav-label">@Text("Web_ExternalStorage_Title", "External Storage")</span>
                </NavLink>
            }

        </div>


        <div class="sidebar-footer">
            <NavLink class="nav-item" href="/settings" Match="NavLinkMatch.All">
                @Assets.SVG("gear.svg", new SvgOptions())
                <span class="nav-label">@Resources.Web_Nav_Settings</span>
            </NavLink>
            @if (!string.IsNullOrEmpty(_displayName))
            {
                <div class="sidebar-user">
                    <div class="sidebar-avatar">@_initials</div>
                    <span class="sidebar-username">@_displayName</span>
                </div>
            }
            <div class="sidebar-actions">
                <button class="theme-toggle" @onclick="ToggleTheme" title="@Resources.Web_Nav_ToggleTheme">
                    @if (Theme.IsDark)
                    {
                        @Assets.SVG("sun.svg", new SvgOptions())
                    }
                    else
                    {
                        @Assets.SVG("moon.svg", new SvgOptions())
                    }
                </button>
                <button class="theme-toggle" @onclick="Logout" title="@Resources.Web_Nav_Logout">
                    @Assets.SVG("logout.svg", new SvgOptions())
                </button>
            </div>
        </div>
    </nav> 
    <InputFile @key="_fileInputKey" id="global-file-input" OnChange="OnFilesSelected" style="display:none" multiple />
    <main class="main">
        <div class="search-bar-container">
            <GlobalSearch />
            <JobMenu CanSeeReindex="_canManageSettings" />
        </div>
        @if (Demo.ReadOnly)
        {
            <div class="demo-readonly-notice" role="status">
                @Assets.SVG("info.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))
                <span>@Text("Web_Demo_ReadOnlyNotice", "Read-only demo — your changes are not saved.")</span>
            </div>
        }
        @Body
        
    </main>
    <ToastContainer />

    @if (Demo.ReadOnly)
    {
        <div class="demo-banner">
            <span>@Text("Web_Demo_FeedbackText", "This is a read-only demo.")</span>
            <a href="https://feedback-kaimo.familie-hanisch.de/" target="_blank" rel="noopener noreferrer">
                @Text("Web_Demo_FeedbackLink", "Submit feedback")
            </a>
        </div>
    }
</div>

@code {
    private string _displayName = "";
    private string _initials = "";

    private int _fileInputKey;

    private bool _canManageSyncs;
    private bool _canManageCloudAccess;
    private bool _canManageSettings;
    private UserContext? _currentUser;
    
    [Inject] private IJSRuntime JS { get; set; } = default!;


    protected override void OnInitialized()
    {
        UploadCoordinator.OnUploadRequested += TriggerFileDialog;
        UploadCoordinator.OnFilesProcessed += ResetFileInput;
    }
    private async void TriggerFileDialog()
    {
        // Click the hidden input to open the file dialog
        await JS.InvokeVoidAsync("document.getElementById('global-file-input').click");
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        // The browser streams belong to this InputFile. The browser page starts
        // its upload independently and notifies us once all streams are consumed.
        // Returning now keeps the interactive circuit responsive for large batches.
        await UploadCoordinator.NotifyFilesSelected(e);
    }

    private void ResetFileInput()
        => _ = InvokeAsync(() =>
        {
            // Browsers do not raise change when the same file is selected twice.
            _fileInputKey++;
            StateHasChanged();
        });

    public void Dispose()
    {
        UploadCoordinator.OnUploadRequested -= TriggerFileDialog;
        UploadCoordinator.OnFilesProcessed -= ResetFileInput;
    }
    
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _displayName = state.User.FindFirst("display_name")?.Value
                       ?? state.User.Identity?.Name
                       ?? "";
        _initials = GetInitials(_displayName);

        var username = state.User.Identity?.Name;
        if (username != null)
        {
            _currentUser = await UserContextFactory.CreateByUsernameAsync(username);
            _canManageSyncs = _currentUser != null
                              && await ManagementAuthService.HasAnyPermissionAsync(_currentUser, ManagementPermission.SyncAdmin);
            _canManageCloudAccess = _currentUser != null
                                    && (await ManagementAuthService.HasAnyPermissionAsync(
                                            _currentUser, ManagementPermission.ManageConnections)
                                        || await ManagementAuthService.HasAnyPermissionAsync(
                                            _currentUser, ManagementPermission.UseConnections)
                                        || await ManagementAuthService.HasAnyPermissionAsync(
                                            _currentUser, ManagementPermission.ManageCloudAccess));
            _canManageSettings = _currentUser != null
                                 && await ManagementAuthService.HasAnyPermissionAsync(
                                        _currentUser, ManagementPermission.ManageSystemSettings);
        }

        // Load the global date-display format once for the whole circuit (uses the
        // DbContext, which is available here — unlike the theme init in OnAfterRender).
        await DateFmt.InitializeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Theme.InitializeAsync(); // this one's fine to keep here — no DbContext involved presumably
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        await Theme.ToggleAsync();
        StateHasChanged();
    }

    private async Task Logout()
    {
        await AuthState.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: false);
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
        return name[..Math.Min(2, name.Length)].ToUpperInvariant();
    }

    private bool canManageSyncs()
        => _canManageSyncs;

    private static string Text(string key, string fallback)
        => Resources.ResourceManager.GetString(key) ?? fallback;

}
