@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Web.DynamicHelpers
@inherits LayoutComponentBase
@inject ThemeService Theme
@inject NavigationManager Nav
@inject JwtAuthenticationStateProvider AuthState
@inject AuthenticationStateProvider AuthStateProvider
@inject FileUploadCoordinator UploadCoordinator
@inject AssetProvider Assets 

<div class="app-shell" data-theme="@Theme.Current">
    <nav class="sidebar">
        <div class="sidebar-brand">
            @* Don't replace this with an Assets.SVG call, cuz this a lil too complicated for it *@
            @* <svg width="28" height="28" viewBox="0 0 48 48" fill="none">
                <rect width="48" height="48" rx="10" fill="var(--accent)" />
                <path d="M14 20h20v2H14zM14 26h20v2H14zM14 32h14v2H14z" fill="#fff" />
            </svg> *@
            @Assets.RawSVG("icon_kaimo_default.svg", 40, 40)
            <span class="brand-text">Kaimo Files</span>
        </div>

        <div class="sidebar-nav">
            <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">
                @Assets.SVG("folder.svg", new SvgOptions())
                @Resources.Web_Nav_Shares
            </NavLink>
            <NavLink class="nav-item" href="/users" Match="NavLinkMatch.All">
                @Assets.SVG("users.svg", new SvgOptions())
                @Resources.Web_Nav_Users
            </NavLink>
            <NavLink class="nav-item" href="/departments" Match="NavLinkMatch.All">
                @Assets.SVG("users.svg", new SvgOptions())
                @Resources.Web_Nav_Departments
            </NavLink>
            <NavLink class="nav-item" href="/files" Match="NavLinkMatch.All">
                @Assets.SVG("compass.svg", new SvgOptions())
                @Resources.Web_Nav_BrowseFiles
            </NavLink>
        </div>


        <div class="sidebar-footer">
            <NavLink class="nav-item" href="/settings" Match="NavLinkMatch.All">
                @Assets.SVG("gear.svg", new SvgOptions())
                @Resources.Web_Nav_Settings
            </NavLink>
            @if (!string.IsNullOrEmpty(_displayName))
            {
                <div class="sidebar-user">
                    <div class="sidebar-avatar">@_initials</div>
                    <span class="sidebar-username">@_displayName</span>
                </div>
            }
            <div class="sidebar-actions">
                <button class="theme-toggle" @onclick="ToggleTheme" title="@Resources.Web_Nav_ToggleTheme">
                    @if (Theme.IsDark)
                    {
                        @Assets.SVG("sun.svg", new SvgOptions())
                    }
                    else
                    {
                        @Assets.SVG("moon.svg", new SvgOptions())
                    }
                </button>
                <button class="theme-toggle" @onclick="Logout" title="@Resources.Web_Nav_Logout">
                    @Assets.SVG("logout.svg", new SvgOptions())
                </button>
            </div>
        </div>
    </nav> 
    <InputFile id="global-file-input" OnChange="OnFilesSelected" style="display:none" multiple />
    <main class="main">
        <div class="search-bar-container">
            <div class="search-bar">
                @Assets.SVG("compass.svg", new SvgOptions())
                <input type="text"
                       class="search-input"
                       placeholder="@Resources.Web_Nav_BrowseFiles..."
                       @bind="_searchQuery"
                       @bind:event="oninput"
                       @onkeydown="HandleSearchKeyDown" />
                @if (!string.IsNullOrEmpty(_searchQuery))
                {
                    <button class="search-clear" @onclick="ClearSearch">
                        ✕
                    </button>
                }
            </div>
        </div>
        
        @Body
        
    </main>
    <ToastContainer />
</div>

@code {
    private string _displayName = "";
    private string _initials = "";
    private string _searchQuery = "";
    
    private InputFile? _inputFile;
    private ElementReference _inputElement;
    
    [Inject] private IJSRuntime JS { get; set; } = default!;


    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_searchQuery))
        {
            Nav.NavigateTo($"/files?q={Uri.EscapeDataString(_searchQuery)}");
        }
    }

    private void ClearSearch()
    {
        _searchQuery = "";
    }
    
    
    protected override void OnInitialized()
    {
        UploadCoordinator.OnUploadRequested += TriggerFileDialog;
    }
    private async void TriggerFileDialog()
    {
        // Click the hidden input to open the file dialog
        await JS.InvokeVoidAsync("document.querySelector('input[type=file]').click");
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        await UploadCoordinator.NotifyFilesSelected(e);
    }

    public void Dispose()
    {
        UploadCoordinator.OnUploadRequested -= TriggerFileDialog;
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Theme.InitializeAsync();

            // Username aus dem AuthState laden
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            _displayName = state.User.FindFirst("display_name")?.Value
                        ?? state.User.Identity?.Name
                        ?? "";
            _initials = GetInitials(_displayName);

            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        await Theme.ToggleAsync();
        StateHasChanged();
    }

    private async Task Logout()
    {
        await AuthState.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: false);
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
        return name[..Math.Min(2, name.Length)].ToUpperInvariant();
    }
}
