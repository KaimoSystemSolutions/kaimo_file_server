@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Core.Repositories
@using Kaimo_File_Server.Core.Security
@using Kaimo_File_Server.Core.Services
@using Kaimo_File_Server.Web.Components.Search
@using Kaimo_File_Server.Web.DynamicHelpers
@inherits AppLayoutComponentBase
@inject ThemeService Theme
@inject DateFormatService DateFmt
@inject NavigationManager Nav
@inject JwtAuthenticationStateProvider AuthState
@inject AuthenticationStateProvider AuthStateProvider
@inject FileUploadCoordinator UploadCoordinator
@inject IUserContextFactory UserContextFactory
@inject IManagementAuthService ManagementAuthService
@inject DemoModeOptions Demo
@inject Kaimo_File_Server.Web.Components.ProfileNavigator ProfileNav


<div class="app-shell" data-theme="@Theme.Current" data-accent="@Theme.Accent">
    <nav class="sidebar">
        <div class="sidebar-brand">
            @* Don't replace this with an Assets.SVG call, cuz this a lil too complicated for it *@
            @* <svg width="28" height="28" viewBox="0 0 48 48" fill="none">
                <rect width="48" height="48" rx="10" fill="var(--accent)" />
                <path d="M14 20h20v2H14zM14 26h20v2H14zM14 32h14v2H14z" fill="#fff" />
            </svg> *@
            @Assets.RawSVG("icon_kaimo.svg", 40, 40)
            <span class="brand-text">Kaimo File Server</span>
        </div>

        <div class="sidebar-nav">
            <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">
                @Assets.SVG("folder.svg", new SvgOptions())
                <span class="nav-label">@Resources.Web_Nav_Shares</span>
            </NavLink>
            @if (_canManageUsers)
            {
                <NavLink class="nav-item" href="/users" Match="NavLinkMatch.All">
                    @Assets.SVG("users.svg", new SvgOptions())
                    <span class="nav-label">@Resources.Web_Nav_Users</span>
                </NavLink>
            }
            @if (_canViewDepartments)
            {
                <NavLink class="nav-item" href="/departments" Match="NavLinkMatch.All">
                    @Assets.SVG("building.svg", new SvgOptions())
                    <span class="nav-label">@Resources.Web_Nav_Departments</span>
                </NavLink>
            }
            @* Keep the File Browser selected while navigating within a share. *@
            <NavLink class="nav-item" href="/files" Match="NavLinkMatch.Prefix">
                @Assets.SVG("compass.svg", new SvgOptions())
                <span class="nav-label">@Resources.Web_Nav_BrowseFiles</span>
            </NavLink>

            @if (canManageSyncs() || _canManageCloudAccess)
            {
                <NavLink class="nav-item" href="/external-storage" Match="NavLinkMatch.Prefix">
                    @Assets.SVG("cloud-download.svg", new SvgOptions())
                    <span class="nav-label">@Text("Web_ExternalStorage_Title", "External Storage")</span>
                </NavLink>
            }

            @if (_canManageShareLinks)
            {
                <NavLink class="nav-item" href="/share-links" Match="NavLinkMatch.Prefix">
                    @Assets.SVG("share.svg", new SvgOptions())
                    <span class="nav-label">@Text("Web_Nav_ShareLinks", "Share Links")</span>
                </NavLink>
            }

        </div>


        <div class="sidebar-footer">
            <NavLink class="nav-item" href="/settings" Match="NavLinkMatch.All">
                @Assets.SVG("gear.svg", new SvgOptions())
                <span class="nav-label">@Resources.Web_Nav_Settings</span>
            </NavLink>
            <div class="sidebar-user-row">
                @if (!string.IsNullOrEmpty(_displayName))
                {
                    <button type="button" class="sidebar-user" @onclick="GoToOwnProfile"
                            title="@Resources.Web_Nav_ViewProfile">
                        <div class="sidebar-avatar">
                            @if (_avatarUri is not null)
                            {
                                <img src="@_avatarUri" alt="" />
                            }
                            else
                            {
                                @_initials
                            }
                        </div>
                        <span class="sidebar-username">@_displayName</span>
                    </button>
                }
                <button class="theme-toggle" @onclick="Logout" title="@Resources.Web_Nav_Logout">
                    @Assets.SVG("logout.svg", new SvgOptions())
                </button>
            </div>
            <div class="sidebar-actions">
                <div class="accent-picker">
                    <button class="theme-toggle" @onclick="ToggleAccentMenu"
                            title="@Text("Web_Nav_AccentColor", "Accent color")">
                        @Assets.SVG("palette.svg", new SvgOptions())
                    </button>
                    @if (_accentOpen)
                    {
                        <div class="accent-popover">
                            @foreach (var accent in ThemeService.Accents)
                            {
                                <button type="button"
                                        class="accent-swatch @(Theme.Accent == accent ? "accent-swatch--active" : "")"
                                        style="--swatch:@AccentDot(accent)"
                                        title="@AccentLabel(accent)"
                                        aria-label="@AccentLabel(accent)"
                                        @onclick="() => SetAccent(accent)"></button>
                            }
                        </div>
                    }
                </div>
                <button class="theme-toggle" @onclick="ToggleTheme" title="@Resources.Web_Nav_ToggleTheme">
                    @if (Theme.IsDark)
                    {
                        @Assets.SVG("sun.svg", new SvgOptions())
                    }
                    else
                    {
                        @Assets.SVG("moon.svg", new SvgOptions())
                    }
                </button>
            </div>
        </div>
    </nav> 
    @* One live input per in-flight upload batch. Only the active slot carries the well-known
       id that the drop JS and file dialog target; retained slots keep an earlier batch's
       browser streams valid until that batch finishes. *@
    @foreach (var slot in _uploadSlots)
    {
        <InputFile @key="slot" id="@(slot == _activeSlot ? "global-file-input" : null)"
                   OnChange="e => OnSlotChanged(slot, e)" style="display:none" multiple />
    }
    <main class="main">
        <div class="search-bar-container">
            <GlobalSearch />
            <JobMenu CanSeeReindex="_canManageSettings" />
        </div>
        @if (Demo.ReadOnly)
        {
            <div class="demo-readonly-notice" role="status">
                @Assets.SVG("info.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))
                <span>@Text("Web_Demo_ReadOnlyNotice", "Read-only demo — your changes are not saved.")</span>
            </div>
        }
        @Body
        
    </main>
    <ToastContainer />

    @if (Demo.ReadOnly)
    {
        <div class="demo-banner">
            <span>@Text("Web_Demo_FeedbackText", "This is a read-only demo.")</span>
            <a href="https://feedback-kaimo.familie-hanisch.de/" target="_blank" rel="noopener noreferrer">
                @Text("Web_Demo_FeedbackLink", "Submit feedback")
            </a>
        </div>
    }
</div>

@code {
    private string _displayName = "";
    private string _initials = "";
    private string? _avatarUri;

    // Each slot is one <InputFile> element identified by a batch id. Exactly one is active
    // (receives new selections); the rest are retained until their upload signals completion.
    private sealed record UploadSlot(Guid Id);
    private readonly List<UploadSlot> _uploadSlots = new();
    private UploadSlot _activeSlot = new(Guid.NewGuid());

    private bool _canManageSyncs;
    private bool _canManageCloudAccess;
    private bool _canManageSettings;
    private bool _canManageUsers;
    private bool _canViewDepartments;
    private bool _canManageShareLinks;
    private UserContext? _currentUser;
    
    [Inject] private IJSRuntime JS { get; set; } = default!;


    protected override void OnInitialized()
    {
        _uploadSlots.Add(_activeSlot);
        UploadCoordinator.OnUploadRequested += TriggerFileDialog;
        UploadCoordinator.OnFilesProcessed += ReleaseSlot;
    }
    private async void TriggerFileDialog()
    {
        // Click the hidden input to open the file dialog
        await JS.InvokeVoidAsync("document.getElementById('global-file-input').click");
    }

    private async Task OnSlotChanged(UploadSlot slot, InputFileChangeEventArgs e)
    {
        // Only the active input accepts new selections; a retained slot never fires.
        if (slot != _activeSlot) return;

        // Promote a fresh active input BEFORE starting the upload so a second selection
        // made while this batch still streams lands on a different element and cannot
        // clobber this batch's browser file streams. This slot's element stays alive
        // (rendered, non-active) until its upload signals completion via ReleaseSlot.
        _activeSlot = new UploadSlot(Guid.NewGuid());
        _uploadSlots.Add(_activeSlot);
        StateHasChanged();

        // The browser page starts its upload independently and notifies us once all
        // streams are consumed. Returning keeps the circuit responsive for large batches.
        await UploadCoordinator.NotifyFilesSelected(e, slot.Id);
    }

    private void ReleaseSlot(Guid batchId)
        => _ = InvokeAsync(() =>
        {
            // The batch consumed all its streams; drop its now-unused input element.
            // Never remove the active slot (it never carries a completed batch id).
            if (_uploadSlots.RemoveAll(s => s.Id == batchId && s != _activeSlot) > 0)
                StateHasChanged();
        });

    public void Dispose()
    {
        UploadCoordinator.OnUploadRequested -= TriggerFileDialog;
        UploadCoordinator.OnFilesProcessed -= ReleaseSlot;
    }
    
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _displayName = state.User.FindFirst("display_name")?.Value
                       ?? state.User.Identity?.Name
                       ?? "";
        _initials = GetInitials(_displayName);

        var username = state.User.Identity?.Name;
        if (username != null)
        {
            _currentUser = await UserContextFactory.CreateByUsernameAsync(username);
            _avatarUri = DynamicHelpers.UserAvatar.DataUri(_currentUser?.User);
            if (_currentUser?.User is { } actor)
                _initials = DynamicHelpers.UserAvatar.Initials(actor);
            _canManageSyncs = _currentUser != null
                              && await ManagementAuthService.HasAnyPermissionAsync(_currentUser, ManagementPermission.SyncAdmin);
            _canManageCloudAccess = _currentUser != null
                                    && (await ManagementAuthService.HasAnyPermissionAsync(
                                            _currentUser, ManagementPermission.ManageConnections)
                                        || await ManagementAuthService.HasAnyPermissionAsync(
                                            _currentUser, ManagementPermission.UseConnections)
                                        || await ManagementAuthService.HasAnyPermissionAsync(
                                            _currentUser, ManagementPermission.ManageCloudAccess));
            _canManageSettings = _currentUser != null
                                 && await ManagementAuthService.HasAnyPermissionAsync(
                                        _currentUser, ManagementPermission.ManageSystemSettings);
            // Mirror UserListViewModel.CanAccessPage — show the tab only if the user
            // can reach the page behind it.
            _canManageUsers = _currentUser != null
                              && await ManagementAuthService.HasAnyPermissionAsync(
                                     _currentUser,
                                     ManagementPermission.CreateUsers
                                     | ManagementPermission.EditUserProfiles
                                     | ManagementPermission.CreateGroups
                                     | ManagementPermission.ManageGroupMembers
                                     | ManagementPermission.AssignRoles);
            // Mirror DepartmentViewModel.CanAccessPage (FullAdmin carries ViewDepartment).
            _canViewDepartments = _currentUser != null
                                  && await ManagementAuthService.HasAnyPermissionAsync(
                                         _currentUser,
                                         ManagementPermission.ViewDepartment
                                         | ManagementPermission.EditDepartment);
            _canManageShareLinks = _currentUser != null
                                   && await ManagementAuthService.HasAnyPermissionAsync(
                                          _currentUser, ManagementPermission.ManageShareLinks);
        }

        // Load the global date-display format once for the whole circuit (uses the
        // DbContext, which is available here — unlike the theme init in OnAfterRender).
        await DateFmt.InitializeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Theme.InitializeAsync(); // this one's fine to keep here — no DbContext involved presumably
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        await Theme.ToggleAsync();
        StateHasChanged();
    }

    private bool _accentOpen;

    private void ToggleAccentMenu() => _accentOpen = !_accentOpen;

    private async Task SetAccent(string accent)
    {
        await Theme.SetAccentAsync(accent);
        _accentOpen = false;
        StateHasChanged();
    }

    // Static label color for each swatch dot (independent of the live theme, so the
    // swatches read as a stable color legend).
    private static string AccentDot(string accent) => accent switch
    {
        "green" => "#3f9e00",
        "magenta" => "#b01e98",
        "orange" => "#d9700a",
        "red" => "#d63a3a",
        "blue" => "#2f7fe0",
        "yellow" => "#e0b400",
        "turquoise" => "#10a898",
        _ => "#3f9e00",
    };

    private static string AccentLabel(string accent)
        => Text($"Web_Accent_{char.ToUpperInvariant(accent[0])}{accent[1..]}", accent);

    // Jumps to the user administration page with the actor's own record preselected.
    // Self-view is always permitted, even for users without management permissions.
    // Routed through ProfileNavigator (not the URL) so a repeat click re-selects even when
    // the page is already open, and so a Groups/Roles view switches back to Users.
    private async Task GoToOwnProfile()
    {
        await ProfileNav.RequestSelfAsync();
        Nav.NavigateTo("/users");
    }

    private async Task Logout()
    {
        await AuthState.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: false);
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
        return name[..Math.Min(2, name.Length)].ToUpperInvariant();
    }

    private bool canManageSyncs()
        => _canManageSyncs;

    private static string Text(string key, string fallback)
        => Resources.ResourceManager.GetString(key) ?? fallback;

}
