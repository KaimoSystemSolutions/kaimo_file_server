@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Core.Repositories
@using Kaimo_File_Server.Core.Security
@using Kaimo_File_Server.Core.Services
@using Kaimo_File_Server.Search
@using Kaimo_File_Server.Web.DynamicHelpers
@inherits LayoutComponentBase
@inject ThemeService Theme
@inject NavigationManager Nav
@inject JwtAuthenticationStateProvider AuthState
@inject AuthenticationStateProvider AuthStateProvider
@inject FileUploadCoordinator UploadCoordinator
@inject FileSelectionCoordinator FileSelectionCoordinator
@inject AssetProvider Assets
@inject ISearchService SearchService
@inject IUserContextFactory UserContextFactory
@inject IManagementAuthService ManagementAuthService


<div class="app-shell" data-theme="@Theme.Current">
    <nav class="sidebar">
        <div class="sidebar-brand">
            @* Don't replace this with an Assets.SVG call, cuz this a lil too complicated for it *@
            @* <svg width="28" height="28" viewBox="0 0 48 48" fill="none">
                <rect width="48" height="48" rx="10" fill="var(--accent)" />
                <path d="M14 20h20v2H14zM14 26h20v2H14zM14 32h14v2H14z" fill="#fff" />
            </svg> *@
            @Assets.RawSVG("icon_kaimo_default.svg", 40, 40)
            <span class="brand-text">Kaimo Files</span>
        </div>

        <div class="sidebar-nav">
            <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">
                @Assets.SVG("folder.svg", new SvgOptions())
                @Resources.Web_Nav_Shares
            </NavLink>
            <NavLink class="nav-item" href="/users" Match="NavLinkMatch.All">
                @Assets.SVG("users.svg", new SvgOptions())
                @Resources.Web_Nav_Users
            </NavLink>
            <NavLink class="nav-item" href="/departments" Match="NavLinkMatch.All">
                @Assets.SVG("users.svg", new SvgOptions())
                @Resources.Web_Nav_Departments
            </NavLink>
            <NavLink class="nav-item" href="/files" Match="NavLinkMatch.All">
                @Assets.SVG("compass.svg", new SvgOptions())
                @Resources.Web_Nav_BrowseFiles
            </NavLink>
            
            @if (hasShareSelected() && canManageSyncs())
            {
                <NavLink class="nav-item" href="@($"/sync/{getSelectedShare()}")" Match="NavLinkMatch.All">
                    @Assets.SVG("sync.svg", new SvgOptions())
                    Cloud Sync
                </NavLink>
            
            }
            
        </div>


        <div class="sidebar-footer">
            <NavLink class="nav-item" href="/settings" Match="NavLinkMatch.All">
                @Assets.SVG("gear.svg", new SvgOptions())
                @Resources.Web_Nav_Settings
            </NavLink>
            @if (!string.IsNullOrEmpty(_displayName))
            {
                <div class="sidebar-user">
                    <div class="sidebar-avatar">@_initials</div>
                    <span class="sidebar-username">@_displayName</span>
                </div>
            }
            <div class="sidebar-actions">
                <button class="theme-toggle" @onclick="ToggleTheme" title="@Resources.Web_Nav_ToggleTheme">
                    @if (Theme.IsDark)
                    {
                        @Assets.SVG("sun.svg", new SvgOptions())
                    }
                    else
                    {
                        @Assets.SVG("moon.svg", new SvgOptions())
                    }
                </button>
                <button class="theme-toggle" @onclick="Logout" title="@Resources.Web_Nav_Logout">
                    @Assets.SVG("logout.svg", new SvgOptions())
                </button>
            </div>
        </div>
    </nav> 
    <InputFile @key="_fileInputKey" id="global-file-input" OnChange="OnFilesSelected" style="display:none" multiple />
    <main class="main">
        <div class="search-bar-container">
            <div class="search-bar @(_searchResults.Any() ? "has-results" : "")">
                @Assets.SVG("search.svg", new SvgOptions())
                <input type="text"
                       class="search-input"
                       placeholder="@Resources.Web_Search_Searching"
                       @bind="_searchQuery"
                       @bind:event="oninput"
                       @bind:after="OnSearchInputChanged"
                       @onkeydown="HandleSearchKeyDown"
                       @onfocusin="() => _dropdownVisible = _searchResults.Any()"
                       @onfocusout="HideDropdownDelayed" />
                @if (!string.IsNullOrEmpty(_searchQuery))
                {
                    <button class="search-clear" @onclick="ClearSearch">✕</button>
                }
        
                @if (_dropdownVisible && _searchResults.Any())
                {
                    <div class="search-dropdown">
                        @foreach (var group in _searchResults.GroupBy(r => r.ShareName))
                        {
                            <div class="search-group-header">@group.Key</div>
                            @foreach (var result in group)
                            {
                                <div class="search-result-item" @onmousedown="() => NavigateToResult(result)">
                                    @Assets.SVG(result.IsDirectory ? "folder.svg" : FileHelper.GetIcon(result.FileName), new SvgOptions())
                                    <div class="search-result-info">
                                        <span class="search-result-name">@result.FileName <span class="search-result-path">— @result.SharePath</span></span>
                                        @if (!string.IsNullOrEmpty(result.HighlightSnippet))
                                        {
                                            <span class="search-result-snippet">@((MarkupString)result.HighlightSnippet)</span>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
                else if (_dropdownVisible && _isSearching)
                {
                    <div class="search-dropdown">
                        <div class="search-result-item searching">
                            <span>@Resources.Web_Search_Searching</span>
                        </div>
                    </div>
                }
                else if (_dropdownVisible && _searchQuery.Length >= 2 && !_searchResults.Any() && !_isSearching)
                {
                    <div class="search-dropdown">
                        <div class="search-result-item no-results">
                            <span>@Resources.Web_Search_NoResults</span>
                        </div>
                    </div>
                }
            </div>
        </div>
        @Body
        
    </main>
    <ToastContainer />
</div>

@code {
    private string _displayName = "";
    private string _initials = "";
    private string _searchQuery = "";
    
    private int _fileInputKey;
    
    private List<FileDocument> _searchResults = new();
    private bool _dropdownVisible;
    private bool _isSearching;
    private CancellationTokenSource? _searchCts;

    private bool _canManageSyncs;
    private UserContext? _currentUser;
    
    [Inject] private IJSRuntime JS { get; set; } = default!;


    private async Task OnSearchInputChanged()
    {
        if (_searchQuery.Length < 2)
        {
            _searchResults.Clear();
            _dropdownVisible = false;
            return;
        }

        // Cancel previous search
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        _isSearching = true;
        _dropdownVisible = true;

        try
        {
            // Debounce: wait 250ms before firing
            await Task.Delay(250, token);

            // SECURITY: search results must be scoped to what THIS user may read.
            // Resolve the user context and let the search service enforce ACLs;
            // without a user there must be no results.
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = state.User.Identity?.Name;

            var userContext = string.IsNullOrEmpty(username)
                ? null
                : await UserContextFactory.CreateByUsernameAsync(username);

            if (userContext is null)
            {
                _searchResults.Clear();
                _isSearching = false;
                return;
            }

            var results = await SearchService.SearchAsync(_searchQuery, userContext, token);
            if (!token.IsCancellationRequested)
            {
                _searchResults = results.Take(8).ToList();
                _isSearching = false;
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // Expected when typing fast — previous search gets cancelled
        }
    }

    private void NavigateToResult(FileDocument result)
    {
        _dropdownVisible = false;
        _searchQuery = "";
        _searchResults.Clear();

        string url;
        if (result.IsDirectory)
        {
            // Navigate INTO the folder itself.
            var dirPath = (result.SharePath ?? string.Empty).Replace('\\', '/').Trim('/');
            url = string.IsNullOrEmpty(dirPath) || dirPath == "."
                ? $"/files/{result.ShareName}"
                : $"/files/{result.ShareName}/{dirPath}";
        }
        else
        {
            // Select directly when the containing folder is already open. Otherwise
            // keep the one-time request until that folder has finished loading.
            var folderPath = (Path.GetDirectoryName(result.SharePath) ?? string.Empty)
                .Replace('\\', '/').Trim('/');
            url = string.IsNullOrEmpty(folderPath)
                ? $"/files/{result.ShareName}"
                : $"/files/{result.ShareName}/{folderPath}";

            if (FileSelectionCoordinator.RequestSelection(result.ShareName, folderPath, result.FileName))
                return;
        }

        Nav.NavigateTo(url);
    }
    
    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_searchQuery))
        {
            //Nav.NavigateTo($"/files?q={Uri.EscapeDataString(_searchQuery)}");
        }
    }

    private async Task HideDropdownDelayed()
    {
        // Small delay so @onmousedown on results fires before we hide
        await Task.Delay(200);
        _dropdownVisible = false;
        StateHasChanged();
    }

    private void ClearSearch()
    {
        _searchQuery = "";
        _searchResults.Clear();
        _dropdownVisible = false;
    }
    
    
    protected override void OnInitialized()
    {
        UploadCoordinator.OnUploadRequested += TriggerFileDialog;
    }
    private async void TriggerFileDialog()
    {
        // Click the hidden input to open the file dialog
        await JS.InvokeVoidAsync("document.getElementById('global-file-input').click");
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        try
        {
            await UploadCoordinator.NotifyFilesSelected(e);
        }
        finally
        {
            // Browsers do not raise change when the same file is selected twice.
            // Recreate the InputFile only after all BrowserFile streams were consumed.
            // This stays entirely inside Blazor and does not depend on a cached JS file.
            _fileInputKey++;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        UploadCoordinator.OnUploadRequested -= TriggerFileDialog;
    }
    
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _displayName = state.User.FindFirst("display_name")?.Value
                       ?? state.User.Identity?.Name
                       ?? "";
        _initials = GetInitials(_displayName);

        var username = state.User.Identity?.Name;
        if (username != null)
        {
            _currentUser = await UserContextFactory.CreateByUsernameAsync(username);
            _canManageSyncs = _currentUser != null
                              && await ManagementAuthService.HasAnyPermissionAsync(_currentUser, ManagementPermission.SyncAdmin);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Theme.InitializeAsync(); // this one's fine to keep here — no DbContext involved presumably
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        await Theme.ToggleAsync();
        StateHasChanged();
    }

    private async Task Logout()
    {
        await AuthState.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: false);
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
        return name[..Math.Min(2, name.Length)].ToUpperInvariant();
    }

    private bool hasShareSelected()
        => Nav.ToBaseRelativePath(Nav.Uri).StartsWith("files");

    private string getSelectedShare()
        => Nav.ToBaseRelativePath(Nav.Uri).Split("/")[1];

    private bool canManageSyncs()
        => _canManageSyncs;

}
