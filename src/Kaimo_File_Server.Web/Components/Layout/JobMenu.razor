@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Infrastructure.Clouds
@using Kaimo_File_Server.Search
@using Kaimo_File_Server.Web.DynamicHelpers
@implements IDisposable
@inject JobService JobService
@inject ICloudSyncJobRunner SyncJobRunner
@inject ISearchAdminService SearchAdmin
@inherits AppComponentBase

<div class="job-menu">
    <button class="job-menu-toggle @(_isOpen ? "job-menu-toggle--open" : "")"
            type="button"
            title="@Text("Web_Jobs_Title", "Running jobs")"
            aria-label="@Text("Web_Jobs_Title", "Running jobs")"
            aria-expanded="@_isOpen"
            @onclick="Toggle">
        @Assets.SVG("upload.svg", new SvgOptions(Width: 18, Height: 18, StrokeWidth: 2))
        <span>@Text("Web_Jobs_Title", "Running jobs")</span>
        @* Always rendered so the slot reserves room for a two-digit count and
           the surrounding controls don't shift when a number appears. *@
        <span class="job-menu-count @(TotalCount > 0 ? "" : "job-menu-count--empty")">@(TotalCount > 0 ? TotalCount.ToString() : "")</span>
    </button>

    @if (_isOpen)
    {
        <section class="job-menu-panel" aria-live="polite">
            <header class="job-menu-header">
                <strong>@Text("Web_Jobs_Title", "Running jobs")</strong>
                <span>@string.Format(Text("Web_Jobs_Count", "{0} active"), TotalCount)</span>
            </header>

            @if (TotalCount == 0)
            {
                <div class="job-menu-empty">@Text("Web_Jobs_Empty", "No jobs are currently running.")</div>
            }
            else
            {
                <div class="job-menu-list">
                    @if (ReindexRunning)
                    {
                        @* Process-wide reindex (started by any admin), visible to
                           anyone with system-settings rights — who may also cancel it. *@
                        <article class="job-menu-item">
                            <div class="job-menu-item-heading">
                                <div>
                                    <strong>@($"{Text("Web_Settings_Search_ReindexTitle", "Manual indexing")} · {ReindexScopeLabel}")</strong>
                                    <small>@string.Format(
                                        Text("Web_Settings_Search_Indexing", "Indexing… {0} / {1} ({2} %)"),
                                        _reindex.Done, _reindex.Total, _reindex.Percent)</small>
                                </div>
                                <button class="job-cancel"
                                        type="button"
                                        disabled="@_reindexCancelRequested"
                                        title="@Text("Web_Jobs_Cancel", "Cancel job")"
                                        aria-label="@Text("Web_Jobs_Cancel", "Cancel job")"
                                        @onclick="CancelReindex">
                                    @Assets.SVG("close.svg", new SvgOptions(Width: 13, Height: 13, StrokeWidth: 2))
                                </button>
                            </div>
                            <div class="job-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@_reindex.Percent">
                                <div class="job-progress-fill" style="width: @(_reindex.Percent)%"></div>
                            </div>
                            <div class="job-menu-meta">
                                <span>@(_reindexCancelRequested ? Text("Web_Jobs_Cancelling", "Cancelling…") : $"{_reindex.Percent}%")</span>
                                @if (_reindex.StartedAt is not null)
                                {
                                    <span>@_reindex.StartedAt.Value.ToLocalTime().ToString("t")</span>
                                }
                            </div>
                        </article>
                    }
                    @foreach (var job in JobService.Jobs)
                    {
                        <article class="job-menu-item">
                            <div class="job-menu-item-heading">
                                <div>
                                    <strong>@job.Title</strong>
                                    <small>@job.Detail</small>
                                </div>
                                <button class="job-cancel"
                                        type="button"
                                        disabled="@job.IsCancellationRequested"
                                        title="@Text("Web_Jobs_Cancel", "Cancel job")"
                                        aria-label="@Text("Web_Jobs_Cancel", "Cancel job")"
                                        @onclick="() => Cancel(job.Id)">
                                    @Assets.SVG("close.svg", new SvgOptions(Width: 13, Height: 13, StrokeWidth: 2))
                                </button>
                            </div>
                            <div class="job-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@job.Progress">
                                <div class="job-progress-fill" style="width: @(job.Progress)%"></div>
                            </div>
                            <div class="job-menu-meta">
                                <span>@(job.IsCancellationRequested
                                    ? Text("Web_Jobs_Cancelling", "Cancelling…")
                                    : $"{job.Progress}%")</span>
                                <span>@job.StartedAt.ToLocalTime().ToString("t")</span>
                            </div>
                        </article>
                    }
                    @* Server-side cloud syncs (manual + scheduled) run off the UI
                       circuit in the singleton runner, so they survive navigation
                       and appear for every session. *@
                    @foreach (var job in SyncJobRunner.Jobs)
                    {
                        <article class="job-menu-item">
                            <div class="job-menu-item-heading">
                                <div>
                                    <strong>@job.Title</strong>
                                    <small>@job.Detail</small>
                                </div>
                                <button class="job-cancel"
                                        type="button"
                                        disabled="@job.IsCancellationRequested"
                                        title="@Text("Web_Jobs_Cancel", "Cancel job")"
                                        aria-label="@Text("Web_Jobs_Cancel", "Cancel job")"
                                        @onclick="() => SyncJobRunner.Cancel(job.Id)">
                                    @Assets.SVG("close.svg", new SvgOptions(Width: 13, Height: 13, StrokeWidth: 2))
                                </button>
                            </div>
                            <div class="job-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@job.Progress">
                                <div class="job-progress-fill" style="width: @(job.Progress)%"></div>
                            </div>
                            <div class="job-menu-meta">
                                <span>@(job.IsCancellationRequested
                                    ? Text("Web_Jobs_Cancelling", "Cancelling…")
                                    : $"{job.Progress}%")</span>
                                <span>@job.StartedAt.ToLocalTime().ToString("t")</span>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    }
</div>

@code {
    /// <summary>
    /// Whether this session may see the server-wide Elasticsearch reindex progress.
    /// Set by the layout from the ManageSystemSettings permission.
    /// </summary>
    [Parameter] public bool CanSeeReindex { get; set; }

    private bool _isOpen;
    private ReindexProgress _reindex = ReindexProgress.Idle;
    private (bool Running, int Done, int Total) _reindexSig;
    // Local "cancel clicked" flag for immediate UI feedback: the reindex has no
    // per-request signal and keeps Running=true until it stops at the next
    // file/directory boundary. Reset once the run is no longer running.
    private bool _reindexCancelRequested;

    // The reindex reports progress into an in-memory record, not through an event,
    // so a light timer polls it. GetReindexProgress is a cheap in-memory read; we
    // only re-render when the visible numbers actually change.
    private System.Timers.Timer? _pollTimer;

    private bool ReindexRunning => CanSeeReindex && _reindex.Running;

    // Scope shown on the reindex row: the share name, or the localized "all shares".
    private string ReindexScopeLabel => string.IsNullOrEmpty(_reindex.ShareName)
        ? Text("Web_Settings_Search_ReindexAllShares", "All shares")
        : _reindex.ShareName!;
    private int TotalCount => JobService.Jobs.Count + SyncJobRunner.Jobs.Count + (ReindexRunning ? 1 : 0);

    protected override void OnInitialized()
    {
        JobService.OnChanged += HandleChanged;
        SyncJobRunner.OnChanged += HandleChanged;
        _reindex = SearchAdmin.GetReindexProgress();
        _reindexSig = (_reindex.Running, _reindex.Done, _reindex.Total);

        _pollTimer = new System.Timers.Timer(1500) { AutoReset = true };
        _pollTimer.Elapsed += PollReindex;
        _pollTimer.Start();
    }

    private void PollReindex(object? sender, System.Timers.ElapsedEventArgs e)
    {
        if (!CanSeeReindex) return;

        var p = SearchAdmin.GetReindexProgress();
        var sig = (p.Running, p.Done, p.Total);
        if (sig == _reindexSig) return;

        _reindex = p;
        _reindexSig = sig;
        if (!p.Running) _reindexCancelRequested = false;
        _ = InvokeAsync(StateHasChanged);
    }

    // Opening an empty menu is intentional: it gives the user an explicit view
    // that no work is running instead of making the control disappear.
    private void Toggle() => _isOpen = !_isOpen;

    // Menu and toast cancellation both target the same registered job id.
    private void Cancel(string id) => JobService.Cancel(id);

    // Requests cancellation of the process-wide reindex; the row updates via the
    // poll once the run stops. Only reachable for users who can see the row.
    private void CancelReindex()
    {
        SearchAdmin.CancelReindex();
        _reindexCancelRequested = true;
    }

    // Job notifications are thread-agnostic; InvokeAsync safely returns rendering
    // to the component's synchronization context.
    private void HandleChanged() => _ = InvokeAsync(StateHasChanged);

    // A scoped job service can outlive this layout instance during navigation,
    // therefore event handlers must always be detached explicitly.
    public void Dispose()
    {
        JobService.OnChanged -= HandleChanged;
        SyncJobRunner.OnChanged -= HandleChanged;
        if (_pollTimer is not null)
        {
            _pollTimer.Elapsed -= PollReindex;
            _pollTimer.Dispose();
        }
    }

    private static string Text(string key, string fallback)
        => Resources.ResourceManager.GetString(key) ?? fallback;
}
