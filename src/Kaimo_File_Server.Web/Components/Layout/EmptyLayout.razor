@inherits LayoutComponentBase
@inject ThemeService Theme

<div data-theme="@Theme.Current" data-accent="@Theme.Accent">
    @Body
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Theme.InitializeAsync();
            StateHasChanged();
        }
    }
}
