@using Kaimo_File_Server.Core.Security
@using Kaimo_File_Server.Web.Components.ViewModels
@inject AclEditorViewModel VM

<div class="acl-editor">

    @if (IsLoading)
    {
        <div class="loading-state" style="padding: 24px 0;">
            <div class="spinner"></div>
            <p>Lade Berechtigungen…</p>
        </div>
    }

    @if (VM.ErrorMessage is not null)
    {
        <div class="error-banner">@VM.ErrorMessage</div>
    }

    @if (VM.SuccessMessage is not null)
    {
        <div class="success-banner">@VM.SuccessMessage</div>
    }

    @if (VM.IsLoaded)
    {
        @* ── Existing Entries ── *@
        @if (VM.Entries.Any())
        {
            <div class="acl-list">
                @foreach (var entry in VM.Entries)
                {
                    var isEditing = VM.EditingEntryId == entry.Id;
                    var principalType = VM.GetPrincipalType(entry.PrincipalId);

                    <div class="acl-entry @(entry.EntryType == AclEntryType.Deny ? "acl-entry--deny" : "acl-entry--allow") @(isEditing ? "acl-entry--editing" : "")">
                        <div class="acl-entry-header">
                            <div class="acl-entry-principal">
                                @if (principalType == "group")
                                {
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--text-tertiary)" stroke-width="2" class="acl-icon">
                                        <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" />
                                        <circle cx="9" cy="7" r="4" />
                                        <path d="M23 21v-2a4 4 0 00-3-3.87" />
                                        <path d="M16 3.13a4 4 0 010 7.75" />
                                    </svg>
                                }
                                else if (principalType == "role")
                                {
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--text-tertiary)" stroke-width="2" class="acl-icon">
                                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                                    </svg>
                                }
                                else
                                {
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--text-tertiary)" stroke-width="2" class="acl-icon">
                                        <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
                                        <circle cx="12" cy="7" r="4" />
                                    </svg>
                                }
                                <span class="acl-entry-name">@VM.GetPrincipalDisplayName(entry.PrincipalId)</span>
                                <span class="acl-entry-type-badge @(entry.EntryType == AclEntryType.Deny ? "badge--deny" : "badge--allow")">
                                    @(entry.EntryType == AclEntryType.Allow ? "Allow" : "Deny")
                                </span>
                            </div>
                            <div class="acl-entry-actions">
                                @if (!isEditing)
                                {
                                    <button class="btn-icon btn-icon--small" title="Bearbeiten"
                                            @onclick="() => StartEdit(entry)">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" />
                                            <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z" />
                                        </svg>
                                    </button>
                                    <button class="btn-icon btn-icon--small btn-icon--danger" title="Entfernen"
                                            @onclick="() => DeleteEntry(entry.Id)">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <line x1="18" y1="6" x2="6" y2="18" />
                                            <line x1="6" y1="6" x2="18" y2="18" />
                                        </svg>
                                    </button>
                                }
                            </div>
                        </div>

                        @if (isEditing)
                        {
                            <div class="acl-form">
                                <div class="acl-form-row">
                                    <span class="detail-label">Aktion</span>
                                    <div class="acl-type-tabs">
                                        <button class="acl-type-tab @(VM.NewEntryType == AclEntryType.Allow ? "active acl-tab--allow" : "")"
                                                @onclick="() => SetEntryType(AclEntryType.Allow)">
                                            Allow
                                        </button>
                                        <button class="acl-type-tab @(VM.NewEntryType == AclEntryType.Deny ? "active acl-tab--deny" : "")"
                                                @onclick="() => SetEntryType(AclEntryType.Deny)">
                                            Deny
                                        </button>
                                    </div>
                                </div>

                                <div class="acl-form-row">
                                    <span class="detail-label">Schnellauswahl</span>
                                    <div class="acl-shortcut-row">
                                        <button class="acl-shortcut @(VM.IsShortcutFullySet(VM.NewPermissions, FilePermission.ReadAll) ? "acl-shortcut--active" : "")"
                                                @onclick="() => ToggleShortcut(FilePermission.ReadAll)">
                                            Lesen
                                        </button>
                                        <button class="acl-shortcut @(VM.IsShortcutFullySet(VM.NewPermissions, FilePermission.WriteAll) ? "acl-shortcut--active" : "")"
                                                @onclick="() => ToggleShortcut(FilePermission.WriteAll)">
                                            Schreiben
                                        </button>
                                        <button class="acl-shortcut @(VM.IsShortcutFullySet(VM.NewPermissions, FilePermission.AdminAll) ? "acl-shortcut--active" : "")"
                                                @onclick="() => ToggleShortcut(FilePermission.AdminAll)">
                                            Admin
                                        </button>
                                        <button class="acl-shortcut @(VM.IsShortcutFullySet(VM.NewPermissions, FilePermission.FullControl) ? "acl-shortcut--active" : "")"
                                                @onclick="() => ToggleShortcut(FilePermission.FullControl)">
                                            Vollzugriff
                                        </button>
                                    </div>
                                </div>

                                <div class="acl-form-row">
                                    <span class="detail-label">Einzelberechtigungen</span>
                                    <div class="acl-perm-grid">
                                        <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.TraverseExecute)" @onchange="() => TogglePerm(FilePermission.TraverseExecute)" /><span>Durchsuchen/Ausführen</span></label>
                                        <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.ListReadData)" @onchange="() => TogglePerm(FilePermission.ListReadData)" /><span>Lesen/Auflisten</span></label>
                                        <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.ReadAttributes)" @onchange="() => TogglePerm(FilePermission.ReadAttributes)" /><span>Attribute lesen</span></label>
                                        <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.ReadExtAttributes)" @onchange="() => TogglePerm(FilePermission.ReadExtAttributes)" /><span>Erw. Attribute lesen</span></label>
                                        <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.ReadPermissions)" @onchange="() => TogglePerm(FilePermission.ReadPermissions)" /><span>Rechte lesen</span></label>
                                        <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.CreateWriteData)" @onchange="() => TogglePerm(FilePermission.CreateWriteData)" /><span>Erstellen/Schreiben</span></label>
                                        <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.CreateAppendData)" @onchange="() => TogglePerm(FilePermission.CreateAppendData)" /><span>Erstellen/Anhängen</span></label>
                                        <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.WriteAttributes)" @onchange="() => TogglePerm(FilePermission.WriteAttributes)" /><span>Attribute schreiben</span></label>
                                        <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.WriteExtAttributes)" @onchange="() => TogglePerm(FilePermission.WriteExtAttributes)" /><span>Erw. Attr. schreiben</span></label>
                                        <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.DeleteSubItems)" @onchange="() => TogglePerm(FilePermission.DeleteSubItems)" /><span>Unterelem. löschen</span></label>
                                        <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.Delete)" @onchange="() => TogglePerm(FilePermission.Delete)" /><span>Löschen</span></label>
                                        <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.ChangePermissions)" @onchange="() => TogglePerm(FilePermission.ChangePermissions)" /><span>Rechte ändern</span></label>
                                        <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.TakeOwnership)" @onchange="() => TogglePerm(FilePermission.TakeOwnership)" /><span>Besitz übernehmen</span></label>
                                    </div>
                                </div>

                                <div class="acl-form-row">
                                    <span class="detail-label">Vererbung</span>
                                    <div class="acl-perm-grid">
                                        <label class="acl-checkbox"><input type="checkbox" checked="@((VM.NewInheritance & AclInheritance.ThisFolder) != 0)" @onchange="() => ToggleInheritance(AclInheritance.ThisFolder)" /><span>Dieser Ordner</span></label>
                                        <label class="acl-checkbox"><input type="checkbox" checked="@((VM.NewInheritance & AclInheritance.SubFolders) != 0)" @onchange="() => ToggleInheritance(AclInheritance.SubFolders)" /><span>Unterordner</span></label>
                                        <label class="acl-checkbox"><input type="checkbox" checked="@((VM.NewInheritance & AclInheritance.SubFiles) != 0)" @onchange="() => ToggleInheritance(AclInheritance.SubFiles)" /><span>Dateien</span></label>
                                        <label class="acl-checkbox"><input type="checkbox" checked="@((VM.NewInheritance & AclInheritance.AllDescendants) != 0)" @onchange="() => ToggleInheritance(AclInheritance.AllDescendants)" /><span>Alle Nachfahren (rekursiv)</span></label>
                                    </div>
                                </div>

                                <div class="acl-form-actions">
                                    <button class="btn-primary" @onclick="SaveEdit">Speichern</button>
                                    <button class="btn-secondary" @onclick="CancelEdit">Abbrechen</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="acl-entry-details">
                                <span class="acl-detail-label">Berechtigungen:</span>
                                <span class="acl-detail-value">@FormatPermissions(entry.Permissions)</span>
                            </div>
                            <div class="acl-entry-details">
                                <span class="acl-detail-label">Vererbung:</span>
                                <span class="acl-detail-value">@FormatInheritance(entry.Inheritance)</span>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <p class="empty-hint">Keine Berechtigungen konfiguriert. Ohne ACL-Einträge haben alle Benutzer mit Share-Zugriff vollen Zugriff.</p>
        }

        @* ── Add Entry ── *@
        @if (VM.IsAddingEntry)
        {
            <div class="acl-add-form">
                <h4>Berechtigung hinzufügen</h4>
                <div class="acl-form">
                    <div class="acl-form-row">
                        <span class="detail-label">Typ</span>
                        <div class="acl-type-tabs">
                            <button class="acl-type-tab @(VM.NewPrincipalType == "user" ? "active" : "")"
                                    @onclick='() => SetPrincipalType("user")'>
                                Benutzer
                            </button>
                            <button class="acl-type-tab @(VM.NewPrincipalType == "group" ? "active" : "")"
                                    @onclick='() => SetPrincipalType("group")'>
                                Gruppe
                            </button>
                            <button class="acl-type-tab @(VM.NewPrincipalType == "role" ? "active" : "")"
                                    @onclick='() => SetPrincipalType("role")'>
                                Rolle
                            </button>
                        </div>
                    </div>

                    <div class="acl-form-row">
                        <span class="detail-label">
                            @(VM.NewPrincipalType == "user" ? "Benutzer" : VM.NewPrincipalType == "group" ? "Gruppe" : "Rolle")
                        </span>
                        <select class="edit-input" @onchange="OnPrincipalSelected">
                            <option value="">— Auswählen —</option>
                            @if (VM.NewPrincipalType == "user")
                            {
                                @foreach (var u in VM.AllUsers)
                                {
                                    <option value="@u.Id">@(u.Name ?? u.Username)</option>
                                }
                            }
                            else if (VM.NewPrincipalType == "group")
                            {
                                @foreach (var g in VM.AllGroups)
                                {
                                    <option value="@g.Id">@g.Name</option>
                                }
                            }
                            else
                            {
                                @foreach (var r in VM.AllRoles)
                                {
                                    <option value="@r.Id">@r.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="acl-form-row">
                        <span class="detail-label">Aktion</span>
                        <div class="acl-type-tabs">
                            <button class="acl-type-tab @(VM.NewEntryType == AclEntryType.Allow ? "active acl-tab--allow" : "")"
                                    @onclick="() => SetEntryType(AclEntryType.Allow)">
                                Allow
                            </button>
                            <button class="acl-type-tab @(VM.NewEntryType == AclEntryType.Deny ? "active acl-tab--deny" : "")"
                                    @onclick="() => SetEntryType(AclEntryType.Deny)">
                                Deny
                            </button>
                        </div>
                    </div>

                    <div class="acl-form-row">
                        <span class="detail-label">Schnellauswahl</span>
                        <div class="acl-shortcut-row">
                            <button class="acl-shortcut @(VM.IsShortcutFullySet(VM.NewPermissions, FilePermission.ReadAll) ? "acl-shortcut--active" : "")"
                                    @onclick="() => ToggleShortcut(FilePermission.ReadAll)">
                                Lesen
                            </button>
                            <button class="acl-shortcut @(VM.IsShortcutFullySet(VM.NewPermissions, FilePermission.WriteAll) ? "acl-shortcut--active" : "")"
                                    @onclick="() => ToggleShortcut(FilePermission.WriteAll)">
                                Schreiben
                            </button>
                            <button class="acl-shortcut @(VM.IsShortcutFullySet(VM.NewPermissions, FilePermission.AdminAll) ? "acl-shortcut--active" : "")"
                                    @onclick="() => ToggleShortcut(FilePermission.AdminAll)">
                                Admin
                            </button>
                            <button class="acl-shortcut @(VM.IsShortcutFullySet(VM.NewPermissions, FilePermission.FullControl) ? "acl-shortcut--active" : "")"
                                    @onclick="() => ToggleShortcut(FilePermission.FullControl)">
                                Vollzugriff
                            </button>
                        </div>
                    </div>

                    <div class="acl-form-row">
                        <span class="detail-label">Einzelberechtigungen</span>
                        <div class="acl-perm-grid">
                            <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.TraverseExecute)" @onchange="() => TogglePerm(FilePermission.TraverseExecute)" /><span>Durchsuchen/Ausführen</span></label>
                            <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.ListReadData)" @onchange="() => TogglePerm(FilePermission.ListReadData)" /><span>Lesen/Auflisten</span></label>
                            <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.ReadAttributes)" @onchange="() => TogglePerm(FilePermission.ReadAttributes)" /><span>Attribute lesen</span></label>
                            <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.ReadExtAttributes)" @onchange="() => TogglePerm(FilePermission.ReadExtAttributes)" /><span>Erw. Attribute lesen</span></label>
                            <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.ReadPermissions)" @onchange="() => TogglePerm(FilePermission.ReadPermissions)" /><span>Rechte lesen</span></label>
                            <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.CreateWriteData)" @onchange="() => TogglePerm(FilePermission.CreateWriteData)" /><span>Erstellen/Schreiben</span></label>
                            <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.CreateAppendData)" @onchange="() => TogglePerm(FilePermission.CreateAppendData)" /><span>Erstellen/Anhängen</span></label>
                            <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.WriteAttributes)" @onchange="() => TogglePerm(FilePermission.WriteAttributes)" /><span>Attribute schreiben</span></label>
                            <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.WriteExtAttributes)" @onchange="() => TogglePerm(FilePermission.WriteExtAttributes)" /><span>Erw. Attr. schreiben</span></label>
                            <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.DeleteSubItems)" @onchange="() => TogglePerm(FilePermission.DeleteSubItems)" /><span>Unterelem. löschen</span></label>
                            <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.Delete)" @onchange="() => TogglePerm(FilePermission.Delete)" /><span>Löschen</span></label>
                            <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.ChangePermissions)" @onchange="() => TogglePerm(FilePermission.ChangePermissions)" /><span>Rechte ändern</span></label>
                            <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.TakeOwnership)" @onchange="() => TogglePerm(FilePermission.TakeOwnership)" /><span>Besitz übernehmen</span></label>
                        </div>
                    </div>

                    <div class="acl-form-row">
                        <span class="detail-label">Vererbung</span>
                        <div class="acl-perm-grid">
                            <label class="acl-checkbox"><input type="checkbox" checked="@((VM.NewInheritance & AclInheritance.ThisFolder) != 0)" @onchange="() => ToggleInheritance(AclInheritance.ThisFolder)" /><span>Dieser Ordner</span></label>
                            <label class="acl-checkbox"><input type="checkbox" checked="@((VM.NewInheritance & AclInheritance.SubFolders) != 0)" @onchange="() => ToggleInheritance(AclInheritance.SubFolders)" /><span>Unterordner</span></label>
                            <label class="acl-checkbox"><input type="checkbox" checked="@((VM.NewInheritance & AclInheritance.SubFiles) != 0)" @onchange="() => ToggleInheritance(AclInheritance.SubFiles)" /><span>Dateien</span></label>
                            <label class="acl-checkbox"><input type="checkbox" checked="@((VM.NewInheritance & AclInheritance.AllDescendants) != 0)" @onchange="() => ToggleInheritance(AclInheritance.AllDescendants)" /><span>Alle Nachfahren (rekursiv)</span></label>
                        </div>
                    </div>

                    <div class="acl-form-actions">
                        <button class="btn-primary" @onclick="AddEntry">Hinzufügen</button>
                        <button class="btn-secondary" @onclick="CancelAdd">Abbrechen</button>
                    </div>
                </div>
            </div>
        }
        else if (VM.EditingEntryId is null)
        {
            <button class="btn-secondary" style="margin-top: 12px;" @onclick="StartAdd">
                + Berechtigung hinzufügen
            </button>
        }
    }
</div>

@code {
    [Parameter] public string Path { get; set; } = "";
    [Parameter] public bool IsDirectory { get; set; } = true;
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool IsLoading;
    private string? _loadedPath;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(Path) && Path != _loadedPath)
        {
            _loadedPath = Path;
            IsLoading = true;
            StateHasChanged();

            await VM.LoadAsync(Path, IsDirectory);

            IsLoading = false;
        }
    }

    // ── Simple wrapper methods to avoid lambda issues ──

    private void StartAdd()
    {
        VM.StartAddEntry();
    }

    private void CancelAdd()
    {
        VM.CancelAddEntry();
    }

    private void StartEdit(AccessEntry entry)
    {
        VM.StartEditEntry(entry);
    }

    private void CancelEdit()
    {
        VM.CancelEditEntry();
    }

    private async Task DeleteEntry(Guid entryId)
    {
        await VM.DeleteEntryAsync(entryId);
        if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
    }

    private async Task AddEntry()
    {
        var success = await VM.AddEntryAsync();
        if (success && OnChanged.HasDelegate) await OnChanged.InvokeAsync();
    }

    private async Task SaveEdit()
    {
        var success = await VM.SaveEditEntryAsync();
        if (success && OnChanged.HasDelegate) await OnChanged.InvokeAsync();
    }

    private void SetPrincipalType(string type)
    {
        VM.NewPrincipalType = type;
        VM.NewPrincipalId = null;
    }

    private void SetEntryType(AclEntryType type)
    {
        VM.NewEntryType = type;
    }

    private void TogglePerm(FilePermission flag)
    {
        VM.NewPermissions = VM.TogglePermission(VM.NewPermissions, flag);
    }

    private void ToggleShortcut(FilePermission shortcut)
    {
        VM.NewPermissions = VM.ApplyShortcut(VM.NewPermissions, shortcut);
    }

    private void ToggleInheritance(AclInheritance flag)
    {
        VM.NewInheritance ^= flag;
    }

    private void OnPrincipalSelected(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        VM.NewPrincipalId = !string.IsNullOrEmpty(val) && Guid.TryParse(val, out var id) ? id : null;
    }

    private string FormatPermissions(FilePermission p)
    {
        if (p == FilePermission.FullControl) return "Vollzugriff";
        if (p == FilePermission.ReadAll) return "Lesen";
        if (p == FilePermission.WriteAll) return "Schreiben";
        if (p == (FilePermission.ReadAll | FilePermission.WriteAll)) return "Lesen + Schreiben";

        var parts = new List<string>();
        if ((p & FilePermission.ReadAll) == FilePermission.ReadAll) parts.Add("Lesen");
        else
        {
            if ((p & FilePermission.ListReadData) != 0) parts.Add("Lesen/Auflisten");
            if ((p & FilePermission.ReadAttributes) != 0) parts.Add("Attribute lesen");
            if ((p & FilePermission.TraverseExecute) != 0) parts.Add("Durchsuchen");
        }
        if ((p & FilePermission.WriteAll) == FilePermission.WriteAll) parts.Add("Schreiben");
        else
        {
            if ((p & FilePermission.CreateWriteData) != 0) parts.Add("Erstellen/Schreiben");
            if ((p & FilePermission.Delete) != 0) parts.Add("Löschen");
            if ((p & FilePermission.DeleteSubItems) != 0) parts.Add("Unterelemente löschen");
        }
        if ((p & FilePermission.AdminAll) == FilePermission.AdminAll) parts.Add("Administration");
        else
        {
            if ((p & FilePermission.ChangePermissions) != 0) parts.Add("Rechte ändern");
            if ((p & FilePermission.TakeOwnership) != 0) parts.Add("Besitz übernehmen");
        }
        return parts.Count > 0 ? string.Join(", ", parts) : "Keine";
    }

    private string FormatInheritance(AclInheritance i)
    {
        if (i == AclInheritance.Everything) return "Alles (rekursiv)";
        if (i == AclInheritance.ThisOnly) return "Nur dieser Ordner";
        if (i == AclInheritance.ThisAndDirect) return "Dieser Ordner + direkte Unterelemente";

        var parts = new List<string>();
        if ((i & AclInheritance.ThisFolder) != 0) parts.Add("Dieser Ordner");
        if ((i & AclInheritance.SubFolders) != 0) parts.Add("Unterordner");
        if ((i & AclInheritance.SubFiles) != 0) parts.Add("Dateien");
        if ((i & AclInheritance.AllDescendants) != 0) parts.Add("Alle Nachfahren");
        return parts.Count > 0 ? string.Join(", ", parts) : "Keine";
    }
}
