@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Core.Logging
@using Kaimo_File_Server.Core.Security
@using Kaimo_File_Server.Web.DynamicHelpers
@using Microsoft.Extensions.Logging
@inject AclEditorViewModel VM
@inject AssetProvider Assets
@inject ILogger<AclEditor> Logger

<div class="acl-editor">

    @if (_isLoading)
    {
        <div class="loading-state" style="padding: 24px 0;">
            <div class="spinner"></div>
            <p>@Resources.Web_Acl_LoadingPermissions</p>
        </div>
    }
    else if (_errorMessage is not null)
    {
        <div class="error-banner">@_errorMessage</div>
    }
    else if (VM.ErrorMessage is not null)
    {
        <div class="error-banner">@VM.ErrorMessage</div>
    }

    @if (VM.SuccessMessage is not null)
    {
        <div class="success-banner">@VM.SuccessMessage</div>
    }

    @if (_loaded)
    {
        @* -- Inherited ACLs (readonly) -- *@
        @if (VM.InheritedEntries.Any())
        {
            <div class="acl-inherited-section">
                <span class="detail-label" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">
                    @Resources.Web_Acl_Inherited
                </span>
                <div class="acl-list">
                    @foreach (var inherited in VM.InheritedEntries)
                    {
                        var entry = inherited.Entry;
                        var principalType = VM.GetPrincipalType(entry.PrincipalId);
                        var sourceName = string.IsNullOrEmpty(inherited.SourcePath) ? Resources.Web_Acl_ShareRoot : inherited.SourcePath;

                        <div class="acl-entry acl-entry--inherited @(entry.EntryType == AclEntryType.Deny ? "acl-entry--deny" : "acl-entry--allow")">
                            <div class="acl-entry-header">
                                <div class="acl-entry-principal">
                                    @(principalType switch
                                    {
                                        "group" => Assets.SVG("users.svg", new SvgOptions(Width: 14, Height: 14, Color: "var(--text-tertiary)", StrokeWidth: 2, CssClass: "acl-icon")),
                                        "role" => Assets.SVG("shield.svg", new SvgOptions(Width: 14, Height: 14, Color: "var(--text-tertiary)", StrokeWidth: 2, CssClass: "acl-icon")),
                                        _ => Assets.SVG("user.svg", new SvgOptions(Width: 14, Height: 14, Color: "var(--text-tertiary)", StrokeWidth: 2, CssClass: "acl-icon")),
                                    })
                                    <span class="acl-entry-name">@VM.GetPrincipalDisplayName(entry.PrincipalId)</span>
                                    <span class="acl-entry-type-badge @(entry.EntryType == AclEntryType.Deny ? "badge--deny" : "badge--allow")">
                                        @(entry.EntryType == AclEntryType.Allow ? Resources.Web_Acl_Allow : Resources.Web_Acl_Deny)
                                    </span>
                                    <span class="acl-inherited-badge" title="@string.Format(Resources.Web_Acl_InheritedFrom, sourceName)">
                                        ↑ @sourceName
                                    </span>
                                </div>
                            </div>
                            <div class="acl-entry-details">
                                <span class="acl-detail-label">@Resources.Web_Action_Permissions:</span>
                                <span class="acl-detail-value">@FormatPermissions(entry.Permissions)</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @* -- Direct ACLs (editable) -- *@
        @if (VM.InheritedEntries.Any() || VM.Entries.Any())
        {
            <span class="detail-label" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 12px; display: block;">
                @Resources.Web_Acl_Directly
            </span>
        }

        @if (VM.Entries.Any())
        {
            <div class="acl-list">
                @foreach (var entry in VM.Entries)
                {
                    var isEditing = VM.EditingEntryId == entry.Id;
                    var principalType = VM.GetPrincipalType(entry.PrincipalId);

                    <div class="acl-entry @(entry.EntryType == AclEntryType.Deny ? "acl-entry--deny" : "acl-entry--allow") @(isEditing ? "acl-entry--editing" : "")">
                        <div class="acl-entry-header">
                            <div class="acl-entry-principal">
                                @(principalType switch
                                {
                                    "group" => Assets.SVG("users.svg", new SvgOptions(Width: 14, Height: 14, Color: "var(--text-tertiary)", StrokeWidth: 2, CssClass: "acl-icon")),
                                    "role" => Assets.SVG("shield.svg", new SvgOptions(Width: 14, Height: 14, Color: "var(--text-tertiary)", StrokeWidth: 2, CssClass: "acl-icon")),
                                    _ => Assets.SVG("user.svg", new SvgOptions(Width: 14, Height: 14, Color: "var(--text-tertiary)", StrokeWidth: 2, CssClass: "acl-icon")),
                                })
                                <span class="acl-entry-name">@VM.GetPrincipalDisplayName(entry.PrincipalId)</span>
                                <span class="acl-entry-type-badge @(entry.EntryType == AclEntryType.Deny ? "badge--deny" : "badge--allow")">
                                    @(entry.EntryType == AclEntryType.Allow ? Resources.Web_Acl_Allow : Resources.Web_Acl_Deny)
                                </span>
                            </div>
                            <div class="acl-entry-actions">
                                @if (!isEditing)
                                {
                                    <button class="btn-icon btn-icon--small" title="@Resources.Web_Acl_Edit" @onclick="() => StartEdit(entry)">
                                        @Assets.SVG("edit_box.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                                    </button>
                                    <button class="btn-icon btn-icon--small btn-icon--danger" title="@Resources.Web_Acl_Remove" @onclick="() => DeleteEntry(entry.Id)">
                                        @Assets.SVG("close.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                                    </button>
                                }
                            </div>
                        </div>

                        @if (isEditing)
                        {
                            @RenderPermissionForm(false)
                        }
                        else
                        {
                            <div class="acl-entry-details">
                                <span class="acl-detail-label">@Resources.Web_Action_Permissions:</span>
                                <span class="acl-detail-value">@FormatPermissions(entry.Permissions)</span>
                            </div>
                            <div class="acl-entry-details">
                                <span class="acl-detail-label">@Resources.Web_Acl_Inheritance:</span>
                                <span class="acl-detail-value">@FormatInheritance(entry.Inheritance)</span>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <p class="empty-hint">@Resources.Web_Acl_EmptyHint</p>
        }

        @* -- Add Entry -- *@
        @if (VM.IsAddingEntry)
        {
            <div class="acl-add-form">
                <h4>@Resources.Web_Acl_AddPermission</h4>
                <div class="acl-form">
                    <div class="acl-form-row">
                        <span class="detail-label">@Resources.Web_Acl_Type</span>
                        <div class="acl-type-tabs">
                            <button class="acl-type-tab @(VM.NewPrincipalType == "user" ? "active" : "")" @onclick='() => SetPrincipalType("user")'>@Resources.Web_Acl_Button_User</button>
                            <button class="acl-type-tab @(VM.NewPrincipalType == "group" ? "active" : "")" @onclick='() => SetPrincipalType("group")'>@Resources.Web_Acl_Button_Group</button>
                            <button class="acl-type-tab @(VM.NewPrincipalType == "role" ? "active" : "")" @onclick='() => SetPrincipalType("role")'>@Resources.Web_Acl_Button_Role</button>
                        </div>
                    </div>
                    <div class="acl-form-row">
                        <span class="detail-label">@(VM.NewPrincipalType == "user" ? Resources.Web_Acl_Button_User : VM.NewPrincipalType == "group" ? Resources.Web_Acl_Button_Group : Resources.Web_Acl_Button_Role)</span>
                        <select class="edit-input" @onchange="OnPrincipalSelected">
                            <option value="">— @Resources.Web_Acl_SelectPlaceholder —</option>
                            @if (VM.NewPrincipalType == "user")
                            {
                                @foreach (var u in VM.AllUsers)
                                {
                                    <option value="@u.Id">@(u.Name ?? u.Username)</option>
                                }
                            }
                            else if (VM.NewPrincipalType == "group")
                            {
                                @foreach (var g in VM.AllGroups)
                                {
                                    <option value="@g.Id">@g.Name</option>
                                }
                            }
                            else
                            {
                                @foreach (var r in VM.AllRoles)
                                {
                                    <option value="@r.Id">@r.Name</option>
                                }
                            }
                        </select>
                    </div>
                    @RenderPermissionForm(true)
                </div>
            </div>
        }
        else if (VM.EditingEntryId is null)
        {
            <button class="btn-secondary" style="margin-top: 12px;" @onclick="StartAdd">
                + @Resources.Web_Acl_AddPermission
            </button>
        }
    }
</div>

@* -- Shared Permission Form Fragment -- *@
@{
    RenderFragment RenderPermissionForm(bool isAdd) => __builder2 =>
    {
        <div class="acl-form" style="@(isAdd ? "" : "margin-top: 8px;")">
            <div class="acl-form-row">
                <span class="detail-label">@Resources.Web_Acl_Action</span>
                <div class="acl-type-tabs">
                    <button class="acl-type-tab @(VM.NewEntryType == AclEntryType.Allow ? "active acl-tab--allow" : "")" @onclick="() => SetEntryType(AclEntryType.Allow)">@Resources.Web_Acl_Allow</button>
                    <button class="acl-type-tab @(VM.NewEntryType == AclEntryType.Deny ? "active acl-tab--deny" : "")" @onclick="() => SetEntryType(AclEntryType.Deny)">@Resources.Web_Acl_Deny</button>
                </div>
            </div>
            <div class="acl-form-row">
                <span class="detail-label">@Resources.Web_Acl_QuickSelect</span>
                <div class="acl-shortcut-row">
                    <button class="acl-shortcut @(VM.IsShortcutFullySet(VM.NewPermissions, FilePermission.ReadAll) ? "acl-shortcut--active" : "")" @onclick="() => ToggleShortcut(FilePermission.ReadAll)">@Resources.Web_Acl_Permission_Read</button>
                    <button class="acl-shortcut @(VM.IsShortcutFullySet(VM.NewPermissions, FilePermission.WriteAll) ? "acl-shortcut--active" : "")" @onclick="() => ToggleShortcut(FilePermission.WriteAll)">@Resources.Web_Acl_Permission_Write</button>
                    <button class="acl-shortcut @(VM.IsShortcutFullySet(VM.NewPermissions, FilePermission.AdminAll) ? "acl-shortcut--active" : "")" @onclick="() => ToggleShortcut(FilePermission.AdminAll)">@Resources.Web_Acl_Permission_Admin</button>
                    <button class="acl-shortcut @(VM.IsShortcutFullySet(VM.NewPermissions, FilePermission.FullControl) ? "acl-shortcut--active" : "")" @onclick="() => ToggleShortcut(FilePermission.FullControl)">@Resources.Web_Acl_Permission_FullAccess</button>
                </div>
            </div>

            @* -- Collapsible individual permissions -- *@
            <div class="acl-form-row">
                <button class="acl-collapse-toggle" @onclick="() => _showDetailPerms = !_showDetailPerms">
                    @Assets.SVG("chevron_right.svg", new SvgOptions(Width: 12, Height: 12, StrokeWidth: 2, CssClass: "acl-collapse-chevron" + (_showDetailPerms ? " acl-collapse-chevron--open" : "")))
                    <span class="detail-label" style="margin-bottom: 0; cursor: pointer;">@Resources.Web_Acl_DetailPermissions</span>
                </button>
                @if (_showDetailPerms)
                {
                    <div class="acl-perm-grid">
                        <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.TraverseExecute)" @onchange="() => TogglePerm(FilePermission.TraverseExecute)" /><span>@Resources.Web_Acl_Perm_TraverseExecute</span></label>
                        <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.ListReadData)" @onchange="() => TogglePerm(FilePermission.ListReadData)" /><span>@Resources.Web_Acl_Perm_ListReadData</span></label>
                        <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.ReadAttributes)" @onchange="() => TogglePerm(FilePermission.ReadAttributes)" /><span>@Resources.Web_Acl_Perm_ReadAttributes</span></label>
                        <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.ReadExtAttributes)" @onchange="() => TogglePerm(FilePermission.ReadExtAttributes)" /><span>@Resources.Web_Acl_Perm_ReadExtAttributes</span></label>
                        <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.ReadPermissions)" @onchange="() => TogglePerm(FilePermission.ReadPermissions)" /><span>@Resources.Web_Acl_Perm_ReadPermissions</span></label>
                        <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.CreateWriteData)" @onchange="() => TogglePerm(FilePermission.CreateWriteData)" /><span>@Resources.Web_Acl_Perm_CreateWriteData</span></label>
                        <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.CreateAppendData)" @onchange="() => TogglePerm(FilePermission.CreateAppendData)" /><span>@Resources.Web_Acl_Perm_CreateAppendData</span></label>
                        <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.WriteAttributes)" @onchange="() => TogglePerm(FilePermission.WriteAttributes)" /><span>@Resources.Web_Acl_Perm_WriteAttributes</span></label>
                        <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.WriteExtAttributes)" @onchange="() => TogglePerm(FilePermission.WriteExtAttributes)" /><span>@Resources.Web_Acl_Perm_WriteExtAttributes</span></label>
                        <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.DeleteSubItems)" @onchange="() => TogglePerm(FilePermission.DeleteSubItems)" /><span>@Resources.Web_Acl_Perm_DeleteSubItems</span></label>
                        <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.Delete)" @onchange="() => TogglePerm(FilePermission.Delete)" /><span>@Resources.Web_Acl_Perm_Delete</span></label>
                        <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.ChangePermissions)" @onchange="() => TogglePerm(FilePermission.ChangePermissions)" /><span>@Resources.Web_Acl_Perm_ChangePermissions</span></label>
                        <label class="acl-checkbox"><input type="checkbox" checked="@VM.HasPermission(VM.NewPermissions, FilePermission.TakeOwnership)" @onchange="() => TogglePerm(FilePermission.TakeOwnership)" /><span>@Resources.Web_Acl_Perm_TakeOwnership</span></label>
                    </div>
                }
            </div>

            @* -- Collapsible inheritance -- *@
            <div class="acl-form-row">
                <button class="acl-collapse-toggle" @onclick="() => _showInheritance = !_showInheritance">
                    @Assets.SVG("chevron_right.svg", new SvgOptions(Width: 12, Height: 12, StrokeWidth: 2, CssClass: "acl-collapse-chevron" + (_showInheritance ? " acl-collapse-chevron--open" : "")))
                    <span class="detail-label" style="margin-bottom: 0; cursor: pointer;">@Resources.Web_Acl_Inheritance</span>
                </button>
                @if (_showInheritance)
                {
                    <div class="acl-perm-grid">
                        <label class="acl-checkbox"><input type="checkbox" checked="@((VM.NewInheritance & AclInheritance.ThisFolder) != 0)" @onchange="() => ToggleInheritance(AclInheritance.ThisFolder)" /><span>@Resources.Web_Acl_Inherit_ThisFolder</span></label>
                        <label class="acl-checkbox"><input type="checkbox" checked="@((VM.NewInheritance & AclInheritance.SubFolders) != 0)" @onchange="() => ToggleInheritance(AclInheritance.SubFolders)" /><span>@Resources.Web_Acl_Inherit_SubFolders</span></label>
                        <label class="acl-checkbox"><input type="checkbox" checked="@((VM.NewInheritance & AclInheritance.SubFiles) != 0)" @onchange="() => ToggleInheritance(AclInheritance.SubFiles)" /><span>@Resources.Web_Acl_Inherit_Files</span></label>
                        <label class="acl-checkbox"><input type="checkbox" checked="@((VM.NewInheritance & AclInheritance.AllDescendants) != 0)" @onchange="() => ToggleInheritance(AclInheritance.AllDescendants)" /><span>@Resources.Web_Acl_Inherit_AllDescendants</span></label>
                    </div>
                }
            </div>

            <div class="acl-form-actions">
                @if (isAdd)
                {
                    <button class="btn-primary" @onclick="AddEntry">@Resources.Web_Acl_Button_Add</button>
                    <button class="btn-secondary" @onclick="CancelAdd">@Resources.Web_Acl_Button_Cancel</button>
                }
                else
                {
                    <button class="btn-primary" @onclick="SaveEdit">@Resources.Web_Acl_Button_Save</button>
                    <button class="btn-secondary" @onclick="CancelEdit">@Resources.Web_Acl_Button_Cancel</button>
                }
            </div>
        </div>
    };
}
