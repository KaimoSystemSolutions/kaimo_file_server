@page "/shared"
@page "/shared/{Token}"
@page "/shared/{Token}/{*SubPath}"
@layout EmptyLayout
@inherits AppComponentBase
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

@using Kaimo_File_Server.Core.Domain
@using Kaimo_File_Server.Core.Helpers
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Core.Repositories
@using Kaimo_File_Server.Web.Components.Pages.Files.FileBrowser
@using Kaimo_File_Server.Web.Components.ViewModels
@using Kaimo_File_Server.Web.DynamicHelpers
@using Kaimo_File_Server.Web.Helpers
@using Kaimo_File_Server.Web.Services

@inject ShareLinkService ShareLinks
@inject PublicUploadService Uploads
@inject IShareRepository Shares
@inject PublicShareFileBrowserViewModel Vm
@inject ClientConnectionInfo Client
@inject IJSRuntime JS
@implements IDisposable

@*
    Anonymous landing page for a public share link ("/shared/{token}"). Folder links open the
    normal file browser confined to the shared folder (read-only, multi-select download); file
    links show a download card; upload links show a drop zone that uploads into the linked
    folder without revealing its content. Optional password unlock happens on the circuit,
    never in the URL.
*@

@if (_state == State.NotFound || _state == State.Unavailable)
{
    <div class="public-share-shell">
        <div class="public-share-card">
            <div class="public-share-icon">@Assets.SVG("share.svg", new SvgOptions(Width: 32, Height: 32))</div>
            <h1>@T("Web_PublicShare_Unavailable_Title", "Link unavailable")</h1>
            <p>@T("Web_PublicShare_Unavailable_Body", "This link does not exist, or is no longer available.")</p>
        </div>
    </div>
}
else if (_state == State.Password)
{
    <div class="public-share-shell">
        <div class="public-share-card">
            <div class="public-share-icon">@Assets.SVG("share.svg", new SvgOptions(Width: 32, Height: 32))</div>
            <h1>@_link!.DisplayName</h1>
            <p>@T("Web_PublicShare_Password_Body", "This link is password-protected.")</p>
            <input type="password" class="edit-input" autocomplete="current-password"
                   placeholder="@T("Web_PublicShare_Password_Placeholder", "Password")"
                   @bind="_passwordInput" @bind:event="oninput" @onkeydown="OnPasswordKeyDown" />
            @if (_passwordError is not null)
            {
                <div class="error-banner">@_passwordError</div>
            }
            <button class="btn-primary" @onclick="UnlockAsync">@T("Web_PublicShare_Unlock", "Open")</button>
        </div>
    </div>
}
else if (_state == State.Folder)
{
    <div class="public-share-browser">
        <FileBrowser VM="Vm"
                     ShareName="@_shareName"
                     InPlaceNavigation="true"
                     ShareRoute="@($"/shared/{Token}")"
                     OverviewRoute="@($"/shared/{Token}")"
                     ShareDisplayName="@_link!.DisplayName" />
    </div>
}
else if (_state == State.File)
{
    <div class="public-share-shell">
        <div class="public-share-card">
            <div class="public-share-icon">@Assets.SVG("download.svg", new SvgOptions(Width: 32, Height: 32))</div>
            <h1>@_link!.DisplayName</h1>
            <button class="btn-primary" @onclick="DownloadFileAsync">@T("Web_PublicShare_Download", "Download")</button>
        </div>
    </div>
}

else if (_state == State.Upload)
{
    <div class="public-share-shell">
        <div class="public-share-card public-upload-card">
            <div class="public-share-icon">@Assets.SVG("upload.svg", new SvgOptions(Width: 32, Height: 32))</div>
            <h1>@_link!.DisplayName</h1>
            <p>@T("Web_PublicUpload_Body", "Upload files for the owner of this link. Files uploaded by others are not visible.")</p>

            <label class="public-upload-drop @(_busy ? "public-upload-drop--busy" : "")">
                <InputFile multiple id="@PublicUploadInputId" class="public-upload-input" disabled="@_busy" OnChange="OnFilesSelected"
                           accept="@(_link.AllowedExtensionList.Count > 0 ? string.Join(",", _link.AllowedExtensionList) : null)" />
                @Assets.SVG("upload.svg", new SvgOptions(Width: 22, Height: 22, Color: "var(--accent)"))
                <span>@(_busy ? T("Web_PublicUpload_Busy", "Uploading...") : T("Web_PublicUpload_Drop", "Drop files here or click to choose"))</span>
            </label>
            <button type="button" class="btn-secondary public-upload-folder" disabled="@_busy" @onclick="ChooseFolderAsync">
                @Assets.SVG("folder.svg", new SvgOptions(Width: 16, Height: 16, Color: "var(--folder-stroke)", Fill: "var(--folder-fill)"))
                <span>@T("Web_PublicUpload_ChooseFolder", "Upload a folder")</span>
            </button>

            <ul class="public-upload-limits">
                <li>@string.Format(T("Web_PublicUpload_MaxSize", "Max. {0} per file"), FormatHelper.FormatFileSize(_maxFileSize))</li>
                @if (_link.AllowedExtensionList.Count > 0)
                {
                    <li>@string.Format(T("Web_PublicUpload_AllowedTypes", "Allowed: {0}"), string.Join(", ", _link.AllowedExtensionList))</li>
                }
                @if (_link.MaxAccessCount is { } maxFiles)
                {
                    <li>@string.Format(T("Web_PublicUpload_FilesLeft", "{0} more file(s) allowed"), Math.Max(0, maxFiles - _link.AccessCount))</li>
                }
                @if (_link.MaxTotalBytes is { } maxTotal)
                {
                    <li>@string.Format(T("Web_PublicUpload_SpaceLeft", "{0} space left"), FormatHelper.FormatFileSize(Math.Max(0, maxTotal - _link.UploadedBytes)))</li>
                }
            </ul>

            @if (_uploads.Count > 0)
            {
                <ul class="public-upload-list">
                    @foreach (var item in _uploads)
                    {
                        <li class="public-upload-item public-upload-item--@item.Tone">
                            <span class="public-upload-name" title="@item.Name">@item.Name</span>
                            <span class="public-upload-state">@item.StateText</span>
                            @if (item.Tone == "running")
                            {
                                <span class="public-upload-bar"><span style="width: @(item.Percent)%"></span></span>
                            }
                        </li>
                    }
                </ul>
            }

            @if (_busy)
            {
                <button class="btn-secondary" @onclick="CancelUploads">@Resources.Web_Button_Cancel</button>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string Token { get; set; } = "";
    [Parameter] public string? SubPath { get; set; }

    private enum State { Loading, NotFound, Unavailable, Password, Folder, File, Upload }

    // Most files a visitor may pick in one go; the link's own file cap is enforced per file.
    private const int MaxFilesPerSelection = 100;

    private sealed class UploadItem(string name)
    {
        public string Name { get; } = name;
        public int Percent { get; set; }
        public string Tone { get; set; } = "queued";   // queued / running / done / error
        public string StateText { get; set; } = "";
    }

    private const string PublicUploadInputId = "public-upload-input";

    // Folder of each file of the next selection, registered by fileUpload.js right before it
    // hands the files to the InputFile (same order as the files).
    private sealed record PendingUploadPaths(string?[] Dirs);
    private PendingUploadPaths? _pendingUploadPaths;
    private DotNetObjectReference<PublicShareLink>? _dotNetRef;
    private bool _folderDropBound;

    private readonly List<UploadItem> _uploads = new();
    private CancellationTokenSource? _uploadCts;
    private bool _busy;
    private long _maxFileSize;
    private State _state = State.Loading;

    private ShareLink? _link;
    private string _shareName = "";
    private bool _unlocked;
    private string? _passwordInput;
    private string? _passwordError;

    private static string T(string key, string fallback)
        => Resources.ResourceManager.GetString(key) ?? fallback;

    protected override async Task OnParametersSetAsync()
    {
        // Anything not found under /shared (missing/blank token, unknown token, a resolution
        // error, or a missing/disabled share) always lands on the "link unavailable" page.
        try
        {
            if (string.IsNullOrWhiteSpace(Token)) { _state = State.NotFound; return; }

            // Nothing may follow the token: a share link is addressed only by "/shared/{token}".
            // Any trailing path (a guessed folder name, tampering) is always unavailable — the
            // browser navigates folders in place, so a legitimate visit never carries one.
            if (!string.IsNullOrWhiteSpace(SubPath)) { _state = State.NotFound; return; }

            // Links only work under the default server domain. Checked before the token lookup so
            // another host cannot even probe whether a token exists. Downloads and uploads are
            // driven from this page, so this one gate covers them all.
            if (!await ShareLinks.IsAllowedHostAsync(Client.Host)) { _state = State.NotFound; return; }

            _link = await ShareLinks.GetByTokenAsync(Token);
            if (_link is null) { _state = State.NotFound; return; }

            if (!_link.IsWindowOpen(DateTime.UtcNow)) { _state = State.Unavailable; return; }

            var share = await Shares.GetByIdAsync(_link.ShareId);
            if (share is null || !share.IsEnabled) { _state = State.Unavailable; return; }
            if (await ShareLinks.ResolveCreatorAsync(_link) is null) { _state = State.Unavailable; return; }
            _shareName = share.Name;

            // Upload links honour the global switch (and demo mode) already on the landing page.
            if (_link.Kind == ShareLinkKind.Upload && !await Uploads.IsUploadEnabledAsync())
            { _state = State.Unavailable; return; }

            if (_link.PasswordHash is not null && !_unlocked) { _state = State.Password; return; }

            if (_link.Kind == ShareLinkKind.Upload)
            {
                await EnterUploadStateAsync();
            }
            else if (_link.IsDirectory)
            {
                Vm.Initialize(_link);
                _state = State.Folder;
            }
            else
            {
                _state = State.File;
            }
        }
        catch
        {
            _state = State.NotFound;
        }
    }

    private async Task OnPasswordKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await UnlockAsync();
    }

    private async Task UnlockAsync()
    {
        if (_link is null) return;

        var (ok, retryAfter) = ShareLinks.VerifyPassword(_link, _passwordInput);
        if (ok)
        {
            _unlocked = true;
            _passwordError = null;
            _passwordInput = null;
            if (_link.Kind == ShareLinkKind.Upload)
            {
                await EnterUploadStateAsync();
                return;
            }
            _state = _link.IsDirectory ? State.Folder : State.File;
            if (_link.IsDirectory) Vm.Initialize(_link);
        }
        else
        {
            _passwordError = retryAfter > TimeSpan.Zero
                ? string.Format(T("Web_PublicShare_Password_Locked", "Too many attempts. Try again in {0} minutes."),
                    Math.Max(1, (int)Math.Ceiling(retryAfter.TotalMinutes)))
                : T("Web_PublicShare_Password_Wrong", "Wrong password.");
        }
    }

    private async Task EnterUploadStateAsync()
    {
        var settings = await ShareLinks.GetSettingsAsync();
        _maxFileSize = settings.EffectiveMaxFileSize(_link!);
        _state = State.Upload;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Dropped folders keep their structure only through the JS drop handler.
        if (_state != State.Upload || _folderDropBound) return;
        _folderDropBound = true;
        _dotNetRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("kaimoUpload.initPublicDrop",
            ".public-upload-drop", PublicUploadInputId, _dotNetRef, MaxFilesPerSelection);
    }

    private async Task ChooseFolderAsync()
    {
        if (_busy) return;
        _dotNetRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("kaimoUpload.pickFolder", _dotNetRef, PublicUploadInputId, MaxFilesPerSelection);
    }

    // Empty folders are ignored here: a visitor only ever creates folders that hold a file.
    // Empty arrays withdraw a registration whose files never reached the input.
    [JSInvokable]
    public void SetPendingUploadPaths(string[] dirs, int[] dirIndex, string[] emptyDirs)
        => _pendingUploadPaths = dirIndex.Length == 0
            ? null
            : new PendingUploadPaths(UploadFolderPath.Unpack(dirs, dirIndex));

    [JSInvokable]
    public Task OnUploadTooManyFiles(int maxFiles)
        => ShowUploadErrorAsync(string.Format(T("Web_PublicUpload_TooManyFiles", "Choose at most {0} files at once."), maxFiles));

    [JSInvokable]
    public Task OnUploadSelectionTooLarge()
        => ShowUploadErrorAsync(T("Web_Upload_SelectionTooLarge", "The selection is too large (too many files or too long paths). Please upload it in smaller parts."));

    private Task ShowUploadErrorAsync(string message)
        => InvokeAsync(() =>
        {
            _uploads.Insert(0, new UploadItem("—") { Tone = "error", StateText = message });
            StateHasChanged();
        });

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        // Always take the registered folders so they can never leak into a later selection.
        var pending = Interlocked.Exchange(ref _pendingUploadPaths, null);
        if (_link is null || _busy) return;

        IReadOnlyList<IBrowserFile> files;
        try
        {
            files = e.GetMultipleFiles(MaxFilesPerSelection);
        }
        catch (InvalidOperationException)
        {
            _uploads.Insert(0, new UploadItem("—")
            {
                Tone = "error",
                StateText = string.Format(T("Web_PublicUpload_TooManyFiles", "Choose at most {0} files at once."), MaxFilesPerSelection),
            });
            return;
        }
        if (files.Count == 0) return;

        _busy = true;
        _uploadCts = new CancellationTokenSource();
        var ct = _uploadCts.Token;
        // The service validates each folder; here it only labels the file in the list.
        var dirs = pending is not null && pending.Dirs.Length == files.Count ? pending.Dirs : null;
        var batch = files
            .Select((f, i) =>
            {
                var dir = dirs?[i] ?? "";
                var label = dir.Length == 0 ? f.Name : $"{dir.Trim('/')}/{f.Name}";
                return (File: f, Dir: dir, Item: new UploadItem(label) { StateText = T("Web_PublicUpload_Queued", "Waiting") });
            })
            .ToList();
        _uploads.InsertRange(0, batch.Select(b => b.Item));
        StateHasChanged();

        try
        {
            foreach (var (file, dir, item) in batch)
            {
                if (ct.IsCancellationRequested)
                {
                    SetResult(item, PublicUploadStatus.Cancelled);
                    continue;
                }

                item.Tone = "running";
                item.StateText = "0 %";
                StateHasChanged();

                // The reserved size becomes the stream's hard cap (see PublicUploadService).
                var lastRender = DateTime.UtcNow;
                var result = await Uploads.UploadAsync(_link, file.Name, file.Size,
                    max => new ProgressStream(file.OpenReadStream(max, ct), file.Size, (read, total) =>
                    {
                        item.Percent = total > 0 ? (int)(read * 100 / total) : 100;
                        item.StateText = $"{item.Percent} %";
                        if ((DateTime.UtcNow - lastRender).TotalMilliseconds < 400) return;
                        lastRender = DateTime.UtcNow;
                        _ = InvokeAsync(StateHasChanged);
                    }),
                    ct,
                    dir);

                SetResult(item, result.Status, result.StoredName);
                StateHasChanged();
            }

            // Refresh the remaining file/space counters shown to the visitor.
            if (await ShareLinks.GetByTokenAsync(Token) is { } fresh)
                _link = fresh;
        }
        finally
        {
            _busy = false;
            _uploadCts?.Dispose();
            _uploadCts = null;
            StateHasChanged();
        }
    }

    private void SetResult(UploadItem item, PublicUploadStatus status, string? storedName = null)
    {
        item.Tone = status == PublicUploadStatus.Uploaded ? "done" : "error";
        if (status == PublicUploadStatus.Uploaded) item.Percent = 100;
        item.StateText = status switch
        {
            PublicUploadStatus.Uploaded when storedName is not null && storedName != item.Name
                => string.Format(T("Web_PublicUpload_DoneRenamed", "Uploaded as {0}"), storedName),
            PublicUploadStatus.Uploaded => T("Web_PublicUpload_Done", "Uploaded"),
            PublicUploadStatus.InvalidName => T("Web_PublicUpload_InvalidName", "Invalid file name"),
            PublicUploadStatus.TypeNotAllowed => T("Web_PublicUpload_TypeNotAllowed", "File type not allowed"),
            PublicUploadStatus.TooLarge => T("Web_PublicUpload_TooLarge", "File too large"),
            PublicUploadStatus.QuotaExceeded => T("Web_PublicUpload_QuotaExceeded", "Upload limit reached"),
            PublicUploadStatus.Unavailable => T("Web_PublicUpload_Unavailable", "This link no longer accepts uploads"),
            PublicUploadStatus.Cancelled => T("Web_PublicUpload_Cancelled", "Cancelled"),
            _ => T("Web_PublicUpload_Failed", "Upload failed"),
        };
    }

    private void CancelUploads() => _uploadCts?.Cancel();

    public void Dispose()
    {
        _uploadCts?.Cancel();
        _dotNetRef?.Dispose();
    }

    private async Task DownloadFileAsync()
    {
        if (_link is null) return;
        var rel = ShareRelativePath.Normalize(_link.RootRelativePath);
        var ticket = ShareLinks.IssueTicket(_link, new[] { rel }, zip: false, downloadName: _link.DisplayName);
        var url = "/api/public/download?ticket=" + Uri.EscapeDataString(ticket);
        await JS.InvokeVoidAsync("filePreview.downloadFromUrl", url, _link.DisplayName);
    }
}
