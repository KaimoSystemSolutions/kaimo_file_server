@using Kaimo_File_Server.Core.Domain
@using Kaimo_File_Server.Core.Helpers
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Core.Services.DataServices
@using Kaimo_File_Server.Core.Services.ExternalStorage
@using Kaimo_File_Server.Infrastructure.Clouds
@using Kaimo_File_Server.Web.Components.Pages.CloudSync.Components
@using Kaimo_File_Server.Web.Components.ViewModels
@using Kaimo_File_Server.Web.DynamicHelpers
@using Microsoft.JSInterop
@using System.Globalization
@using System.Text.Json
@implements IAsyncDisposable
@inject ExternalStorageSyncViewModel VM
@inject ICloudSyncJobRunner SyncJobRunner
@inject IJSRuntime JS
@inject DateFormatService DateFmt
@inherits AppComponentBase

@if (VM.IsLoading)
{
    <div class="loading-state"><div class="spinner"></div><p>@R("Web_ExternalStorage_Loading")</p></div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_error ?? VM.ErrorMessage))
    {
        <div class="error-banner">@(_error ?? VM.ErrorMessage)</div>
    }

    <div class="storage-toolbar">
        <div>
            <h2>@R("Web_ExternalStorage_Tab_Syncs")</h2>
            <p class="subtitle">@R("Web_ExternalStorage_SyncsHelp")</p>
        </div>
        <button class="btn-primary" type="button" disabled="@(!ReadyConnections.Any())" @onclick="StartCreate">
            @R("Web_ExternalStorage_CreateSync")
        </button>
    </div>

    <div class="sync-workspace">
        <section class="sync-list-pane">
            @if (VM.Syncs.Count == 0)
            {
                <div class="empty-state"><p>@R("Web_ExternalStorage_NoSyncs")</p></div>
            }
            else
            {
                <div class="sync-list">
                    <div class="sync-list-header" aria-hidden="true">
                        <span>@R("Web_ExternalStorage_Name")</span>
                        <span>@R("Web_ExternalStorage_Health")</span>
                        <span>@R("Web_ExternalStorage_Mode")</span>
                    </div>
                    @foreach (var item in VM.Syncs)
                    {
                        <button class="sync-row @(_selectedId == item.Definition.Id ? "sync-row--selected" : "")" type="button" @onclick="() => Select(item)">
                            <span class="sync-name">
                                <span class="sync-provider-icon" style="color: @ProviderColor(ProviderIdFor(item))">@Assets.SVG(ProviderIcon(ProviderIdFor(item)), new SvgOptions(Width: 18, Height: 18))</span>
                                <span class="sync-name-text">
                                    <strong>@DisplayName(item)</strong>
                                    <small>@item.ConnectionName · @ProviderFor(item)</small>
                                </span>
                            </span>
                            <StatusBadge Tone="@SyncStateTone(item)" Class="sync-state" Label="@SyncState(item)" />
                            <span class="sync-mode">@ModeName(item.Definition.Mode) · @(item.Definition.Schedule.IsEnabled ? R("Web_ExternalStorage_ScheduleEnabled") : R("Web_ExternalStorage_Disabled"))</span>
                        </button>
                    }
                </div>
            }
        </section>

        <aside class="storage-editor sync-detail-pane" aria-label="@R("Web_ExternalStorage_EditSync")">
        @if (_editing)
        {
            <div class="storage-editor-heading">
                <div>
                    <h3>@(_editingId is null ? R("Web_ExternalStorage_CreateSync") : R("Web_ExternalStorage_EditSync"))</h3>
                    <span>@(_editingId is null ? R("Web_ExternalStorage_SyncsHelp") : _model.DisplayName)</span>
                </div>
                <div class="storage-enabled">
                    <label class="toggle-switch" title="@R("Web_ExternalStorage_Enabled")">
                        <input type="checkbox" @bind="_model.Enabled" />
                        <span class="toggle-slider"></span>
                    </label>
                    <span>@R("Web_ExternalStorage_Enabled")</span>
                </div>
            </div>

            <Tabs class="detail-tabs--panel" aria-label="@R("Web_ExternalStorage_EditSync")">
                <Tab Active="@(_activeSettingsTab == SyncSettingsTab.General)" Icon="settings.svg" Label="@R("Web_CloudSync_Tab_General")"
                     OnClick="() => _activeSettingsTab = SyncSettingsTab.General" />
                <Tab Active="@(_activeSettingsTab == SyncSettingsTab.Schedule)" Icon="history.svg" Label="@R("Web_CloudSync_Tab_Schedule")"
                     OnClick="() => _activeSettingsTab = SyncSettingsTab.Schedule" />
                <Tab Active="@(_activeSettingsTab == SyncSettingsTab.Advanced)" Icon="gear.svg" Label="@R("Web_CloudSync_Tab_Advanced")"
                     OnClick="() => _activeSettingsTab = SyncSettingsTab.Advanced" />
            </Tabs>

            @if (_activeSettingsTab == SyncSettingsTab.General)
            {
                <div class="storage-form-grid storage-tab-panel" role="tabpanel">
                    <label><span>@R("Web_ExternalStorage_Name")</span><input class="edit-input" maxlength="200" @bind="_model.DisplayName" @bind:event="oninput" aria-invalid="@(SyncNameTaken ? "true" : null)" /></label>
                    <label><span>@R("Web_ExternalStorage_Connection")</span><select class="edit-input" @bind="_model.ConnectionId" @bind:after="ConnectionChanged">
                        <option value="@Guid.Empty">@R("Web_ExternalStorage_Select")</option>
                        @* Keep a broken sync's current connection selectable so it can still be edited and disabled. *@
                        @foreach (var connection in VM.Connections.Where(c => c.Id == _model.ConnectionId || ReadyConnections.Contains(c)))
                        {
                            <option value="@connection.Id">@connection.Name (@ProviderName(connection.ProviderId))</option>
                        }
                    </select></label>
                    <label><span>@R("Web_ExternalStorage_LocalShare")</span><select class="edit-input" @bind="_model.LocalShareId" @bind:after="ShareChanged" disabled="@(_editingId is not null)">
                        <option value="@Guid.Empty">@R("Web_ExternalStorage_Select")</option>
                        @foreach (var share in VM.Shares)
                        {
                            <option value="@share.Id">@share.Name</option>
                        }
                    </select></label>
                    <label><span>@R("Web_ExternalStorage_Mode")</span><select class="edit-input" @bind="_model.Mode">
                        @if (SelectedConnectionSupports(StorageProviderCapabilities.Write)
                            && !SelectedConnectionSupports(StorageProviderCapabilities.OptimizedSync))
                        {
                            <option value="@SyncMode.TwoWay">@R("Web_CloudSync_Mode_TwoWay")</option>
                        }
                        @if (SelectedConnectionSupports(StorageProviderCapabilities.Write))
                        {
                            <option value="@SyncMode.Push">@R("Web_CloudSync_Mode_Push")</option>
                        }
                        <option value="@SyncMode.Pull">@R("Web_CloudSync_Mode_Pull")</option>
                    </select></label>
                    <label><span>@R("Web_ExternalStorage_LocalPath")</span><span class="storage-path-field"><input class="edit-input" @bind="LocalPathDisplay" /><button class="btn-secondary" type="button" disabled="@(_model.LocalShareId == Guid.Empty)" @onclick="OpenLocalPickerAsync">@R("Web_CloudAccess_Browse")</button></span></label>
                    <label><span>@R("Web_ExternalStorage_RemotePath")</span><span class="storage-path-field"><input class="edit-input" @bind="_model.RemotePath" @bind:event="oninput" />@if (SelectedConnectionSupports(StorageProviderCapabilities.Browse)) { <button class="btn-secondary" type="button" disabled="@(_model.ConnectionId == Guid.Empty)" @onclick="OpenRemotePickerAsync">@R("Web_CloudAccess_Browse")</button> }</span></label>
                    <label class="storage-wide"><span>@R("Web_ExternalStorage_Description")</span><textarea class="edit-input" maxlength="2000" @bind="_model.Description"></textarea></label>
                </div>
            }
            else if (_activeSettingsTab == SyncSettingsTab.Schedule)
            {
                <div class="storage-tab-panel cloud-schedule-section" role="tabpanel">
                    <div class="cloud-schedule-heading">
                        <div class="cloud-schedule-title-row">
                            <span class="detail-label">@R("Web_CloudSync_Schedule")</span>
                            <InfoButton Text="@R("Web_CloudSync_Schedule_Help")" />
                        </div>
                        <label class="toggle-switch cloud-schedule-toggle" title="@R("Web_CloudSync_Schedule_Toggle")">
                            <input type="checkbox" @bind="_model.ScheduleEnabled" @bind:after="ScheduleToggled" aria-label="@R("Web_CloudSync_Schedule_Toggle")" />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                    <label class="cloud-schedule-interval">
                        <span class="cloud-schedule-field-label">@R("Web_CloudSync_Schedule_Interval")</span>
                        <span class="cloud-schedule-interval-input">
                            <input class="edit-input cloud-schedule-interval-field" type="number"
                                   min="@CloudSyncSchedule.MinIntervalSeconds" max="@CloudSyncSchedule.MaxIntervalSeconds"
                                   @bind="_model.IntervalSeconds" @bind:event="oninput" />
                            <span>@R("Web_CloudSync_Schedule_Seconds")</span>
                        </span>
                    </label>
                    @if (_model.ScheduleEnabled)
                    {
                        <button class="acl-collapse-toggle cloud-schedule-custom-toggle" type="button" aria-expanded="@_scheduleCustomOpen"
                                @onclick="() => _scheduleCustomOpen = !_scheduleCustomOpen">
                            @Assets.SVG("chevron_right.svg", new SvgOptions(Width: 12, Height: 12, StrokeWidth: 2, CssClass: "acl-collapse-chevron" + (_scheduleCustomOpen ? " acl-collapse-chevron--open" : "")))
                            <span>@R("Web_CloudSync_Schedule_Custom")</span>
                        </button>
                    }
                    @if (_model.ScheduleEnabled && _scheduleCustomOpen)
                    {
                        <div class="cloud-schedule-paint-toolbar">
                            <span class="cloud-schedule-paint-label cloud-schedule-field-label">@R("Web_CloudSync_Schedule_Paint_Mode")</span>
                            <div class="cloud-schedule-paint-modes" role="group" aria-label="@R("Web_CloudSync_Schedule_Paint_Mode")">
                                <button class="cloud-schedule-paint-mode cloud-schedule-paint-mode--select @(_schedulePaintMode == SchedulePaintMode.Select ? "cloud-schedule-paint-mode--active" : "")"
                                        type="button" disabled="@(!_model.ScheduleEnabled)" @onclick="() => _schedulePaintMode = SchedulePaintMode.Select">
                                    <span aria-hidden="true">+</span>@R("Web_CloudSync_Schedule_Paint_Select")
                                </button>
                                <button class="cloud-schedule-paint-mode cloud-schedule-paint-mode--deselect @(_schedulePaintMode == SchedulePaintMode.Deselect ? "cloud-schedule-paint-mode--active" : "")"
                                        type="button" disabled="@(!_model.ScheduleEnabled)" @onclick="() => _schedulePaintMode = SchedulePaintMode.Deselect">
                                    <span aria-hidden="true">−</span>@R("Web_CloudSync_Schedule_Paint_Deselect")
                                </button>
                            </div>
                        </div>
                        <div class="cloud-schedule-scroll @SchedulePaintModeClass @(_model.ScheduleEnabled ? "" : "cloud-schedule-scroll--disabled")" @ref="_scheduleGrid">
                            <div class="cloud-schedule-grid" role="grid" aria-label="@R("Web_CloudSync_Schedule_Grid")">
                                @* Days are columns and hours are rows, so the grid fits the narrow detail panel without horizontal scrolling. *@
                                <span class="cloud-schedule-corner" aria-hidden="true"></span>
                                @foreach (var day in ScheduleDays)
                                {
                                    <button class="cloud-schedule-day" type="button" disabled="@(!_model.ScheduleEnabled)"
                                            title="@ScheduleDayActionLabel(day)" @onclick="() => PaintScheduleDay(day)">@ScheduleDayName(day)</button>
                                }
                                @foreach (var hour in Enumerable.Range(0, CloudSyncSchedule.HoursPerDay))
                                {
                                    <button class="cloud-schedule-hour" type="button" disabled="@(!_model.ScheduleEnabled)"
                                            title="@ScheduleHourActionLabel(hour)" @onclick="() => PaintScheduleHour(hour)">@($"{hour:00}:00")</button>
                                    @foreach (var day in ScheduleDays)
                                    {
                                        var active = IsScheduleSlotActive(day, hour);
                                        <button class="cloud-schedule-slot @(active ? "cloud-schedule-slot--active" : "")" type="button" role="gridcell"
                                                data-schedule-row="@Array.IndexOf(ScheduleDays, day)" data-schedule-hour="@hour"
                                                aria-pressed="@active" aria-label="@ScheduleSlotLabel(day, hour, active)"
                                                title="@ScheduleSlotLabel(day, hour, active)" disabled="@(!_model.ScheduleEnabled)"
                                                @onclick="() => PaintScheduleSlot(day, hour)"></button>
                                    }
                                }
                            </div>
                        </div>
                        <div class="cloud-schedule-footer">
                            <span>@string.Format(R("Web_CloudSync_Schedule_Selected"), _model.ActiveScheduleSlots.Count)</span>
                            @if (_model.ActiveScheduleSlots.Count > 0)
                            {
                                <button type="button" class="cloud-schedule-clear" @onclick="ClearSchedule">@R("Web_CloudSync_Schedule_Clear")</button>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="storage-tab-panel cloud-sync-advanced" role="tabpanel">
                    <h4>@R("Web_CloudSync_Advanced")</h4>
                    <p>@R("Web_CloudSync_Advanced_Help")</p>
                    <div class="storage-form-grid">
                        <label><span>@R("Web_CloudSync_Advanced_MaxFileSize")</span><input class="edit-input" type="number" min="0" @bind="_model.MaxFileSizeMb" @bind:event="oninput" /><small>@R("Web_CloudSync_Advanced_Unlimited_Help")</small></label>
                        <label><span>@R("Web_CloudSync_Advanced_ExcludedExtensions")</span><textarea class="edit-input" placeholder=".tmp, .iso, .bak" @bind="_model.ExcludedExtensions"></textarea><small>@R("Web_CloudSync_Advanced_ExcludedExtensions_Help")</small></label>
                        <label><span>@R("Web_CloudSync_Advanced_MaxUpload")</span><input class="edit-input" type="number" min="0" @bind="_model.MaxUploadRateKbps" @bind:event="oninput" /><small>@R("Web_CloudSync_Advanced_Unlimited_Help")</small></label>
                        <label><span>@R("Web_CloudSync_Advanced_MaxDownload")</span><input class="edit-input" type="number" min="0" @bind="_model.MaxDownloadRateKbps" @bind:event="oninput" /><small>@R("Web_CloudSync_Advanced_Unlimited_Help")</small></label>
                    </div>
                    @if (_model.Mode == SyncMode.TwoWay || _model.Mode == SyncMode.Pull)
                    {
                        <label class="storage-form-checkbox">
                            <input type="checkbox" @bind="_model.SyncDeletions" />
                            <span>@R("Web_CloudSync_Advanced_SyncDeletions")</span>
                            <small>@(_model.Mode == SyncMode.Pull ? R("Web_CloudSync_Advanced_SyncDeletions_PullHelp") : R("Web_CloudSync_Advanced_SyncDeletions_Help"))</small>
                        </label>
                    }
                </div>
            }
            <div class="detail-actions">
                @if (ValidationHint is { } hint)
                {
                    <small class="sync-validation-hint" role="status">@hint</small>
                }
                <button class="btn-secondary" type="button" disabled="@_busy" @onclick="CancelEdit">@R("Web_Button_Cancel")</button>
                <button class="btn-primary" type="button" disabled="@(_busy || !CanSave)" @onclick="SaveAsync">@R("Web_CloudAccess_Save")</button>
            </div>
        }
        else if (SelectedItem is { } selected)
        {
            <div class="detail-header sync-detail-header">
                <div class="sync-detail-title">
                    <div class="sync-title-row">
                        <span class="sync-detail-icon" style="color: @ProviderColor(ProviderIdFor(selected))">@Assets.SVG(ProviderIcon(ProviderIdFor(selected)), new SvgOptions(Width: 22, Height: 22))</span>
                        <h3>@DisplayName(selected)</h3>
                    </div>
                    <span class="detail-subtitle">@selected.ConnectionName · @ProviderFor(selected)</span>
                </div>
            </div>
            <div class="sync-detail-actions-top">
                <button class="btn-secondary" type="button" disabled="@(_busy || !selected.Definition.Enabled)" @onclick="() => RunAsync(selected)">@R("Web_ExternalStorage_RunNow")</button>
                @if (_runSucceeded)
                {
                    <span class="sync-run-success"><span class="sync-run-health"></span>@R("Web_ExternalStorage_SyncStarted")</span>
                }
            </div>
            <div class="sync-detail-grid">
                <section class="sync-detail-group">
                    <h4>@R("Web_ExternalStorage_Tab_Syncs")</h4>
                    <dl>
                        <dt>@R("Web_ExternalStorage_Connection")</dt><dd>@selected.ConnectionName</dd>
                        <dt>@R("Web_ExternalStorage_LocalShare")</dt><dd>@selected.ShareName</dd>
                        <dt>@R("Web_ExternalStorage_LocalPath")</dt><dd>@DisplayPath(selected.Definition.LocalPath)</dd>
                        <dt>@R("Web_ExternalStorage_RemotePath")</dt><dd>@selected.Definition.RemotePath</dd>
                        <dt>@R("Web_ExternalStorage_Mode")</dt><dd>@ModeName(selected.Definition.Mode)</dd>
                    </dl>
                </section>
                <section class="sync-detail-group">
                    <h4>@R("Web_ExternalStorage_Health")</h4>
                    <dl>
                        <dt>@R("Web_ExternalStorage_State")</dt><dd><StatusBadge Tone="@SyncStateTone(selected)" Label="@SyncState(selected)" /></dd>
                        <dt>@R("Web_CloudSync_Schedule")</dt><dd>@(selected.Definition.Schedule.IsEnabled ? R("Web_ExternalStorage_ScheduleEnabled") : R("Web_ExternalStorage_Disabled"))</dd>
                        <dt>@R("Web_ExternalStorage_LastRun")</dt><dd>@DateFmt.FormatDateTime(selected.Runtime?.LastRunAtUtc, nullText: R("Web_CloudSync_Never"))</dd>
                    </dl>
                </section>
                @if (!string.IsNullOrWhiteSpace(selected.Definition.Description))
                {
                    <section class="sync-detail-group sync-detail-group--wide">
                        <h4>@R("Web_ExternalStorage_Description")</h4>
                        <p class="sync-detail-description">@selected.Definition.Description</p>
                    </section>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(selected.Runtime?.LastErrorCode))
            {
                <div class="error-banner">@ErrorMessage(selected.Runtime!.LastErrorCode)</div>
            }
            @if (selected.Runtime?.LastRunFailureCount > 0)
            {
                var failed = FailedItems(selected);
                <details class="sync-failures">
                    <summary>@string.Format(R("Web_CloudSync_FailedItemsHeader"), selected.Runtime!.LastRunFailureCount)</summary>
                    <ul>
                        @foreach (var failure in failed)
                        {
                            <li><code>@failure.Path</code> — @failure.Reason</li>
                        }
                    </ul>
                    @if (selected.Runtime!.LastRunFailureCount > failed.Count)
                    {
                        <p class="sync-failures-more">@string.Format(R("Web_CloudSync_FailedItemsMore"), selected.Runtime!.LastRunFailureCount!.Value - failed.Count)</p>
                    }
                </details>
            }
            <div class="detail-actions sync-summary-actions">
                <button class="btn-secondary sync-edit-action" type="button" disabled="@_busy" @onclick="() => StartEdit(selected)">@R("Web_CloudAccess_Edit")</button>
                <button class="btn-danger-outline" type="button" disabled="@_busy" @onclick="() => DeleteAsync(selected)">@R("Web_Action_Delete")</button>
            </div>
        }
        else
        {
            <div class="detail-empty">
                <p>@R("Web_ExternalStorage_SelectSyncHint")</p>
            </div>
        }
        </aside>
    </div>
}

<DirectoryPickerDialog IsOpen="@_pickerOpen"
                       IsRemote="@_pickerIsRemote"
                       IsLoading="@_pickerLoading"
                       Title="@PickerTitle"
                       CurrentPath="@_pickerPath"
                       Items="@_pickerItems"
                       ErrorMessage="@_pickerError"
                       OnNavigate="NavigatePickerAsync"
                       OnSelected="SelectPickerFolderAsync"
                       OnClosed="ClosePicker" />

@code {
    private enum SyncSettingsTab { General, Schedule, Advanced }
    private enum SchedulePaintMode { Select, Deselect }
    private static readonly DayOfWeek[] ScheduleDays = [DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday];

    [Parameter] public Guid? InitialConnectionId { get; set; }
    [Parameter] public Guid? InitialSyncId { get; set; }
    private bool _editing;
    private bool _busy;
    private bool _runSucceeded;
    private Guid? _editingId;
    private Guid? _selectedId;
    private string? _error;
    private ExternalStorageSyncEditModel _model = new();
    private bool _pickerOpen;
    private bool _pickerIsRemote = true;
    private bool _pickerLoading;
    private string _pickerPath = "/";
    private string? _pickerError;
    private IReadOnlyList<CloudDirectoryItem> _pickerItems = [];
    private ExternalStorageSyncListItem? SelectedItem
        => _selectedId is Guid id ? VM.Syncs.FirstOrDefault(sync => sync.Definition.Id == id) : null;
    private string PickerTitle => _pickerIsRemote
        ? R("Web_CloudAccess_FolderPickerTitle")
        : R("Web_CloudSync_Directory_LocalTitle");
    private SyncSettingsTab _activeSettingsTab = SyncSettingsTab.General;
    private SchedulePaintMode _schedulePaintMode = SchedulePaintMode.Select;
    private bool _scheduleCustomOpen;
    private ElementReference _scheduleGrid;
    private DotNetObjectReference<SyncAdministration>? _schedulePaintReference;
    private IEnumerable<StorageConnection> ReadyConnections => VM.Connections.Where(c =>
        c.State == StorageConnectionState.Ready && VM.Supports(c, StorageProviderCapabilities.Sync));
    // Live validation: the first missing/invalid field, mirroring the save-path checks.
    private string? ValidationHint
        => _model.ConnectionId == Guid.Empty ? R("Web_CloudAccess_ConnectionRequired")
            : _model.LocalShareId == Guid.Empty ? R("Web_CloudSync_Error_ShareRequired")
            : SyncNameTaken ? R("Web_ExternalStorage_SyncNameExists")
            : ExternalStorageSyncViewModel.GetFieldError(_model);
    private bool CanSave => ValidationHint is null;
    /// <summary>Live duplicate-name check against the loaded list; the view model re-checks on save.</summary>
    private bool SyncNameTaken => !string.IsNullOrWhiteSpace(_model.DisplayName)
        && !(_editingId is not null && string.Equals(SelectedItem?.Definition.DisplayName, _model.DisplayName.Trim(), StringComparison.Ordinal))
        && VM.Syncs.Any(sync => sync.Definition.Id != _editingId
            && string.Equals(sync.Definition.DisplayName?.Trim(), _model.DisplayName.Trim(), StringComparison.OrdinalIgnoreCase));
    // Local paths are stored share-relative ("" = root) but shown rooted ("/docs"),
    // exactly like remote paths. Bound on change, so normalizing never fights typing.
    private string LocalPathDisplay
    {
        get => DisplayPath(_model.LocalPath);
        set => _model.LocalPath = ShareRelativePath.Normalize(value);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await VM.LoadAsync();
            if (InitialSyncId is Guid syncId && VM.Syncs.Any(sync => sync.Definition.Id == syncId))
                _selectedId = syncId;
            else if (InitialConnectionId is Guid connectionId && ReadyConnections.Any(c => c.Id == connectionId))
                StartCreate(connectionId);
            StateHasChanged();
        }
        // Initialize once per rendered grid element (the grid is recreated when the
        // tab or edit form reopens); the JS side is idempotent, but a round trip on
        // every render floods the circuit.
        if (_scheduleGrid.Context is not null && _scheduleGrid.Id != _initializedScheduleGridId)
        {
            _initializedScheduleGridId = _scheduleGrid.Id;
            _schedulePaintReference ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("schedulePaint.initialize", _scheduleGrid, _schedulePaintReference);
        }
    }
    private string? _initializedScheduleGridId;

    private void StartCreate() => StartCreate(InitialConnectionId);
    private void StartCreate(Guid? connectionId)
    {
        _editing = true;
        _editingId = null;
        _selectedId = null;
        _error = null;
        _activeSettingsTab = SyncSettingsTab.General;
        _model = new ExternalStorageSyncEditModel { ConnectionId = connectionId ?? Guid.Empty, RemotePath = string.Empty };
        _scheduleCustomOpen = false;
        ConnectionChanged();
    }

    private void Select(ExternalStorageSyncListItem item)
    {
        _selectedId = item.Definition.Id;
        _editing = false;
        _editingId = null;
        _error = null;
        _runSucceeded = false;
    }

    // A local folder belongs to its share; start again at the share root.
    private void ShareChanged() => _model.LocalPath = string.Empty;

    private void ConnectionChanged()
    {
        // A remote folder belongs to its connection, so a new sync must pick it again.
        if (_editingId is null) _model.RemotePath = string.Empty;
        if (_model.ConnectionId != Guid.Empty
            && (!SelectedConnectionSupports(StorageProviderCapabilities.Write)
                || (SelectedConnectionSupports(StorageProviderCapabilities.OptimizedSync)
                    && _model.Mode == SyncMode.TwoWay)))
            _model.Mode = SyncMode.Pull;
    }

    private void StartEdit(ExternalStorageSyncListItem item)
    {
        var definition = item.Definition;
        _editing = true;
        _editingId = definition.Id;
        _selectedId = definition.Id;
        _error = null;
        _activeSettingsTab = SyncSettingsTab.General;
        _model = new ExternalStorageSyncEditModel
        {
            ConnectionId = definition.ConnectionId,
            LocalShareId = definition.LocalShareId,
            DisplayName = definition.DisplayName,
            Description = definition.Description,
            LocalPath = definition.LocalPath,
            RemotePath = definition.RemotePath,
            Mode = definition.Mode,
            Enabled = definition.Enabled,
            ScheduleEnabled = definition.Schedule.IsEnabled,
            IntervalSeconds = definition.Schedule.IntervalSeconds,
            ActiveScheduleSlots = new HashSet<int>((definition.Schedule.ActiveSlots ?? []).Where(CloudSyncSchedule.IsValidSlot)),
            MaxFileSizeMb = ToUnit(definition.AdvancedSettings.MaxFileSizeBytes, 1024L * 1024),
            MaxUploadRateKbps = ToUnit(definition.AdvancedSettings.MaxUploadBytesPerSecond, 1024L),
            MaxDownloadRateKbps = ToUnit(definition.AdvancedSettings.MaxDownloadBytesPerSecond, 1024L),
            ExcludedExtensions = string.Join(", ", definition.AdvancedSettings.ExcludedExtensions),
            SyncDeletions = definition.AdvancedSettings.SyncDeletions
        };
        // Only a partial week counts as custom times worth showing straight away.
        _scheduleCustomOpen = _model.ActiveScheduleSlots.Count is > 0 and < CloudSyncSchedule.SlotCount;
    }

    private async Task SaveAsync() => await ActAsync(async () =>
    {
        if (_editingId is Guid id) await VM.UpdateAsync(id, _model); else await VM.CreateAsync(_model);
        CancelEdit();
    });
    private async Task DeleteAsync(ExternalStorageSyncListItem item)
    {
        await ActAsync(() => VM.DeleteAsync(item.Definition.Id));
        if (VM.Syncs.All(sync => sync.Definition.Id != item.Definition.Id))
        {
            if (_selectedId == item.Definition.Id) _selectedId = null;
            if (_editingId == item.Definition.Id) CancelEdit();
        }
    }
    private async Task RunAsync(ExternalStorageSyncListItem item)
    {
        _runSucceeded = false;
        await ActAsync(() => VM.RunAsync(item.Definition.Id));
        _runSucceeded = _error is null;
    }
    private async Task ActAsync(Func<Task> action)
    {
        _busy = true; _error = null;
        try { await action(); }
        catch (ArgumentException exception) { _error = exception.Message; }
        catch (InvalidOperationException exception) { _error = exception.Message; }
        catch (NotSupportedException exception) { _error = exception.Message; }
        catch { _error = R("Web_ExternalStorage_OperationFailed"); }
        finally { _busy = false; }
    }
    private void CancelEdit() { _editing = false; _editingId = null; _model = new(); }
    private async Task OpenRemotePickerAsync()
    {
        _pickerIsRemote = true;
        _pickerOpen = true;
        _pickerPath = string.IsNullOrWhiteSpace(_model.RemotePath) ? "/" : _model.RemotePath;
        await LoadPickerAsync(_pickerPath);
    }
    private async Task OpenLocalPickerAsync()
    {
        _pickerIsRemote = false;
        _pickerOpen = true;
        _pickerPath = _model.LocalPath ?? string.Empty;
        await LoadPickerAsync(_pickerPath);
    }
    private async Task NavigatePickerAsync(string path)
    {
        _pickerPath = path;
        await LoadPickerAsync(path);
    }
    private async Task LoadPickerAsync(string path)
    {
        _pickerLoading = true;
        _pickerError = null;
        try
        {
            _pickerItems = _pickerIsRemote
                ? await VM.ListRemoteDirectoriesAsync(_model.ConnectionId, _model.LocalShareId, path)
                : await VM.ListLocalDirectoriesAsync(_model.LocalShareId, path);
        }
        catch
        {
            _pickerItems = [];
            _pickerError = _pickerIsRemote
                ? R("Web_ExternalStorage_RemoteBrowseFailed")
                : R("Web_CloudSync_Directory_Error");
        }
        finally { _pickerLoading = false; }
    }
    private Task SelectPickerFolderAsync(string path)
    {
        if (_pickerIsRemote) _model.RemotePath = path;
        else _model.LocalPath = path;
        ClosePicker();
        return Task.CompletedTask;
    }
    private void ClosePicker() { _pickerOpen = false; _pickerItems = []; _pickerError = null; }
    private string SchedulePaintModeClass => _schedulePaintMode == SchedulePaintMode.Select ? "cloud-schedule-scroll--paint-select" : "cloud-schedule-scroll--paint-deselect";
    private bool SchedulePaintValue => _schedulePaintMode == SchedulePaintMode.Select;
    private static string ScheduleDayName(DayOfWeek day) => CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedDayName(day);
    private bool IsScheduleSlotActive(DayOfWeek day, int hour) => _model.ActiveScheduleSlots.Contains(CloudSyncSchedule.ToSlot(day, hour));
    private void SetScheduleSlot(DayOfWeek day, int hour, bool active)
    {
        int slot = CloudSyncSchedule.ToSlot(day, hour);
        if (active) _model.ActiveScheduleSlots.Add(slot); else _model.ActiveScheduleSlots.Remove(slot);
    }
    private void PaintScheduleSlot(DayOfWeek day, int hour) => SetScheduleSlot(day, hour, SchedulePaintValue);
    private void PaintScheduleDay(DayOfWeek day)
    {
        foreach (int hour in Enumerable.Range(0, CloudSyncSchedule.HoursPerDay)) SetScheduleSlot(day, hour, SchedulePaintValue);
    }
    private void PaintScheduleHour(int hour)
    {
        foreach (DayOfWeek day in ScheduleDays) SetScheduleSlot(day, hour, SchedulePaintValue);
    }
    private void ClearSchedule() => _model.ActiveScheduleSlots.Clear();
    // Enabling automatic sync defaults to every hour of every day; existing custom slots are kept.
    private void ScheduleToggled()
    {
        if (_model.ScheduleEnabled && _model.ActiveScheduleSlots.Count == 0)
            _model.ActiveScheduleSlots.UnionWith(Enumerable.Range(0, CloudSyncSchedule.SlotCount));
    }
    private string ScheduleDayActionLabel(DayOfWeek day) => string.Format(R("Web_CloudSync_Schedule_Day_Paint"), ScheduleDayName(day), R(_schedulePaintMode == SchedulePaintMode.Select ? "Web_CloudSync_Schedule_Paint_Select" : "Web_CloudSync_Schedule_Paint_Deselect"));
    private string ScheduleHourActionLabel(int hour) => string.Format(R("Web_CloudSync_Schedule_Hour_Paint"), hour.ToString("00"), R(_schedulePaintMode == SchedulePaintMode.Select ? "Web_CloudSync_Schedule_Paint_Select" : "Web_CloudSync_Schedule_Paint_Deselect"));
    private static string ScheduleSlotLabel(DayOfWeek day, int hour, bool active) => string.Format(R(active ? "Web_CloudSync_Schedule_Slot_On" : "Web_CloudSync_Schedule_Slot_Off"), ScheduleDayName(day), hour.ToString("00"), ((hour + 1) % CloudSyncSchedule.HoursPerDay).ToString("00"));
    [JSInvokable]
    public Task PaintScheduleRectangleFromJs(int startRow, int startHour, int endRow, int endHour)
    {
        if (!_model.ScheduleEnabled || startRow < 0 || endRow < 0 || startRow >= ScheduleDays.Length || endRow >= ScheduleDays.Length || startHour is < 0 or >= CloudSyncSchedule.HoursPerDay || endHour is < 0 or >= CloudSyncSchedule.HoursPerDay) return Task.CompletedTask;
        for (int row = Math.Min(startRow, endRow); row <= Math.Max(startRow, endRow); row++)
            for (int hour = Math.Min(startHour, endHour); hour <= Math.Max(startHour, endHour); hour++)
                SetScheduleSlot(ScheduleDays[row], hour, SchedulePaintValue);
        return InvokeAsync(StateHasChanged);
    }
    private static long? ToUnit(long? value, long divisor) => value is > 0 ? (long)Math.Ceiling(value.Value / (double)divisor) : null;
    private static string DisplayName(ExternalStorageSyncListItem item) => string.IsNullOrWhiteSpace(item.Definition.DisplayName) ? item.ShareName : item.Definition.DisplayName;
    private static string DisplayPath(string path) => string.IsNullOrEmpty(path) ? "/" : $"/{path}";
    private string ProviderName(string id) => VM.GetProviderName(id);
    private string ProviderIdFor(ExternalStorageSyncListItem item)
        => VM.Connections.FirstOrDefault(connection => connection.Id == item.Definition.ConnectionId)?.ProviderId ?? "";
    private string ProviderFor(ExternalStorageSyncListItem item)
        => ProviderIdFor(item) is { Length: > 0 } id ? VM.GetProviderName(id) : "—";
    private static string ProviderIcon(string id) => id.ToLowerInvariant() switch
    {
        "smb" => "connection_smb.svg",
        "rsync-ssh" => "connection_rsync.svg",
        "sftp" => "connection_sftp.svg",
        "onedrive" => "connection_onedrive.svg",
        "google" or "googledrive" => "connection_google.svg",
        _ => "cloud-download.svg"
    };
    private static string ProviderColor(string id) => id.ToLowerInvariant() switch
    {
        "smb" => "var(--provider-smb)",
        "rsync-ssh" => "var(--provider-rsync)",
        "sftp" => "var(--provider-sftp)",
        "onedrive" => "var(--provider-onedrive)",
        "google" or "googledrive" => "var(--provider-google)",
        _ => "var(--text-secondary)"
    };
    private bool SelectedConnectionSupports(StorageProviderCapabilities capability)
        => VM.Connections.FirstOrDefault(c => c.Id == _model.ConnectionId) is { } connection
           && VM.Supports(connection, capability);
    private static string ModeName(SyncMode mode) => mode switch { SyncMode.Pull => R("Web_CloudSync_Mode_Pull"), SyncMode.Push => R("Web_CloudSync_Mode_Push"), _ => R("Web_CloudSync_Mode_TwoWay") };
    private static string Health(ExternalStorageSyncListItem item)
        => !string.IsNullOrWhiteSpace(item.Runtime?.LastErrorCode) ? R("Web_ExternalStorage_AttentionRequired")
            : item.Runtime?.LastRunFailureCount > 0 ? R("Web_ExternalStorage_CompletedWithErrors")
            : R("Web_ExternalStorage_Healthy");
    private static string SyncState(ExternalStorageSyncListItem item)
        => item.Definition.Enabled ? Health(item) : R("Web_ExternalStorage_Disabled");
    private static StatusTone SyncStateTone(ExternalStorageSyncListItem item)
        => !item.Definition.Enabled ? StatusTone.Neutral
            : !string.IsNullOrWhiteSpace(item.Runtime?.LastErrorCode) || item.Runtime?.LastRunFailureCount > 0
                ? StatusTone.Warning
                : StatusTone.Positive;

    // The persisted failure list is capped (see SyncDefinitionRepository); the
    // total is reported separately by LastRunFailureCount. A malformed payload
    // degrades to showing just the count rather than throwing in the UI.
    private static IReadOnlyList<SyncFailure> FailedItems(ExternalStorageSyncListItem item)
    {
        if (string.IsNullOrWhiteSpace(item.Runtime?.LastRunFailures))
            return Array.Empty<SyncFailure>();
        try
        {
            return JsonSerializer.Deserialize<List<SyncFailure>>(item.Runtime!.LastRunFailures!)
                ?? (IReadOnlyList<SyncFailure>)Array.Empty<SyncFailure>();
        }
        catch (JsonException)
        {
            return Array.Empty<SyncFailure>();
        }
    }
    private static string R(string key) => Resources.ResourceManager.GetString(key) ?? key;

    // Turns a persisted error code into an explicit, localized message. Falls back
    // to a generic "attention required (code)" so an unmapped provider code is
    // still legible for support instead of shown raw.
    private static string ErrorMessage(string code)
        => Resources.ResourceManager.GetString($"Web_ExternalStorage_ErrorCode_{code}")
           ?? string.Format(
               Resources.ResourceManager.GetString("Web_ExternalStorage_ErrorCode_Unknown")
               ?? "Attention required ({0})", code);

    protected override void OnInitialized()
        => SyncJobRunner.OnChanged += HandleSyncJobsChanged;

    // Reload the list when a background sync finishes so the row and detail health
    // (and any new error message) reflect the outcome without a manual page reload.
    private int _lastSyncJobCount;
    private void HandleSyncJobsChanged()
    {
        int count = SyncJobRunner.Jobs.Count;
        // This page shows no live progress, so progress ticks must not re-render it
        // (while editing, every render would also re-run the schedule-grid interop).
        if (count == _lastSyncJobCount)
            return;
        bool finished = count < _lastSyncJobCount;
        _lastSyncJobCount = count;
        _ = InvokeAsync(async () =>
        {
            if (finished)
                await VM.LoadAsync();
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        SyncJobRunner.OnChanged -= HandleSyncJobsChanged;
        if (_scheduleGrid.Context is not null)
        {
            try { await JS.InvokeVoidAsync("schedulePaint.dispose", _scheduleGrid); }
            catch (JSDisconnectedException) { }
        }
        _schedulePaintReference?.Dispose();
    }
}
