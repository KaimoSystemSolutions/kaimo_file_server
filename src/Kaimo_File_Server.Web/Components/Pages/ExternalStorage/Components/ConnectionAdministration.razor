@using Kaimo_File_Server.Core.Domain
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Core.Repositories
@using Kaimo_File_Server.Core.Services.ExternalStorage
@using Kaimo_File_Server.Infrastructure.ExternalStorage
@using Kaimo_File_Server.Web.Components.ViewModels
@using Kaimo_File_Server.Web.DynamicHelpers
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.Security.Cryptography
@implements IAsyncDisposable
@inject CloudAccessViewModel VM
@inject IStorageConnectionProviderCatalog ProviderCatalog
@inject IRsyncSshSetupService RsyncSshSetup
@inject NavigationManager Nav
@inject IJSRuntime JS
@inherits AppComponentBase

@if (VM.IsLoading)
{
    <div class="loading-state"><div class="spinner"></div><p>@R("Web_ExternalStorage_Loading")</p></div>
}
else if (!VM.CanManage)
{
    <div class="error-banner">@R("Web_CloudAccess_NoPermission")</div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_error ?? VM.ErrorMessage))
    {
        <div class="error-banner">@(_error ?? VM.ErrorMessage)</div>
    }
    <div class="connection-toolbar">
        <div><h2>@R("Web_ExternalStorage_Tab_Connections")</h2><p class="subtitle">@R("Web_ExternalStorage_ConnectionsHelp")</p></div>
        @if (VM.CanManageConnections)
        {
            <button class="btn-primary" type="button" @onclick="() => _creating = !_creating">@R("Web_CloudAccess_AddConnection")</button>
        }
    </div>

    @if (_creating)
    {
        <section class="connection-editor">
            <div class="connection-editor-heading">
                <h3>@R("Web_CloudAccess_AddConnection")</h3>
                <p>@R("Web_ExternalStorage_ConnectionsHelp")</p>
            </div>
            <div class="connection-form">
                <label><span>@R("Web_CloudAccess_Provider")</span><select class="edit-input" @bind="_provider" @bind:after="ProviderChanged">@foreach (var provider in CreatableProviders) { <option value="@provider.Id">@provider.DisplayName</option> }</select></label>
                <label><span>@R("Web_CloudAccess_ConnectionName")</span><input class="edit-input" maxlength="200" @bind="_name" /></label>
                <label><span>@R("Web_CloudAccess_Department")</span><select class="edit-input" @bind="_departmentId"><option value="@Guid.Empty">@R("Web_ExternalStorage_Select")</option>@foreach (var department in VM.ManageableDepartments) { <option value="@department.Id">@department.Name</option> }</select></label>
                @if (_departmentId == Guid.Empty)
                {
                    <p class="storage-wide connection-form-hint">@R("Web_ExternalStorage_DepartmentRequiredHint")</p>
                }
                @if (IsSmbProvider)
                {
                    <label><span>@R("Web_ExternalStorage_Server")</span><input class="edit-input" maxlength="253" placeholder="192.168.1.10" @bind="_server" /></label>
                    <label><span>@R("Web_ExternalStorage_Port")</span><input class="edit-input" type="number" min="1" max="65535" @bind="_port" /></label>
                    <label><span>@R("Web_ExternalStorage_Username")</span><input class="edit-input" maxlength="256" autocomplete="username" @bind="_username" /></label>
                    <label><span>@R("Web_ExternalStorage_Password")</span><input class="edit-input" type="password" maxlength="4096" autocomplete="new-password" @bind="_password" /></label>
                    <label><span>@R("Web_ExternalStorage_Domain")</span><input class="edit-input" maxlength="256" placeholder="WORKGROUP" @bind="_domain" /></label>
                    <label><span>@R("Web_ExternalStorage_MinimumDialect")</span><select class="edit-input" @bind="_minimumDialect"><option value="3.0">SMB 3.0</option><option value="3.02">SMB 3.0.2</option><option value="3.1.1">SMB 3.1.1</option></select></label>
                    <p class="storage-wide connection-form-hint">@R("Web_ExternalStorage_SmbSharePickerHelp")</p>
                }
                else if (IsWebDavProvider)
                {
                    <label><span>@R("Web_ExternalStorage_WebDavServerUrl")</span><input class="edit-input" maxlength="2048" placeholder="https://cloud.example.com/remote.php/dav/files/user/" @bind="_serverUrl" /></label>
                    <label><span>@R("Web_ExternalStorage_Username")</span><input class="edit-input" maxlength="256" autocomplete="username" @bind="_username" /></label>
                    <label><span>@R("Web_ExternalStorage_Password")</span><input class="edit-input" type="password" maxlength="4096" autocomplete="new-password" @bind="_password" /></label>
                    <p class="storage-wide connection-form-hint">@R("Web_ExternalStorage_WebDavHelp")</p>
                }
                else if (UsesPinnedSshSetup)
                {
                    <label><span>@R("Web_ExternalStorage_Server")</span><input class="edit-input" maxlength="253" placeholder="backup.example.com" @bind="_server" @bind:after="SshEndpointChangedAsync" /></label>
                    <label><span>@R("Web_ExternalStorage_Port")</span><input class="edit-input" type="number" min="1" max="65535" @bind="_port" @bind:after="SshEndpointChangedAsync" /></label>
                    <label><span>@R("Web_ExternalStorage_Username")</span><input class="edit-input" maxlength="64" autocomplete="username" @bind="_username" /></label>
                    <label><span>@R("Web_ExternalStorage_RemoteRoot")</span><input class="edit-input" maxlength="4096" placeholder="/srv/backups" @bind="_remoteRoot" /></label>
                    <section class="storage-wide ssh-setup-card">
                        <div class="ssh-setup-heading"><div><strong>@R("Web_ExternalStorage_SshKeySetup")</strong><small>@R("Web_ExternalStorage_SshKeySetupHelp")</small></div><label class="storage-check"><input type="checkbox" @bind="_advancedSshSetup" @bind:after="SshModeChangedAsync" /> <span>@R("Web_ExternalStorage_SshAdvancedMode")</span></label></div>
                        @if (!_advancedSshSetup)
                        {
                            <div class="ssh-setup-section">
                                <span class="ssh-step">1</span><div class="ssh-step-content"><strong>@R("Web_ExternalStorage_SshPrivateKey")</strong><small>@R("Web_ExternalStorage_SshPrivateKeyHelp")</small>
                                    <div class="ssh-actions"><InputFile OnChange="UploadSshPrivateKeyAsync" accept=".key,.pem,.openssh" /><button class="btn-secondary" type="button" disabled="@_sshSetupBusy" @onclick="GenerateSshPrivateKeyAsync">@R("Web_ExternalStorage_SshGenerateKey")</button></div>
                                    @if (_sshPrivateKey is not null)
                                    {
                                        <div class="ssh-ready-line"><span class="connection-health"></span>@(_sshPrivateKeyName ?? R("Web_ExternalStorage_SshGeneratedKeyReady"))</div>
                                        <label><span>@R("Web_ExternalStorage_SshPublicKey")</span><textarea class="edit-input ssh-public-key" readonly rows="3">@_sshPublicKey</textarea></label>
                                        <button class="btn-secondary ssh-copy" type="button" @onclick="CopyPublicKeyAsync">@R("Web_ExternalStorage_CopyPublicKey")</button>
                                    }
                                </div>
                            </div>
                            <div class="ssh-setup-section">
                                <span class="ssh-step">2</span><div class="ssh-step-content"><strong>@R("Web_ExternalStorage_SshHostVerification")</strong><small>@R("Web_ExternalStorage_SshHostVerificationHelp")</small>
                                    <button class="btn-secondary" type="button" disabled="@(_sshSetupBusy || string.IsNullOrWhiteSpace(_server) || _port is < 1 or > 65535)" @onclick="DiscoverHostKeysAsync">@R("Web_ExternalStorage_SshFetchHostKey")</button>
                                    @if (_hostKeyCandidates.Count > 0)
                                    {
                                        <label><span>@R("Web_ExternalStorage_SshHostKey")</span><select class="edit-input" @bind="_selectedHostFingerprint" @bind:after="HostKeySelectionChanged">
                                            @foreach (var candidate in _hostKeyCandidates) { <option value="@candidate.FingerprintSha256">@candidate.Algorithm — @candidate.FingerprintSha256</option> }
                                        </select></label>
                                        <div class="ssh-fingerprint">@SelectedHostKey?.FingerprintSha256</div>
                                        <label class="storage-check ssh-confirm"><input type="checkbox" @bind="_hostKeyConfirmed" /> <span>@R("Web_ExternalStorage_SshConfirmFingerprint")</span></label>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="ssh-advanced-grid">
                                <label><span>@R("Web_ExternalStorage_SshHostFingerprint")</span><input class="edit-input" maxlength="100" placeholder="SHA256:…" @bind="_sshHostFingerprint" /></label>
                                <label><span>@R("Web_ExternalStorage_PrivateKeySecretReference")</span><input class="edit-input" maxlength="4096" placeholder="/run/secrets/kaimo_rsync_key" @bind="_privateKeySecretReference" /></label>
                                <label><span>@R("Web_ExternalStorage_KnownHostsSecretReference")</span><input class="edit-input" maxlength="4096" placeholder="/run/secrets/kaimo_known_hosts" @bind="_knownHostsSecretReference" /></label>
                            </div>
                        }
                    </section>
                    <p class="storage-wide connection-form-hint">@R("Web_ExternalStorage_RsyncSshHelp")</p>
                }
                else if (!SelectedProviderUsesInteractiveAuthorization)
                {
                    <label class="storage-wide"><span>@R("Web_ExternalStorage_ConnectionSettings")</span><textarea class="edit-input" rows="10" maxlength="65536" @bind="_settingsJson"></textarea><small>@R("Web_ExternalStorage_ConnectionSettingsHelp")</small></label>
                }
            </div>
            <div class="detail-actions"><button class="btn-secondary" type="button" @onclick="CancelCreateAsync">@R("Web_Button_Cancel")</button><button class="btn-primary" type="button" disabled="@(_busy || _sshSetupBusy || !CanCreate)" @onclick="CreateAsync">@R("Web_CloudAccess_Connect")</button></div>
        </section>
    }

    @if (VM.Connections.Count == 0)
    {
        <div class="empty-state"><p>@R("Web_CloudAccess_NoConnections")</p></div>
    }
    else
    {
        <div class="connection-layout">
            <div class="connection-list">
                <div class="connection-list-header" aria-hidden="true">
                    <span>@R("Web_ExternalStorage_Name")</span>
                    <span>@R("Web_ExternalStorage_State")</span>
                    <span>@R("Web_ExternalStorage_Usage")</span>
                </div>
                @foreach (var connection in VM.Connections)
                {
                    <button class="connection-row @(_selected?.Id == connection.Id ? "connection-row--selected" : "")" type="button" @onclick="() => SelectConnection(connection)">
                        <span class="connection-name">
                            <span class="connection-provider-icon" style="color: @ProviderColor(connection.ProviderId)">@Assets.SVG(ProviderIcon(connection.ProviderId), new SvgOptions(Width: 18, Height: 18))</span>
                            <span class="connection-name-text">
                                <strong>@connection.Name</strong>
                                <small>@ProviderName(connection.ProviderId) · @(connection.AccountEmail ?? connection.AccountDisplayName ?? R("Web_CloudAccess_NotAuthorized"))</small>
                            </span>
                        </span>
                        <StatusBadge Tone="@StateTone(connection.State)" Class="connection-state" Label="@StateName(connection.State)" />
                        <span class="connection-usage">@UsageSummary(connection.Id)</span>
                    </button>
                }
            </div>
            <aside class="connection-detail">
                @if (_selected is null)
                {
                    <div class="detail-empty">
                        <div class="detail-empty-icon">@Assets.SVG("cloud-download.svg", new SvgOptions(Width: 32, Height: 32, Color: "var(--text-tertiary)"))</div>
                        <p class="detail-empty-title">@R("Web_ExternalStorage_NoConnectionSelected")</p>
                        <p>@R("Web_ExternalStorage_NoConnectionSelectedHint")</p>
                    </div>
                }
                else
                {
                    var usage = Usage(_selected.Id);
                    <div class="detail-header connection-detail-header">
                        <div class="connection-detail-title">
                            @if (_renaming)
                            {
                                <div class="connection-rename-card">
                                    <label class="connection-rename-label">@R("Web_CloudAccess_ConnectionName")</label>
                                    <div class="connection-rename-row">
                                        <input class="edit-input connection-rename-input" maxlength="200" @bind="_renameValue" @bind:event="oninput" aria-label="@R("Web_CloudAccess_ConnectionName")" @onkeydown="RenameKeyDownAsync" />
                                    </div>
                                    <div class="connection-rename-actions">
                                        <button class="btn-primary" type="button" disabled="@(_busy || string.IsNullOrWhiteSpace(_renameValue))" @onclick="SaveRenameAsync">@R("Web_CloudAccess_Save")</button>
                                        <button class="btn-secondary" type="button" disabled="@_busy" @onclick="CancelRename">@R("Web_Button_Cancel")</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="connection-title-row">
                                    <span class="connection-detail-icon" style="color: @ProviderColor(_selected.ProviderId)">@Assets.SVG(ProviderIcon(_selected.ProviderId), new SvgOptions(Width: 22, Height: 22))</span>
                                    <h3>@_selected.Name</h3>
                                    @if (VM.CanManageConnections)
                                    {
                                        <button class="connection-rename-trigger" type="button" disabled="@_busy" @onclick="StartRename" title="@R("Web_CloudAccess_Rename")">@Assets.SVG("edit.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 1.75f))</button>
                                    }
                                </div>
                                <span class="detail-subtitle">@ProviderName(_selected.ProviderId)</span>
                            }
                        </div>
                        <StatusBadge Tone="@StateTone(_selected.State)" Class="connection-state" Label="@StateName(_selected.State)" />
                    </div>
                    <div class="connection-detail-grid">
                        <section class="connection-detail-group">
                            <h4>@R("Web_ExternalStorage_Identity")</h4>
                            <dl>
                                <dt>@R("Web_ExternalStorage_AuthorizationMode")</dt><dd>@AuthorizationName(_selected.AuthorizationMode)</dd>
                                <dt>@R("Web_CloudAccess_Account")</dt><dd>@(_selected.AccountEmail ?? _selected.AccountDisplayName ?? R("Web_CloudAccess_NotAuthorized"))</dd>
                                <dt>@R("Web_ExternalStorage_Tenant")</dt><dd>@(_selected.ProviderTenantId ?? "—")</dd>
                                <dt>@R("Web_ExternalStorage_Scopes")</dt><dd>@(_selected.EffectiveScopes ?? "—")</dd>
                            </dl>
                        </section>
                        <section class="connection-detail-group">
                            <h4>@R("Web_ExternalStorage_Health")</h4>
                            <dl>
                                <dt>@R("Web_ExternalStorage_State")</dt><dd>@StateName(_selected.State)</dd>
                                <dt>@R("Web_ExternalStorage_LastVerified")</dt><dd>@FormatDate(_selected.LastVerifiedAtUtc)</dd>
                                <dt>@R("Web_ExternalStorage_ProfileHealth")</dt><dd>@(_selected.ProviderProfileId is null ? R("Web_ExternalStorage_ProfileLegacy") : R("Web_ExternalStorage_ProfileConfigured"))</dd>
                                <dt>@R("Web_ExternalStorage_SecretHealth")</dt><dd>@SecretHealth(_selected)</dd>
                            </dl>
                        </section>
                        <section class="connection-detail-group connection-detail-group--wide">
                            <h4>@R("Web_ExternalStorage_CapabilitiesAndUsage")</h4>
                            <dl>
                                <dt>@R("Web_ExternalStorage_Usage")</dt><dd>@string.Format(R("Web_ExternalStorage_UsageFormat"), usage.SyncCount, usage.VirtualShareCount)</dd>
                                <dt>@R("Web_ExternalStorage_Capabilities")</dt><dd>@CapabilityNames(_selected)</dd>
                            </dl>
                        </section>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_selected.LastErrorCode))
                    {
                        <div class="error-banner">@R("Web_ExternalStorage_AttentionRequired") (@_selected.LastErrorCode)</div>
                    }
                    <div class="detail-actions connection-actions">
                        @if (VM.CanManageConnections)
                        {
                            <button class="btn-secondary" type="button" disabled="@_busy" @onclick="TestAsync">@R("Web_ExternalStorage_Test")</button>
                            @if (_testSucceeded) { <span class="connection-test-success"><span class="connection-health"></span>@R("Web_ExternalStorage_TestSuccessful")</span> }
                            else if (_testFailed) { <span class="connection-test-failed">@R("Web_ExternalStorage_TestFailed")</span> }
                            @if (SupportsAuthorization(_selected))
                            {
                                <button class="btn-secondary" type="button" disabled="@_busy" @onclick="AuthorizeAsync">@(_selected.State == StorageConnectionState.Ready ? R("Web_CloudAccess_Reauthorize") : R("Web_CloudAccess_Authorize"))</button>
                            }
                            <button class="btn-secondary" type="button" disabled="@_busy" @onclick="ToggleEnabledAsync">@(_selected.State == StorageConnectionState.Disabled ? R("Web_ExternalStorage_Enable") : R("Web_ExternalStorage_Disable"))</button>
                            <button class="btn-danger-outline" type="button" disabled="@(_busy || usage.TotalCount > 0)" @onclick="DeleteAsync">@R("Web_Action_Delete")</button>
                        }
                    </div>
                }
            </aside>
        </div>
    }
}

@code {
    private StorageConnection? _selected;
    private bool _creating;
    private bool _busy;
    private string _provider = "onedrive";
    private string _name = string.Empty;
    private string _settingsJson = string.Empty;
    private string _server = string.Empty;
    private string _username = string.Empty;
    private string _password = string.Empty;
    private string _domain = string.Empty;
    private int _port = 445;
    private string _minimumDialect = "3.1.1";
    private string _serverUrl = string.Empty;
    private string _remoteRoot = "/";
    private string _sshHostFingerprint = string.Empty;
    private string _privateKeySecretReference = string.Empty;
    private string _knownHostsSecretReference = string.Empty;
    private bool _advancedSshSetup;
    private bool _sshSetupBusy;
    private byte[]? _sshPrivateKey;
    private string? _sshPrivateKeyName;
    private string _sshPublicKey = string.Empty;
    private List<RsyncSshHostKeyCandidate> _hostKeyCandidates = [];
    private string _selectedHostFingerprint = string.Empty;
    private bool _hostKeyConfirmed;
    private string? _managedKnownHostsPath;
    private bool _testSucceeded;
    private bool _testFailed;
    private Guid _departmentId;
    private string? _error;
    private bool _renaming;
    private string _renameValue = string.Empty;
    private IEnumerable<IStorageConnectionProvider> CreatableProviders => ProviderCatalog.Providers
        .Where(provider => provider.AuthorizationModes.Any(mode => mode is StorageAuthorizationMode.DeviceCode
            or StorageAuthorizationMode.UsernamePassword or StorageAuthorizationMode.NetworkIdentity
            or StorageAuthorizationMode.HostMount or StorageAuthorizationMode.SshKey))
        .OrderBy(provider => provider.DisplayName, StringComparer.CurrentCultureIgnoreCase);
    private IStorageConnectionProvider? SelectedProvider => ProviderCatalog.TryGet(_provider, out var provider) ? provider : null;
    private bool SelectedProviderUsesInteractiveAuthorization =>
        SelectedProvider?.AuthorizationModes.Contains(StorageAuthorizationMode.DeviceCode) == true;
    private bool IsSmbProvider => string.Equals(_provider, "smb", StringComparison.OrdinalIgnoreCase);
    private bool IsRsyncSshProvider => string.Equals(_provider, "rsync-ssh", StringComparison.OrdinalIgnoreCase);
    private bool IsSftpProvider => string.Equals(_provider, "sftp", StringComparison.OrdinalIgnoreCase);
    private bool IsWebDavProvider => string.Equals(_provider, "webdav", StringComparison.OrdinalIgnoreCase);
    // rsync-over-SSH and SFTP share the identical pinned-SSH setup (key + host key).
    private bool UsesPinnedSshSetup => IsRsyncSshProvider || IsSftpProvider;
    private bool CanCreate => !string.IsNullOrWhiteSpace(_name)
                              && _departmentId != Guid.Empty
                              && SelectedProvider is not null
                              && (SelectedProviderUsesInteractiveAuthorization
                                  || (IsSmbProvider && !string.IsNullOrWhiteSpace(_server)
                                      && _port is >= 1 and <= 65535
                                      && !string.IsNullOrWhiteSpace(_username)
                                      && !string.IsNullOrEmpty(_password))
                                  || (IsWebDavProvider && !string.IsNullOrWhiteSpace(_serverUrl)
                                      && !string.IsNullOrWhiteSpace(_username)
                                      && !string.IsNullOrEmpty(_password))
                                  || (UsesPinnedSshSetup && !string.IsNullOrWhiteSpace(_server)
                                      && _port is >= 1 and <= 65535
                                      && !string.IsNullOrWhiteSpace(_username)
                                      && !string.IsNullOrWhiteSpace(_remoteRoot)
                                      && (_advancedSshSetup
                                          ? !string.IsNullOrWhiteSpace(_sshHostFingerprint)
                                            && !string.IsNullOrWhiteSpace(_privateKeySecretReference)
                                            && (IsSftpProvider || !string.IsNullOrWhiteSpace(_knownHostsSecretReference))
                                          : _sshPrivateKey is not null
                                            && SelectedHostKey is not null
                                            && _hostKeyConfirmed))
                                  || (!IsSmbProvider && !UsesPinnedSshSetup
                                      && !string.IsNullOrWhiteSpace(_settingsJson)));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await VM.LoadAsync();
        StateHasChanged();
    }

    private async Task CreateAsync() => await ActAsync(async () =>
    {
        if (SelectedProviderUsesInteractiveAuthorization)
        {
            string uri = await VM.CreateOneDriveConnectionAsync(_name, _departmentId);
            Nav.NavigateTo(uri, forceLoad: true);
        }
        else
        {
            if (UsesPinnedSshSetup && !_advancedSshSetup)
                await PrepareManagedSshSettingsAsync();
            string settingsJson = BuildSettingsJson();
            bool usesUsernamePassword = IsSmbProvider || IsWebDavProvider;
            await VM.CreateConfiguredConnectionAsync(
                _provider, _name, _departmentId, settingsJson,
                usesUsernamePassword ? _username : null,
                usesUsernamePassword ? _password : null,
                IsSmbProvider ? _domain : null,
                UsesPinnedSshSetup && !_advancedSshSetup ? _sshPrivateKey : null);
            if (_sshPrivateKey is not null)
                CryptographicOperations.ZeroMemory(_sshPrivateKey);
            _sshPrivateKey = null;
            _managedKnownHostsPath = null;
            _creating = false;
            _selected = VM.Connections.FirstOrDefault(connection =>
                connection.Name == _name && connection.DepartmentId == _departmentId);
        }
    });
    private async Task AuthorizeAsync() => await ActAsync(async () => Nav.NavigateTo(await VM.AuthorizeConnectionAsync(_selected!.Id), forceLoad: true));
    private async Task TestAsync()
    {
        _testSucceeded = _testFailed = false;
        Guid selectedId = _selected!.Id;
        _busy = true; _error = null;
        try
        {
            await VM.TestConnectionAsync(selectedId);
            _selected = VM.Connections.FirstOrDefault(connection => connection.Id == selectedId);
            _testSucceeded = _selected?.State == StorageConnectionState.Ready
                             && string.IsNullOrWhiteSpace(_selected.LastErrorCode);
            _testFailed = !_testSucceeded;
        }
        catch (Exception exception)
        {
            _error = exception is InvalidOperationException or ArgumentException
                ? exception.Message
                : R("Web_ExternalStorage_OperationFailed");
            _testFailed = true;
        }
        finally { _busy = false; }
    }
    private async Task ToggleEnabledAsync() => await ActAsync(() => VM.SetConnectionEnabledAsync(_selected!.Id, _selected.State == StorageConnectionState.Disabled));
    private async Task DeleteAsync() => await ActAsync(() => VM.DeleteConnectionAsync(_selected!.Id));
    private async Task ProviderChanged()
    {
        if (!UsesPinnedSshSetup)
            await ResetGuidedSshStateAsync();
        _port = IsSmbProvider ? 445 : UsesPinnedSshSetup ? 22 : _port;
        _remoteRoot = "/";
        _serverUrl = string.Empty;
    }
    private async Task ActAsync(Func<Task> action)
    {
        Guid? selectedId = _selected?.Id;
        _busy = true; _error = null;
        try { await action(); _selected = selectedId is Guid id ? VM.Connections.FirstOrDefault(c => c.Id == id) : VM.Connections.FirstOrDefault(); }
        catch (InvalidOperationException exception) { _error = exception.Message; }
        catch (ArgumentException exception) { _error = exception.Message; }
        catch { _error = R("Web_ExternalStorage_OperationFailed"); }
        finally { _busy = false; }
    }
    private string BuildSettingsJson()
    {
        if (IsWebDavProvider)
            return System.Text.Json.JsonSerializer.Serialize(new
            {
                ServerUrl = _serverUrl.Trim()
            });
        if (IsSmbProvider)
            return System.Text.Json.JsonSerializer.Serialize(new
            {
                Server = _server.Trim(),
                Port = _port,
                Domain = string.IsNullOrWhiteSpace(_domain) ? null : _domain.Trim(),
                MinimumDialect = _minimumDialect,
                RequireSigning = true,
                RequireEncryption = true
            });
        if (UsesPinnedSshSetup)
            return System.Text.Json.JsonSerializer.Serialize(new
            {
                Host = _server.Trim(),
                Port = _port,
                Username = _username.Trim(),
                RemoteRoot = _remoteRoot.Trim(),
                ExpectedHostKeySha256 = _sshHostFingerprint.Trim(),
                PrivateKeySecretReference = _privateKeySecretReference.Trim(),
                KnownHostsSecretReference = _knownHostsSecretReference.Trim()
            });
        return _settingsJson;
    }
    private async Task CancelCreateAsync()
    {
        await ResetGuidedSshStateAsync();
        _creating = false;
        _name = _settingsJson = _server = _username = _password = _domain = _serverUrl = string.Empty;
        _sshHostFingerprint = _privateKeySecretReference = _knownHostsSecretReference = string.Empty;
        _remoteRoot = "/";
        _port = 445;
        _minimumDialect = "3.1.1";
        _departmentId = Guid.Empty;
    }
    private StorageConnectionUsage Usage(Guid id) => VM.ConnectionUsage.GetValueOrDefault(id) ?? new StorageConnectionUsage(0, 0);
    private string UsageSummary(Guid id)
    {
        var usage = Usage(id);
        return $"{usage.SyncCount} / {usage.VirtualShareCount}";
    }
    private string ProviderName(string id) => ProviderCatalog.TryGet(id, out var provider) ? provider.DisplayName : id;
    private static string ProviderIcon(string id) => id.ToLowerInvariant() switch
    {
        "smb" => "connection_smb.svg",
        "rsync-ssh" => "connection_rsync.svg",
        "sftp" => "connection_sftp.svg",
        "webdav" => "connection_webdav.svg",
        "onedrive" => "connection_onedrive.svg",
        "google" or "googledrive" => "connection_google.svg",
        _ => "cloud-download.svg"
    };
    private static string ProviderColor(string id) => id.ToLowerInvariant() switch
    {
        "smb" => "var(--provider-smb, #5b7fa4)",
        "rsync-ssh" => "var(--provider-rsync, #6a9a5b)",
        "sftp" => "var(--provider-sftp, #8b6baf)",
        "webdav" => "var(--provider-webdav, #2e8b57)",
        "onedrive" => "var(--provider-onedrive, #0078d4)",
        "google" or "googledrive" => "var(--provider-google, #e67c35)",
        _ => "var(--text-secondary)"
    };
    private bool Supports(StorageConnection connection, StorageProviderCapabilities capability)
        => ProviderCatalog.TryGet(connection.ProviderId, out var provider) && provider.Capabilities.HasFlag(capability);
    private bool SupportsAuthorization(StorageConnection connection)
        => connection.AuthorizationMode == StorageAuthorizationMode.DeviceCode
           && Supports(connection, StorageProviderCapabilities.DelegatedAuthorization);
    private string CapabilityNames(StorageConnection connection)
    {
        if (!ProviderCatalog.TryGet(connection.ProviderId, out var provider))
            return R("Web_ExternalStorage_None");
        var names = Enum.GetValues<StorageProviderCapabilities>()
            .Where(capability => capability != StorageProviderCapabilities.None
                                 && provider.Capabilities.HasFlag(capability))
            .Select(capability => R($"Web_ExternalStorage_Capability_{capability}"));
        return string.Join(", ", names);
    }
    private static string StateName(StorageConnectionState state) => R($"Web_ExternalStorage_State_{state}");
    private static StatusTone StateTone(StorageConnectionState state) => state switch { StorageConnectionState.Ready => StatusTone.Positive, StorageConnectionState.Disabled => StatusTone.Neutral, _ => StatusTone.Warning };
    private static string AuthorizationName(StorageAuthorizationMode mode) => R($"Web_ExternalStorage_Auth_{mode}");
    private static string SecretHealth(StorageConnection connection) => connection.AuthorizationMode switch
    {
        StorageAuthorizationMode.NetworkIdentity => R("Web_ExternalStorage_RuntimeIdentity"),
        StorageAuthorizationMode.SshKey => string.IsNullOrWhiteSpace(connection.EncryptedCredentialPayload)
            ? R("Web_ExternalStorage_SecretFileReferences")
            : R("Web_ExternalStorage_Protected"),
        _ => string.IsNullOrWhiteSpace(connection.EncryptedCredentialPayload)
            ? R("Web_ExternalStorage_NotAuthorized")
            : R("Web_ExternalStorage_Protected")
    };
    private static string FormatDate(DateTime? value) => value?.ToLocalTime().ToString("g") ?? R("Web_CloudSync_Never");
    private static string R(string key) => Resources.ResourceManager.GetString(key) ?? key;

    private RsyncSshHostKeyCandidate? SelectedHostKey => _hostKeyCandidates.FirstOrDefault(
        candidate => candidate.FingerprintSha256 == _selectedHostFingerprint);

    private async Task UploadSshPrivateKeyAsync(InputFileChangeEventArgs args)
    {
        _sshSetupBusy = true; _error = null;
        try
        {
            await using Stream stream = args.File.OpenReadStream(1024 * 1024);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            byte[] uploaded = memory.ToArray();
            try { SetSshKey(await RsyncSshSetup.ValidatePrivateKeyAsync(uploaded), args.File.Name); }
            finally { CryptographicOperations.ZeroMemory(uploaded); }
        }
        catch (Exception exception) { _error = SetupError(exception); }
        finally { _sshSetupBusy = false; }
    }

    private async Task GenerateSshPrivateKeyAsync()
    {
        _sshSetupBusy = true; _error = null;
        try { SetSshKey(await RsyncSshSetup.GeneratePrivateKeyAsync(), R("Web_ExternalStorage_SshGeneratedKeyReady")); }
        catch (Exception exception) { _error = SetupError(exception); }
        finally { _sshSetupBusy = false; }
    }

    private void SetSshKey(RsyncSshKeyMaterial material, string name)
    {
        if (_sshPrivateKey is not null)
            CryptographicOperations.ZeroMemory(_sshPrivateKey);
        _sshPrivateKey = material.PrivateKey;
        _sshPublicKey = material.PublicKey;
        _sshPrivateKeyName = name;
    }

    private async Task CopyPublicKeyAsync()
    {
        if (_sshPublicKey.Length > 0)
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _sshPublicKey);
    }

    private async Task DiscoverHostKeysAsync()
    {
        _sshSetupBusy = true; _error = null; _hostKeyConfirmed = false;
        try
        {
            _hostKeyCandidates = (await RsyncSshSetup.DiscoverHostKeysAsync(_server.Trim(), _port)).ToList();
            _selectedHostFingerprint = _hostKeyCandidates.FirstOrDefault()?.FingerprintSha256 ?? string.Empty;
            if (_hostKeyCandidates.Count == 0)
                _error = R("Web_ExternalStorage_SshHostKeyNotFound");
        }
        catch (Exception exception) { _error = SetupError(exception); }
        finally { _sshSetupBusy = false; }
    }

    private void HostKeySelectionChanged() => _hostKeyConfirmed = false;

    private async Task SshEndpointChangedAsync()
    {
        _hostKeyCandidates = [];
        _selectedHostFingerprint = string.Empty;
        _hostKeyConfirmed = false;
        if (_managedKnownHostsPath is not null)
        {
            await RsyncSshSetup.DeleteManagedKnownHostAsync(_managedKnownHostsPath);
            _managedKnownHostsPath = null;
        }
    }

    private async Task SshModeChangedAsync()
    {
        _error = null;
        if (_advancedSshSetup)
        {
            if (_sshPrivateKey is not null)
                CryptographicOperations.ZeroMemory(_sshPrivateKey);
            _sshPrivateKey = null;
            _sshPrivateKeyName = null;
            _sshPublicKey = string.Empty;
            await SshEndpointChangedAsync();
        }
        else
        {
            _sshHostFingerprint = string.Empty;
            _privateKeySecretReference = string.Empty;
            _knownHostsSecretReference = string.Empty;
        }
    }

    private async Task PrepareManagedSshSettingsAsync()
    {
        RsyncSshHostKeyCandidate candidate = SelectedHostKey
            ?? throw new InvalidOperationException(R("Web_ExternalStorage_SshHostKeyNotFound"));
        if (!_hostKeyConfirmed || _sshPrivateKey is null)
            throw new InvalidOperationException(R("Web_ExternalStorage_SshSetupIncomplete"));
        _managedKnownHostsPath ??= await RsyncSshSetup.PersistKnownHostAsync(candidate);
        _sshHostFingerprint = candidate.FingerprintSha256;
        _knownHostsSecretReference = _managedKnownHostsPath;
        _privateKeySecretReference = string.Empty;
    }

    private async Task ResetGuidedSshStateAsync()
    {
        if (_sshPrivateKey is not null)
            CryptographicOperations.ZeroMemory(_sshPrivateKey);
        _sshPrivateKey = null;
        _sshPrivateKeyName = null;
        _sshPublicKey = string.Empty;
        _hostKeyCandidates = [];
        _selectedHostFingerprint = string.Empty;
        _hostKeyConfirmed = false;
        if (_managedKnownHostsPath is not null)
            await RsyncSshSetup.DeleteManagedKnownHostAsync(_managedKnownHostsPath);
        _managedKnownHostsPath = null;
        _advancedSshSetup = false;
    }

    private void SelectConnection(StorageConnection connection)
    {
        _selected = connection;
        _testSucceeded = _testFailed = false;
        _renaming = false;
    }

    private void StartRename()
    {
        _renameValue = _selected?.Name ?? string.Empty;
        _renaming = true;
    }

    private void CancelRename() => _renaming = false;

    private async Task RenameKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !string.IsNullOrWhiteSpace(_renameValue) && !_busy)
            await SaveRenameAsync();
        else if (args.Key == "Escape")
            CancelRename();
    }

    private async Task SaveRenameAsync()
    {
        if (_selected is null)
            return;
        var connectionId = _selected.Id;
        await ActAsync(() => VM.UpdateConnectionAsync(connectionId, _renameValue));
        if (_error is null)
            _renaming = false;
    }

    private static string SetupError(Exception exception)
        => exception is ProtocolConfigurationException configuration
            ? R($"Web_ExternalStorage_SshSetupError_{configuration.Code}")
            : R("Web_ExternalStorage_SshSetupError");

    public async ValueTask DisposeAsync() => await ResetGuidedSshStateAsync();
}
