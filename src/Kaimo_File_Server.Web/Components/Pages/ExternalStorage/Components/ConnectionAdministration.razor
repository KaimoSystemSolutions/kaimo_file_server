@using Kaimo_File_Server.Core.Domain
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Core.Repositories
@using Kaimo_File_Server.Core.Services.ExternalStorage
@using Kaimo_File_Server.Infrastructure.ExternalStorage
@using Kaimo_File_Server.Web.Components.ViewModels
@using Kaimo_File_Server.Web.DynamicHelpers
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using static Kaimo_File_Server.Web.Components.Pages.ExternalStorage.Components.ConnectionDisplay
@implements IAsyncDisposable
@inject CloudAccessViewModel VM
@inject DateFormatService DateFmt
@inject IStorageConnectionProviderCatalog ProviderCatalog
@inject IRsyncSshSetupService RsyncSshSetup
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ToastService Toasts
@inherits AppComponentBase

@if (VM.IsLoading)
{
    <div class="loading-state"><div class="spinner"></div><p>@R("Web_ExternalStorage_Loading")</p></div>
}
else if (!VM.CanManage)
{
    <div class="error-banner">@R("Web_CloudAccess_NoPermission")</div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_error ?? VM.ErrorMessage))
    {
        <div class="error-banner">@(_error ?? VM.ErrorMessage)</div>
    }
    <div class="connection-toolbar">
        <div><h2>@R("Web_ExternalStorage_Tab_Connections")</h2><p class="subtitle">@R("Web_ExternalStorage_ConnectionsHelp")</p></div>
        @if (VM.CanManageConnections)
        {
            <button class="btn-primary" type="button" @onclick="ToggleCreateAsync">@R("Web_CloudAccess_AddConnection")</button>
        }
    </div>

    @if (_creating)
    {
        <section class="connection-editor">
            <div class="connection-editor-heading">
                <div>
                    <h3>@R("Web_CloudAccess_AddConnection")</h3>
                    <p>@R("Web_ExternalStorage_ConnectionsHelp")</p>
                </div>
            </div>
            @ConnectionTabStrip
            <div class="connection-tab-panel"><div class="connection-form">@ConnectionFormFields</div></div>
            <div class="detail-actions"><button class="btn-secondary" type="button" @onclick="CancelCreateAsync">@R("Web_Button_Cancel")</button><button class="btn-primary" type="button" disabled="@(_busy || _sshSetupBusy || !CanCreate)" @onclick="CreateAsync">@R("Web_CloudAccess_Connect")</button></div>
        </section>
    }

    @if (VM.Connections.Count == 0)
    {
        <div class="empty-state"><p>@R("Web_CloudAccess_NoConnections")</p></div>
    }
    else
    {
        <div class="connection-layout">
            <div class="connection-list">
                <div class="connection-list-header" aria-hidden="true">
                    <span>@R("Web_ExternalStorage_Name")</span>
                    <span>@R("Web_ExternalStorage_State")</span>
                    <span>@R("Web_ExternalStorage_Tab_Syncs")</span>
                    <span>@R("Web_Shares_VirtualShares")</span>
                </div>
                @foreach (var connection in VM.Connections)
                {
                    var usage = Usage(connection.Id);
                    <button class="connection-row @(_selected?.Id == connection.Id ? "connection-row--selected" : "")" type="button" @onclick="() => SelectConnection(connection)">
                        <span class="connection-name">
                            <span class="connection-provider-icon" style="color: @ProviderColor(connection.ProviderId)">@Assets.SVG(ProviderIcon(connection.ProviderId), new SvgOptions(Width: 18, Height: 18))</span>
                            <span class="connection-name-text">
                                <strong>@connection.Name</strong>
                                <small>@ProviderName(connection.ProviderId) · @(connection.AccountEmail ?? connection.AccountDisplayName ?? R("Web_CloudAccess_NotAuthorized"))</small>
                            </span>
                        </span>
                        <StatusBadge Tone="@StateTone(connection.State)" Class="connection-state" Label="@StateName(connection.State)" />
                        <span class="connection-usage">@usage.SyncCount</span>
                        <span class="connection-usage">@usage.VirtualShareCount</span>
                    </button>
                }
            </div>
            <aside class="connection-detail">
                @if (_selected is null)
                {
                    <div class="detail-empty">
                        <div class="detail-empty-icon">@Assets.SVG("cloud-download.svg", new SvgOptions(Width: 32, Height: 32, Color: "var(--text-tertiary)"))</div>
                        <p class="detail-empty-title">@R("Web_ExternalStorage_NoConnectionSelected")</p>
                        <p>@R("Web_ExternalStorage_NoConnectionSelectedHint")</p>
                    </div>
                }
                else if (_editing)
                {
                    <section class="connection-editor connection-editor--inline">
                        <div class="connection-editor-heading">
                            <div>
                                <h3>@R("Web_CloudAccess_EditConnection")</h3>
                                <p>@_selected.Name · @ProviderName(_selected.ProviderId)</p>
                            </div>
                            <div class="connection-enabled">
                                <label class="toggle-switch" title="@R("Web_ExternalStorage_Enabled")">
                                    <input type="checkbox" @bind="_editEnabled" />
                                    <span class="toggle-slider"></span>
                                </label>
                                <span>@R("Web_ExternalStorage_Enabled")</span>
                            </div>
                        </div>
                        @ConnectionTabStrip
                        <div class="connection-tab-panel"><div class="connection-form">@ConnectionFormFields</div></div>
                        <div class="detail-actions"><button class="btn-secondary" type="button" disabled="@_busy" @onclick="CancelEdit">@R("Web_Button_Cancel")</button><button class="btn-primary" type="button" disabled="@(_busy || _sshSetupBusy || !CanSaveEdit)" @onclick="SaveEditAsync">@R("Web_CloudAccess_Save")</button></div>
                    </section>
                }
                else
                {
                    var usage = Usage(_selected.Id);
                    var hasError = !string.IsNullOrWhiteSpace(_selected.LastErrorCode);
                    // Authorizing is the next step until the connection is ready; afterwards re-authorizing is rare.
                    var authorizeFirst = SupportsAuthorization(_selected) && _selected.State != StorageConnectionState.Ready;
                    <DetailHeader Title="@_selected.Name" Subtitle="@ProviderName(_selected.ProviderId)">
                        <Leading>
                            <span class="detail-head-icon" aria-hidden="true" style="color: @ProviderColor(_selected.ProviderId)">
                                @Assets.SVG(ProviderIcon(_selected.ProviderId), new SvgOptions(Width: 20, Height: 20))
                            </span>
                        </Leading>
                        <Status>
                            <StatusBadge Tone="@StateTone(_selected.State)" Label="@StateName(_selected.State)" />
                        </Status>
                        <Actions>
                            @if (VM.CanManageConnections)
                            {
                                <button class="btn-tinted" type="button" disabled="@_busy" @onclick="StartEditAsync">
                                    @Assets.SVG("edit.svg", new SvgOptions(Width: 14, Height: 14))
                                    <span>@R("Web_CloudAccess_Edit")</span>
                                </button>
                                @if (authorizeFirst)
                                {
                                    <button class="btn-tinted" type="button" disabled="@_busy" @onclick="AuthorizeAsync">
                                        @Assets.SVG("shield.svg", new SvgOptions(Width: 14, Height: 14))
                                        <span>@R("Web_CloudAccess_Authorize")</span>
                                    </button>
                                }
                                <button class="btn-tinted btn-tinted--info" type="button" disabled="@_busy" @onclick="TestAsync">
                                    @Assets.SVG("refresh.svg", new SvgOptions(Width: 14, Height: 14))
                                    <span>@R("Web_ExternalStorage_Test")</span>
                                </button>
                            }
                        </Actions>
                        <MoreActions>
                            @if (VM.CanManageConnections)
                            {
                                @if (SupportsAuthorization(_selected) && !authorizeFirst)
                                {
                                    <MenuItem Icon="shield.svg" Label="@R("Web_CloudAccess_Reauthorize")" Disabled="@_busy" OnClick="AuthorizeAsync" />
                                    <MenuItem Separator />
                                }
                                <MenuItem Icon="trash.svg" Label="@R("Web_Action_Delete")" Danger
                                          Disabled="@(_busy || usage.TotalCount > 0)"
                                          Tooltip="@(usage.TotalCount > 0 ? R("Web_StorageConnection_DeleteInUse") : null)"
                                          OnClick="() => _confirmDelete = true" />
                            }
                        </MoreActions>
                    </DetailHeader>

                    @if (hasError || _testFailed)
                    {
                        <div class="detail-alerts">
                            <div class="error-banner" role="alert">
                                @if (_testFailed)
                                {
                                    <strong>@R("Web_ExternalStorage_TestFailed")@(hasError ? ":" : "")</strong>
                                    @(hasError ? ErrorMessage(_selected.LastErrorCode!) : "")
                                }
                                else
                                {
                                    @ErrorMessage(_selected.LastErrorCode!)
                                }
                            </div>
                        </div>
                    }

                    <div class="fact-tiles">
                        <FactTile Label="@R("Web_ExternalStorage_LastVerified")" Value="@DateFmt.FormatDateTime(_selected.LastVerifiedAtUtc, nullText: R("Web_CloudSync_Never"))" Compact
                                  Tone="@(_selected.LastVerifiedAtUtc is null ? StatusTone.Neutral : StateTone(_selected.State))" />
                        <FactTile Label="@R("Web_ExternalStorage_Tab_Syncs")" Value="@usage.SyncCount.ToString()"
                                  OnLink="OnOpenSyncs" LinkLabel="@R("Web_ExternalStorage_OpenSyncs")" />
                        <FactTile Label="@R("Web_Shares_VirtualShares")" Value="@usage.VirtualShareCount.ToString()" />
                    </div>

                    <DetailSection Title="@R("Web_ExternalStorage_Identity")">
                        <PropertyRow Label="@R("Web_ExternalStorage_AuthorizationMode")" Value="@AuthorizationName(_selected.AuthorizationMode)" />
                        <PropertyRow Label="@R("Web_CloudAccess_Account")" Value="@(_selected.AccountEmail ?? _selected.AccountDisplayName ?? R("Web_CloudAccess_NotAuthorized"))" />
                        <PropertyRow Label="@R("Web_ExternalStorage_Tenant")" Value="@_selected.ProviderTenantId" Mono Copyable />
                        <PropertyRow Label="@R("Web_ExternalStorage_Scopes")" Value="@_selected.EffectiveScopes" Mono />
                    </DetailSection>

                    <DetailSection Title="@R("Web_ExternalStorage_Health")">
                        <PropertyRow Label="@R("Web_ExternalStorage_ProfileHealth")" Value="@(_selected.ProviderProfileId is null ? R("Web_ExternalStorage_ProfileLegacy") : R("Web_ExternalStorage_ProfileConfigured"))" />
                        <PropertyRow Label="@R("Web_ExternalStorage_SecretHealth")" Value="@SecretHealth(_selected)" />
                        <PropertyRow Label="@R("Web_ExternalStorage_Capabilities")" Value="@CapabilityNames(_selected)" />
                    </DetailSection>

                    @if (_confirmDelete)
                    {
                        <div class="modal-backdrop" @onclick="() => _confirmDelete = false">
                            <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="connection-delete-title" @onclick:stopPropagation="true">
                                <h2 class="modal-title" id="connection-delete-title">@string.Format(R("Web_ExternalStorage_DeleteConnectionTitle"), _selected.Name)</h2>
                                <p class="modal-text">@R("Web_ExternalStorage_DeleteConnectionHint")</p>
                                <div class="modal-actions">
                                    <button type="button" class="btn-secondary" @onclick="() => _confirmDelete = false">@R("Web_Button_Cancel")</button>
                                    <button type="button" class="btn-danger" disabled="@_busy" @onclick="DeleteAsync">@R("Web_Action_Delete")</button>
                                </div>
                            </div>
                        </div>
                    }
                }
            </aside>
        </div>
    }
}

@code {
    // Tab strip shared by the create form and the in-place editor. Providers
    // driven by interactive authorization (OneDrive, Dropbox) expose only the
    // General tab; the connection and security tabs appear when relevant.
    private RenderFragment ConnectionTabStrip => @<text>
        <Tabs class="detail-tabs--panel connection-tabs" aria-label="@R("Web_CloudAccess_EditConnection")">
            <Tab Active="@(_activeConnectionTab == ConnectionTab.General)" Icon="settings.svg" Label="@R("Web_ExternalStorage_ConnTab_General")"
                 OnClick="() => _activeConnectionTab = ConnectionTab.General" />
            @if (ShowConnectionTab)
            {
                <Tab Active="@(_activeConnectionTab == ConnectionTab.Connection)" Icon="globe.svg" Label="@R("Web_ExternalStorage_ConnTab_Connection")"
                     OnClick="() => _activeConnectionTab = ConnectionTab.Connection" />
            }
            @if (ShowSecurityTab)
            {
                <Tab Active="@(_activeConnectionTab == ConnectionTab.Security)" Icon="shield.svg" Label="@R("Web_ExternalStorage_ConnTab_Security")"
                     OnClick="() => _activeConnectionTab = ConnectionTab.Security" />
            }
        </Tabs>
    </text>;

    // Segmented key/password choice of SFTP (DESIGN_SPEC: .toggle-button-group).
    private RenderFragment SshAuthChoice(bool password, string label) => @<button type="button" role="radio"
        aria-checked="@(_sshUsePassword == password ? "true" : "false")"
        class="toggle-btn @(_sshUsePassword == password ? "toggle-btn--active" : null)"
        disabled="@_sshSetupBusy" @onclick="() => SelectSshAuthMethod(password)">@label</button>;

    // Fields of the active tab. In edit mode the provider and department are
    // fixed (shown read-only) and the password may be left blank to keep the
    // stored credential.
    private RenderFragment ConnectionFormFields => @<text>
        @if (_activeConnectionTab == ConnectionTab.General)
        {
            <label><span>@R("Web_CloudAccess_Provider")</span>
                @if (_editing)
                {
                    <input class="edit-input" value="@ProviderName(_provider)" disabled />
                }
                else
                {
                    <select class="edit-input" @bind="_provider" @bind:after="ProviderChanged">@foreach (var provider in CreatableProviders) { <option value="@provider.Id">@provider.DisplayName</option> }</select>
                }
            </label>
            <label><span>@R("Web_CloudAccess_ConnectionName")</span><input class="edit-input" maxlength="200" @bind="_name" @bind:event="oninput" aria-invalid="@(ConnectionNameTaken ? "true" : null)" />
                @if (ConnectionNameTaken)
                {
                    <small class="connection-field-error" role="alert">@R("Web_ExternalStorage_ConnectionNameExists")</small>
                }
            </label>
        }
        else if (_activeConnectionTab == ConnectionTab.Connection)
        {
            @if (IsSmbProvider)
            {
                <label><span>@R("Web_ExternalStorage_Server")</span><input class="edit-input" maxlength="253" placeholder="192.168.1.10" @bind="_server" @bind:event="oninput" /></label>
                <label><span>@R("Web_ExternalStorage_Port")</span><input class="edit-input" type="number" min="1" max="65535" @bind="_port" /></label>
                <label><span>@R("Web_ExternalStorage_Domain")</span><input class="edit-input" maxlength="256" placeholder="WORKGROUP" @bind="_domain" /></label>
                <label><span>@R("Web_ExternalStorage_MinimumDialect")</span><select class="edit-input" @bind="_minimumDialect"><option value="3.0">SMB 3.0</option><option value="3.02">SMB 3.0.2</option><option value="3.1.1">SMB 3.1.1</option></select></label>
                <p class="storage-wide connection-form-hint">@R("Web_ExternalStorage_SmbSharePickerHelp")</p>
            }
            else if (IsWebDavProvider)
            {
                <label class="storage-wide"><span>@R("Web_ExternalStorage_WebDavServerUrl")</span><input class="edit-input" maxlength="2048" placeholder="https://cloud.example.com/remote.php/dav/files/user/" @bind="_serverUrl" @bind:event="oninput" /></label>
                <p class="storage-wide connection-form-hint">@R("Web_ExternalStorage_WebDavHelp")</p>
                @if (IsInsecureWebDavUrl)
                {
                    <label class="storage-wide storage-check"><span class="toggle-switch"><input type="checkbox" @bind="_allowInsecureHttp" /><span class="toggle-slider"></span></span> <span>@R("Web_ExternalStorage_WebDavAllowInsecureHttp")</span></label>
                    <p class="storage-wide connection-form-hint">@R("Web_ExternalStorage_WebDavAllowInsecureHttpWarning")</p>
                }
            }
            else if (UsesPinnedSshSetup)
            {
                <label><span>@R("Web_ExternalStorage_Server")</span><input class="edit-input" maxlength="253" placeholder="backup.example.com" @bind="_server" @bind:event="oninput" @onchange="SshEndpointChangedAsync" /></label>
                <label><span>@R("Web_ExternalStorage_Port")</span><input class="edit-input" type="number" min="1" max="65535" @bind="_port" @bind:after="SshEndpointChangedAsync" /></label>
                <label class="storage-wide"><span>@R("Web_ExternalStorage_RemoteRoot")</span><input class="edit-input" maxlength="4096" placeholder="/srv/backups" @bind="_remoteRoot" @bind:event="oninput" /></label>
                <p class="storage-wide connection-form-hint">@R("Web_ExternalStorage_RsyncSshHelp")</p>
            }
            else
            {
                <label class="storage-wide"><span>@R("Web_ExternalStorage_ConnectionSettings")</span><textarea class="edit-input" rows="10" maxlength="65536" @bind="_settingsJson" @bind:event="oninput"></textarea><small>@R("Web_ExternalStorage_ConnectionSettingsHelp")</small></label>
            }
        }
        else
        {
            @if (IsSmbProvider || IsWebDavProvider)
            {
                <label><span>@R("Web_ExternalStorage_Username")</span><input class="edit-input" maxlength="256" autocomplete="username" @bind="_username" @bind:event="oninput" /></label>
                <label><span>@R("Web_ExternalStorage_Password")</span><input class="edit-input" type="password" maxlength="4096" autocomplete="new-password" @bind="_password" @bind:event="oninput" /></label>
                @if (_editing)
                {
                    <p class="storage-wide connection-form-hint">@R("Web_ExternalStorage_PasswordKeepHint")</p>
                }
            }
            else if (UsesPinnedSshSetup)
            {
                <label><span>@R("Web_ExternalStorage_Username")</span><input class="edit-input" maxlength="64" autocomplete="username" @bind="_username" @bind:event="oninput" /></label>
                @if (IsSftpProvider && !_editing)
                {
                    <div class="storage-wide ssh-auth-method">
                        <span id="ssh-auth-method-label">@R("Web_ExternalStorage_SshAuthMethod")</span>
                        <div class="toggle-button-group" role="radiogroup" aria-labelledby="ssh-auth-method-label">
                            @SshAuthChoice(false, R("Web_ExternalStorage_SshAuthKey"))
                            @SshAuthChoice(true, R("Web_ExternalStorage_SshAuthPassword"))
                        </div>
                    </div>
                }
                @if (_editing)
                {
                    @if (UsesSshPassword)
                    {
                        <label><span>@R("Web_ExternalStorage_Password")</span><input class="edit-input" type="password" maxlength="4096" autocomplete="new-password" @bind="_password" @bind:event="oninput" /></label>
                    }
                    <label><span>@R("Web_ExternalStorage_SshHostFingerprint")</span><input class="edit-input" maxlength="100" placeholder="SHA256:…" @bind="_sshHostFingerprint" /></label>
                    <p class="storage-wide connection-form-hint">@R(UsesSshPassword ? "Web_ExternalStorage_PasswordKeepHint" : "Web_ExternalStorage_SshKeyEditHint")</p>
                }
                else
                {
                    <section class="storage-wide ssh-setup-card">
                        <div class="ssh-setup-heading"><div><strong>@R("Web_ExternalStorage_SshKeySetup")</strong><small>@R(UsesSshPassword ? "Web_ExternalStorage_SshPasswordSetupHelp" : "Web_ExternalStorage_SshKeySetupHelp")</small></div><label class="storage-check"><span class="toggle-switch"><input type="checkbox" @bind="_advancedSshSetup" @bind:after="SshModeChangedAsync" /><span class="toggle-slider"></span></span> <span>@R("Web_ExternalStorage_SshAdvancedMode")</span></label></div>
                        @if (!_advancedSshSetup)
                        {
                            @if (UsesSshPassword)
                            {
                                <div class="ssh-setup-section">
                                    <span class="ssh-step">1</span><div class="ssh-step-content"><strong>@R("Web_ExternalStorage_SshPasswordStep")</strong><small>@R("Web_ExternalStorage_SshPasswordHelp")</small>
                                        <label><span>@R("Web_ExternalStorage_Password")</span><input class="edit-input" type="password" maxlength="4096" autocomplete="new-password" @bind="_password" @bind:event="oninput" /></label>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="ssh-setup-section">
                                    <span class="ssh-step">1</span><div class="ssh-step-content"><strong>@R("Web_ExternalStorage_SshPrivateKey")</strong><small>@R("Web_ExternalStorage_SshPrivateKeyHelp")</small>
                                        <div class="ssh-actions"><InputFile OnChange="UploadSshPrivateKeyAsync" accept=".key,.pem,.openssh" /><button class="btn-secondary" type="button" disabled="@_sshSetupBusy" @onclick="GenerateSshPrivateKeyAsync">@R("Web_ExternalStorage_SshGenerateKey")</button></div>
                                        @if (_sshPrivateKey is not null)
                                        {
                                            <div class="ssh-ready-line"><span class="connection-health"></span>@(_sshPrivateKeyName ?? R("Web_ExternalStorage_SshGeneratedKeyReady"))</div>
                                            <label><span>@R("Web_ExternalStorage_SshPublicKey")</span><textarea class="edit-input ssh-public-key" readonly rows="3">@_sshPublicKey</textarea></label>
                                            <button class="btn-secondary ssh-copy" type="button" @onclick="CopyPublicKeyAsync">@R("Web_ExternalStorage_CopyPublicKey")</button>
                                        }
                                    </div>
                                </div>
                            }
                            <div class="ssh-setup-section">
                                <span class="ssh-step">2</span><div class="ssh-step-content"><strong>@R("Web_ExternalStorage_SshHostVerification")</strong><small>@R("Web_ExternalStorage_SshHostVerificationHelp")</small>
                                    <button class="btn-secondary" type="button" disabled="@(_sshSetupBusy || string.IsNullOrWhiteSpace(_server) || _port is < 1 or > 65535)" @onclick="DiscoverHostKeysAsync">@R("Web_ExternalStorage_SshFetchHostKey")</button>
                                    @if (_hostKeyCandidates.Count > 0)
                                    {
                                        <label><span>@R("Web_ExternalStorage_SshHostKey")</span><select class="edit-input" @bind="_selectedHostFingerprint" @bind:after="HostKeySelectionChanged">
                                            @foreach (var candidate in _hostKeyCandidates) { <option value="@candidate.FingerprintSha256">@candidate.Algorithm — @candidate.FingerprintSha256</option> }
                                        </select></label>
                                        <div class="ssh-fingerprint">@SelectedHostKey?.FingerprintSha256</div>
                                        <label class="storage-check ssh-confirm"><input type="checkbox" @bind="_hostKeyConfirmed" /> <span>@R("Web_ExternalStorage_SshConfirmFingerprint")</span></label>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="ssh-advanced-grid">
                                <label><span>@R("Web_ExternalStorage_SshHostFingerprint")</span><input class="edit-input" maxlength="100" placeholder="SHA256:…" @bind="_sshHostFingerprint" @bind:event="oninput" /></label>
                                @if (UsesSshPassword)
                                {
                                    <label><span>@R("Web_ExternalStorage_Password")</span><input class="edit-input" type="password" maxlength="4096" autocomplete="new-password" @bind="_password" @bind:event="oninput" /></label>
                                }
                                else
                                {
                                    <label><span>@R("Web_ExternalStorage_PrivateKeySecretReference")</span><input class="edit-input" maxlength="4096" placeholder="/run/secrets/kaimo_rsync_key" @bind="_privateKeySecretReference" @bind:event="oninput" /></label>
                                }
                                <label><span>@R("Web_ExternalStorage_KnownHostsSecretReference")</span><input class="edit-input" maxlength="4096" placeholder="/run/secrets/kaimo_known_hosts" @bind="_knownHostsSecretReference" @bind:event="oninput" /></label>
                            </div>
                        }
                    </section>
                }
            }
        }
    </text>;
}
