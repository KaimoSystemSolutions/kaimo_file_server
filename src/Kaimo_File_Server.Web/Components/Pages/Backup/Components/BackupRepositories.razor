@using Kaimo_File_Server.Core.Domain.Backup
@using Kaimo_File_Server.Core.Domain.Department
@using Kaimo_File_Server.Infrastructure.Backup.Restic
@using Kaimo_File_Server.Web.Components.Shared
@using Kaimo_File_Server.Web.Components.ViewModels.Backup
@using Kaimo_File_Server.Web.DynamicHelpers
@inherits AppComponentBase
@implements IDisposable
@inject BackupViewModel VM
@inject DateFormatService DateFmt
@inject NavigationManager Nav

@*
    Repositories (Global): create (test → initialize new / connect existing), recovery kit
    (download → type code → active), department release, enable/disable, delete.
*@

<div class="backup-toolbar">
    <p class="subtitle">@R("Web_Backup_Repos_Help")</p>
    <button class="btn-primary" type="button" disabled="@VM.IsReadOnlyDemo" @onclick="StartCreate">@R("Web_Backup_Repos_Create")</button>
</div>

<div class="workspace">
    <section class="workspace-list" aria-label="@R("Web_Backup_Tab_Repositories")">
        <div class="workspace-list-header"><span>@R("Web_Backup_Tab_Repositories")</span></div>
        @if (VM.Repositories.Count == 0)
        {
            <div class="empty-state"><p>@R("Web_Backup_Repos_Empty")</p></div>
        }
        @foreach (var view in VM.Repositories)
        {
            var repo = view.Repository;
            <button type="button" class="workspace-row @(_selectedId == repo.Id && !_editing ? "workspace-row--selected" : "")"
                    aria-pressed="@(_selectedId == repo.Id ? "true" : "false")" @onclick="() => Select(repo.Id)">
                <span class="workspace-row-icon">@Assets.SVG("archive.svg", new SvgOptions(Width: 16, Height: 16))</span>
                <span class="workspace-row-text">
                    <strong>@repo.Name</strong>
                    <small>@BackupUi.BackendLabel(repo.Backend)</small>
                </span>
                <StatusBadge Tone="@BackupUi.RepositoryTone(repo)" Label="@BackupUi.RepositoryStateLabel(repo)" />
            </button>
        }
    </section>

    <aside class="workspace-detail" aria-label="@R("Web_Backup_Repos_Detail")">
        @if (_editing)
        {
            var form = VM.RepositoryForm;
            var isNew = form.Id is null;
            <div class="workspace-heading">
                <div>
                    <h3>@(isNew ? R("Web_Backup_Repos_Create") : R("Web_Backup_Repos_Edit"))</h3>
                    <span class="workspace-heading-sub">@BackupUi.BackendLabel(form.Backend)</span>
                </div>
            </div>

            <div class="workspace-form">
                <label>
                    <span>@R("Web_Backup_Name")</span>
                    <input class="edit-input" maxlength="200" @bind="form.Name" @bind:event="oninput" />
                </label>
                <label>
                    <span>@R("Web_Backup_Repos_Backend")</span>
                    <select class="edit-input" @bind="form.Backend" @bind:after="BackendChanged" disabled="@(!isNew)">
                        @foreach (var backend in Enum.GetValues<BackupBackend>())
                        {
                            <option value="@backend">@BackupUi.BackendLabel(backend)</option>
                        }
                    </select>
                </label>

                @switch (form.Backend)
                {
                    case BackupBackend.Local:
                        <label>
                            <span>@R("Web_Backup_Repos_LocalPath")</span>
                            <input class="edit-input" @bind="form.Path" @bind:event="oninput" @bind:after="Changed" spellcheck="false" />
                            <small>@string.Format(R("Web_Backup_Repos_LocalPathHelp"), string.Join(", ", VM.LocalRoots))</small>
                        </label>
                        break;
                    case BackupBackend.Sftp:
                        <label>
                            <span>@R("Web_Backup_Repos_Connection")</span>
                            <select class="edit-input" @bind="form.ConnectionId" @bind:after="Changed">
                                <option value="@Guid.Empty">@R("Web_Backup_Select")</option>
                                @foreach (var (id, name) in VM.SshConnections)
                                {
                                    <option value="@id">@name</option>
                                }
                            </select>
                            <small>@R("Web_Backup_Repos_ConnectionHelp")</small>
                        </label>
                        <label>
                            <span>@R("Web_Backup_Repos_RemotePath")</span>
                            <input class="edit-input" @bind="form.Path" @bind:event="oninput" @bind:after="Changed" spellcheck="false" placeholder="kaimo-backup" />
                        </label>
                        break;
                    case BackupBackend.Rest:
                        <label>
                            <span>@R("Web_Backup_Repos_Endpoint")</span>
                            <input class="edit-input" @bind="form.Endpoint" @bind:event="oninput" @bind:after="Changed" spellcheck="false" placeholder="https://backup.example.com:8000" />
                        </label>
                        <label>
                            <span>@R("Web_Backup_Repos_SubPath")</span>
                            <input class="edit-input" @bind="form.Path" @bind:event="oninput" @bind:after="Changed" spellcheck="false" />
                        </label>
                        <label>
                            <span>@R("Web_Backup_Repos_Username")</span>
                            <input class="edit-input" @bind="form.RestUsername" @bind:event="oninput" @bind:after="Changed" autocomplete="off"
                                   placeholder="@(isNew ? "" : R("Web_Backup_Repos_KeepSecret"))" />
                        </label>
                        <label>
                            <span>@R("Web_Backup_Repos_Password")</span>
                            <input class="edit-input" type="password" @bind="form.RestPassword" @bind:event="oninput" @bind:after="Changed" autocomplete="new-password"
                                   placeholder="@(isNew ? "" : R("Web_Backup_Repos_KeepSecret"))" />
                        </label>
                        break;
                    case BackupBackend.S3:
                        <label>
                            <span>@R("Web_Backup_Repos_Endpoint")</span>
                            <input class="edit-input" @bind="form.Endpoint" @bind:event="oninput" @bind:after="Changed" spellcheck="false" placeholder="https://s3.eu-central-1.amazonaws.com" />
                        </label>
                        <label>
                            <span>@R("Web_Backup_Repos_Bucket")</span>
                            <input class="edit-input" @bind="form.Bucket" @bind:event="oninput" @bind:after="Changed" spellcheck="false" />
                        </label>
                        <label>
                            <span>@R("Web_Backup_Repos_Prefix")</span>
                            <input class="edit-input" @bind="form.Path" @bind:event="oninput" @bind:after="Changed" spellcheck="false" />
                        </label>
                        <label>
                            <span>@R("Web_Backup_Repos_Region")</span>
                            <input class="edit-input" @bind="form.Region" @bind:event="oninput" @bind:after="Changed" spellcheck="false" />
                        </label>
                        <label>
                            <span>@R("Web_Backup_Repos_AccessKey")</span>
                            <input class="edit-input" @bind="form.S3AccessKeyId" @bind:event="oninput" @bind:after="Changed" autocomplete="off"
                                   placeholder="@(isNew ? "" : R("Web_Backup_Repos_KeepSecret"))" />
                        </label>
                        <label>
                            <span>@R("Web_Backup_Repos_SecretKey")</span>
                            <input class="edit-input" type="password" @bind="form.S3SecretAccessKey" @bind:event="oninput" @bind:after="Changed" autocomplete="new-password"
                                   placeholder="@(isNew ? "" : R("Web_Backup_Repos_KeepSecret"))" />
                        </label>
                        <div class="toggle-row">
                            <span>@R("Web_Backup_Repos_PathStyle")</span>
                            <label class="toggle-switch">
                                <input type="checkbox" @bind="form.S3PathStyle" @bind:after="Changed" aria-label="@R("Web_Backup_Repos_PathStyle")" />
                                <span class="toggle-slider"></span>
                            </label>
                        </div>
                        break;
                    case BackupBackend.B2:
                        <label>
                            <span>@R("Web_Backup_Repos_Bucket")</span>
                            <input class="edit-input" @bind="form.Bucket" @bind:event="oninput" @bind:after="Changed" spellcheck="false" />
                        </label>
                        <label>
                            <span>@R("Web_Backup_Repos_Prefix")</span>
                            <input class="edit-input" @bind="form.Path" @bind:event="oninput" @bind:after="Changed" spellcheck="false" />
                        </label>
                        <label>
                            <span>@R("Web_Backup_Repos_B2KeyId")</span>
                            <input class="edit-input" @bind="form.B2AccountId" @bind:event="oninput" @bind:after="Changed" autocomplete="off"
                                   placeholder="@(isNew ? "" : R("Web_Backup_Repos_KeepSecret"))" />
                        </label>
                        <label>
                            <span>@R("Web_Backup_Repos_B2Key")</span>
                            <input class="edit-input" type="password" @bind="form.B2AccountKey" @bind:event="oninput" @bind:after="Changed" autocomplete="new-password"
                                   placeholder="@(isNew ? "" : R("Web_Backup_Repos_KeepSecret"))" />
                        </label>
                        break;
                    case BackupBackend.Azure:
                        <label>
                            <span>@R("Web_Backup_Repos_AzureAccount")</span>
                            <input class="edit-input" @bind="form.AzureAccountName" @bind:event="oninput" @bind:after="Changed" spellcheck="false" />
                        </label>
                        <label>
                            <span>@R("Web_Backup_Repos_Container")</span>
                            <input class="edit-input" @bind="form.Bucket" @bind:event="oninput" @bind:after="Changed" spellcheck="false" />
                        </label>
                        <label>
                            <span>@R("Web_Backup_Repos_Prefix")</span>
                            <input class="edit-input" @bind="form.Path" @bind:event="oninput" @bind:after="Changed" spellcheck="false" />
                        </label>
                        <label>
                            <span>@R("Web_Backup_Repos_AzureKey")</span>
                            <input class="edit-input" type="password" @bind="form.AzureAccountKey" @bind:event="oninput" @bind:after="Changed" autocomplete="new-password"
                                   placeholder="@(isNew ? "" : R("Web_Backup_Repos_KeepSecret"))" />
                        </label>
                        <label>
                            <span>@R("Web_Backup_Repos_AzureSas")</span>
                            <input class="edit-input" type="password" @bind="form.AzureSasToken" @bind:event="oninput" @bind:after="Changed" autocomplete="new-password"
                                   placeholder="@(isNew ? "" : R("Web_Backup_Repos_KeepSecret"))" />
                            <small>@R("Web_Backup_Repos_AzureCredentialsHelp")</small>
                        </label>
                        <label>
                            <span>@R("Web_Backup_Repos_AzureSuffix")</span>
                            <input class="edit-input" @bind="form.AzureEndpointSuffix" @bind:event="oninput" @bind:after="Changed" spellcheck="false" placeholder="core.windows.net" />
                            <small>@R("Web_Backup_Repos_AzureSuffixHelp")</small>
                        </label>
                        break;
                    case BackupBackend.Gcs:
                        <label>
                            <span>@R("Web_Backup_Repos_Bucket")</span>
                            <input class="edit-input" @bind="form.Bucket" @bind:event="oninput" @bind:after="Changed" spellcheck="false" />
                        </label>
                        <label>
                            <span>@R("Web_Backup_Repos_Prefix")</span>
                            <input class="edit-input" @bind="form.Path" @bind:event="oninput" @bind:after="Changed" spellcheck="false" />
                        </label>
                        <label>
                            <span>@R("Web_Backup_Repos_GcsKey")</span>
                            <textarea class="edit-input backup-pem" rows="4" spellcheck="false" autocomplete="off" @bind="form.GcsCredentialsJson" @bind:event="oninput" @bind:after="Changed"
                                      placeholder="@(isNew ? "{ \"type\": \"service_account\", … }" : R("Web_Backup_Repos_KeepSecret"))"></textarea>
                            <small>@R("Web_Backup_Repos_GcsKeyHelp")</small>
                        </label>
                        break;
                    case BackupBackend.Swift:
                        <label>
                            <span>@R("Web_Backup_Repos_Container")</span>
                            <input class="edit-input" @bind="form.Bucket" @bind:event="oninput" @bind:after="Changed" spellcheck="false" />
                        </label>
                        <label>
                            <span>@R("Web_Backup_Repos_Prefix")</span>
                            <input class="edit-input" @bind="form.Path" @bind:event="oninput" @bind:after="Changed" spellcheck="false" />
                        </label>
                        <label>
                            <span>@R("Web_Backup_Repos_SwiftEnv")</span>
                            <textarea class="edit-input backup-pem" rows="6" spellcheck="false" autocomplete="off" @bind="form.SwiftEnvironment" @bind:event="oninput" @bind:after="Changed"
                                      placeholder="@(isNew ? "OS_AUTH_URL=https://keystone.example.com:5000/v3\nOS_USERNAME=…\nOS_PASSWORD=…" : R("Web_Backup_Repos_KeepSecret"))"></textarea>
                            <small>@R("Web_Backup_Repos_SwiftEnvHelp")</small>
                        </label>
                        break;
                    case BackupBackend.Rclone:
                        <label>
                            <span>@R("Web_Backup_Repos_RcloneConfig")</span>
                            <textarea class="edit-input backup-pem" rows="6" spellcheck="false" autocomplete="off" @bind="form.RcloneConfig" @bind:event="oninput" @bind:after="Changed"
                                      placeholder="@(isNew ? "[onedrive]\ntype = onedrive\ntoken = {…}" : R("Web_Backup_Repos_KeepSecret"))"></textarea>
                            <small>@R("Web_Backup_Repos_RcloneConfigHelp")</small>
                        </label>
                        <label>
                            <span>@R("Web_Backup_Repos_RclonePath")</span>
                            <input class="edit-input" @bind="form.Path" @bind:event="oninput" @bind:after="Changed" spellcheck="false" placeholder="kaimo-backup" />
                        </label>
                        break;
                }

                @if (form.Backend is BackupBackend.Rest or BackupBackend.S3 or BackupBackend.Swift)
                {
                    <label>
                        <span>@R("Web_Backup_Repos_CaCertificate")</span>
                        <textarea class="edit-input backup-pem" rows="3" spellcheck="false" @bind="form.CaCertificatePem" @bind:event="oninput" @bind:after="Changed"
                                  placeholder="-----BEGIN CERTIFICATE-----"></textarea>
                        <small>@R("Web_Backup_Repos_CaCertificateHelp")</small>
                    </label>
                }

                @if (form.Backend == BackupBackend.Local)
                {
                    <label>
                        <span>@R("Web_Backup_Repos_MinFreeSpace")</span>
                        <input class="edit-input" type="number" min="0" @bind="form.MinFreeSpaceGb" @bind:event="oninput" />
                    </label>
                }

                @if (form.Backend == BackupBackend.Rest)
                {
                    <div class="toggle-row">
                        <span class="backup-label-with-info">
                            @R("Web_Backup_Repos_AppendOnly")
                            <InfoButton Text="@R("Web_Backup_Repos_AppendOnlyHelp")" />
                        </span>
                        <label class="toggle-switch">
                            <input type="checkbox" @bind="form.IsAppendOnly" aria-label="@R("Web_Backup_Repos_AppendOnly")" />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                }

                <div class="workspace-field">
                    <span class="backup-label-with-info">
                        @R("Web_Backup_Repos_Departments")
                        <InfoButton Text="@R("Web_Backup_Repos_DepartmentsHelp")" />
                    </span>
                    <MultiSelect T="Department" Items="form.Departments" Label="d => d.Name"
                                 PlaceholderText="@R("Web_Backup_Repos_DepartmentsNone")" />
                </div>
            </div>

            <section class="workspace-section">
                <h4>@R("Web_Backup_Maintenance")</h4>
                <p>@R("Web_Backup_Maintenance_Help")</p>
                <BackupScheduleEditor Times="form.MaintenanceTimes" Days="form.MaintenanceDays" />
                <div class="workspace-form backup-maintenance-form">
                    <div class="toggle-row">
                        <span class="backup-label-with-info">
                            @R("Web_Backup_Maintenance_ReadData")
                            <InfoButton Text="@R("Web_Backup_Maintenance_ReadDataHelp")" />
                        </span>
                        <label class="toggle-switch">
                            <input type="checkbox" @bind="form.ReadDataMonthly" aria-label="@R("Web_Backup_Maintenance_ReadData")" />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                    <label>
                        <span class="backup-label-with-info">
                            @R("Web_Backup_Maintenance_SampleSize")
                            <InfoButton Text="@R("Web_Backup_Maintenance_SampleSizeHelp")" />
                        </span>
                        <input class="edit-input" type="number" min="0" max="@BackupCatalogService.MaximumTestRestoreSample" @bind="form.TestRestoreSampleSize" />
                    </label>
                    <label>
                        <span class="backup-label-with-info">
                            @R("Web_Backup_Maintenance_Mirror")
                            <InfoButton Text="@R("Web_Backup_Maintenance_MirrorHelp")" />
                        </span>
                        <select class="edit-input" @bind="form.MirrorTargetId">
                            <option value="@Guid.Empty">@R("Web_Backup_Maintenance_NoMirror")</option>
                            @foreach (var candidate in VM.MirrorCandidates)
                            {
                                <option value="@candidate.Id">@candidate.Name (@BackupUi.BackendLabel(candidate.Backend))</option>
                            }
                        </select>
                        <small>@R("Web_Backup_Maintenance_MirrorRule")</small>
                    </label>
                </div>
                @if (form.Backend == BackupBackend.Rest && form.IsAppendOnly)
                {
                    <p class="form-hint">@R("Web_Backup_Maintenance_AppendOnlyHint")</p>
                }
            </section>

            @if (isNew)
            {
                <section class="workspace-section">
                    <h4>@R("Web_Backup_Repos_Setup")</h4>
                    <p>@R("Web_Backup_Repos_SetupHelp")</p>
                    <div class="detail-actions backup-inline-actions">
                        <button class="btn-secondary" type="button" disabled="@(VM.IsBusy || !CanSubmit)" @onclick="VM.ProbeAsync">
                            @(VM.IsBusy ? R("Web_Backup_Working") : R("Web_Backup_Repos_Test"))
                        </button>
                    </div>
                    @if (VM.ProbeResult == BackupRepositoryProbe.Empty)
                    {
                        <div class="detail-actions backup-inline-actions">
                            <button class="btn-primary" type="button" disabled="@(VM.IsBusy || !CanSubmit)" @onclick="() => CreateAsync(false)">@R("Web_Backup_Repos_Initialize")</button>
                        </div>
                    }
                    else if (VM.ProbeResult == BackupRepositoryProbe.Existing)
                    {
                        <label class="workspace-field">
                            <span>@R("Web_Backup_Repos_ExistingPassword")</span>
                            <input class="edit-input" type="password" autocomplete="off" @bind="form.ExistingPassword" @bind:event="oninput" />
                        </label>
                        <div class="detail-actions backup-inline-actions">
                            <button class="btn-primary" type="button" disabled="@(VM.IsBusy || string.IsNullOrEmpty(form.ExistingPassword))" @onclick="() => CreateAsync(true)">@R("Web_Backup_Repos_Connect")</button>
                        </div>
                    }
                </section>
            }

            <div class="detail-actions">
                <button class="btn-secondary" type="button" disabled="@VM.IsBusy" @onclick="() => _editing = false">@R("Web_Button_Cancel")</button>
                @if (!isNew)
                {
                    <button class="btn-primary" type="button" disabled="@(VM.IsBusy || !CanSubmit)" @onclick="UpdateAsync">@R("Web_Backup_Save")</button>
                }
            </div>
        }
        else if (Selected is { } view)
        {
            var repo = view.Repository;
            var maintenance = VM.ActiveMaintenance(repo.Id);
            <DetailHeader Icon="archive.svg" Title="@repo.Name" Subtitle="@BackupUi.BackendLabel(repo.Backend)">
                <Status>
                    <StatusBadge Tone="@BackupUi.RepositoryTone(repo)" Label="@BackupUi.RepositoryStateLabel(repo)" />
                </Status>
                <Actions>
                    <button class="btn-tinted" type="button" disabled="@(VM.IsBusy || VM.IsReadOnlyDemo)" @onclick="() => StartEdit(view)">
                        @Assets.SVG("edit.svg", new SvgOptions(Width: 14, Height: 14))
                        <span>@R("Web_Backup_Edit")</span>
                    </button>
                    @if (repo.State == BackupRepositoryState.Active)
                    {
                        if (maintenance is not null)
                        {
                            <button class="btn-tinted btn-tinted--danger" type="button" disabled="@(VM.IsBusy || maintenance.IsCancellationRequested)" @onclick="() => VM.CancelRunAsync(maintenance.RunId)">
                                @Assets.SVG("close.svg", new SvgOptions(Width: 14, Height: 14))
                                <span>@R("Web_Jobs_Cancel")</span>
                            </button>
                        }
                        else
                        {
                            <button class="btn-tinted btn-tinted--info" type="button" disabled="@(VM.IsBusy || VM.IsReadOnlyDemo)" @onclick="() => VM.RunMaintenanceAsync(repo.Id)">
                                @Assets.SVG("refresh.svg", new SvgOptions(Width: 14, Height: 14))
                                <span>@R("Web_Backup_Maintenance_RunNow")</span>
                            </button>
                        }
                    }
                </Actions>
                <MoreActions>
                    @if (repo.State != BackupRepositoryState.PendingRecoveryKit)
                    {
                        <MenuItem Icon="download.svg" Label="@R("Web_Backup_Kit_Download")" Disabled="@VM.IsReadOnlyDemo" OnClick="() => DownloadKitAsync(repo.Id)" />
                    }
                    @if (repo.State == BackupRepositoryState.Disabled)
                    {
                        <MenuItem Icon="check.svg" Label="@R("Web_Backup_Enable")" Disabled="@(VM.IsBusy || VM.IsReadOnlyDemo)" OnClick="() => VM.SetRepositoryEnabledAsync(repo.Id, true)" />
                    }
                    else
                    {
                        <MenuItem Icon="circle_x.svg" Label="@R("Web_Backup_Disable")" Disabled="@(VM.IsBusy || VM.IsReadOnlyDemo)" OnClick="() => VM.SetRepositoryEnabledAsync(repo.Id, false)" />
                    }
                    <MenuItem Separator />
                    <MenuItem Icon="trash.svg" Label="@R("Web_Action_Delete")" Danger
                              Disabled="@(VM.IsBusy || VM.IsReadOnlyDemo || view.JobCount > 0)"
                              Tooltip="@(view.JobCount > 0 ? R("Web_Backup_Error_repository_in_use") : null)"
                              OnClick="() => _confirmDelete = true" />
                </MoreActions>
            </DetailHeader>

            @if (maintenance is not null || repo.State == BackupRepositoryState.PendingRecoveryKit || !string.IsNullOrEmpty(repo.LastErrorCode))
            {
                <div class="detail-alerts">
                    @if (!string.IsNullOrEmpty(repo.LastErrorCode))
                    {
                        <div class="error-banner" role="alert"><strong>@R("Web_Backup_LastError"):</strong> @BackupViewModel.ErrorText(repo.LastErrorCode)</div>
                    }
                    @if (maintenance is not null)
                    {
                        <div class="backup-progress">
                            <div class="job-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@maintenance.Progress">
                                <div class="job-progress-fill" style="width: @(maintenance.Progress)%"></div>
                            </div>
                            <span class="form-hint">
                                @(maintenance.IsCancellationRequested ? R("Web_Jobs_Cancelling")
                                    : maintenance.IsRunning ? string.Format(R("Web_Backup_Running"), maintenance.Progress) + (maintenance.Detail is null ? "" : " · " + maintenance.Detail)
                                    : R("Web_Backup_Queued"))
                            </span>
                        </div>
                    }
                    @if (repo.State == BackupRepositoryState.PendingRecoveryKit)
                    {
                        <div class="backup-kit" role="status">
                            <strong>@R("Web_Backup_Kit_Title")</strong>
                            <p>@R("Web_Backup_Kit_Help")</p>
                            <ol class="backup-kit-steps">
                                <li>
                                    <span>@R("Web_Backup_Kit_Step1")</span>
                                    <button class="btn-secondary btn-secondary--sm" type="button" disabled="@VM.IsReadOnlyDemo" @onclick="() => DownloadKitAsync(repo.Id)">
                                        @Assets.SVG("download.svg", new SvgOptions(Width: 12, Height: 12))
                                        <span>@R("Web_Backup_Kit_Download")</span>
                                    </button>
                                </li>
                                <li>
                                    <span>@R("Web_Backup_Kit_Step2")</span>
                                    <span class="backup-kit-confirm">
                                        <input class="edit-input backup-kit-code" maxlength="12" autocomplete="off" spellcheck="false"
                                               aria-label="@R("Web_Backup_Kit_Code")" placeholder="ABC234" @bind="_kitCode" @bind:event="oninput" />
                                        <button class="btn-primary" type="button" disabled="@(VM.IsBusy || repo.KitDownloadedAtUtc is null && !_kitDownloaded || string.IsNullOrWhiteSpace(_kitCode))"
                                                @onclick="() => ConfirmKitAsync(repo.Id)">@R("Web_Backup_Kit_Confirm")</button>
                                    </span>
                                </li>
                            </ol>
                        </div>
                    }
                </div>
            }

            <div class="fact-tiles">
                <FactTile Label="@R("Web_Backup_LastReachable")" Value="@DateFmt.FormatDateTime(repo.LastReachableAtUtc, R("Web_Backup_Never"))" Compact
                          Tone="@(!string.IsNullOrEmpty(repo.LastErrorCode) ? StatusTone.Negative : repo.LastReachableAtUtc is null ? StatusTone.Neutral : StatusTone.Positive)" />
                <FactTile Label="@R("Web_Backup_Maintenance_LastCheck")" Value="@DateFmt.FormatDateTime(repo.LastCheckAtUtc, R("Web_Backup_Never"))" Compact
                          Tone="@(repo.LastCheckAtUtc is null ? StatusTone.Neutral : repo.LastCheckOk == true ? StatusTone.Positive : StatusTone.Negative)"
                          Tooltip="@(repo.LastCheckAtUtc is { } checkedAt
                                        ? string.Format(R(repo.LastCheckOk == true ? "Web_Backup_Maintenance_CheckOkAt" : "Web_Backup_Maintenance_CheckFailedAt"), DateFmt.FormatDateTime(checkedAt))
                                        : null)" />
                <FactTile Label="@R("Web_Backup_Maintenance_Next")" Value="@DateFmt.FormatDateTime(VM.NextMaintenanceUtc(repo), R("Web_Backup_NoSchedule"))" Compact />
                <FactTile Label="@R("Web_Backup_Tab_Jobs")" Value="@view.JobCount.ToString()"
                          OnLink="OnOpenJobs" LinkLabel="@R("Web_Backup_Repos_OpenJobs")" />
            </div>

            <DetailSection Title="@R("Web_Backup_Repos_Section_Connection")">
                <PropertyRow Label="@R("Web_Backup_Repos_Location")" Value="@Location(repo)" Mono Copyable />
                <PropertyRow Label="@R("Web_Backup_Repos_Departments")" Value="@DepartmentNames(view)" Entity />
                @if (repo.Backend == BackupBackend.Rest)
                {
                    <PropertyRow Label="@R("Web_Backup_Repos_AppendOnly")" Value="@(repo.IsAppendOnly ? R("Web_Common_Yes") : R("Web_Common_No"))" />
                }
            </DetailSection>

            <DetailSection Title="@R("Web_Backup_Maintenance")">
                <PropertyRow Label="@R("Web_Backup_Schedule")" Value="@BackupUi.ScheduleText(repo.MaintenanceSchedule, DateFmt.FormatTime)" />
                <PropertyRow Entity="@(repo.MirrorTargetId is not null)" Label="@R("Web_Backup_Maintenance_Mirror")" Value="@(repo.MirrorTargetId is { } mirrorId ? VM.RepositoryName(mirrorId) : R("Web_Backup_Maintenance_NoMirror"))" />
            </DetailSection>

            <DetailSection Title="@R("Web_Backup_Repos_Section_Recovery")">
                <PropertyRow Label="@R("Web_Backup_Kit_Title")">
                    @if (repo.KitConfirmedAtUtc is { } confirmed)
                    {
                        @string.Format(R("Web_Backup_Kit_ConfirmedAt"), DateFmt.FormatDateTime(confirmed))
                    }
                    else
                    {
                        <StatusBadge Tone="StatusTone.Warning" Label="@R("Web_Backup_Kit_NotConfirmed")" />
                    }
                </PropertyRow>
            </DetailSection>

            <DetailSection Title="@R("Web_Backup_Repos_Section_Technical")" InitiallyCollapsed>
                <PropertyRow Label="@R("Web_Backup_Repos_RepositoryId")" Value="@repo.ResticRepositoryId" Mono Copyable />
            </DetailSection>

            @if (_confirmDelete)
            {
                <div class="modal-backdrop" @onclick="() => _confirmDelete = false">
                    <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="backup-repo-delete-title" @onclick:stopPropagation="true">
                        <h2 class="modal-title" id="backup-repo-delete-title">@string.Format(R("Web_Backup_Repos_DeleteTitle"), repo.Name)</h2>
                        <p class="modal-text">@R("Web_Backup_Repos_DeleteHint")</p>
                        <div class="modal-actions">
                            <button type="button" class="btn-secondary" @onclick="() => _confirmDelete = false">@R("Web_Button_Cancel")</button>
                            <button type="button" class="btn-danger" disabled="@VM.IsBusy" @onclick="() => DeleteAsync(repo.Id)">@R("Web_Backup_ConfirmDelete")</button>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="detail-empty"><p>@R("Web_Backup_Repos_SelectHint")</p></div>
        }
    </aside>
</div>

@code {
    // Results and runner progress are announced by the view model; the page does not
    // re-render this component on its own.
    protected override void OnInitialized() => VM.Changed += Refresh;
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => VM.Changed -= Refresh;

    [Parameter] public Guid? SelectedRepositoryId { get; set; }

    /// <summary>Opens the jobs tab; the jobs tile shows no link without it.</summary>
    [Parameter] public EventCallback OnOpenJobs { get; set; }

    private Guid? _selectedId;
    private bool _editing;
    private bool _confirmDelete;
    private bool _kitDownloaded;
    private string _kitCode = string.Empty;

    protected override void OnParametersSet()
    {
        if (SelectedRepositoryId is not null)
            _selectedId = SelectedRepositoryId;
    }

    private BackupRepositoryView? Selected => VM.Repositories.FirstOrDefault(r => r.Repository.Id == _selectedId);

    private bool CanSubmit
    {
        get
        {
            var f = VM.RepositoryForm;
            return !string.IsNullOrWhiteSpace(f.Name) && f.Backend switch
            {
                BackupBackend.Local => !string.IsNullOrWhiteSpace(f.Path),
                BackupBackend.Sftp => f.ConnectionId != Guid.Empty && !string.IsNullOrWhiteSpace(f.Path),
                BackupBackend.Rest => !string.IsNullOrWhiteSpace(f.Endpoint),
                BackupBackend.S3 => !string.IsNullOrWhiteSpace(f.Endpoint) && !string.IsNullOrWhiteSpace(f.Bucket),
                BackupBackend.Azure => !string.IsNullOrWhiteSpace(f.AzureAccountName) && !string.IsNullOrWhiteSpace(f.Bucket),
                BackupBackend.B2 or BackupBackend.Gcs or BackupBackend.Swift => !string.IsNullOrWhiteSpace(f.Bucket),
                BackupBackend.Rclone => !string.IsNullOrWhiteSpace(f.Path),
                _ => false,
            };
        }
    }

    private void Select(Guid id)
    {
        _selectedId = id;
        _editing = false;
        _confirmDelete = false;
        _kitDownloaded = false;
        _kitCode = string.Empty;
    }

    private async Task StartCreate()
    {
        VM.NewRepository();
        _editing = true;
        await VM.RefreshMirrorCandidatesAsync();
    }

    private async Task StartEdit(BackupRepositoryView view)
    {
        VM.EditRepository(view);
        _editing = true;
        _confirmDelete = false;
        await VM.RefreshMirrorCandidatesAsync();
    }

    // Any change to the target invalidates an earlier test result and may change which
    // repositories can serve as its mirror (same storage type needs the same access).
    private async Task Changed()
    {
        if (VM.RepositoryForm.Id is null)
            VM.ResetProbe();
        await VM.RefreshMirrorCandidatesAsync();
    }

    private Task BackendChanged()
    {
        VM.ApplyBackendDefaults();
        return Changed();
    }

    private async Task CreateAsync(bool connectExisting)
    {
        if (await VM.CreateRepositoryAsync(connectExisting))
        {
            Select(VM.RepositoryForm.Id!.Value);
        }
    }

    private async Task UpdateAsync()
    {
        if (await VM.UpdateRepositoryAsync())
            _editing = false;
    }

    private async Task DeleteAsync(Guid id)
    {
        if (await VM.DeleteRepositoryAsync(id))
            _selectedId = null;
        _confirmDelete = false;
    }

    private async Task DownloadKitAsync(Guid id)
    {
        var url = await VM.CreateKitDownloadUrlAsync(Nav.BaseUri, id);
        if (string.IsNullOrEmpty(url))
            return;
        _kitDownloaded = true;
        Nav.NavigateTo(url, forceLoad: true);
    }

    private async Task ConfirmKitAsync(Guid id)
    {
        if (await VM.ConfirmKitAsync(id, _kitCode))
            _kitCode = string.Empty;
    }

    private string DepartmentNames(BackupRepositoryView view)
    {
        var names = VM.AllDepartments.Where(d => view.DepartmentIds.Contains(d.Id)).Select(d => d.Name).ToList();
        return names.Count == 0 ? R("Web_Backup_Repos_DepartmentsNone") : string.Join(", ", names);
    }

    private static string Location(BackupRepository repo)
    {
        var s = ResticRepositorySettings.Parse(repo.SettingsJson);
        return repo.Backend switch
        {
            BackupBackend.Local => s.Path ?? "–",
            BackupBackend.Sftp => "sftp: " + s.Path,
            BackupBackend.Rest => s.Endpoint + (string.IsNullOrEmpty(s.Path) ? "" : "/" + s.Path.Trim('/')),
            BackupBackend.S3 => s.Endpoint + "/" + s.Bucket + (string.IsNullOrEmpty(s.Path) ? "" : "/" + s.Path.Trim('/')),
            // The URL of the remaining backends holds no secret.
            _ => ResticBackend.BuildUrl(repo.Backend, s),
        };
    }

    private static string R(string key) => BackupViewModel.R(key);
}
