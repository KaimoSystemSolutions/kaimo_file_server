@using Kaimo_File_Server.Core.Domain
@using Kaimo_File_Server.Core.Domain.Backup
@using Kaimo_File_Server.Infrastructure.Backup.Restic
@using Kaimo_File_Server.Web.Components.Shared
@using Kaimo_File_Server.Web.Components.ViewModels.Backup
@using Kaimo_File_Server.Web.DynamicHelpers
@inherits AppComponentBase
@implements IDisposable
@inject BackupViewModel VM
@inject DateFormatService DateFmt

@* Backup jobs: list left, detail / editor right (shared workspace frame). *@

<div class="backup-toolbar">
    <p class="subtitle">@R("Web_Backup_Jobs_Help")</p>
    <button class="btn-primary" type="button" disabled="@(VM.IsReadOnlyDemo || (VM.SelectableShares.Count == 0 && !VM.Access.JobsUnrestricted))" @onclick="StartCreate">
        @R("Web_Backup_Jobs_Create")
    </button>
</div>

<div class="workspace">
    <section class="workspace-list" aria-label="@R("Web_Backup_Tab_Jobs")">
        <div class="workspace-list-header"><span>@R("Web_Backup_Tab_Jobs")</span></div>
        @if (VM.Jobs.Count == 0)
        {
            <div class="empty-state"><p>@R("Web_Backup_Jobs_Empty")</p></div>
        }
        @foreach (var view in VM.Jobs)
        {
            var job = view.Job;
            <button type="button" class="workspace-row @(_selectedId == job.Id && !_editing ? "workspace-row--selected" : "")"
                    aria-pressed="@(_selectedId == job.Id ? "true" : "false")" @onclick="() => Select(job.Id)">
                <span class="workspace-row-icon @BackupUi.JobIconClass">@Assets.SVG("history.svg", new SvgOptions(Width: 16, Height: 16))</span>
                <span class="workspace-row-text">
                    <strong>@job.Name</strong>
                    <small>@BackupUi.SourcesText(view) → @view.RepositoryName</small>
                </span>
                <StatusBadge Tone="@BackupUi.JobTone(job)" Label="@BackupUi.JobStatusLabel(job)" />
            </button>
        }
    </section>

    <aside class="workspace-detail" aria-label="@R("Web_Backup_Jobs_Detail")">
        @if (_editing)
        {
            var form = VM.JobForm;
            var repos = VM.UsableRepositoriesForForm;
            <div class="workspace-heading">
                <div>
                    <h3>@(form.Id is null ? R("Web_Backup_Jobs_Create") : R("Web_Backup_Jobs_Edit"))</h3>
                    <span class="workspace-heading-sub">@BackupUi.LevelLabel(form.ContentLevel)</span>
                </div>
                <label class="workspace-enabled">
                    <span class="toggle-switch">
                        <input type="checkbox" @bind="form.Enabled" aria-label="@R("Web_Backup_Enabled")" />
                        <span class="toggle-slider"></span>
                    </span>
                    <span>@R("Web_Backup_Enabled")</span>
                </label>
            </div>

            <div class="workspace-form">
                <label>
                    <span>@R("Web_Backup_Name")</span>
                    <input class="edit-input" maxlength="200" @bind="form.Name" @bind:event="oninput" />
                </label>
                @if (VM.Access.JobsUnrestricted)
                {
                    <div class="workspace-field">
                        <span id="backup-job-source-kind">@R("Web_Backup_Jobs_SourceKind")</span>
                        <div class="toggle-button-group" role="radiogroup" aria-labelledby="backup-job-source-kind">
                            @foreach (var kind in new[] { BackupSourceKind.Share, BackupSourceKind.Pool })
                            {
                                <button type="button" role="radio" aria-checked="@(form.SourceKind == kind ? "true" : "false")"
                                        class="toggle-btn @(form.SourceKind == kind ? "toggle-btn--active" : null)"
                                        @onclick="() => form.SourceKind = kind">@R("Web_Backup_Jobs_SourceKind_" + kind)</button>
                            }
                        </div>
                    </div>
                }
                @if (form.SourceKind == BackupSourceKind.Share)
                {
                    <div class="workspace-field">
                        <span>@R("Web_Backup_Jobs_Sources")</span>
                        <PrincipalPickerField Mode="SelectionMode.Multiple"
                                              Items='form.Shares.ToPickerItems(PrincipalKind.Share, s => s.Id, s => s.Name, s => s.Path)'
                                              SelectedIds="form.Shares.CheckedIds(s => s.Id)"
                                              SelectedIdsChanged="ids => form.Shares.ApplySelection(ids, s => s.Id)"
                                              Title="@R("Web_Backup_Jobs_Sources")"
                                              Placeholder="@(form.Shares.Count == 0 ? R("Web_Backup_Jobs_NoShares") : R("Web_Backup_Jobs_SourcesPlaceholder"))" />
                        <small>@R("Web_Backup_Jobs_SourcesHelp")</small>
                    </div>
                }
                else
                {
                    <div class="workspace-field">
                        <span>@R("Web_Backup_Jobs_Pools")</span>
                        <PrincipalPickerField Mode="SelectionMode.Multiple"
                                              Items="form.Pools.ToPoolItems(p => p.Item, p => BackupUi.PoolName(p.Item))"
                                              SelectedIds="form.Pools.CheckedIds(PrincipalPickerBindings.PoolId)"
                                              SelectedIdsChanged="ids => form.Pools.ApplySelection(ids, PrincipalPickerBindings.PoolId)"
                                              Title="@R("Web_Backup_Jobs_Pools")"
                                              Placeholder="@(form.Pools.Count == 0 ? R("Web_Backup_Jobs_NoPools") : R("Web_Backup_Jobs_PoolsPlaceholder"))" />
                        <small>@R("Web_Backup_Jobs_PoolsHelp")</small>
                    </div>
                    @if (form.SelectedPools.Any())
                    {
                        <div class="backup-pool-shares" role="group" aria-label="@R("Web_Backup_Jobs_PoolShares")">
                            <span class="backup-pool-shares-title">@R("Web_Backup_Jobs_PoolShares")</span>
                            @foreach (var pool in form.SelectedPools)
                            {
                                var names = VM.SharesInPool(pool);
                                <span class="backup-pool-shares-line">
                                    <strong>@BackupUi.PoolName(pool)</strong>
                                    <span>@(names.Count == 0 ? R("Web_Backup_Jobs_PoolNoShares") : string.Join(", ", names))</span>
                                </span>
                            }
                        </div>
                    }
                }
                @if (VM.Access.JobsUnrestricted)
                {
                    <label>
                        <span>@R("Web_Backup_Jobs_Content")</span>
                        <select class="edit-input" @bind="form.ContentLevel">
                            @foreach (var level in Enum.GetValues<BackupContentLevel>())
                            {
                                <option value="@level">@BackupUi.LevelLabel(level)</option>
                            }
                        </select>
                        <small>@R("Web_Backup_Level_" + form.ContentLevel + "_Help")</small>
                    </label>
                }
                <label>
                    <span>@R("Web_Backup_Repository")</span>
                    <select class="edit-input" @bind="form.RepositoryId">
                        <option value="@Guid.Empty">@R("Web_Backup_Select")</option>
                        @foreach (var repo in repos)
                        {
                            <option value="@repo.Id">@repo.Name (@BackupUi.BackendLabel(repo.Backend))</option>
                        }
                    </select>
                    @if (repos.Count == 0)
                    {
                        <small>@R("Web_Backup_Jobs_NoRepository")</small>
                    }
                </label>
                <div class="toggle-row">
                    <span>@R("Web_Backup_Jobs_IncludeRecycleBin")</span>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="form.IncludeRecycleBin" aria-label="@R("Web_Backup_Jobs_IncludeRecycleBin")" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>
                @if (VM.Access.JobsUnrestricted && form.SelectedPools.Any())
                {
                    var needsDatabase = form.ContentLevel == BackupContentLevel.Files;
                    <div class="toggle-row">
                        <span>
                            @R("Web_Backup_Jobs_IncludeVersions")
                            <small class="form-hint">@(needsDatabase ? R("Web_Backup_Jobs_IncludeVersionsNeedsDb") : R("Web_Backup_Jobs_IncludeVersionsHelp"))</small>
                        </span>
                        <label class="toggle-switch">
                            <input type="checkbox" checked="@(form.IncludeVersions && !needsDatabase)" disabled="@needsDatabase"
                                   aria-label="@R("Web_Backup_Jobs_IncludeVersions")" @onchange="e => form.IncludeVersions = e.Value is true" />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                }
            </div>

            <section class="workspace-section">
                <h4>@R("Web_Backup_Schedule")</h4>
                <p>@R("Web_Backup_Schedule_Help")</p>
                <BackupScheduleEditor Times="form.Times" Days="form.Days" />
            </section>

            <section class="workspace-section">
                <h4>@R("Web_Backup_Retention")</h4>
                <p>@R("Web_Backup_Retention_Help")</p>
                <div class="backup-retention">
                    <label>
                        <span>@R("Web_Backup_Retention_Last")</span>
                        <input class="edit-input" type="number" min="0" max="@BackupRetention.MaximumValue" @bind="form.KeepLast" />
                    </label>
                    <label>
                        <span>@R("Web_Backup_Retention_Daily")</span>
                        <input class="edit-input" type="number" min="0" max="@BackupRetention.MaximumValue" @bind="form.KeepDaily" />
                    </label>
                    <label>
                        <span>@R("Web_Backup_Retention_Weekly")</span>
                        <input class="edit-input" type="number" min="0" max="@BackupRetention.MaximumValue" @bind="form.KeepWeekly" />
                    </label>
                    <label>
                        <span>@R("Web_Backup_Retention_Monthly")</span>
                        <input class="edit-input" type="number" min="0" max="@BackupRetention.MaximumValue" @bind="form.KeepMonthly" />
                    </label>
                    <label>
                        <span>@R("Web_Backup_Retention_Yearly")</span>
                        <input class="edit-input" type="number" min="0" max="@BackupRetention.MaximumValue" @bind="form.KeepYearly" />
                    </label>
                </div>
                @if (form.ToRetention().IsEmpty)
                {
                    <p class="form-hint">@R("Web_Backup_Retention_KeepAllHint")</p>
                }
                <label class="workspace-field backup-alert-days">
                    <span class="backup-label-with-info">
                        @R("Web_Backup_AlertAfterDays")
                        <InfoButton Text="@R("Web_Backup_AlertAfterDaysHelp")" />
                    </span>
                    <input class="edit-input" type="number" min="0" max="@BackupCatalogService.MaximumAlertAfterDays" @bind="form.AlertAfterDays" />
                </label>
            </section>

            <div class="detail-actions">
                <button class="btn-secondary" type="button" disabled="@VM.IsBusy" @onclick="CancelEdit">@R("Web_Button_Cancel")</button>
                <button class="btn-primary" type="button" disabled="@(VM.IsBusy || !CanSave)" @onclick="SaveAsync">@R("Web_Backup_Save")</button>
            </div>
        }
        else if (Selected is { } view)
        {
            var job = view.Job;
            var active = VM.ActiveRuns.FirstOrDefault(r => r.JobId == job.Id);
            var hasPools = job.Sources.Any(s => s.Kind == BackupSourceKind.Pool);
            <DetailHeader Icon="history.svg" IconClass="@BackupUi.JobIconClass" Title="@job.Name" Subtitle="@view.RepositoryName">
                <Status>
                    <StatusBadge Tone="@BackupUi.JobTone(job)" Label="@BackupUi.JobStatusLabel(job)" />
                </Status>
                <Actions>
                    <button class="btn-tinted" type="button" disabled="@(VM.IsBusy || VM.IsReadOnlyDemo)" @onclick="() => StartEdit(view)">
                        @Assets.SVG("edit.svg", new SvgOptions(Width: 14, Height: 14))
                        <span>@R("Web_Backup_Edit")</span>
                    </button>
                    @if (active is not null)
                    {
                        <button class="btn-tinted btn-tinted--danger" type="button" disabled="@(VM.IsBusy || active.IsCancellationRequested)" @onclick="() => VM.CancelRunAsync(active.RunId)">
                            @Assets.SVG("close.svg", new SvgOptions(Width: 14, Height: 14))
                            <span>@R("Web_Jobs_Cancel")</span>
                        </button>
                    }
                    else
                    {
                        <button class="btn-tinted btn-tinted--info" type="button" disabled="@(VM.IsBusy || VM.IsReadOnlyDemo || !job.Enabled)"
                                title="@(job.Enabled ? null : R("Web_Backup_Disabled"))" @onclick="() => VM.RunNowAsync(job.Id)">
                            @Assets.SVG("play.svg", new SvgOptions(Width: 14, Height: 14))
                            <span>@R("Web_Backup_Jobs_RunNow")</span>
                        </button>
                    }
                </Actions>
                <MoreActions>
                    <MenuItem Icon="trash.svg" Label="@R("Web_Action_Delete")" Danger
                              Disabled="@(VM.IsBusy || VM.IsReadOnlyDemo)" OnClick="() => _confirmDelete = true" />
                </MoreActions>
            </DetailHeader>

            @if (active is not null)
            {
                <div class="detail-alerts">
                    <div class="backup-progress">
                        <div class="job-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@active.Progress">
                            <div class="job-progress-fill" style="width: @(active.Progress)%"></div>
                        </div>
                        <span class="form-hint">
                            @(active.IsCancellationRequested ? R("Web_Jobs_Cancelling")
                                : active.IsRunning ? string.Format(R("Web_Backup_Running"), active.Progress) + (active.Detail is null ? "" : " · " + active.Detail)
                                : R("Web_Backup_Queued"))
                        </span>
                    </div>
                </div>
            }

            <div class="fact-tiles">
                <FactTile Label="@R("Web_Backup_LastRun")" Value="@DateFmt.FormatDateTime(job.LastRunAtUtc, R("Web_Backup_Never"))" Compact
                          Tone="@(job.LastStatus is { } lastStatus ? BackupUi.RunTone(lastStatus) : StatusTone.Neutral)"
                          Tooltip="@(job.LastStatus is { } status ? BackupUi.RunStatusLabel(status) : null)" />
                <FactTile Label="@R("Web_Backup_LastSuccess")" Value="@DateFmt.FormatDateTime(job.LastSuccessAtUtc, R("Web_Backup_Never"))" Compact
                          Tone="@SuccessTone(job)"
                          Tooltip="@(SuccessTone(job) == StatusTone.Warning ? string.Format(R("Web_Backup_Jobs_SuccessOverdue"), BackupSchedulerService.EffectiveAlertDays(job)) : null)" />
                <FactTile Label="@R("Web_Backup_NextRun")" Value="@DateFmt.FormatDateTime(VM.NextRunUtc(job), R("Web_Backup_NoSchedule"))" Compact />
                <FactTile Label="@R("Web_Backup_Repository")" Value="@view.RepositoryName" Compact
                          OnLink="@(OnOpenRepository.HasDelegate ? EventCallback.Factory.Create(this, () => OnOpenRepository.InvokeAsync(job.RepositoryId)) : default)"
                          LinkLabel="@R("Web_Backup_Jobs_OpenRepository")" />
            </div>

            <DetailSection Title="@R("Web_Backup_Jobs_Section_Sources")">
                @if (view.Shares.Count > 0)
                {
                    <PropertyRow Label="@R("Web_Backup_Jobs_Sources")" Value="@string.Join(", ", view.Shares.Select(s => s.Name))" Entity />
                }
                @if (hasPools)
                {
                    <PropertyRow Label="@R("Web_Backup_Jobs_Pools")"
                                 Value="@string.Join(", ", job.Sources.Where(s => s.Kind == BackupSourceKind.Pool && s.PoolPath is not null).Select(s => BackupUi.PoolName(s.PoolPath!)))" Entity />
                    <PropertyRow Label="@R("Web_Backup_Jobs_PoolShares")"
                                 Value="@string.Join(", ", job.Sources.Where(s => s.Kind == BackupSourceKind.Pool && s.PoolPath is not null).SelectMany(s => VM.SharesInPool(s.PoolPath!)).Distinct())" Entity />
                }
                <PropertyRow Label="@R("Web_Backup_Jobs_Content")" Value="@BackupUi.LevelLabel(job.ContentLevel)" />
                @if (hasPools)
                {
                    <PropertyRow Label="@R("Web_Backup_Jobs_IncludeVersions")" Value="@(BackupJobExecutor.IncludesVersions(job) ? R("Web_Common_Yes") : R("Web_Common_No"))" />
                }
                <PropertyRow Label="@R("Web_Backup_Jobs_IncludeRecycleBin")" Value="@(job.IncludeRecycleBin ? R("Web_Common_Yes") : R("Web_Common_No"))" />
            </DetailSection>

            <DetailSection Title="@R("Web_Backup_Jobs_Section_Schedule")">
                <PropertyRow Label="@R("Web_Backup_Schedule")" Value="@BackupUi.ScheduleText(job.Schedule, DateFmt.FormatTime)" />
                <PropertyRow Label="@R("Web_Backup_Retention")" Value="@BackupUi.RetentionText(job.Retention)" />
                <PropertyRow Label="@R("Web_Backup_AlertAfterDays")" Value="@(job.AlertAfterDays > 0 ? string.Format(R("Web_Backup_AlertAfterDaysValue"), job.AlertAfterDays) : R("Web_Backup_AlertOff"))" />
            </DetailSection>

            @if (_confirmDelete)
            {
                <div class="modal-backdrop" @onclick="() => _confirmDelete = false">
                    <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="backup-job-delete-title" @onclick:stopPropagation="true">
                        <h2 class="modal-title" id="backup-job-delete-title">@string.Format(R("Web_Backup_Jobs_DeleteTitle"), job.Name)</h2>
                        <p class="modal-text">@R("Web_Backup_Jobs_DeleteHint")</p>
                        <div class="modal-actions">
                            <button type="button" class="btn-secondary" @onclick="() => _confirmDelete = false">@R("Web_Button_Cancel")</button>
                            <button type="button" class="btn-danger" disabled="@VM.IsBusy" @onclick="() => DeleteAsync(job.Id)">@R("Web_Backup_ConfirmDelete")</button>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="detail-empty"><p>@R("Web_Backup_Jobs_SelectHint")</p></div>
        }
    </aside>
</div>

@code {
    // Results and runner progress are announced by the view model; the page does not
    // re-render this component on its own.
    protected override void OnInitialized() => VM.Changed += Refresh;
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => VM.Changed -= Refresh;

    [Parameter] public Guid? SelectedJobId { get; set; }

    /// <summary>Opens a repository on its tab; the repository tile shows no link without it.</summary>
    [Parameter] public EventCallback<Guid> OnOpenRepository { get; set; }

    private Guid? _selectedId;
    private bool _editing;
    private bool _confirmDelete;

    protected override void OnParametersSet()
    {
        if (SelectedJobId is not null)
            _selectedId = SelectedJobId;
    }

    private BackupJobView? Selected => VM.Jobs.FirstOrDefault(j => j.Job.Id == _selectedId);

    private bool CanSave => !string.IsNullOrWhiteSpace(VM.JobForm.Name)
                            && VM.JobForm.HasSources
                            && VM.JobForm.RepositoryId != Guid.Empty;

    private void Select(Guid id)
    {
        _selectedId = id;
        _editing = false;
        _confirmDelete = false;
    }

    private void StartCreate()
    {
        VM.NewJob();
        _editing = true;
        _confirmDelete = false;
    }

    private void StartEdit(BackupJobView view)
    {
        VM.EditJob(view);
        _editing = true;
        _confirmDelete = false;
    }

    private void CancelEdit() => _editing = false;

    private async Task SaveAsync()
    {
        if (await VM.SaveJobAsync())
        {
            _selectedId = VM.JobForm.Id;
            _editing = false;
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        if (await VM.DeleteJobAsync(id))
            _selectedId = null;
        _confirmDelete = false;
    }

    // Warning when the scheduler counts the job as overdue; negative when runs never
    // succeeded, neutral before the first run.
    private static StatusTone SuccessTone(BackupJob job)
        => BackupSchedulerService.IsStale(job, DateTime.UtcNow) ? StatusTone.Warning
            : job.LastSuccessAtUtc is not null ? StatusTone.Positive
            : job.LastRunAtUtc is null ? StatusTone.Neutral
            : StatusTone.Negative;

    private static string R(string key) => BackupViewModel.R(key);
}
