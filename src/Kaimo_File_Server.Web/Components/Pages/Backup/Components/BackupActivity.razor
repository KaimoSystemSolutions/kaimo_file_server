@using System.Text.Json
@using Kaimo_File_Server.Core.Domain.Backup
@using Kaimo_File_Server.Core.Services.Notifications
@using Kaimo_File_Server.Infrastructure.Backup.Restic
@using Kaimo_File_Server.Web.Components.Shared
@using Kaimo_File_Server.Web.Components.ViewModels.Backup
@using Kaimo_File_Server.Web.DynamicHelpers
@inherits AppComponentBase
@implements IDisposable
@inject BackupViewModel VM
@inject DateFormatService DateFmt

@* Activity: every restic operation (backup, init, …) with its outcome; doubles as audit log. *@

<div class="workspace">
    <section class="workspace-list" aria-label="@R("Web_Backup_Tab_Activity")">
        <div class="workspace-list-header">
            <span>@R("Web_Backup_Tab_Activity")</span>
            <button type="button" class="btn-secondary btn-secondary--sm" disabled="@VM.IsBusy" @onclick="VM.ReloadAsync">@R("Web_Backup_Refresh")</button>
        </div>
        @if (VM.Runs.Count == 0)
        {
            <div class="empty-state"><p>@R("Web_Backup_Activity_Empty")</p></div>
        }
        @foreach (var run in VM.Runs)
        {
            <button type="button" class="workspace-row @(_selectedId == run.Id ? "workspace-row--selected" : "")"
                    aria-pressed="@(_selectedId == run.Id ? "true" : "false")" @onclick="() => _selectedId = run.Id">
                <span class="workspace-row-text">
                    <strong>@BackupUi.RunTypeLabel(run.Type) · @RunSubject(run)</strong>
                    <small>@DateFmt.FormatDateTime(run.StartedAtUtc ?? run.QueuedAtUtc) · @BackupUi.TriggerLabel(run.Trigger)</small>
                </span>
                <StatusBadge Tone="@BackupUi.RunTone(run.Status)" Label="@BackupUi.RunStatusLabel(run.Status)" />
            </button>
        }
    </section>

    <aside class="workspace-detail" aria-label="@R("Web_Backup_Activity_Detail")">
        @if (Selected is { } current)
        {
            var failed = !string.IsNullOrEmpty(current.ErrorCode);
            <DetailHeader Icon="@RunIcon(current.Type)" Title="@BackupUi.RunTypeLabel(current.Type)" Subtitle="@RunSubject(current)">
                <Status>
                    <StatusBadge Tone="@BackupUi.RunTone(current.Status)" Label="@BackupUi.RunStatusLabel(current.Status)" />
                </Status>
            </DetailHeader>

            @if (failed || current.WarningCount > 0)
            {
                <div class="detail-alerts">
                    @if (failed)
                    {
                        <div class="error-banner" role="alert"><strong>@R("Web_Backup_LastError"):</strong> @BackupViewModel.ErrorText(current.ErrorCode)</div>
                    }
                    @if (current.WarningCount > 0)
                    {
                        <div class="warning-banner" role="status">@string.Format(R("Web_Backup_Activity_SourceWarnings"), current.WarningCount)</div>
                    }
                </div>
            }

            <div class="fact-tiles">
                <FactTile Label="@R("Web_Backup_Activity_Started")" Value="@DateFmt.FormatDateTime(current.StartedAtUtc ?? current.QueuedAtUtc)" Compact />
                <FactTile Label="@R("Web_Backup_Activity_Duration")" Value="@Duration(current)" Compact />
                @if (current.JobId is { } jobId)
                {
                    <FactTile Label="@R("Web_Backup_Activity_Job")" Value="@VM.JobName(jobId)" Compact
                              OnLink="@(OnOpenJob.HasDelegate ? EventCallback.Factory.Create(this, () => OnOpenJob.InvokeAsync(jobId)) : default)"
                              LinkLabel="@R("Web_Backup_Activity_OpenJob")" />
                }
                <FactTile Label="@R("Web_Backup_Repository")" Value="@VM.RepositoryName(current.RepositoryId)" Compact
                          OnLink="@(OnOpenRepository.HasDelegate ? EventCallback.Factory.Create(this, () => OnOpenRepository.InvokeAsync(current.RepositoryId)) : default)"
                          LinkLabel="@R("Web_Backup_Jobs_OpenRepository")" />
            </div>

            <DetailSection Title="@R("Web_Backup_Activity_Section_Run")">
                <PropertyRow Label="@R("Web_Backup_Activity_Trigger")" Value="@BackupUi.TriggerLabel(current.Trigger)" />
                <PropertyRow Label="@R("Web_Backup_Activity_Finished")" Value="@DateFmt.FormatDateTime(current.FinishedAtUtc)" />
                @if (current.Type == BackupRunType.Backup)
                {
                    <PropertyRow Label="@R("Web_Backup_Activity_Files")" Value="@string.Format(R("Web_Backup_Activity_FilesValue"), current.FilesNew, current.FilesChanged, current.FilesUnmodified)" />
                    <PropertyRow Label="@R("Web_Backup_Activity_Data")" Value="@string.Format(R("Web_Backup_Activity_DataValue"), NotificationEvents.FormatSize(current.BytesAdded), NotificationEvents.FormatSize(current.BytesProcessed))" />
                }
            </DetailSection>

            @if (Sources(current) is { Count: > 0 } sources)
            {
                <DetailSection Title="@R("Web_Backup_Activity_Sources")">
                    @foreach (var source in sources)
                    {
                        var tone = source.ErrorCode is not null ? "negative" : source.WarningCount > 0 ? "warning" : "positive";
                        <PropertyRow Label="@BackupUi.SourceName(source.Name)">
                            <span class="backup-source-state backup-source-state--@tone">
                                @(source.ErrorCode is not null ? BackupViewModel.ErrorText(source.ErrorCode)
                                    : source.WarningCount > 0 ? string.Format(R("Web_Backup_Activity_SourceWarnings"), source.WarningCount)
                                    : string.Format(R("Web_Backup_Activity_Snapshot"), source.SnapshotId?[..Math.Min(8, source.SnapshotId.Length)]))
                            </span>
                            @if (source.Warnings.Count > 0)
                            {
                                <details class="backup-details">
                                    <summary>@R("Web_Backup_Activity_ShowWarnings")</summary>
                                    <ul>
                                        @foreach (var warning in source.Warnings)
                                        {
                                            <li><code>@warning</code></li>
                                        }
                                    </ul>
                                </details>
                            }
                        </PropertyRow>
                    }
                </DetailSection>
            }

            @if (current.Type == BackupRunType.Restore && BackupRestoreDetails.TryParse(current.DetailsJson) is { } restore)
            {
                var request = restore.Request;
                var result = restore.Result;
                <DetailSection Title="@R("Web_Backup_Activity_Restore")">
                    <ChildContent>
                        <PropertyRow Label="@R("Web_Backup_Restore_Mode")"
                                     Value="@(R("Web_Backup_Restore_Mode_" + request.Mode) + (request.Mode == BackupRestoreMode.InPlace ? " · " + R("Web_Backup_Restore_Conflict_" + request.Conflict) : ""))" />
                        <PropertyRow Label="@R("Web_Backup_Activity_RestoreSource")"
                                     Value="@(SharePath(result?.SourceShareName, request.FolderPath) + (request.Items.Count == 0 ? "" : " · " + string.Join(", ", request.Items)))" Mono />
                        @if (result is not null && request.Mode != BackupRestoreMode.Download)
                        {
                            <PropertyRow Label="@R("Web_Backup_Activity_RestoreTarget")" Value="@SharePath(result.DestinationShareName, result.DestinationPath)" Mono />
                            <PropertyRow Label="@R("Web_Backup_Activity_Files")" Value="@string.Format(R("Web_Backup_Activity_RestoreFilesValue"), result.FilesRestored, NotificationEvents.FormatSize(result.BytesRestored))" />
                            @if (request.Mode == BackupRestoreMode.InPlace)
                            {
                                <PropertyRow Label="@R("Web_Backup_Activity_RestoreConflicts")"
                                             Value="@string.Format(R("Web_Backup_Activity_RestoreConflictsValue"), result.Overwritten, result.VersionsCreated, result.Unchanged, result.Skipped, result.Renamed)" />
                            }
                            <PropertyRow Label="@R("Web_Backup_Restore_Permissions")"
                                         Value="@(request.RestorePermissions || result.AclEntriesApplied > 0 ? string.Format(R("Web_Backup_Activity_RestoreAclValue"), result.AclEntriesApplied) : R("Web_Common_No"))" />
                        }
                    </ChildContent>
                    <Body>
                        @if (result is { SkippedPrincipals.Count: > 0 })
                        {
                            <details class="backup-details">
                                <summary>@string.Format(R("Web_Backup_Activity_SkippedPrincipals"), result.SkippedPrincipals.Count)</summary>
                                <ul>
                                    @foreach (var principal in result.SkippedPrincipals)
                                    {
                                        <li>@(principal.Name ?? "?") <code>@principal.Id</code></li>
                                    }
                                </ul>
                            </details>
                        }
                        @if (result is { SkippedItems.Count: > 0 })
                        {
                            <details class="backup-details">
                                <summary>@string.Format(R("Web_Backup_Activity_SkippedItems"), result.SkippedItems.Count)</summary>
                                <ul>
                                    @foreach (var item in result.SkippedItems)
                                    {
                                        <li><code>@item</code></li>
                                    }
                                </ul>
                            </details>
                        }
                    </Body>
                </DetailSection>
            }

            @* Prune records no details; it shows only the common fields above. *@
            @if (current.Type is BackupRunType.Forget or BackupRunType.Check or BackupRunType.TestRestore or BackupRunType.Copy
                 && BackupMaintenanceDetails.TryParse(current.DetailsJson) is { } maintenance)
            {
                <DetailSection Title="@R("Web_Backup_Activity_Section_Result")">
                    <ChildContent>
                        @if (maintenance.SnapshotsRemoved is { } removed)
                        {
                            <PropertyRow Label="@R("Web_Backup_Activity_Forgotten")" Value="@string.Format(R("Web_Backup_Activity_ForgottenValue"), removed, maintenance.JobsApplied ?? 0)" />
                        }
                        @if (current.Type == BackupRunType.Check)
                        {
                            <PropertyRow Label="@R("Web_Backup_Activity_ReadData")" Value="@(maintenance.ReadDataSubset ?? R("Web_Common_No"))" />
                        }
                        @if (maintenance.FilesVerified is { } verified)
                        {
                            <PropertyRow Label="@R("Web_Backup_Activity_TestRestore")"
                                         Value="@string.Format(R("Web_Backup_Activity_TestRestoreValue"), verified, maintenance.FilesChanged ?? 0, maintenance.Mismatches?.Count ?? 0)" />
                        }
                        @if (maintenance.DatabaseDumpOk is { } dumpOk)
                        {
                            <PropertyRow Label="@R("Web_Backup_Activity_DumpCheck")" Value="@(dumpOk ? R("Web_Backup_Activity_DumpOk") : R("Web_Backup_Activity_DumpBroken"))" />
                        }
                        @if (maintenance.MirrorName is { } mirror)
                        {
                            <PropertyRow Label="@R("Web_Backup_Maintenance_Mirror")"
                                         Value="@(mirror + (maintenance.SnapshotsCopied is { } copied ? " · " + string.Format(R("Web_Backup_Activity_CopiedValue"), copied) : ""))" Entity />
                        }
                    </ChildContent>
                    <Body>
                        @if (maintenance.CheckErrors is { Count: > 0 } errors)
                        {
                            <details class="backup-details">
                                <summary>@string.Format(R("Web_Backup_Activity_CheckErrors"), errors.Count)</summary>
                                <ul>
                                    @foreach (var error in errors)
                                    {
                                        <li><code>@error</code></li>
                                    }
                                </ul>
                            </details>
                        }
                        @if (maintenance.Mismatches is { Count: > 0 } mismatches)
                        {
                            <details class="backup-details" open>
                                <summary>@string.Format(R("Web_Backup_Activity_Mismatches"), mismatches.Count)</summary>
                                <ul>
                                    @foreach (var file in mismatches)
                                    {
                                        <li><code>@file</code></li>
                                    }
                                </ul>
                            </details>
                        }
                    </Body>
                </DetailSection>
            }

            @if (!string.IsNullOrWhiteSpace(current.LogExcerpt))
            {
                @* Mostly needed to diagnose a failure; otherwise it starts closed. *@
                <DetailSection Title="@R("Web_Backup_Activity_Log")" InitiallyCollapsed="@(!failed)">
                    <Body>
                        <pre class="backup-log">@current.LogExcerpt</pre>
                    </Body>
                </DetailSection>
            }
        }
        else
        {
            <div class="detail-empty"><p>@R("Web_Backup_Activity_SelectHint")</p></div>
        }
    </aside>
</div>

@code {
    // Results and runner progress are announced by the view model; the page does not
    // re-render this component on its own.
    protected override void OnInitialized() => VM.Changed += Refresh;
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => VM.Changed -= Refresh;

    /// <summary>Opens a job on its tab; the job tile shows no link without it.</summary>
    [Parameter] public EventCallback<Guid> OnOpenJob { get; set; }

    /// <summary>Opens a repository on its tab; the repository tile shows no link without it.</summary>
    [Parameter] public EventCallback<Guid> OnOpenRepository { get; set; }

    private Guid? _selectedId;

    private BackupRun? Selected => VM.Runs.FirstOrDefault(r => r.Id == _selectedId);

    private sealed record DetailsDto(List<BackupSourceOutcome>? Sources);

    private static List<BackupSourceOutcome> Sources(BackupRun run)
    {
        if (string.IsNullOrWhiteSpace(run.DetailsJson))
            return [];
        try
        {
            return JsonSerializer.Deserialize<DetailsDto>(run.DetailsJson, new JsonSerializerOptions(JsonSerializerDefaults.Web))?.Sources ?? [];
        }
        catch (JsonException)
        {
            return [];
        }
    }

    /// <summary>Restores name their source ("share/folder"), jobs their job, the rest their repository.</summary>
    private string RunSubject(BackupRun run)
        => run.Type == BackupRunType.Restore && BackupRestoreDetails.TryParse(run.DetailsJson) is { } restore
            ? SharePath(restore.Result?.SourceShareName, restore.Request.FolderPath)
            : run.JobId is null ? VM.RepositoryName(run.RepositoryId) : VM.JobName(run.JobId);

    // The share name is only recorded once the run started; a queued restore shows its folder.
    private static string SharePath(string? share, string? path)
        => string.Join("/", new[] { share, path }.Where(p => !string.IsNullOrEmpty(p))) is { Length: > 0 } text ? text : "–";

    private static string RunIcon(BackupRunType type) => type switch
    {
        BackupRunType.Backup => "upload.svg",
        BackupRunType.Restore => "cloud-download.svg",
        BackupRunType.Check or BackupRunType.TestRestore => "shield.svg",
        BackupRunType.Copy => "copy.svg",
        BackupRunType.Forget or BackupRunType.Prune => "trash.svg",
        _ => "archive.svg",
    };

    // Queued or still running runs have no duration yet.
    private static string? Duration(BackupRun run)
    {
        if (run.StartedAtUtc is not { } started || run.FinishedAtUtc is not { } finished)
            return null;
        var span = finished - started;
        return span.TotalHours >= 1 ? $"{(int)span.TotalHours} h {span.Minutes} min"
            : span.TotalMinutes >= 1 ? $"{span.Minutes} min {span.Seconds} s"
            : $"{Math.Max(0, span.Seconds)} s";
    }

    private static string R(string key) => BackupViewModel.R(key);
}
