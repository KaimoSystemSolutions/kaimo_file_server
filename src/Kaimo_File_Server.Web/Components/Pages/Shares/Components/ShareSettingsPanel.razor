@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Core.Helpers

@if (VM.EditSuccessMessage is not null)
{
    <div class="success-banner">@VM.EditSuccessMessage</div>
}
@if (VM.EditErrorMessage is not null)
{
    <div class="error-banner">@VM.EditErrorMessage</div>
}

@if (VM.SelectedShare is not null)
{
    var isReadOnly = VM.IsSelectedShareReadOnly;

    <div class="detail-section">
        <span class="detail-label">@Resources.Web_ShareList_Label_Name</span>
        <div class="detail-rename-row">
            <input class="edit-input" type="text" @bind="VM.EditShareName" @bind:event="oninput"
                   disabled="@(isReadOnly || VM.IsRenaming)" />
            <button class="btn-primary" @onclick="RenameShare"
                    disabled="@(isReadOnly || VM.EditShareName.Trim() == VM.SelectedShare.Name || VM.IsRenaming)">
                @(VM.IsRenaming ? "…" : Resources.Web_Action_Rename)
            </button>
        </div>
    </div>

    <div class="detail-section">
        <span class="detail-label">@Resources.Web_ShareList_Label_Path</span>
        <span class="detail-value">@VM.SelectedShare.Path</span>
    </div>

    <div class="detail-section">
        <span class="detail-label">@Resources.Web_ShareList_Label_StoragePool</span>
        <div class="detail-value-row">
            <select class="edit-input"
                    @bind="VM.EditSharePoolPath"
                    disabled="@(isReadOnly || VM.IsMovingPool)">
                @if (VM.GetPoolNameForShare(VM.SelectedShare) is null)
                {
                    <option value="@VM.EditSharePoolPath">
                        @Resources.Web_ShareList_StoragePoolUnconfigured
                    </option>
                }
                @foreach (var pool in VM.StoragePools)
                {
                    <option value="@pool.Path">@pool.Name — @pool.Path</option>
                }
            </select>
            <button class="btn-primary"
                    @onclick="ChangeStoragePool"
                    disabled="@(isReadOnly || VM.IsMovingPool)">
                @(VM.IsMovingPool ? "…" : Resources.Web_ShareList_Action_MovePool)
            </button>
        </div>
    </div>

    @if (VM.Departments.Count > 0)
    {
        <div class="detail-section">
            <span class="detail-label">@Resources.Web_ShareList_Label_Department</span>
            <PrincipalPickerField Mode="SelectionMode.Single"
                                  Items="VM.Departments.ToDepartmentItems()"
                                  SelectedIds="VM.EditShareDepartmentId.AsSelection()"
                                  SelectedIdsChanged="ids => VM.EditShareDepartmentId =
                                      ids.FirstOrNull() ?? WellKnownGUIDs.DEPARTMENT_GLOBAL"
                                  AllowClear="false"
                                  Title="@Resources.Web_ShareList_Label_Department" />

            @if (!VM.ShowDepartmentConfirm)
            {
                <button class="btn-primary department-change-button"
                        @onclick="() => VM.ShowDepartmentConfirm = true"
                        disabled="@(isReadOnly || VM.EditShareDepartmentId == VM.SelectedShare.DepartmentId)">
                    @Resources.Web_ShareList_Action_ChangeDepartment
                </button>
            }
            else
            {
                <div class="confirm-delete">
                    <p>@Resources.Web_ShareList_DepartmentChangeWarning</p>
                    <div class="delete-actions">
                        <button class="btn-primary" disabled="@isReadOnly"
                                @onclick="ChangeDepartment">@Resources.Web_ShareList_Action_ChangeDepartmentConfirm</button>
                        <button class="btn-secondary"
                                @onclick="() => VM.ShowDepartmentConfirm = false">@Resources.Web_Button_Cancel</button>
                    </div>
                </div>
            }
        </div>
    }

    <div class="detail-section">
        <span class="detail-label">@Resources.Web_ShareList_Label_Status</span>
        <div class="detail-value-row">
            <label class="toggle-switch" title="@(VM.SelectedShare.IsEnabled ? Resources.Web_ShareList_Action_Disable : Resources.Web_ShareList_Action_Enable)">
                <input type="checkbox" checked="@VM.SelectedShare.IsEnabled" disabled="@isReadOnly" @onchange="ToggleShareEnabled" />
                <span class="toggle-slider"></span>
            </label>
            <span class="detail-value">@(VM.SelectedShare.IsEnabled ? Resources.Web_ShareList_Status_Active : Resources.Web_ShareList_Status_Disabled)</span>
        </div>
    </div>

    <div class="detail-section">
        <span class="detail-label">@Resources.Web_ShareList_Label_RecycleBin</span>
        <div class="detail-value-row">
            <label class="toggle-switch" title="@(VM.SelectedShare.IsRecycleEnabled ? Resources.Web_ShareList_Action_Disable : Resources.Web_ShareList_Action_Enable)">
                <input type="checkbox" checked="@VM.SelectedShare.IsRecycleEnabled" disabled="@isReadOnly" @onchange="ToggleRecycleEnabled" />
                <span class="toggle-slider"></span>
            </label>
            <span class="detail-value">@(VM.SelectedShare.IsRecycleEnabled ? Resources.Web_ShareList_Status_Active : Resources.Web_ShareList_Status_Disabled)</span>
        </div>
    </div>

    <div class="detail-actions">
        @if (!VM.ShowDeleteConfirm)
        {
            <button class="btn-danger-outline" disabled="@isReadOnly"
                    @onclick="() => VM.ShowDeleteConfirm = true">@Resources.Web_ShareList_DeleteShare</button>
        }
        else
        {
            <div class="confirm-delete">
                <p>@string.Format(Resources.Web_ShareList_DeleteConfirm, VM.SelectedShare.Name)</p>
                <div class="delete-actions">
                    <button class="btn-danger-outline" disabled="@isReadOnly"
                            @onclick="DeleteShare">@Resources.Web_ShareList_DeletePermanently</button>
                    <button class="btn-secondary" @onclick="() => VM.ShowDeleteConfirm = false">@Resources.Web_Button_Cancel</button>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public ShareListViewModel VM { get; set; } = default!;
    [Parameter] public EventCallback OnDeleted { get; set; }
    // Raised after an edit so the parent can re-render the overview list in sync.
    [Parameter] public EventCallback OnChanged { get; set; }

    private async Task RenameShare() { await VM.RenameShareAsync(); await OnChanged.InvokeAsync(); }
    private async Task ChangeStoragePool() { await VM.ChangeStoragePoolAsync(); await OnChanged.InvokeAsync(); }
    private async Task ToggleShareEnabled() { await VM.ToggleShareEnabledAsync(); await OnChanged.InvokeAsync(); }
    private async Task ToggleRecycleEnabled() { await VM.ToggleRecycleEnabledAsync(); await OnChanged.InvokeAsync(); }
    private async Task ChangeDepartment() { await VM.ChangeDepartmentAsync(); await OnChanged.InvokeAsync(); }

    private async Task DeleteShare()
    {
        await VM.DeleteShareAsync();
        await OnDeleted.InvokeAsync();
    }
}
