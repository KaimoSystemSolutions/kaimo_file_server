@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Core.Helpers

@* Additional share settings ("Zusatz"): department, storage pool, availability status,
   visibility and recycle-bin limits. Split out of the general settings panel so the general tab keeps only
   the share identity (name, path) and its destructive action. *@

@if (VM.EditSuccessMessage is not null)
{
    <div class="success-banner">@VM.EditSuccessMessage</div>
}
@if (VM.EditErrorMessage is not null)
{
    <div class="error-banner">@VM.EditErrorMessage</div>
}

@if (VM.SelectedShare is not null)
{
    var isReadOnly = VM.IsSelectedShareReadOnly;

    <div class="detail-section">
        <span class="detail-label label-with-info">
            @Resources.Web_ShareList_Label_StoragePool
            <InfoButton Text="@(Resources.ResourceManager.GetString("Web_ShareList_MovePoolHint") ?? "The share is unavailable on all access paths while the move runs.")" />
        </span>
        <div class="detail-value-row">
            @{
                // A share outside every configured pool keeps its current folder as a choice.
                var pools = VM.StoragePools.Select(p => (p.Path, p.Name)).ToList();
                if (VM.GetPoolNameForShare(VM.SelectedShare) is null && !string.IsNullOrEmpty(VM.EditSharePoolPath))
                    pools.Insert(0, (VM.EditSharePoolPath, Resources.Web_ShareList_StoragePoolUnconfigured));
            }
            <PrincipalPickerField Mode="SelectionMode.Single"
                                  Items="pools.ToPoolItems(p => p.Path, p => p.Name)"
                                  SelectedIds="VM.EditSharePoolPath.AsPoolSelection()"
                                  SelectedIdsChanged="ids => VM.EditSharePoolPath =
                                      pools.Select(p => p.Path).PoolPathFor(ids) ?? VM.EditSharePoolPath"
                                  AllowClear="false"
                                  Disabled="@(isReadOnly || VM.IsMovingPool)"
                                  Title="@Resources.Web_ShareList_Label_StoragePool" />
            <button class="btn-primary"
                    @onclick="ChangeStoragePool"
                    disabled="@(isReadOnly || VM.IsMovingPool)">
                @(VM.IsMovingPool ? "…" : Resources.Web_ShareList_Action_MovePool)
            </button>
        </div>
    </div>

    @if (VM.Departments.Count > 0)
    {
        <div class="extra-group-divider"></div>
        <div class="detail-section">
            <span class="detail-label">@Resources.Web_ShareList_Label_Department</span>
            <PrincipalPickerField Mode="SelectionMode.Single"
                                  Items="VM.ShareTargetDepartments.ToDepartmentItems()"
                                  SelectedIds="VM.EditShareDepartmentId.AsSelection()"
                                  SelectedIdsChanged="ids => VM.EditShareDepartmentId =
                                      ids.FirstOrNull() ?? WellKnownGUIDs.DEPARTMENT_GLOBAL"
                                  AllowClear="false"
                                  Title="@Resources.Web_ShareList_Label_Department" />

            @if (!VM.ShowDepartmentConfirm)
            {
                <button class="btn-primary department-change-button"
                        @onclick="() => VM.ShowDepartmentConfirm = true"
                        disabled="@(isReadOnly || !VM.CanChangeSelectedShareDepartment
                                    || VM.EditShareDepartmentId == VM.SelectedShare.DepartmentId)">
                    @Resources.Web_ShareList_Action_ChangeDepartment
                </button>
            }
            else
            {
                <div class="confirm-delete">
                    <p>@Resources.Web_ShareList_DepartmentChangeWarning</p>
                    <div class="delete-actions">
                        <button class="btn-primary" disabled="@isReadOnly"
                                @onclick="ChangeDepartment">@Resources.Web_ShareList_Action_ChangeDepartmentConfirm</button>
                        <button class="btn-secondary"
                                @onclick="() => VM.ShowDepartmentConfirm = false">@Resources.Web_Button_Cancel</button>
                    </div>
                </div>
            }
        </div>
    }

    <div class="extra-group-divider"></div>
    <div class="detail-section">
        <span class="detail-label">@Resources.Web_ShareList_Label_Status</span>
        <div class="detail-value-row">
            <label class="toggle-switch" title="@(VM.SelectedShare.IsEnabled ? Resources.Web_ShareList_Action_Disable : Resources.Web_ShareList_Action_Enable)">
                <input type="checkbox" checked="@VM.SelectedShare.IsEnabled" disabled="@isReadOnly" @onchange="ToggleShareEnabled" />
                <span class="toggle-slider"></span>
            </label>
            <span class="detail-value">@(VM.SelectedShare.IsEnabled ? Resources.Web_ShareList_Status_Active : Resources.Web_ShareList_Status_Disabled)</span>
        </div>
    </div>

    <div class="detail-section">
        <span class="detail-label">@Resources.Web_ShareList_VisibilityHeader</span>
        <p class="share-help-text">@Resources.Web_ShareList_VisibilityDescription</p>
        <div class="detail-value-row">
            <label class="toggle-switch" title="@(VM.SelectedShare.IsShareHidden ? Resources.Web_ShareList_Action_Disable : Resources.Web_ShareList_Action_Enable)">
                <input type="checkbox" checked="@VM.SelectedShare.IsShareHidden" disabled="@isReadOnly" @onchange="ToggleShareHidden" />
                <span class="toggle-slider"></span>
            </label>
            <span class="detail-value">@(VM.SelectedShare.IsShareHidden ? Resources.Web_ShareList_Status_Active : Resources.Web_ShareList_Status_Disabled)</span>
        </div>
    </div>

    @if (VM.SelectedShare.IsRecycleEnabled)
    {
        <div class="extra-group-divider"></div>
        <div class="detail-section">
            <span class="detail-label">@(Resources.ResourceManager.GetString("Web_Recycle_LimitsLabel") ?? "Recycle bin limits")</span>
            <RecycleLimitFields Value="VM.SelectedShare.GetRecycleLimits()"
                                GlobalMaxSizeBytes="VM.GlobalRecycleMaxSizeBytes"
                                Disabled="isReadOnly"
                                OnSave="SaveRecycleLimits" />
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public ShareListViewModel VM { get; set; } = default!;
    // Raised after an edit so the parent can re-render the overview list in sync.
    [Parameter] public EventCallback OnChanged { get; set; }

    private async Task ChangeStoragePool() { await VM.ChangeStoragePoolAsync(); await OnChanged.InvokeAsync(); }
    private async Task ChangeDepartment() { await VM.ChangeDepartmentAsync(); await OnChanged.InvokeAsync(); }
    private async Task ToggleShareEnabled() { await VM.ToggleShareEnabledAsync(); await OnChanged.InvokeAsync(); }
    private async Task SaveRecycleLimits(Kaimo_File_Server.Core.Domain.RecycleLimits limits) { await VM.SaveRecycleLimitsAsync(limits); await OnChanged.InvokeAsync(); }
    private async Task ToggleShareHidden() { await VM.ToggleShareHiddenAsync(); await OnChanged.InvokeAsync(); }
}
