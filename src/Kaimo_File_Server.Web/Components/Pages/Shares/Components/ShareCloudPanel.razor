@using Kaimo_File_Server.Core.Language
@inject NavigationManager Navigation

<div class="detail-section">
    <span class="detail-label">@Text("Web_Nav_CloudSync", "Cloud Sync")</span>
    <p class="share-help-text">
        @Text("Web_CloudSync_SharePanel_Help", "Manage this share's local and remote folder mappings in the central cloud-sync workspace.")
    </p>
    <span class="detail-value">
        @string.Format(
            Text("Web_CloudSync_SharePanel_Count", "Configured syncs: {0}"),
            VM.SelectedShare?.CloudSettings.Folders.Count ?? 0)
    </span>
</div>

<div class="detail-actions">
    <button class="btn-primary" type="button" @onclick="OpenCloudSync">
        @Text("Web_CloudSync_SharePanel_Open", "Open cloud-sync management")
    </button>
</div>

@code {
    [Parameter, EditorRequired] public ShareListViewModel VM { get; set; } = default!;

    private void OpenCloudSync()
    {
        if (VM.SelectedShare is null)
            return;

        Navigation.NavigateTo("/external-storage?tab=syncs");
    }

    private static string Text(string key, string fallback)
        => Resources.ResourceManager.GetString(key) ?? fallback;
}
