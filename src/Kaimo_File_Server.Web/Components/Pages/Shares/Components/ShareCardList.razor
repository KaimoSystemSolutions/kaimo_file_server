@using Kaimo_File_Server.Core.Domain
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Web.DynamicHelpers
@inject AssetProvider Icons

<div class="share-table @(ShowExtendedInfo ? "share-table--extended" : "share-table--compact")"
     role="listbox"
     aria-label="@Resources.Web_Nav_Shares">
    <div class="share-table-header" aria-hidden="true">
        <span>@Resources.Web_ShareList_Label_Name</span>
        <span>@Resources.Web_ShareList_Label_Status</span>
        @if (ShowExtendedInfo)
        {
            <span>@Resources.Web_ShareList_Label_StoragePool</span>
            <span>@Resources.Web_ShareList_Label_RecycleBin</span>
            <span>@Resources.Web_ShareList_Card_Hidden</span>
        }
    </div>

    <div class="share-table-body">
        @foreach (var share in SortedShares)
        {
            var isSelected = SelectedShare?.Id == share.Id;
            var isStorageUnavailable = !(StorageAvailable?.Invoke(share) ?? true);
            var isUsable = IsUsable(share);

            <button class="share-table-row @(isSelected ? "share-table-row--selected" : "") @(isStorageUnavailable ? "share-table-row--storage-unavailable" : "")"
                    type="button"
                    role="option"
                    aria-selected="@isSelected"
                    @onclick="() => OnSelected.InvokeAsync(share)"
                    @ondblclick="() => OnOpened.InvokeAsync(share.Name)">
                <span class="share-table-cell share-table-name">
                    <span class="share-icon" aria-hidden="true">
                        @Icons.SVG(
                            $"folder{(share.CloudConnection is null ? "" : "_" + share.CloudConnection.ServiceName)}.svg",
                            new SvgOptions(
                                Width: 24,
                                Height: 24,
                                Color: isStorageUnavailable ? "var(--text-tertiary)" : "var(--folder-stroke)",
                                Fill: isStorageUnavailable ? "transparent" : "var(--folder-fill)")
                        )
                    </span>
                    <span class="share-name" title="@share.Name">@share.Name</span>
                </span>

                <span class="share-table-cell">
                    <span class="share-availability @(isUsable ? "share-availability--usable" : "share-availability--unusable")">
                        <span class="share-status-dot" aria-hidden="true"></span>
                        <span>@(isStorageUnavailable
                            ? Resources.Web_ShareList_Card_Unavailable
                            : share.IsEnabled
                                ? Resources.Web_ShareList_Card_Available
                                : Resources.Web_ShareList_Card_Disabled)</span>
                    </span>
                </span>

                @if (ShowExtendedInfo)
                {
                    <span class="share-table-cell share-pool" title="@(StoragePoolName?.Invoke(share))">
                        @(StoragePoolName?.Invoke(share) ?? "—")
                    </span>
                    <span class="share-table-cell">
                        <span class="share-state @(share.IsRecycleEnabled ? "share-state--positive" : "share-state--neutral")">
                            @(share.IsRecycleEnabled
                                ? Resources.Web_ShareList_Card_Yes
                                : Resources.Web_ShareList_Card_No)
                        </span>
                    </span>
                    <span class="share-table-cell">
                        <span class="share-state @(share.IsShareHidden ? "share-state--negative" : "share-state--positive")">
                            @(share.IsShareHidden
                                ? Resources.Web_ShareList_Card_Yes
                                : Resources.Web_ShareList_Card_No)
                        </span>
                    </span>
                }
            </button>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ShareDefinition> Shares { get; set; } = [];
    [Parameter] public ShareDefinition? SelectedShare { get; set; }
    [Parameter] public bool ShowExtendedInfo { get; set; }
    [Parameter] public Func<ShareDefinition, bool>? StorageAvailable { get; set; }
    [Parameter] public Func<ShareDefinition, string>? StoragePoolName { get; set; }
    [Parameter] public EventCallback<ShareDefinition> OnSelected { get; set; }
    [Parameter] public EventCallback<string> OnOpened { get; set; }

    private IEnumerable<ShareDefinition> SortedShares
        => Shares
            .OrderBy(share => IsUsable(share) ? 0 : 1)
            .ThenBy(GetVolumeName, StringComparer.CurrentCultureIgnoreCase)
            .ThenBy(share => share.Name, StringComparer.CurrentCultureIgnoreCase);

    private bool IsUsable(ShareDefinition share)
        => share.IsEnabled && (StorageAvailable?.Invoke(share) ?? true);

    private string GetVolumeName(ShareDefinition share)
        => StoragePoolName?.Invoke(share) ?? string.Empty;
}
