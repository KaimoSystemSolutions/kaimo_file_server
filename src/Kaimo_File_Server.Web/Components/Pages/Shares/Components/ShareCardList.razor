
@using Kaimo_File_Server.Core.Domain
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Web.DynamicHelpers
@inject AssetProvider Icons

<div class="share-grid">
    @foreach (var share in Shares)
    {
        var isSelected = SelectedShare?.Id == share.Id;
        var isDisabled = !share.IsEnabled;

        <div class="share-card @(isSelected ? "share-card--selected" : "") @(isDisabled ? "share-card--disabled" : "")"
             @onclick="() => OnSelected.InvokeAsync(share)"
             @ondblclick="() => OnOpened.InvokeAsync(share.Name)">
            
            <div class="share-icon">
                @Icons.SVG(
                    $"folder{(share.CloudConnection is null ? "" : "_" + share.CloudConnection.getServiceName())}.svg",
                    new SvgOptions(
                        Width: 32,
                        Height: 32,
                        Color: isDisabled ? "var(--text-tertiary)" : "var(--folder-stroke)",
                        Fill: isDisabled ? "transparent" : "var(--folder-fill)")
                )
            </div>
            <div class="share-info">
                <span class="share-name">@share.Name</span>
                <span class="share-path">@share.Path</span>
                @if (isDisabled)
                {
                    <span class="share-badge share-badge--disabled">@Resources.Web_ShareList_Status_Disabled</span>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ShareDefinition> Shares { get; set; } = [];
    [Parameter] public ShareDefinition? SelectedShare { get; set; }
    [Parameter] public EventCallback<ShareDefinition> OnSelected { get; set; }
    [Parameter] public EventCallback<string> OnOpened { get; set; }
}

