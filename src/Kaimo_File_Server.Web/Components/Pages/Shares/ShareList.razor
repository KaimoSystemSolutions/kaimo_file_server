@page "/"
@using Kaimo_File_Server.Web.Components.Pages.Acl
@inject ShareListViewModel VM
@inject NavigationManager Nav

<PageTitle>Kaimo Files – Shares</PageTitle>

<div class="page-header">
    <div>
        <h1>Shares</h1>
        <p class="subtitle">Willkommen, @VM.CurrentUserName</p>
    </div>
    <div style="display: flex; gap: 0.5rem;">
        @if (VM.CanCreateShare)
        {
            <button class="btn-icon" title="Share erstellen" @onclick="ToggleCreate">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                </svg>
            </button>
        }
    </div>
</div>

@* -- Create Form -- *@

@if (VM.IsCreating && VM.CanCreateShare)
{
    <div class="create-form-card">
        <h3>Neuen Share erstellen</h3>
        <div class="create-form-fields">
            <div class="form-group">
                <label>Name</label>
                <input class="edit-input"
                       type="text"
                       placeholder="z.B. projekte, backup, medien"
                       @bind="VM.NewShareName"
                       @bind:event="oninput"
                       @onkeydown="HandleCreateKeyDown" />
            </div>
        </div>
        @if (VM.CreateErrorMessage is not null)
        {
            <div class="error-banner" style="margin-top: 12px; margin-bottom: 0;">@VM.CreateErrorMessage</div>
        }
        <div class="create-form-actions">
            <button class="btn-primary" @onclick="CreateShare">Erstellen</button>
            <button class="btn-secondary" @onclick="() => { VM.IsCreating = false; }">Abbrechen</button>
        </div>
    </div>
}

@* -- Content -- *@

@if (VM.IsLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Lade Shares…</p>
    </div>
}
else if (VM.ErrorMessage is not null)
{
    <div class="error-banner">@VM.ErrorMessage</div>
}
else if (!VM.Shares.Any())
{
    <div class="empty-state">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--text-tertiary)" stroke-width="1.5">
            <path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
        </svg>
        <p>Keine Shares verfügbar.</p>
    </div>
}
else
{
    <div class="admin-content">
        @* -- Share List -- *@
        <div class="admin-list">
            <div class="share-grid">
                @foreach (var share in VM.Shares)
                {
                    var isSelected = VM.SelectedShare?.Id == share.Id;
                    var isDisabled = !share.IsEnabled;

                    <div class="share-card @(isSelected ? "share-card--selected" : "") @(isDisabled ? "share-card--disabled" : "")"
                         @onclick="() => HandleCardClick(share)">
                        <div class="share-icon">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none"
                                 stroke="@(isDisabled ? "var(--text-tertiary)" : "var(--folder-stroke)")" stroke-width="1.5">
                                <path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"
                                      fill="@(isDisabled ? "transparent" : "var(--folder-fill)")" />
                            </svg>
                        </div>
                        <div class="share-info">
                            <span class="share-name">@share.Name</span>
                            <span class="share-path">@share.Path</span>
                            @if (isDisabled)
                            {
                                <span class="share-badge share-badge--disabled">Deaktiviert</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* -- Detail Panel mit Tabs -- *@
        @if (VM.SelectedShare is not null && VM.IsAdmin)
        {
            <div class="admin-detail">
                <div class="detail-header">
                    <h3>@VM.SelectedShare.Name</h3>
                    <span class="detail-subtitle">Share-Einstellungen</span>
                </div>

                @* -- Tab-Navigation -- *@
                <div class="detail-tabs">
                    <button class="detail-tab @(_activeTab == DetailTab.Settings ? "detail-tab--active" : "")"
                            @onclick="() => SwitchTab(DetailTab.Settings)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="3" />
                            <path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z" />
                        </svg>
                        Allgemein
                    </button>
                    <button class="detail-tab @(_activeTab == DetailTab.Access ? "detail-tab--active" : "")"
                            @onclick="() => SwitchTab(DetailTab.Access)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" /><circle cx="9" cy="7" r="4" />
                            <path d="M23 21v-2a4 4 0 00-3-3.87" /><path d="M16 3.13a4 4 0 010 7.75" />
                        </svg>
                        Sichtbarkeit
                    </button>
                    <button class="detail-tab @(_activeTab == DetailTab.Acl ? "detail-tab--active" : "")"
                            @onclick="() => SwitchTab(DetailTab.Acl)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                        </svg>
                        ACL
                    </button>
                </div>

                @* -- Tab: Allgemein -- *@
                @if (_activeTab == DetailTab.Settings)
                {
                    @if (VM.EditSuccessMessage is not null)
                    {
                        <div class="success-banner">@VM.EditSuccessMessage</div>
                    }
                    @if (VM.EditErrorMessage is not null)
                    {
                        <div class="error-banner">@VM.EditErrorMessage</div>
                    }

                    <div class="detail-section">
                        <span class="detail-label">Name</span>
                        <div class="detail-rename-row">
                            <input class="edit-input"
                                   type="text"
                                   @bind="VM.EditShareName"
                                   @bind:event="oninput"
                                   disabled="@VM.IsRenaming" />
                            <button class="btn-primary"
                                    @onclick="RenameShare"
                                    disabled="@(VM.EditShareName.Trim() == VM.SelectedShare.Name || VM.IsRenaming)">
                                @(VM.IsRenaming ? "…" : "Umbenennen")
                            </button>
                        </div>
                    </div>

                    <div class="detail-section">
                        <span class="detail-label">Pfad</span>
                        <span class="detail-value">@VM.SelectedShare.Path</span>
                    </div>

                    <div class="detail-section">
                        <span class="detail-label">Status</span>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span class="detail-value">
                                @(VM.SelectedShare.IsEnabled ? "Aktiv" : "Deaktiviert")
                            </span>
                            <button class="btn-secondary" style="padding: 4px 10px; font-size: 12px;" @onclick="ToggleEnabled">
                                @(VM.SelectedShare.IsEnabled ? "Deaktivieren" : "Aktivieren")
                            </button>
                        </div>
                    </div>

                    <div class="detail-actions">
                        @if (!VM.ShowDeleteConfirm)
                        {
                            <button class="btn-danger-outline" @onclick="() => VM.ShowDeleteConfirm = true">
                                Share löschen
                            </button>
                        }
                        else
                        {
                            <div class="confirm-delete">
                                <p>Share „@VM.SelectedShare.Name" wirklich löschen? Dateien bleiben erhalten.</p>
                                <div style="display: flex; gap: 8px;">
                                    <button class="btn-danger-outline" @onclick="DeleteShare">Endgültig löschen</button>
                                    <button class="btn-secondary" @onclick="() => VM.ShowDeleteConfirm = false">Abbrechen</button>
                                </div>
                            </div>
                        }
                    </div>
                }

                @* -- Tab: Sichtbarkeit -- *@
                @if (_activeTab == DetailTab.Access)
                {
                    @if (VM.AccessErrorMessage is not null)
                    {
                        <div class="error-banner">@VM.AccessErrorMessage</div>
                    }

                    <div class="detail-section">
                        <p style="font-size: 12px; color: var(--text-tertiary); margin-bottom: 12px;">
                            Welche Benutzer und Gruppen diesen Share in der Übersicht sehen.
                        </p>

                        @if (!_accessLoaded)
                        {
                            <div class="loading-state" style="padding: 24px 0;">
                                <div class="spinner"></div>
                            </div>
                        }
                        else
                        {
                            
                            var availableUsers = VM.AllUsers.Where(u => !VM.HasAccess(u.Id)).ToList();
                            var availableGroups = VM.AllGroups.Where(g => !VM.HasAccess(g.Id)).ToList();
                            

                            @if (availableUsers.Any() || availableGroups.Any())
                            {
                                <div class="access-add-row">
                                    <select class="edit-input access-select" @onchange="OnAccessPrincipalAdd">
                                        <option value="">+ Benutzer oder Gruppe hinzufügen…</option>
                                        @if (availableUsers.Any())
                                        {
                                            <optgroup label="Benutzer">
                                                @foreach (var u in availableUsers)
                                                {
                                                    <option value="@u.Id">@(u.Name ?? u.Username)</option>
                                                }
                                            </optgroup>
                                        }
                                        @if (availableGroups.Any())
                                        {
                                            <optgroup label="Gruppen">
                                                @foreach (var g in availableGroups)
                                                {
                                                    <option value="@g.Id">@g.Name</option>
                                                }
                                            </optgroup>
                                        }
                                    </select>
                                </div>
                            }

                            @* -- Aktuelle Einträge als kompakte Chips -- *@
                            @if (VM.AccessEntries.Any())
                            {
                                <div class="access-chip-list">
                                    @foreach (var entry in VM.AccessEntries)
                                    {
                                        var pType = VM.GetPrincipalType(entry.PrincipalId);
                                        <div class="access-chip">
                                            <div class="access-chip-icon">
                                                @if (pType == "group")
                                                {
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" /><circle cx="9" cy="7" r="4" />
                                                        <path d="M23 21v-2a4 4 0 00-3-3.87" /><path d="M16 3.13a4 4 0 010 7.75" />
                                                    </svg>
                                                }
                                                else
                                                {
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" /><circle cx="12" cy="7" r="4" />
                                                    </svg>
                                                }
                                            </div>
                                            <span class="access-chip-name">@VM.GetPrincipalDisplayName(entry.PrincipalId)</span>
                                            <button class="access-chip-remove" title="Entfernen"
                                                    @onclick="() => RevokeAccess(entry.PrincipalId)">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
                                                </svg>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="empty-hint">Keine Sichtbarkeitsregeln – Share ist für alle sichtbar.</p>
                            }
                        }
                    </div>
                }

                @* -- Tab: ACL -- *@
                @if (_activeTab == DetailTab.Acl)
                {
                    <div class="detail-section">
                        <p style="font-size: 12px; color: var(--text-tertiary); margin-bottom: 12px;">
                            NTFS-ähnliche Berechtigungen für Dateien und Ordner innerhalb dieses Shares.
                        </p>
                        <AclEditor @key="@_aclEditorKey" Path="" ShareId="@VM.SelectedShare.Id" IsDirectory="true" />
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private enum DetailTab { Settings, Access, Acl }

    private DetailTab _activeTab = DetailTab.Settings;
    private string _aclEditorKey = "";
    private bool _accessLoaded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await VM.LoadAsync();
            StateHasChanged();
        }
    }

    private void HandleCardClick(ShareDefinition share)
    {
        if (VM.IsAdmin)
        {
            _activeTab = DetailTab.Settings;
            _accessLoaded = false;
            VM.SelectShare(share);
            StateHasChanged();
        }
        else
        {
            Nav.NavigateTo($"/files/{share.Name}");
        }
    }

    private async Task SwitchTab(DetailTab tab)
    {
        _activeTab = tab;

        if (tab == DetailTab.Access && !_accessLoaded)
        {
            await VM.LoadAccessAsync();
            _accessLoaded = true;
        }

        if (tab == DetailTab.Acl)
        {
            _aclEditorKey = $"{VM.SelectedShare?.Name}_{DateTime.UtcNow.Ticks}";
        }

        StateHasChanged();
    }

    private void ToggleCreate()
    {
        VM.DeselectShare();
        _activeTab = DetailTab.Settings;
        _accessLoaded = false;
        VM.IsCreating = !VM.IsCreating;
        StateHasChanged();
    }

    private void OpenShare(string name) => Nav.NavigateTo($"/files/{name}");

    private async Task CreateShare()
    {
        if (!VM.CanCreateShare) return;
        await VM.CreateShareAsync();
        StateHasChanged();
    }

    private async Task HandleCreateKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CreateShare();
    }

    private async Task RenameShare()
    {
        await VM.RenameShareAsync();
        StateHasChanged();
    }

    private async Task ToggleEnabled()
    {
        await VM.ToggleShareEnabledAsync();
        StateHasChanged();
    }

    private async Task DeleteShare()
    {
        await VM.DeleteShareAsync();
        _activeTab = DetailTab.Settings;
        _accessLoaded = false;
        StateHasChanged();
    }

    private async Task OnAccessPrincipalAdd(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (!string.IsNullOrEmpty(val) && Guid.TryParse(val, out var id))
        {
            await GrantAccess(id);
        }
    }

    private async Task GrantAccess(Guid principalId)
    {
        await VM.GrantAccessAsync(principalId);
        StateHasChanged();
    }

    private async Task RevokeAccess(Guid principalId)
    {
        await VM.RevokeAccessAsync(principalId);
        StateHasChanged();
    }
}
