@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ShareListViewModel VM
@inject LoginViewModel LoginVM
@inject NavigationManager Nav

<PageTitle>Kaimo Files – Shares</PageTitle>

<div class="page-header">
    <div>
        <h1>Shares</h1>
        <p class="subtitle">Willkommen, @VM.CurrentUserName</p>
    </div>
    <button class="btn-icon" title="Abmelden" @onclick="Logout">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/>
        </svg>
    </button>
</div>

@if (VM.IsLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Lade Shares...</p>
    </div>
}
else if (VM.ErrorMessage is not null)
{
    <div class="error-banner">@VM.ErrorMessage</div>
}
else if (!VM.Shares.Any())
{
    <div class="empty-state">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--text-tertiary)" stroke-width="1.5">
            <path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
        </svg>
        <p>Keine Shares verfügbar.</p>
    </div>
}
else
{
    <div class="share-grid">
        @foreach (var share in VM.Shares)
        {
            <div class="share-card" @onclick="() => OpenShare(share.Name)">
                <div class="share-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5">
                        <path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
                    </svg>
                </div>
                <div class="share-info">
                    <span class="share-name">@share.Name</span>
                    <span class="share-path">@share.Path</span>
                </div>
            </div>
        }
    </div>
}

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await VM.LoadAsync();
            StateHasChanged();
        }
    }

    private void OpenShare(string name) => Nav.NavigateTo($"/browse/{name}");

    private async Task Logout()
    {
        await LoginVM.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: true);
    }
}
