@page "/"
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Web.Components.Pages.Acl
@using Kaimo_File_Server.Web.DynamicHelpers
@inject ShareListViewModel VM
@inject NavigationManager Nav
@inject AssetProvider Assets

<PageTitle>Shares - Kaimo Files</PageTitle>

<div class="page-header">
    <div>
        <h1>Shares</h1>
        <p class="subtitle">Willkommen, @VM.CurrentUserName</p>
    </div>
    <div style="display: flex; gap: 0.5rem;">
        @if (VM.CanCreateShare)
        {
            <button class="btn-icon" title="Share erstellen" @onclick="ToggleCreate">
                @Assets.SVG("plus.svg", new SvgOptions(Width: 20, Height: 20, StrokeWidth: 2))
            </button>
        }
    </div>
</div>

@* -- Create Form -- *@

@if (VM.IsCreating && VM.CanCreateShare)
{
    <div class="create-form-card">
        <h3>Neuen Share erstellen</h3>
        <div class="create-form-fields">
            <div class="form-group">
                <label>Name</label>
                <input class="edit-input"
                       type="text"
                       placeholder="z.B. projekte, backup, medien"
                       @bind="VM.NewShareName"
                       @bind:event="oninput"
                       @onkeydown="HandleCreateKeyDown" />
            </div>
        </div>
        @if (VM.CreateErrorMessage is not null)
        {
            <div class="error-banner" style="margin-top: 12px; margin-bottom: 0;">@VM.CreateErrorMessage</div>
        }
        <div class="create-form-actions">
            <button class="btn-primary" @onclick="CreateShare">Erstellen</button>
            <button class="btn-secondary" @onclick="() => { VM.IsCreating = false; }">Abbrechen</button>
        </div>
    </div>
}

@* -- Content -- *@

@if (VM.IsLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Lade Shares…</p>
    </div>
}
else if (VM.ErrorMessage is not null)
{
    <div class="error-banner">@VM.ErrorMessage</div>
}
else if (!VM.Shares.Any())
{
    <div class="empty-state">
        @Assets.SVG("folder.svg", new SvgOptions(Width: 64, Height: 64, Color: "var(--text-tertiary)"))
        <p>Keine Shares verfügbar.</p>
    </div>
}
else
{
    <div class="admin-content">
        @* -- Share List -- *@
        <div class="admin-list">
            <div class="share-grid">
                @foreach (var share in VM.Shares)
                {
                    var isSelected = VM.SelectedShare?.Id == share.Id;
                    var isDisabled = !share.IsEnabled;

                    <div class="share-card @(isSelected ? "share-card--selected" : "") @(isDisabled ? "share-card--disabled" : "")"
                         @onclick="() => HandleCardClick(share)"
                         @ondblclick='() => Nav.NavigateTo("files/" + share.Name)'
                         >
                        <div class="share-icon">
                            @Assets.SVG("folder.svg", new SvgOptions(
                                Width: 32, Height: 32,
                                Color: isDisabled ? "var(--text-tertiary)" : "var(--folder-stroke)",
                                Fill: isDisabled ? "transparent" : "var(--folder-fill)"))
                        </div>
                        <div class="share-info">
                            <span class="share-name">@share.Name</span>
                            <span class="share-path">@share.Path</span>
                            @if (isDisabled)
                            {
                                <span class="share-badge share-badge--disabled">Deaktiviert</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* -- Detail Panel mit Tabs -- *@
        @if (VM.SelectedShare is not null && VM.IsAdmin)
        {
            <div class="admin-detail">
                <div class="detail-header">
                    <h3>@VM.SelectedShare.Name</h3>
                    <span class="detail-subtitle">Share-Einstellungen</span>
                </div>

                @* -- Tab-Navigation -- *@
                <div class="detail-tabs">
                    <button class="detail-tab @(_activeTab == DetailTab.Settings ? "detail-tab--active" : "")"
                            @onclick="() => SwitchTab(DetailTab.Settings)">
                        @Assets.SVG("settings.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                        Allgemein
                    </button>
                    <button class="detail-tab @(_activeTab == DetailTab.Access ? "detail-tab--active" : "")"
                            @onclick="() => SwitchTab(DetailTab.Access)">
                        @Assets.SVG("users.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                        Sichtbarkeit
                    </button>
                    <button class="detail-tab @(_activeTab == DetailTab.Acl ? "detail-tab--active" : "")"
                            @onclick="() => SwitchTab(DetailTab.Acl)">
                        @Assets.SVG("shield.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                        ACL
                    </button>
                </div>

                @* -- Tab: Allgemein -- *@
                @if (_activeTab == DetailTab.Settings)
                {
                    @if (VM.EditSuccessMessage is not null)
                    {
                        <div class="success-banner">@VM.EditSuccessMessage</div>
                    }
                    @if (VM.EditErrorMessage is not null)
                    {
                        <div class="error-banner">@VM.EditErrorMessage</div>
                    }

                    <div class="detail-section">
                        <span class="detail-label">@Resources.Web_ShareList_Label_Name</span>
                        <div class="detail-rename-row">
                            <input class="edit-input"
                                   type="text"
                                   @bind="VM.EditShareName"
                                   @bind:event="oninput"
                                   disabled="@VM.IsRenaming" />
                            <button class="btn-primary"
                                    @onclick="RenameShare"
                                    disabled="@(VM.EditShareName.Trim() == VM.SelectedShare.Name || VM.IsRenaming)">
                                @(VM.IsRenaming ? "…" : Resources.Web_Action_Rename)
                            </button>
                        </div>
                    </div>

                    <div class="detail-section">
                        <span class="detail-label">Pfad</span>
                        <span class="detail-value">@VM.SelectedShare.Path</span>
                    </div>

                    <div class="detail-section">
                        <span class="detail-label">Status</span>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span class="detail-value">
                                @(VM.SelectedShare.IsEnabled ? Resources.Web_ShareList_Status_Active : Resources.Web_ShareList_Status_Disabled)
                            </span>
                            <button class="btn-secondary" style="padding: 4px 10px; font-size: 12px;" @onclick="ToggleShareEnabled">
                                @(VM.SelectedShare.IsEnabled ? Resources.Web_ShareList_Action_Disable : Resources.Web_ShareList_Action_Enable)
                            </button>
                        </div>
                    </div>

                    <div class="detail-section">
                        <span class="detail-label">Papierkorb</span>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span class="detail-value">
                                @(VM.SelectedShare.IsRecycleEnabled ? Resources.Web_ShareList_Status_Active : Resources.Web_ShareList_Status_Disabled)
                            </span>
                            <button class="btn-secondary" style="padding: 4px 10px; font-size: 12px;" @onclick="ToggleRecycleEnabled">
                                @(VM.SelectedShare.IsRecycleEnabled ? Resources.Web_ShareList_Action_Disable : Resources.Web_ShareList_Action_Enable)
                            </button>
                        </div>
                    </div>

                    <div class="detail-actions">
                        @if (!VM.ShowDeleteConfirm)
                        {
                            <button class="btn-danger-outline" @onclick="() => VM.ShowDeleteConfirm = true">
                                @Resources.Web_ShareList_DeleteShare
                            </button>
                        }
                        else
                        {
                            <div class="confirm-delete">
                                <p>@string.Format(Resources.Web_ShareList_DeleteConfirm, @VM.SelectedShare.Name)</p>
                                <div style="display: flex; gap: 8px;">
                                    <button class="btn-danger-outline" @onclick="DeleteShare">@Resources.Web_ShareList_DeletePermanently</button>
                                    <button class="btn-secondary" @onclick="() => VM.ShowDeleteConfirm = false">@Resources.Web_Button_Cancel</button>
                                </div>
                            </div>
                        }
                    </div>
                }

                @* -- Tab: Sichtbarkeit -- *@
                @if (_activeTab == DetailTab.Access)
                {
                    @if (VM.AccessErrorMessage is not null)
                    {
                        <div class="error-banner">@VM.AccessErrorMessage</div>
                    }

                    <div class="detail-section">
                        <p style="font-size: 12px; color: var(--text-tertiary); margin-bottom: 12px;">
                            @Resources.Web_ShareList_VisibilityDescription
                        </p>

                        @if (!_accessLoaded)
                        {
                            <div class="loading-state" style="padding: 24px 0;">
                                <div class="spinner"></div>
                            </div>
                        }
                        else
                        {
                            <div class="form-group" style="margin-bottom: 14px;">
                                <label>@Resources.Web_ShareList_Tab_Visibility</label>
                                <div class="detail-section">
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <span class="detail-value">
                                            @(VM.SelectedShare.IsShareHidden ? Resources.Web_ShareList_Status_Active : Resources.Web_ShareList_Status_Disabled)
                                        </span>
                                        <button class="btn-secondary" style="padding: 4px 10px; font-size: 12px;" @onclick="ToggleShareHidden">
                                            @(VM.SelectedShare.IsShareHidden ? Resources.Web_ShareList_Action_Disable : Resources.Web_ShareList_Action_Enable)
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (_activeTab == DetailTab.Acl)
                {
                    <div class="detail-section">
                        <p style="font-size: 12px; color: var(--text-tertiary); margin-bottom: 12px;">
                            @Resources.Web_ShareList_AclDescription
                        </p>
                        <AclEditor @key="@_aclEditorKey" Path="" ShareId="@VM.SelectedShare.Id" IsDirectory="true" />
                    </div>
                }
            </div>
        }
    </div>
}


@code {
    private enum DetailTab { Settings, Access, Acl }

    private DetailTab _activeTab = DetailTab.Settings;
    private string _aclEditorKey = "";
    private bool _accessLoaded;
    private bool _accessUsersOpen;
    private bool _accessGroupsOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await VM.LoadAsync();
            StateHasChanged();
        }
    }

    private void HandleCardClick(ShareDefinition share)
    {
        if (VM.IsAdmin)
        {
            _activeTab = DetailTab.Settings;
            _accessLoaded = false;
            _accessUsersOpen = false;
            _accessGroupsOpen = false;
            VM.SelectShare(share);
            StateHasChanged();
        }
        else
        {
            Nav.NavigateTo($"/files/{share.Name}");
        }
    }

    private async Task SwitchTab(DetailTab tab)
    {
        _activeTab = tab;
        _accessUsersOpen = false;
        _accessGroupsOpen = false;

        if (tab == DetailTab.Access && !_accessLoaded)
        {
            await VM.LoadAccessAsync();
            _accessLoaded = true;
        }

        if (tab == DetailTab.Acl)
        {
            _aclEditorKey = $"{VM.SelectedShare?.Name}_{DateTime.UtcNow.Ticks}";
        }

        StateHasChanged();
    }

    private void ToggleCreate()
    {
        VM.DeselectShare();
        _activeTab = DetailTab.Settings;
        _accessLoaded = false;
        _accessUsersOpen = false;
        _accessGroupsOpen = false;
        VM.IsCreating = !VM.IsCreating;
        StateHasChanged();
    }

    private void OpenShare(string name) => Nav.NavigateTo($"/files/{name}");

    private async Task CreateShare()
    {
        if (!VM.CanCreateShare) return;
        await VM.CreateShareAsync();
        StateHasChanged();
    }

    private async Task HandleCreateKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CreateShare();
    }

    private async Task RenameShare()
    {
        await VM.RenameShareAsync();
        StateHasChanged();
    }

    private async Task ToggleShareEnabled()
    {
        await VM.ToggleShareEnabledAsync();
        StateHasChanged();
    }

    private async Task ToggleRecycleEnabled()
    {
        await VM.ToggleRecycleEnabledAsync();
        StateHasChanged();
    }

    private async Task ToggleShareHidden()
    {
        await VM.ToggleShareHiddenAsync();
        StateHasChanged();
    }

    private async Task DeleteShare()
    {
        await VM.DeleteShareAsync();
        _activeTab = DetailTab.Settings;
        _accessLoaded = false;
        StateHasChanged();
    }

    private async Task ToggleAccessPrincipal(Guid principalId, bool shouldGrant)
    {
        if (shouldGrant)
            await VM.GrantAccessAsync(principalId);
        else
            await VM.RevokeAccessAsync(principalId);

        StateHasChanged();
    }

    private async Task GrantAccess(Guid principalId)
    {
        await VM.GrantAccessAsync(principalId);
        StateHasChanged();
    }

    private async Task RevokeAccess(Guid principalId)
    {
        await VM.RevokeAccessAsync(principalId);
        StateHasChanged();
    }
}