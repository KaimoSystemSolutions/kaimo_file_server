@page "/"
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Web.Components.Pages.Acl
@using Kaimo_File_Server.Web.Components.Pages.Shares.Components
@using Kaimo_File_Server.Web.DynamicHelpers
@inject ShareListViewModel VM
@inject NavigationManager Nav
@inject AssetProvider Assets

<PageTitle>@Resources.Web_Nav_Shares - Kaimo Files</PageTitle>

<div class="page-header">
    <div>
        <h1>@Resources.Web_Nav_Shares</h1>
        <p class="subtitle">@string.Format(Resources.Web_ShareList_Welcome, VM.CurrentUserName)</p>
    </div>
    @if (VM.CanCreateShare)
    {
        <button class="btn-icon" title="@Resources.Web_ShareList_CreateShare" @onclick="ToggleCreate">
            @Assets.SVG("plus.svg", new SvgOptions(Width: 20, Height: 20, StrokeWidth: 2))
        </button>
    }
</div>

@if (VM.IsCreating && VM.CanCreateShare)
{
    <ShareCreateForm VM="VM" OnChanged="StateHasChanged" />
}

@if (VM.IsLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>@Resources.Web_ShareBrowser_Loading</p>
    </div>
}
else if (VM.ErrorMessage is not null)
{
    <div class="error-banner">@VM.ErrorMessage</div>
}
else if (!VM.Shares.Any())
{
    <div class="empty-state">
        @Assets.SVG("folder.svg", new SvgOptions(Width: 64, Height: 64, Color: "var(--text-tertiary)"))
        <p>@Resources.Web_ShareBrowser_Empty</p>
    </div>
}
else
{
    <div class="admin-content">
        <div class="admin-list">
            <ShareCardList Shares="VM.Shares"
                           SelectedShare="VM.SelectedShare"
                           OnSelected="HandleCardClick"
                           OnOpened="OpenShare" />
        </div>

        @if (VM.SelectedShare is not null && VM.CanManageShare(VM.SelectedShare.Id))
        {
            <div class="admin-detail">
                <div class="detail-header">
                    <h3>@VM.SelectedShare.Name</h3>
                    <span class="detail-subtitle">@Resources.Web_ShareList_DetailSubtitle</span>
                </div>

                <div class="detail-tabs">
                    <button class="detail-tab @(_activeTab == ShareDetailTab.Settings ? "detail-tab--active" : "")"
                            @onclick="() => SwitchTab(ShareDetailTab.Settings)">
                        @Assets.SVG("settings.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                        @Resources.Web_ShareList_Tab_General
                    </button>
                    <button class="detail-tab @(_activeTab == ShareDetailTab.Access ? "detail-tab--active" : "")"
                            @onclick="() => SwitchTab(ShareDetailTab.Access)">
                        @Assets.SVG("users.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                        @Resources.Web_ShareList_Tab_Visibility
                    </button>
                    <button class="detail-tab @(_activeTab == ShareDetailTab.Acl ? "detail-tab--active" : "")"
                            @onclick="() => SwitchTab(ShareDetailTab.Acl)">
                        @Assets.SVG("shield.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                        @Resources.Web_ShareList_Tab_ACL
                    </button>
                </div>

                @switch (_activeTab)
                {
                    case ShareDetailTab.Settings:
                        <ShareSettingsPanel VM="VM" OnDeleted="HandleShareDeleted" />
                        break;
                    case ShareDetailTab.Access:
                        <ShareAccessPanel VM="VM" IsLoaded="_accessLoaded" />
                        break;
                    case ShareDetailTab.Acl:
                        <div class="detail-section">
                            <p class="share-help-text">@Resources.Web_ShareList_AclDescription</p>
                            <AclEditor @key="@_aclEditorKey" Path="" ShareId="@VM.SelectedShare.Id" IsDirectory="true" />
                        </div>
                        break;
                }
            </div>
        }
    </div>
}
