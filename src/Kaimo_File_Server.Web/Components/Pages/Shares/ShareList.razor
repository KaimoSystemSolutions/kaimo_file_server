@page "/"
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Web.Components.Pages.Acl
@using Kaimo_File_Server.Web.Components.Pages.CloudAccess
@using Kaimo_File_Server.Web.Components.Pages.Shares.Components
@using Kaimo_File_Server.Web.DynamicHelpers
@inject ShareListViewModel VM
@inject NavigationManager Nav
@inherits AppComponentBase
@inject ToastService Toasts

<PageTitle>@Resources.Web_Nav_Shares - Kaimo Files</PageTitle>

<Tabs aria-label="@Resources.Web_Nav_Shares">
    <Tab Active="@(_shareKind == ShareKind.Local)" OnClick="() => SelectShareKind(ShareKind.Local)">
        @Text("Web_Shares_LocalShares", "Local Shares")
    </Tab>
    <Tab Active="@(_shareKind == ShareKind.Virtual)" OnClick="() => SelectShareKind(ShareKind.Virtual)">
        @Text("Web_Shares_VirtualShares", "Virtual Shares")
    </Tab>
</Tabs>

@if (_shareKind == ShareKind.Virtual)
{
    <CloudAccess Embedded="true" VirtualSharesOnly="true" InitialConnectionId="Connection" />
}
else
{
<div class="page-header share-page-header">
    <div>
        <h1>@Resources.Web_Nav_Shares</h1>
        <p class="subtitle">@string.Format(Resources.Web_ShareList_Welcome, VM.CurrentUserName)</p>
    </div>
    <div class="page-header-actions">
        @if (VM.Shares.Any() && VM.IsAdmin)
        {
            <button class="btn-secondary share-info-toggle @(_showExtendedShareInfo ? "share-info-toggle--active" : "")"
                    title="@(_showExtendedShareInfo
                        ? Resources.Web_ShareList_Card_HideDetails
                        : Resources.Web_ShareList_Card_ShowDetails)"
                    aria-pressed="@_showExtendedShareInfo"
                    @onclick="ToggleExtendedShareInfo">
                @Assets.SVG("circle_info.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))
                <span>@(_showExtendedShareInfo
                    ? Resources.Web_ShareList_Card_HideDetails
                    : Resources.Web_ShareList_Card_ShowDetails)</span>
            </button>
        }
        @if (VM.CanCreateShare)
        {
            <button class="btn-primary share-create-button" type="button" @onclick="ToggleCreate">
                @Assets.SVG("plus.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))
                <span>@Resources.Web_ShareList_CreateShare</span>
            </button>
        }
    </div>
</div>

@if (VM.IsCreating && VM.CanCreateShare)
{
    <ShareCreateForm VM="VM" OnChanged="StateHasChanged"/>
}

@if (VM.IsLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>@Resources.Web_ShareBrowser_Loading</p>
    </div>
}
else if (VM.ErrorMessage is not null)
{
    <div class="error-banner">@VM.ErrorMessage</div>
}
else if (!VM.Shares.Any())
{
    <div class="empty-state">
        @Assets.SVG("folder.svg", new SvgOptions(Width: 64, Height: 64, Color: "var(--text-tertiary)"))
        <p>@Resources.Web_ShareBrowser_Empty</p>
    </div>
}
else
{
    <div class="admin-content share-workspace">
        <ShareCardList Shares="VM.Shares"
                       SelectedShare="VM.SelectedShare"
                       ShowExtendedInfo="_showExtendedShareInfo"
                       StorageAvailable="VM.IsShareStorageAvailable"
                       StoragePoolName="VM.GetStoragePoolDisplayNameForShare"
                       Department="VM.GetDepartmentDisplay"
                       CanViewDetails="@(s => VM.CanManageShare(s.Id))"
                       OnSelected="HandleCardClick"
                       OnOpened="OpenShare"/>

        <aside class="admin-detail share-detail-pane" aria-label="@Resources.Web_ShareList_DetailSubtitle">
            @if (VM.SelectedShare is not null && VM.CanManageShare(VM.SelectedShare.Id))
            {
                <div class="detail-header">
                    <h3>@VM.SelectedShare.Name</h3>
                    <span class="detail-subtitle">@Resources.Web_ShareList_DetailSubtitle</span>
                </div>

                @if (VM.IsSelectedShareReadOnly)
                {
                    <div class="storage-unavailable-banner">
                        @Resources.Web_Error_ShareStorageUnavailableReadOnly
                    </div>
                }

                <Tabs class="detail-tabs--panel">
                    <Tab Active="@(_activeTab == ShareDetailTab.Settings)" Icon="settings.svg" Label="@Resources.Web_ShareList_Tab_General"
                         OnClick="() => SwitchTab(ShareDetailTab.Settings)" />
                    <Tab Active="@(_activeTab == ShareDetailTab.Access)" Disabled="@VM.IsSelectedShareReadOnly" Icon="users.svg" Label="@Resources.Web_ShareList_Tab_Visibility"
                         OnClick="() => SwitchTab(ShareDetailTab.Access)" />
                    <Tab Active="@(_activeTab == ShareDetailTab.Acl)" Disabled="@VM.IsSelectedShareReadOnly" Icon="shield.svg" Label="@Resources.Web_ShareList_Tab_ACL"
                         OnClick="() => SwitchTab(ShareDetailTab.Acl)" />
                    <Tab Active="@(_activeTab == ShareDetailTab.Cloud)" Disabled="@VM.IsSelectedShareReadOnly" Icon="cloud-download.svg" Label="@Text("Web_ShareList_Tab_Cloud", "Cloud")"
                         OnClick="() => SwitchTab(ShareDetailTab.Cloud)" />
                </Tabs>

                @switch (_activeTab)
                {
                    case ShareDetailTab.Settings:
                        <ShareSettingsPanel VM="VM" OnDeleted="HandleShareDeleted" OnChanged="StateHasChanged"/>
                        break;
                    case ShareDetailTab.Access:
                        <ShareAccessPanel VM="VM" IsLoaded="_accessLoaded" OnChanged="StateHasChanged"/>
                        break;
                    case ShareDetailTab.Acl:
                        <div class="detail-section">
                            <p class="share-help-text">@Resources.Web_ShareList_AclDescription</p>
                            <AclEditor @key="@_aclEditorKey"
                                       Path=""
                                       ShareId="@VM.SelectedShare.Id"
                                       IsDirectory="true"/>
                        </div>
                        break;
                    case ShareDetailTab.Cloud:
                        <ShareCloudPanel VM="VM" />
                        break;
                }
            }
            else
            {
                <div class="detail-empty">
                    @Assets.SVG("folder.svg", new SvgOptions(
                        Width: 48,
                        Height: 48,
                        Color: "var(--text-tertiary)"))

                    <p>@Text("Web_ShareList_SelectHint", "Select a share to view its details and settings.")</p>
                </div>
            }
        </aside>
    </div>
}
}
