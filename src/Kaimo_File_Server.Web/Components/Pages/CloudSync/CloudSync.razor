@page "/sync"
@page "/sync/{ShareName}"
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Core.Services.DataServices
@using Kaimo_File_Server.Web.Components.Pages.CloudSync.Components
@using Kaimo_File_Server.Web.DynamicHelpers
@inject CloudSyncViewModel VM
@inject NavigationManager Navigation
@inject AssetProvider Assets
@inject ToastService Toasts
@inject JobService Jobs

<PageTitle>@Text("Web_Nav_CloudSync", "Cloud Sync") - Kaimo Files</PageTitle>

<div class="page-header">
    <div>
        <h1>@Text("Web_CloudSync_Title", "Cloud Sync")</h1>
        <p class="subtitle">@Text("Web_CloudSync_Subtitle", "Manage local and remote folder synchronization across all cloud providers.")</p>
    </div>
    @if (VM.CanCreateSync)
    {
        <button class="btn-primary" type="button" @onclick="ToggleCreate">
            @Assets.SVG("plus.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))
            <span>@Text("Web_CloudSync_Create", "Add cloud sync")</span>
        </button>
    }
</div>

@if (VM.IsCreating && VM.CanCreateSync)
{
    <section class="create-form-card cloud-sync-create" aria-label="@Text("Web_CloudSync_Create", "Add cloud sync")">
        <div class="detail-header">
            <h3>@Text("Web_CloudSync_Create_Title", "Connect a folder")</h3>
            <span class="detail-subtitle">@Text("Web_CloudSync_Create_Help", "Choose a local folder and provider. You can select the remote folder after authorization.")</span>
        </div>
        <div class="cloud-sync-create-grid">
            <label class="form-group">
                <span>@Text("Web_CloudSync_Share", "Share")</span>
                <select @bind="VM.NewShareId" @bind:after="ResetNewLocalPath">
                    @foreach (var share in VM.Shares.Where(share => VM.CanCreateOnShare(share.Id)))
                    {
                        <option value="@share.Id">@share.Name</option>
                    }
                </select>
            </label>
            <label class="form-group">
                <span>@Text("Web_CloudSync_Provider", "Cloud provider")</span>
                <select @bind="VM.NewProviderId">
                    @foreach (var provider in VM.Providers)
                    {
                        <option value="@provider.Id">@provider.DisplayName</option>
                    }
                </select>
            </label>
            <div class="form-group cloud-path-field">
                <span>@Text("Web_CloudSync_Name", "Name")</span>
                <div class="cloud-path-input-row">
                    <input value="@DisplayLocalPath(VM.NewLocalPath)" readonly />
                    <button class="btn-secondary" type="button" @onclick="OpenNewLocalPicker">
                        @Text("Web_CloudSync_Browse", "Browse…")
                    </button>
                </div>
            </div>
        </div>
        <div class="create-form-actions">
            <button class="btn-secondary" type="button" @onclick="ToggleCreate">@Resources.Web_Button_Cancel</button>
            <button class="btn-primary" type="button" @onclick="ConnectAsync">
                @Text("Web_CloudSync_Connect", "Authorize and connect")
            </button>
        </div>
    </section>
}

@if (!string.IsNullOrWhiteSpace(VM.ErrorMessage))
{
    <div class="error-banner">@VM.ErrorMessage</div>
}

@if (VM.IsLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>@Text("Web_CloudSync_Loading", "Loading cloud syncs…")</p>
    </div>
}
else if (VM.Syncs.Count == 0)
{
    <div class="empty-state">
        @Assets.SVG("cloud-download.svg", new SvgOptions(Width: 64, Height: 64, Color: "var(--text-tertiary)"))
        <p>@Text("Web_CloudSync_Empty", "No cloud syncs have been configured yet.")</p>
    </div>
}
else
{
    <div class="admin-content cloud-sync-workspace">
        <div class="cloud-sync-table" role="listbox" aria-label="@Text("Web_CloudSync_Title", "Cloud Sync")">
            <div class="cloud-sync-table-header" aria-hidden="true">
                <span>@Text("Web_CloudSync_LocalFolder", "Local folder")</span>
                <span>@Text("Web_CloudSync_Provider", "Cloud provider")</span>
                <span>@Text("Web_CloudSync_Mode", "Sync mode")</span>
                <span>@Text("Web_CloudSync_LastSync", "Last sync")</span>
            </div>
            @foreach (var sync in VM.Syncs)
            {
                var selected = ReferenceEquals(VM.SelectedSync, sync);
                <button class="cloud-sync-table-row @(selected ? "cloud-sync-table-row--selected" : "")"
                        type="button" role="option" aria-selected="@selected"
                        @onclick="() => SelectAsync(sync)">
                    <span class="cloud-sync-local">
                        @Assets.SVG("folder.svg", new SvgOptions(Width: 23, Height: 23))
                        <span>
                            <strong>@(string.IsNullOrWhiteSpace(sync.Configuration.DisplayName) ? sync.ShareName : sync.Configuration.DisplayName)</strong>
                            <small>@sync.ShareName · @DisplayLocalPath(sync.LocalPath)</small>
                        </span>
                    </span>
                    <span>@sync.ProviderDisplayName</span>
                    <span>@ModeLabel(sync.Configuration.Mode)</span>
                    <span>@FormatLastSync(sync.Configuration.LastSync)</span>
                </button>
            }
        </div>

        <aside class="admin-detail cloud-sync-detail">
            @if (VM.SelectedSync is null)
            {
                <div class="detail-empty">
                    @Assets.SVG("cloud-download.svg", new SvgOptions(Width: 48, Height: 48, Color: "var(--text-tertiary)"))
                    <p>@Text("Web_CloudSync_Select", "Select a cloud sync to view its settings.")</p>
                </div>
            }
            else
            {
                <div class="detail-header">
                    <h3>@(string.IsNullOrWhiteSpace(VM.SelectedSync.Configuration.DisplayName) ? VM.SelectedSync.ShareName : VM.SelectedSync.Configuration.DisplayName)</h3>
                    <span class="detail-subtitle">@VM.SelectedSync.ProviderDisplayName</span>
                </div>

                @if (VM.SelectedAccount is not null)
                {
                    <div class="cloud-account cloud-sync-account">
                        @if (!string.IsNullOrWhiteSpace(VM.SelectedAccount.PictureUrl))
                        {
                            <img class="cloud-avatar" src="@VM.SelectedAccount.PictureUrl" alt="" referrerpolicy="no-referrer" />
                        }
                        <div>
                            @if (!string.IsNullOrWhiteSpace(VM.SelectedAccount.DisplayName))
                            {
                                <strong>@VM.SelectedAccount.DisplayName</strong>
                            }
                            <span class="detail-value">@VM.SelectedAccount.Email</span>
                        </div>
                    </div>
                }

                <div class="detail-tabs cloud-sync-tabs" role="tablist" aria-label="@Text("Web_CloudSync_Title", "Cloud Sync")">
                    <button class="@SettingsTabClass(CloudSyncSettingsTab.General)" type="button"
                            role="tab" aria-selected="@(_activeSettingsTab == CloudSyncSettingsTab.General)"
                            @onclick="() => _activeSettingsTab = CloudSyncSettingsTab.General">
                        @Assets.SVG("refresh.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                        @Text("Web_CloudSync_Tab_General", "General")
                    </button>
                    <button class="@SettingsTabClass(CloudSyncSettingsTab.Schedule)" type="button"
                            role="tab" aria-selected="@(_activeSettingsTab == CloudSyncSettingsTab.Schedule)"
                            @onclick="() => _activeSettingsTab = CloudSyncSettingsTab.Schedule">
                        @Assets.SVG("history.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                        @Text("Web_CloudSync_Tab_Schedule", "Timing")
                    </button>
                    <button class="@SettingsTabClass(CloudSyncSettingsTab.Advanced)" type="button"
                            role="tab" aria-selected="@(_activeSettingsTab == CloudSyncSettingsTab.Advanced)"
                            @onclick="() => _activeSettingsTab = CloudSyncSettingsTab.Advanced">
                        @Assets.SVG("edit_box.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                        @Text("Web_CloudSync_Tab_Advanced", "Advanced")
                    </button>
                </div>

                @if (_activeSettingsTab == CloudSyncSettingsTab.General)
                {
                <div class="detail-section cloud-path-field">
                    <span class="detail-label">@Text("Web_CloudSync_Name", "Name")</span>
                    <input class="edit-input" @bind="VM.EditDisplayName" disabled="@(!VM.CanConfigureSelected)" />
                </div>

                <div class="detail-section cloud-path-field">
                    <span class="detail-label">@Text("Web_CloudSync_Description", "Description")</span>
                    <textarea class="edit-input cloud-sync-description" @bind="VM.EditDescription" disabled="@(!VM.CanConfigureSelected)"></textarea>
                </div>

                <div class="detail-section cloud-path-field">
                    <span class="detail-label">@Text("Web_CloudSync_LocalFolder", "Local folder")</span>
                    <div class="cloud-path-input-row">
                        <input class="edit-input" value="@DisplayLocalPath(VM.EditLocalPath)" readonly />
                        <button class="btn-secondary" type="button" disabled="@(!VM.CanConfigureSelected)"
                                @onclick="OpenEditLocalPicker">@Text("Web_CloudSync_Browse", "Browse…")</button>
                    </div>
                </div>

                <div class="detail-section cloud-path-field">
                    <span class="detail-label">@Text("Web_CloudSync_RemoteFolder", "Remote folder")</span>
                    <div class="cloud-path-input-row">
                        <input class="edit-input" value="@VM.EditRemotePath" readonly />
                        <button class="btn-secondary" type="button" disabled="@(!VM.CanConfigureSelected)"
                                @onclick="OpenRemotePicker">@Text("Web_CloudSync_Browse", "Browse…")</button>
                    </div>
                    @if (VM.RequiresRemoteFolderSelection)
                    {
                        <span class="cloud-path-required">
                            @Text("Web_CloudSync_RemoteFolder_Required", "Select a remote folder before saving this cloud sync. The root folder is allowed.")
                        </span>
                    }
                </div>

                <div class="detail-section">
                    <span class="detail-label">@Text("Web_CloudSync_Mode", "Sync mode")</span>
                    <select class="edit-input" @bind="VM.EditMode" disabled="@(!VM.CanConfigureSelected)">
                        <option value="@SyncMode.TwoWay">@ModeLabel(SyncMode.TwoWay)</option>
                        <option value="@SyncMode.Pull">@ModeLabel(SyncMode.Pull)</option>
                        <option value="@SyncMode.Push">@ModeLabel(SyncMode.Push)</option>
                    </select>
                </div>
                }

                @if (_activeSettingsTab == CloudSyncSettingsTab.Schedule)
                {
                <div class="detail-section cloud-schedule-section">
                    <div class="cloud-schedule-heading">
                        <div class="cloud-schedule-title-row">
                            <span class="detail-label">@Text("Web_CloudSync_Schedule", "Automatic sync")</span>
                            <span class="cloud-schedule-info"
                                  role="img"
                                  tabindex="0"
                                  aria-label="@Text("Web_CloudSync_Schedule_Help", "Select the hourly windows in which this folder should synchronize.")"
                                  title="@Text("Web_CloudSync_Schedule_Help", "Select the hourly windows in which this folder should synchronize.")">
                                i
                            </span>
                        </div>
                        <label class="toggle-switch cloud-schedule-toggle" title="@Text("Web_CloudSync_Schedule_Toggle", "Enable or disable automatic sync")">
                            <input type="checkbox"
                                   @bind="VM.EditScheduleEnabled"
                                   disabled="@(!VM.CanConfigureSelected)"
                                   aria-label="@Text("Web_CloudSync_Schedule_Toggle", "Enable or disable automatic sync")" />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>

                    <label class="cloud-schedule-interval">
                        <span class="cloud-schedule-field-label">
                            @Text("Web_CloudSync_Schedule_Interval", "Check interval")
                            <span class="cloud-schedule-info"
                                  role="img"
                                  tabindex="0"
                                  aria-label="@Text("Web_CloudSync_Schedule_Interval_Help", "How often the server checks for a scheduled synchronization window.")"
                                  title="@Text("Web_CloudSync_Schedule_Interval_Help", "How often the server checks for a scheduled synchronization window.")">
                                i
                            </span>
                        </span>
                        <span class="cloud-schedule-interval-input">
                            <input class="edit-input cloud-schedule-interval-field"
                                   type="number"
                                   min="@CloudSyncSchedule.MinIntervalSeconds"
                                   max="@CloudSyncSchedule.MaxIntervalSeconds"
                                   step="1"
                                   @bind="VM.EditScheduleIntervalSeconds"
                                   disabled="@(!VM.CanConfigureSelected)" />
                            <span>@Text("Web_CloudSync_Schedule_Seconds", "seconds")</span>
                        </span>
                    </label>

                    <div class="cloud-schedule-paint-toolbar">
                        <span class="cloud-schedule-paint-label cloud-schedule-field-label">
                            @Text("Web_CloudSync_Schedule_Paint_Mode", "Edit mode")
                            <span class="cloud-schedule-info"
                                  role="img"
                                  tabindex="0"
                                  aria-label="@Text("Web_CloudSync_Schedule_Paint_Help", "Drag from a start window to span a rectangular selection.")"
                                  title="@Text("Web_CloudSync_Schedule_Paint_Help", "Drag from a start window to span a rectangular selection.")">
                                i
                            </span>
                        </span>
                        <div class="cloud-schedule-paint-modes"
                             role="group"
                             aria-label="@Text("Web_CloudSync_Schedule_Paint_Mode", "Edit mode")">
                            <button class="cloud-schedule-paint-mode cloud-schedule-paint-mode--select @(_schedulePaintMode == SchedulePaintMode.Select ? "cloud-schedule-paint-mode--active" : "")"
                                    type="button"
                                    aria-pressed="@(_schedulePaintMode == SchedulePaintMode.Select ? "true" : "false")"
                                    disabled="@(!VM.CanConfigureSelected || !VM.EditScheduleEnabled)"
                                    @onclick="() => _schedulePaintMode = SchedulePaintMode.Select">
                                <span aria-hidden="true">+</span>
                                @Text("Web_CloudSync_Schedule_Paint_Select", "Select")
                            </button>
                            <button class="cloud-schedule-paint-mode cloud-schedule-paint-mode--deselect @(_schedulePaintMode == SchedulePaintMode.Deselect ? "cloud-schedule-paint-mode--active" : "")"
                                    type="button"
                                    aria-pressed="@(_schedulePaintMode == SchedulePaintMode.Deselect ? "true" : "false")"
                                    disabled="@(!VM.CanConfigureSelected || !VM.EditScheduleEnabled)"
                                    @onclick="() => _schedulePaintMode = SchedulePaintMode.Deselect">
                                <span aria-hidden="true">−</span>
                                @Text("Web_CloudSync_Schedule_Paint_Deselect", "Deselect")
                            </button>
                        </div>
                    </div>

                    <div class="cloud-schedule-scroll @SchedulePaintModeClass @(VM.EditScheduleEnabled ? "" : "cloud-schedule-scroll--disabled")"
                         @ref="_scheduleGrid">
                        <div class="cloud-schedule-grid" role="grid" aria-label="@Text("Web_CloudSync_Schedule_Grid", "Weekly hourly sync schedule")">
                            <span class="cloud-schedule-corner" aria-hidden="true"></span>
                            @foreach (var hour in Enumerable.Range(0, CloudSyncSchedule.HoursPerDay))
                            {
                                <button class="cloud-schedule-hour"
                                        type="button"
                                        title="@ScheduleHourActionLabel(hour)"
                                        disabled="@(!VM.CanConfigureSelected || !VM.EditScheduleEnabled)"
                                        @onclick="() => PaintScheduleHour(hour)">
                                    @hour.ToString("00")
                                </button>
                            }
                            @foreach (var day in ScheduleDays)
                            {
                                <button class="cloud-schedule-day"
                                        type="button"
                                        title="@ScheduleDayActionLabel(day)"
                                        disabled="@(!VM.CanConfigureSelected || !VM.EditScheduleEnabled)"
                                        @onclick="() => PaintScheduleDay(day)">
                                    @ScheduleDayName(day)
                                </button>
                                @foreach (var hour in Enumerable.Range(0, CloudSyncSchedule.HoursPerDay))
                                {
                                    var active = VM.IsScheduleSlotActive(day, hour);
                                    <button class="cloud-schedule-slot @(active ? "cloud-schedule-slot--active" : "")"
                                            type="button"
                                            role="gridcell"
                                            data-schedule-day="@((int)day)"
                                            data-schedule-row="@Array.IndexOf(ScheduleDays, day)"
                                            data-schedule-hour="@hour"
                                            aria-pressed="@active"
                                            aria-label="@ScheduleSlotLabel(day, hour, active)"
                                            title="@ScheduleSlotLabel(day, hour, active)"
                                            disabled="@(!VM.CanConfigureSelected || !VM.EditScheduleEnabled)"
                                            @onclick="() => PaintScheduleSlot(day, hour)">
                                    </button>
                                }
                            }
                        </div>
                    </div>

                    <div class="cloud-schedule-footer">
                        <span>
                            @string.Format(
                                Text("Web_CloudSync_Schedule_Selected", "{0} hourly windows selected · server local time"),
                                VM.ActiveScheduleSlotCount)
                        </span>
                        @if (VM.CanConfigureSelected && VM.ActiveScheduleSlotCount > 0)
                        {
                            <button type="button" class="cloud-schedule-clear" @onclick="VM.ClearSchedule">
                                @Text("Web_CloudSync_Schedule_Clear", "Clear")
                            </button>
                        }
                    </div>
                </div>
                }

                @if (_activeSettingsTab == CloudSyncSettingsTab.Advanced)
                {
                <div class="detail-section cloud-sync-advanced">
                    <h4>@Text("Web_CloudSync_Advanced", "Advanced settings")</h4>
                    <p>@Text("Web_CloudSync_Advanced_Help", "Optional file filters and bandwidth limits for this sync.")</p>
                    <label class="form-group">
                        <span>@Text("Web_CloudSync_Advanced_MaxFileSize", "Maximum file size (MB)")</span>
                        <input class="edit-input" type="number" min="0" step="1" @bind="VM.EditMaxFileSizeMb" disabled="@(!VM.CanConfigureSelected)" />
                        <small>@Text("Web_CloudSync_Advanced_Unlimited_Help", "Enter 0 or leave empty for no limit.")</small>
                    </label>
                    <label class="form-group">
                        <span>@Text("Web_CloudSync_Advanced_ExcludedExtensions", "Excluded file extensions")</span>
                        <textarea class="edit-input cloud-sync-extension-list" @bind="VM.EditExcludedExtensions" disabled="@(!VM.CanConfigureSelected)"
                                  placeholder=".tmp, .iso, .bak"></textarea>
                        <small>@Text("Web_CloudSync_Advanced_ExcludedExtensions_Help", "Separate extensions with commas, spaces, or new lines.")</small>
                    </label>
                    <div class="cloud-sync-advanced-rates">
                        <label class="form-group">
                            <span>@Text("Web_CloudSync_Advanced_MaxUpload", "Maximum upload rate (KB/s)")</span>
                            <input class="edit-input" type="number" min="0" step="1" @bind="VM.EditMaxUploadRateKbps" disabled="@(!VM.CanConfigureSelected)" />
                            <small>@Text("Web_CloudSync_Advanced_Unlimited_Help", "Enter 0 or leave empty for no limit.")</small>
                        </label>
                        <label class="form-group">
                            <span>@Text("Web_CloudSync_Advanced_MaxDownload", "Maximum download rate (KB/s)")</span>
                            <input class="edit-input" type="number" min="0" step="1" @bind="VM.EditMaxDownloadRateKbps" disabled="@(!VM.CanConfigureSelected)" />
                            <small>@Text("Web_CloudSync_Advanced_Unlimited_Help", "Enter 0 or leave empty for no limit.")</small>
                        </label>
                    </div>
                </div>
                }

                @if (_activeSettingsTab == CloudSyncSettingsTab.General)
                {
                <div class="detail-section">
                    <span class="detail-label">@Text("Web_CloudSync_LastSync", "Last sync")</span>
                    <span class="detail-value">@FormatLastSync(VM.SelectedSync.Configuration.LastSync)</span>
                </div>
                }

                <div class="detail-actions">
                    @if (VM.CanConfigureSelected)
                    {
                        <button class="@(VM.HasUnsavedChanges ? "btn-primary cloud-sync-save--changed" : "btn-secondary")"
                                type="button"
                                disabled="@(!VM.HasUnsavedChanges || VM.IsBusy)"
                                @onclick="SaveAsync">
                            @Text("Web_CloudSync_Save", "Save settings")
                        </button>
                    }
                    @if (VM.CanRunSelected)
                    {
                        <button class="btn-primary" type="button" disabled="@(VM.IsBusy || VM.RequiresRemoteFolderSelection)" @onclick="RunSyncAsync">
                            @Text("Web_CloudSync_Run", "Sync now")
                        </button>
                    }
                    @if (VM.CanDeleteSelected)
                    {
                        <button class="btn-danger" type="button" disabled="@VM.IsBusy" @onclick="() => _showDeleteConfirm = true">
                            @Text("Web_CloudSync_Unsync", "Remove cloud sync")
                        </button>
                    }
                    @if (_showDeleteConfirm)
                    {
                        <div class="confirm-delete">
                            <p>@Text("Web_CloudSync_Unsync_Confirm", "Remove this configuration and revoke its cloud connection?")</p>
                            <div class="modal-actions">
                                <button class="btn-secondary" type="button" @onclick="() => _showDeleteConfirm = false">@Resources.Web_Button_Cancel</button>
                                <button class="btn-danger" type="button" @onclick="DeleteAsync">@Text("Web_CloudSync_Unsync", "Remove cloud sync")</button>
                            </div>
                        </div>
                    }
                </div>
            }
        </aside>
    </div>
}

<DirectoryPickerDialog IsOpen="_pickerOpen"
                       IsRemote="_pickerRemote"
                       IsLoading="_pickerLoading"
                       Title="@_pickerTitle"
                       CurrentPath="@_pickerPath"
                       Items="@_pickerItems"
                       ErrorMessage="@_pickerError"
                       OnNavigate="NavigatePickerAsync"
                       OnSelected="SelectPickerPathAsync"
                       OnClosed="ClosePicker" />
