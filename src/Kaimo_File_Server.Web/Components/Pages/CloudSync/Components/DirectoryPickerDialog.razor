@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Web.DynamicHelpers
@inherits AppComponentBase

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="CloseAsync">
        <div class="modal-dialog directory-picker" role="dialog" aria-modal="true"
             aria-label="@Title" @onclick:stopPropagation="true">
            <h3 class="modal-title">@Title</h3>

            <input class="directory-picker-path" type="text" spellcheck="false"
                   autocomplete="off" title="@DisplayPath" value="@DisplayPath"
                   placeholder="@Text("Web_CloudSync_Directory_PathHint", "Type or paste a path…")"
                   @onchange="OnPathEnteredAsync" />

            <div class="directory-picker-toolbar">
                <button class="btn-secondary" type="button" disabled="@IsAtRoot" @onclick="NavigateToParentAsync">
                    @Assets.SVG("chevron_left.svg", new SvgOptions(Width: 15, Height: 15, StrokeWidth: 2))
                    <span>@Text("Web_CloudSync_Directory_Parent", "Parent folder")</span>
                </button>
            </div>

            <div class="directory-picker-list" role="listbox">
                @if (IsLoading)
                {
                    <div class="directory-picker-state">
                        <div class="spinner"></div>
                        <span>@Text("Web_CloudSync_Directory_Loading", "Loading folders…")</span>
                    </div>
                }
                else if (Items.Count == 0)
                {
                    <div class="directory-picker-state">
                        <span>@Text("Web_CloudSync_Directory_Empty", "This folder contains no subfolders.")</span>
                    </div>
                }
                else
                {
                    @foreach (var item in Items)
                    {
                        <button class="directory-picker-item" type="button"
                                @onclick="() => OnNavigate.InvokeAsync(item.Path)">
                            @Assets.SVG("folder.svg", new SvgOptions(Width: 22, Height: 22))
                            <span>@item.Name</span>
                        </button>
                    }
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="modal-error">@ErrorMessage</div>
            }

            <div class="modal-actions">
                <button class="btn-secondary" type="button" @onclick="CloseAsync">@Resources.Web_Button_Cancel</button>
                <button class="btn-primary" type="button" disabled="@IsLoading"
                        @onclick="() => OnSelected.InvokeAsync(CurrentPath)">
                    @Text("Web_CloudSync_Directory_Select", "Select this folder")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsRemote { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string CurrentPath { get; set; } = "";
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public IReadOnlyList<CloudDirectoryItem> Items { get; set; } = [];
    [Parameter] public EventCallback<string> OnNavigate { get; set; }
    [Parameter] public EventCallback<string> OnSelected { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private string RootPath => IsRemote ? "/" : "";
    private string DisplayPath => string.IsNullOrEmpty(CurrentPath) ? "/" : CurrentPath;
    private bool IsAtRoot => string.Equals(CurrentPath, RootPath, StringComparison.Ordinal);

    // The parent owns picker state; the dialog only reports user intent.
    private Task CloseAsync() => OnClosed.InvokeAsync();

    // Local paths use an empty root while remote paths use "/". Normalize both
    // representations before notifying the parent to keep providers abstract.
    private Task NavigateToParentAsync()
    {
        var normalized = CurrentPath.Replace('\\', '/').Trim('/');
        var separator = normalized.LastIndexOf('/');
        var parent = separator < 0 ? "" : normalized[..separator];
        return OnNavigate.InvokeAsync(NormalizePath(parent));
    }

    // Let the user type or paste a path directly. Accepts Windows or Linux
    // separators with any leading/trailing slashes; onchange fires on Enter/blur.
    private Task OnPathEnteredAsync(ChangeEventArgs e)
        => OnNavigate.InvokeAsync(NormalizePath(e.Value?.ToString() ?? ""));

    // Collapse both separator styles and stray slashes into the canonical form
    // each provider expects: remote is rooted with a leading "/", local is not.
    private string NormalizePath(string raw)
    {
        var normalized = (raw ?? "").Replace('\\', '/').Trim().Trim('/');
        if (IsRemote)
            return normalized.Length == 0 ? "/" : $"/{normalized}";
        return normalized;
    }

    // Razor components use a fallback so missing satellite resources never make
    // an administration control unusable.
    private static string Text(string key, string fallback)
        => Resources.ResourceManager.GetString(key) ?? fallback;
}
