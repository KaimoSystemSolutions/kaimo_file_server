@page "/login"
@attribute [AllowAnonymous]
@layout EmptyLayout
@inject LoginViewModel VM
@inject NavigationManager Nav
@inject AssetProvider BrandAssets

<PageTitle>Kaimo File Server – Anmelden</PageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="login-brand">
            @BrandAssets.RawSVG("icon_kaimo.svg", 42, 42)
        </div>
        <h1>Kaimo Files</h1>
        <p class="subtitle">Melde dich an, um fortzufahren</p>

        @if (VM.ErrorMessage is not null)
        {
            <div class="error-banner">@VM.ErrorMessage</div>
        }

        <div class="login-form">
            <div class="form-group">
                <label>Benutzername</label>
                <input type="text"
                       placeholder="Benutzername eingeben"
                       @bind="VM.Username"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown"
                       disabled="@VM.IsLoading" />
            </div>

            <div class="form-group">
                <label>Passwort</label>
                <input type="password"
                       placeholder="Passwort eingeben"
                       @bind="VM.Password"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown"
                       disabled="@VM.IsLoading" />
            </div>

            <button class="btn-primary" type="button" @onclick="HandleLogin" disabled="@VM.IsLoading">
                @(VM.IsLoading ? "Wird angemeldet…" : "Anmelden")
            </button>
        </div>
    </div>
</div>

@code {
    private async Task HandleLogin()
    {
        var success = await VM.LoginAsync();
        if (success)
        {
            Nav.NavigateTo("/", forceLoad: false);
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await HandleLogin();
    }
}
