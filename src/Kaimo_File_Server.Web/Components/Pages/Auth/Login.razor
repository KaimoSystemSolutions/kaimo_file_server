@page "/login"
@attribute [AllowAnonymous]
@layout EmptyLayout
@inject LoginViewModel VM
@inject NavigationManager Nav
@inject AssetProvider BrandAssets
@using Kaimo_File_Server.Core.Language

<PageTitle>@Resources.Web_Login_PageTitle</PageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="login-brand">
            @BrandAssets.RawSVG("icon_kaimo.svg", 42, 42)
        </div>
        <h1>Kaimo File Server</h1>
        <p class="subtitle">@Resources.Web_Login_Subtitle</p>

        @if (VM.ErrorMessage is not null)
        {
            <div class="error-banner">@VM.ErrorMessage</div>
        }

        <div class="login-form">
            <div class="form-group">
                <label for="login-username">@Resources.Web_Login_Label_Username</label>
                <input id="login-username"
                       type="text"
                       name="username"
                       autocomplete="username"
                       placeholder="@Resources.Web_Login_Placeholder_Username"
                       @bind="VM.Username"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown"
                       disabled="@VM.IsLoading" />
            </div>

            <div class="form-group">
                <label for="login-password">@Resources.Web_Login_Label_Password</label>
                <input id="login-password"
                       type="password"
                       name="password"
                       autocomplete="current-password"
                       placeholder="@Resources.Web_Login_Placeholder_Password"
                       @bind="VM.Password"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown"
                       disabled="@VM.IsLoading" />
            </div>

            <button class="btn btn-primary" type="button" @onclick="HandleLogin" disabled="@VM.IsLoading">
                @(VM.IsLoading ? Resources.Web_Login_LoggingIn : Resources.Web_Login_Submit)
            </button>
        </div>
    </div>
</div>

@code {
    private async Task HandleLogin()
    {
        var success = await VM.LoginAsync();
        if (success)
        {
            Nav.NavigateTo("/", forceLoad: false);
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await HandleLogin();
    }
}
