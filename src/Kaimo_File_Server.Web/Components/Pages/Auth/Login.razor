@page "/login"
@layout EmptyLayout
@inject LoginViewModel VM
@inject NavigationManager Nav

<PageTitle>Kaimo Files – Anmelden</PageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="sidebar-brand" style="justify-content: center; margin-bottom: 8px;">
            <svg width="36" height="36" viewBox="0 0 48 48" fill="none">
                <rect width="48" height="48" rx="10" fill="var(--accent)" />
                <path d="M14 20h20v2H14zM14 26h20v2H14zM14 32h14v2H14z" fill="#fff" />
            </svg>
        </div>
        <h2 style="text-align: center;">Kaimo Files</h2>
        <p class="subtitle" style="text-align: center;">Melde dich an, um fortzufahren</p>

        @if (VM.ErrorMessage is not null)
        {
            <div class="error-banner">@VM.ErrorMessage</div>
        }

        <div class="login-form">
            <div class="form-group">
                <label>Benutzername</label>
                <input type="text"
                       placeholder="Benutzername eingeben"
                       @bind="VM.Username"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown"
                       disabled="@VM.IsLoading" />
            </div>

            <div class="form-group">
                <label>Passwort</label>
                <input type="password"
                       placeholder="Passwort eingeben"
                       @bind="VM.Password"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown"
                       disabled="@VM.IsLoading" />
            </div>

            <button class="btn-primary" @onclick="HandleLogin" disabled="@VM.IsLoading">
                @(VM.IsLoading ? "Wird angemeldet…" : "Anmelden")
            </button>
        </div>
    </div>
</div>

@code {
    private async Task HandleLogin()
    {
        var success = await VM.LoginAsync();
        if (success)
        {
            Nav.NavigateTo("/", forceLoad: false);
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await HandleLogin();
    }
}
