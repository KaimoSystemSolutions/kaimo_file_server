@using Kaimo_File_Server.Core.Domain
@using Kaimo_File_Server.Core.Domain.Identity
@using Kaimo_File_Server.Core.Helpers
@using Kaimo_File_Server.Core.Services.ExternalStorage
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Web.Components.Pages.CloudSync.Components
@using Kaimo_File_Server.Web.Components.ViewModels
@using Kaimo_File_Server.Web.DynamicHelpers
@inject CloudAccessViewModel VM
@inject NavigationManager Nav
@inherits AppComponentBase

<div class="page-header vs-page-header">
    <div>
        <h1>@R("Web_Shares_VirtualShares")</h1>
        <p class="subtitle">@R("Web_CloudAccess_Subtitle")</p>
    </div>
    <div class="page-header-actions">
        @if (VM.Shares.Any() && VM.CanManageVirtualShares)
        {
            <button class="btn-secondary vs-info-toggle @(_showVirtualShareDetails ? "vs-info-toggle--active" : "")"
                    type="button"
                    title="@(_showVirtualShareDetails
                        ? R("Web_ShareList_Card_HideDetails")
                        : R("Web_ShareList_Card_ShowDetails"))"
                    aria-pressed="@_showVirtualShareDetails"
                    @onclick="ToggleVirtualShareDetails">
                @Assets.SVG("circle_info.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))
                <span>@(_showVirtualShareDetails
                    ? R("Web_ShareList_Card_HideDetails")
                    : R("Web_ShareList_Card_ShowDetails"))</span>
            </button>
        }
        @if (VM.CanManageVirtualShares && VM.CanUseConnections)
        {
            <button class="btn-primary vs-create-button" type="button" @onclick="ToggleShareForm">
                @Assets.SVG("plus.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))
                <span>@R("Web_CloudAccess_AddShare")</span>
            </button>
        }
    </div>
</div>

@if (VM.IsLoading)
{
    <div class="loading-state"><div class="spinner"></div><p>@R("Web_CloudAccess_Loading")</p></div>
}
else if (!VM.CanManage && !VM.Shares.Any())
{
    @* An actor with neither management rights nor any accessible share. In the virtual
       shares tab this is simply "nothing to show" — not a management-permission error. *@
    <div class="empty-state">
        @Assets.SVG("cloud-download.svg", new SvgOptions(Width: 64, Height: 64, Color: "var(--text-tertiary)"))
        <p>@R("Web_CloudAccess_NoShares")</p>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_error ?? VM.ErrorMessage))
    {
        <div class="error-banner">@(_error ?? VM.ErrorMessage)</div>
    }

    @if (_showShareForm)
    {
        @if (!VM.Connections.Any(IsReady))
        {
            <div class="vs-no-connections-banner">
                <p>@R("Web_CloudAccess_NoReadyConnections")</p>
                <a href="/external-storage?tab=connections" class="btn-secondary vs-connections-link">
                    @Assets.SVG("arrow_right.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                    <span>@R("Web_CloudAccess_GoToConnections")</span>
                </a>
            </div>
        }
        else
        {
            <section class="create-form-card cloud-access-create-card">
                <div class="detail-header">
                    <h3>@R("Web_CloudAccess_AddShare")</h3>
                    <span class="detail-subtitle">@R("Web_CloudAccess_CreateShareHelp")</span>
                </div>
                <div class="cloud-access-form">
                    <label>
                        <span class="detail-label">@R("Web_CloudAccess_Connection")</span>
                        <select class="edit-input" value="@_shareConnectionId" @onchange="ConnectionChangedAsync">
                            <option value="@Guid.Empty">@R("Web_CloudAccess_Select")</option>
                            @foreach (var connection in VM.Connections.Where(connection =>
                                          IsReady(connection) && VM.Supports(connection, StorageProviderCapabilities.Browse)))
                            {
                                <option value="@connection.Id">@ConnectionDisplay(connection)</option>
                            }
                        </select>
                    </label>
                    <label>
                        <span class="detail-label">@R("Web_CloudAccess_ShareName")</span>
                        <input class="edit-input" @bind="_shareName" @bind:event="oninput" maxlength="200" />
                    </label>
                    <label>
                        <span class="detail-label">@R("Web_CloudAccess_Department")</span>
                        <PrincipalPickerField Mode="SelectionMode.Single"
                                              Items="VM.ManageableDepartments.ToDepartmentItems()"
                                              SelectedIds="_shareDepartmentId.AsSelection()"
                                              SelectedIdsChanged="OnShareDepartmentChangedAsync"
                                              AllowClear="false"
                                              Title="@R("Web_CloudAccess_Department")"
                                              Placeholder="@R("Web_CloudAccess_Select")" />
                    </label>
                    <label class="cloud-access-folder-field">
                        <span class="detail-label">@R("Web_CloudAccess_RemoteFolder")</span>
                        <div class="cloud-access-path">
                            <input class="edit-input" value="@_remoteRoot" readonly />
                            <button class="btn-secondary" type="button" disabled="@(_shareConnectionId == Guid.Empty)" @onclick="OpenPickerAsync">@R("Web_CloudAccess_Browse")</button>
                        </div>
                    </label>
                </div>

                @if (_shareConnectionId != Guid.Empty)
                {
                    <div class="detail-section cloud-access-principal-editor">
                        <span class="detail-label">@R("Web_CloudAccess_Access")</span>
                        <p class="share-help-text">@R("Web_CloudAccess_AccessHelp")</p>
                        <CloudAccessAclEditor Principals="PrincipalItems()" Grants="_principalLevels" />
                    </div>
                }

                <div class="detail-actions cloud-access-form-actions">
                    <button class="btn-secondary" type="button" disabled="@_busy" @onclick="CloseShareForm">@Resources.Web_Button_Cancel</button>
                    <button class="btn-primary" type="button" disabled="@(_busy || !CanCreateShare)" @onclick="CreateShareAsync">@Resources.Web_Button_Create</button>
                </div>
            </section>
        }
    }

    @if (!VM.Shares.Any() && !_showShareForm)
    {
        <div class="empty-state">
            @Assets.SVG("cloud-download.svg", new SvgOptions(Width: 64, Height: 64, Color: "var(--text-tertiary)"))
            <p>@R("Web_CloudAccess_NoShares")</p>
        </div>
    }
    else if (VM.Shares.Any())
    {
    <div class="admin-content vs-workspace">
        <div class="vs-share-table @(_showVirtualShareDetails ? "vs-table--extended" : "vs-table--compact")"
             role="listbox" aria-label="@R("Web_CloudAccess_Shares")">
            <div class="vs-table-header" aria-hidden="true">
                <span>@Resources.Web_ShareList_Label_Name</span>
                <span>@Resources.Web_ShareList_Label_Status</span>
                <span>@Resources.Web_ShareList_Label_Department</span>
                @if (_showVirtualShareDetails)
                {
                    <span>@R("Web_CloudAccess_Connection")</span>
                    <span>@R("Web_CloudAccess_RemoteFolder")</span>
                }
            </div>
            <div class="vs-table-body">
                @foreach (var share in VM.Shares)
                {
                    var isSelected = _selectedShare?.Id == share.Id;
                    var connection = VM.Connections.FirstOrDefault(x => x.Id == share.ConnectionId);
                    var isUsable = VM.IsShareUsable(share);
                    <button class="vs-table-row @(isSelected ? "vs-table-row--selected" : "")"
                            type="button" role="option" aria-selected="@isSelected"
                            @onclick="() => SelectShareAsync(share)" @ondblclick="() => OpenShare(share)">
                        <span class="vs-table-cell vs-table-name">
                            <span class="vs-share-icon" aria-hidden="true">
                                @Assets.SVG("cloud-download.svg", new SvgOptions(Width: 24, Height: 24))
                            </span>
                            <span class="vs-share-name" title="@share.Name">@share.Name</span>
                        </span>
                        <span class="vs-table-cell">
                            <StatusBadge Tone="@(isUsable ? StatusTone.Positive : StatusTone.Negative)"
                                         Label="@ShareStatusText(share)" />
                        </span>
                        <span class="vs-table-cell vs-dept">
                            @{ var dept = VM.GetDepartmentDisplay(share); }
                            @if (dept is not null)
                            {
                                <span class="dept-chip"
                                      style="border-color:@dept.Color; background:@dept.Soft;"
                                      title="@dept.Name">@dept.Name</span>
                            }
                            else
                            {
                                <span class="dept-muted">—</span>
                            }
                        </span>
                        @if (_showVirtualShareDetails)
                        {
                            @* Connection and remote-folder are management details — show
                               them only for shares the actor may manage. *@
                            if (VM.CanManageShare(share))
                            {
                                <span class="vs-table-cell vs-connection" title="@(connection?.Name)">
                                    @(connection?.Name ?? "—")
                                </span>
                                <span class="vs-table-cell vs-connection" title="@share.RemoteRootPath">
                                    @share.RemoteRootPath
                                </span>
                            }
                            else
                            {
                                <span class="vs-table-cell vs-connection">—</span>
                                <span class="vs-table-cell vs-connection">—</span>
                            }
                        }
                    </button>
                }
            </div>
        </div>

        <aside class="admin-detail vs-detail-pane">
            @if (_selectedShare is not null && !VM.CanManageShare(_selectedShare))
            {
                @* Access-only: the actor may open the share but not inspect or edit its settings. *@
                <div class="detail-header">
                    <h3>@_selectedShare.Name</h3>
                    <span class="detail-subtitle">@R("Web_CloudAccess_Title")</span>
                </div>
                <div class="detail-actions cloud-access-detail-actions">
                    <button class="btn-primary" type="button" @onclick="() => OpenShare(_selectedShare)">@R("Web_CloudAccess_Open")</button>
                </div>
            }
            else if (_selectedShare is not null)
            {
                <div class="detail-header">
                    <h3>@_selectedShare.Name</h3>
                    <span class="detail-subtitle">@R("Web_CloudAccess_Title")</span>
                </div>
                <Tabs class="detail-tabs--panel">
                    <Tab Active="@(_activeTab == CloudAccessTab.General)" Icon="settings.svg" Label="@R("Web_CloudAccess_TabGeneral")"
                         OnClick="() => SwitchTabAsync(CloudAccessTab.General)" />
                    <Tab Active="@(_activeTab == CloudAccessTab.Extra)" Icon="archive.svg" Label="@R("Web_CloudAccess_TabExtra")"
                         OnClick="() => SwitchTabAsync(CloudAccessTab.Extra)" />
                    <Tab Active="@(_activeTab == CloudAccessTab.Access)" Icon="users.svg" Label="@R("Web_CloudAccess_TabAccess")"
                         OnClick="() => SwitchTabAsync(CloudAccessTab.Access)" />
                </Tabs>

                @if (_activeTab == CloudAccessTab.General)
                {
                    var connection = VM.Connections.FirstOrDefault(x => x.Id == _selectedShare.ConnectionId);

                    <div class="detail-section">
                        <span class="detail-label">@R("Web_CloudAccess_ShareName")</span>
                        <div class="detail-rename-row">
                            <input class="edit-input" type="text" @bind="_editShareName" @bind:event="oninput" disabled="@_busy" maxlength="200" />
                            <button class="btn-primary" type="button"
                                    disabled="@(_busy || string.IsNullOrWhiteSpace(_editShareName) || _editShareName.Trim() == _selectedShare.Name)"
                                    @onclick="RenameShareAsync">@Resources.Web_Action_Rename</button>
                        </div>
                    </div>

                    <div class="detail-section">
                        <span class="detail-label">@R("Web_CloudAccess_Connection")</span>
                        <span class="detail-value">@(connection?.Name ?? "—")</span>
                    </div>

                    <div class="detail-section">
                        <span class="detail-label">@R("Web_CloudAccess_Account")</span>
                        <span class="detail-value">@(connection?.AccountEmail ?? connection?.AccountDisplayName ?? R("Web_CloudAccess_NotAuthorized"))</span>
                    </div>

                    <div class="detail-section">
                        <span class="detail-label">@R("Web_CloudAccess_RemoteFolder")</span>
                        <div class="vs-folder-row">
                            <input class="edit-input" value="@_editShareRoot" readonly />
                            <button class="btn-secondary" type="button" disabled="@_busy" @onclick="OpenEditPickerAsync">@R("Web_CloudAccess_Browse")</button>
                        </div>
                        <button class="btn-primary vs-folder-save" type="button"
                                disabled="@(_busy || string.IsNullOrWhiteSpace(_editShareRoot) || _editShareRoot == _selectedShare.RemoteRootPath)"
                                @onclick="ChangeFolderAsync">@R("Web_CloudAccess_Save")</button>
                    </div>

                    <div class="detail-actions cloud-access-detail-actions">
                        <button class="btn-primary" type="button" @onclick="() => OpenShare(_selectedShare)">@R("Web_CloudAccess_Open")</button>
                        @if (!_showShareDeleteConfirm)
                        {
                            <button class="btn-danger-outline" type="button"
                                    @onclick="() => _showShareDeleteConfirm = true">@Resources.Web_ShareList_DeleteShare</button>
                        }
                        else
                        {
                            <div class="confirm-delete">
                                <p>@string.Format(Resources.Web_ShareList_DeleteConfirm, _selectedShare.Name)</p>
                                <div class="delete-actions">
                                    <button class="btn-danger-outline" type="button" disabled="@_busy"
                                            @onclick="() => DeleteShareAsync(_selectedShare)">@Resources.Web_ShareList_DeletePermanently</button>
                                    <button class="btn-secondary" type="button"
                                            @onclick="() => _showShareDeleteConfirm = false">@Resources.Web_Button_Cancel</button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (_activeTab == CloudAccessTab.Extra)
                {
                    @if (VM.ManageableDepartments.Count > 0)
                    {
                        <div class="detail-section">
                            <span class="detail-label">@Resources.Web_ShareList_Label_Department</span>
                            <PrincipalPickerField Mode="SelectionMode.Single"
                                                  Items="VM.ManageableDepartments.ToDepartmentItems()"
                                                  SelectedIds="_editShareDepartmentId.AsSelection()"
                                                  SelectedIdsChanged="ids => _editShareDepartmentId =
                                                      ids.FirstOrNull() ?? _selectedShare.DepartmentId"
                                                  AllowClear="false"
                                                  Title="@Resources.Web_ShareList_Label_Department" />

                            @if (!_showShareDepartmentConfirm)
                            {
                                <button class="btn-primary department-change-button" type="button"
                                        disabled="@(_busy || _editShareDepartmentId == _selectedShare.DepartmentId)"
                                        @onclick="() => _showShareDepartmentConfirm = true">
                                    @Resources.Web_ShareList_Action_ChangeDepartment
                                </button>
                            }
                            else
                            {
                                <div class="confirm-delete">
                                    <p>@Resources.Web_ShareList_DepartmentChangeWarning</p>
                                    <div class="delete-actions">
                                        <button class="btn-primary" type="button" disabled="@_busy"
                                                @onclick="ChangeShareDepartmentAsync">@Resources.Web_ShareList_Action_ChangeDepartmentConfirm</button>
                                        <button class="btn-secondary" type="button"
                                                @onclick="() => _showShareDepartmentConfirm = false">@Resources.Web_Button_Cancel</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="detail-empty"><p>@R("Web_CloudAccess_DetailHint")</p></div>
                    }
                }
                else
                {
                    <div class="detail-section cloud-access-principal-editor">
                        <p class="share-help-text">@R("Web_CloudAccess_AccessEditHelp")</p>
                        <CloudAccessAclEditor Principals="PrincipalItems()" Grants="_grantLevels" />
                        <div class="detail-actions cloud-access-detail-actions">
                            <button class="btn-primary" type="button" disabled="@_busy" @onclick="SaveGrantsAsync">@R("Web_CloudAccess_SaveAccess")</button>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="detail-empty">
                    @Assets.SVG("cloud-download.svg", new SvgOptions(Width: 48, Height: 48, Color: "var(--text-tertiary)"))
                    <p>@R("Web_CloudAccess_DetailHint")</p>
                </div>
            }
        </aside>
    </div>
    }
}

<DirectoryPickerDialog IsOpen="@_pickerOpen"
                       IsRemote="true"
                       IsLoading="@_pickerLoading"
                       Title="@R("Web_CloudAccess_FolderPickerTitle")"
                       CurrentPath="@_pickerPath"
                       Items="@_pickerItems"
                       ErrorMessage="@_pickerError"
                       OnNavigate="NavigatePickerAsync"
                       OnSelected="SelectPickerAsync"
                       OnClosed="ClosePicker" />
