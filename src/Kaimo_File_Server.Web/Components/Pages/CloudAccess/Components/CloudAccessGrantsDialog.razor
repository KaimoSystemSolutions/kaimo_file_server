@using Kaimo_File_Server.Core.Domain
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Web.Components.Pages.CloudAccess
@inherits AppComponentBase
@inject CloudAccessViewModel CloudAccess

@* Access list of a virtual share mounted as a folder, opened from the file browser's
   "Permissions" command on the mount entry. Same editor as Shares → Virtual shares → Access. *@
@if (_mount is not null)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal-dialog grants-dialog" role="dialog" aria-modal="true" aria-labelledby="vs-grants-title"
             @onclick:stopPropagation="true">
            <h3 class="modal-title" id="vs-grants-title">@string.Format(Resources.Web_Acl_PermissionsFor, _mount.Name)</h3>
            <p class="form-hint">@R("Web_CloudAccess_MountGrantsHint")</p>

            @if (_error is not null)
            {
                <div class="error-banner" role="alert">@_error</div>
            }
            @if (_loading)
            {
                <div class="loading-state"><div class="spinner"></div></div>
            }
            else if (_loaded)
            {
                <CloudAccessAclEditor Principals="_principals" Grants="_grants" />
            }

            <div class="modal-actions">
                <button class="btn btn-secondary" type="button" disabled="@_busy" @onclick="Close">@Resources.Web_Button_Cancel</button>
                <button class="btn btn-primary" type="button" disabled="@(_busy || !_loaded)" @onclick="SaveAsync">@R("Web_CloudAccess_SaveAccess")</button>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Raised after the grants were saved (visibility of the mount may have changed).</summary>
    [Parameter] public EventCallback OnSaved { get; set; }

    private MountedFolder? _mount;
    private Dictionary<Guid, CloudAccessPermission> _grants = [];
    private IReadOnlyList<PrincipalPickerItem> _principals = [];
    private bool _loading;
    private bool _loaded;
    private bool _busy;
    private string? _error;

    public bool IsOpen => _mount is not null;

    public async Task Open(MountedFolder mount)
    {
        (_mount, _loading, _loaded, _busy, _error) = (mount, true, false, false, null);
        StateHasChanged();
        try
        {
            // Loads the principals of the share's department too; throws without manage rights.
            _grants = await CloudAccess.LoadShareGrantsAsync(mount.ShareId);
            _principals = CloudAccess.AvailablePrincipals
                .Select(p => new PrincipalPickerItem(p.Id, p.Name, p is Group ? PrincipalKind.Group : PrincipalKind.User))
                .ToList();
            _loaded = true;
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task SaveAsync()
    {
        if (_mount is null) return;
        _busy = true;
        _error = null;
        try
        {
            await CloudAccess.UpdateShareGrantsAsync(_mount.ShareId, _grants);
            Close();
            await OnSaved.InvokeAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void Close() => _mount = null;

    private static string R(string key) => Resources.ResourceManager.GetString(key) ?? key;
}
