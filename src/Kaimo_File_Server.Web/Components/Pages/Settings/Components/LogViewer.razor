@using Kaimo_File_Server.Core.Logging
@using Kaimo_File_Server.Core.Language
@using Microsoft.Extensions.Logging
@implements IAsyncDisposable
@inject LogViewerViewModel Viewer
@inject NavigationManager Navigation

<div class="detail-section log-viewer-section">
    <div class="log-viewer-heading">
        <div>
            <span class="detail-label">@Resources.Web_Settings_LogViewer_Title</span>
            <p class="settings-description">@Resources.Web_Settings_LogViewer_Description</p>
        </div>
        <div class="log-viewer-actions">
            <label class="log-live-toggle" title="@Resources.Web_Settings_LogViewer_LiveTitle">
                <input type="checkbox" checked="@(!Viewer.IsLivePaused)" @onchange="LiveChangedAsync" />
                <span>@Resources.Web_Settings_LogViewer_Live</span>
            </label>
            <button class="btn-icon" title="@Resources.Web_Settings_LogViewer_Refresh" @onclick="QueueRefreshAsync" disabled="@Viewer.IsLoading">↻</button>
        </div>
    </div>

    @if (!_initialized)
    {
        <div class="log-result-summary">@Resources.Web_Settings_LogViewer_Updating</div>
    }
    else if (!Viewer.IsAuthorized)
    {
        <div class="error-banner">@Resources.Web_Settings_LogViewer_Unauthorized</div>
    }
    else
    {
        <div class="log-viewer-filters">
            <div class="log-filter-block log-source-filter">
                <span class="log-filter-label">@Resources.Web_Settings_LogViewer_Sources</span>
                <div class="log-source-list">
                    @if (Viewer.Sources.Count == 0)
                    {
                        <span class="settings-hint">@Resources.Web_Settings_LogViewer_NoSources</span>
                    }
                    @foreach (var source in Viewer.Sources)
                    {
                        <label class="log-source-chip">
                            <input type="checkbox"
                                   checked="@Viewer.SelectedSources.Contains(source)"
                                   @onchange="args => SourceChangedAsync(source, args)" />
                            <span>@DisplayName(source)</span>
                        </label>
                    }
                </div>
            </div>

            <div class="log-filter-block log-level-filter">
                <span class="log-filter-label">@Resources.Web_Settings_LogViewer_Levels</span>
                <div class="multi-select @(_levelMenuOpen ? "open" : "")">
                    <div class="multi-select-display" @onclick="ToggleLevelMenu">
                        <span class="multi-select-text">@LevelSummary</span>
                        <span class="multi-select-chevron" aria-hidden="true">▾</span>
                    </div>
                    @if (_levelMenuOpen)
                    {
                        <div class="multi-select-backdrop" @onclick="CloseLevelMenu"></div>
                        <div class="multi-select-dropdown">
                            @foreach (var level in Viewer.Levels)
                            {
                                <label class="multi-select-option">
                                    <input type="checkbox"
                                           checked="@Viewer.SelectedLevels.Contains(level)"
                                           @onchange="args => LevelChangedAsync(level, args)" />
                                    <span>@LevelLabel(level)</span>
                                </label>
                            }
                        </div>
                    }
                </div>
            </div>

            <label class="log-filter-block">
                <span class="log-filter-label">@Resources.Web_Settings_LogViewer_DownloadDateUtc</span>
                <input class="edit-input log-date-input"
                       type="date"
                       value="@(Viewer.FilterDateUtc?.ToString("yyyy-MM-dd"))"
                       @onchange="DateChangedAsync" />
            </label>

            <label class="log-filter-block log-search-filter">
                <span class="log-filter-label">@Resources.Web_Settings_LogViewer_Search</span>
                <input class="edit-input"
                       type="search"
                       value="@Viewer.SearchText"
                       maxlength="200"
                       placeholder="@Resources.Web_Settings_LogViewer_SearchPlaceholder"
                       @oninput="SearchChangedAsync" />
            </label>

            <div class="log-filter-block log-exclude-filter">
                <span class="log-filter-label">@Resources.Web_Settings_LogViewer_ExcludePrefixes</span>
                <div class="log-exclude-controls">
                    <input class="edit-input log-exclude-input"
                           value="@_excludedPrefixDraft"
                           maxlength="@LogViewerViewModel.MaxExcludedMessagePrefixLength"
                           placeholder="@Resources.Web_Settings_LogViewer_ExcludePlaceholder"
                           @oninput="args => _excludedPrefixDraft = args.Value?.ToString() ?? string.Empty" />
                    <button class="btn-secondary"
                            type="button"
                            disabled="@(Viewer.ExcludedMessagePrefixes.Count >= LogViewerViewModel.MaxExcludedMessagePrefixes || string.IsNullOrWhiteSpace(_excludedPrefixDraft))"
                            @onclick="AddExcludedPrefixAsync">
                        @Resources.Web_Settings_LogViewer_ExcludeAdd
                    </button>
                </div>
                <span class="settings-hint">
                    @string.Format(Resources.Web_Settings_LogViewer_ExcludeHint, LogViewerViewModel.MaxExcludedMessagePrefixes)
                </span>
                @if (Viewer.ExcludedMessagePrefixes.Count > 0)
                {
                    <div class="log-exclude-list">
                        @foreach (var prefix in Viewer.ExcludedMessagePrefixes)
                        {
                            <span class="log-exclude-chip">
                                <span title="@prefix">@prefix</span>
                                <button type="button"
                                        title="@Resources.Web_Settings_LogViewer_ExcludeRemove"
                                        @onclick="() => RemoveExcludedPrefixAsync(prefix)">×</button>
                            </span>
                        }
                    </div>
                }
            </div>
        </div>

        @if (Viewer.ErrorMessage is not null)
        {
            <div class="error-banner">@Viewer.ErrorMessage</div>
        }

        <div class="log-result-summary">
            <span class="log-result-counts">
                <span>@string.Format(Resources.Web_Settings_LogViewer_ResultCount, Viewer.Entries.Count)</span>
                @if (Viewer.HasMore)
                {
                    <span>@Resources.Web_Settings_LogViewer_HasMore</span>
                }
                @if (Viewer.IsLoading)
                {
                    <span>@Resources.Web_Settings_LogViewer_Updating</span>
                }
                else if (Viewer.IsLivePaused)
                {
                    <span>@Resources.Web_Settings_LogViewer_Paused</span>
                }
            </span>
            <span class="log-download">
                <button class="btn-primary"
                        type="button"
                        @onclick='() => Download("log")'
                        disabled="@(Viewer.SelectedSources.Count == 0)">
                    @Resources.Web_Settings_LogViewer_Download
                </button>
                <button class="btn-secondary btn-secondary--sm"
                        type="button"
                        @onclick='() => Download("ndjson")'
                        disabled="@(Viewer.SelectedSources.Count == 0)">
                    @Resources.Web_Settings_LogViewer_DownloadNdjson
                </button>
            </span>
        </div>

        <div class="log-table" role="table" aria-label="@Resources.Web_Settings_LogViewer_Title">
            <div class="log-table-head" role="row">
                <span role="columnheader">@Resources.Web_Settings_LogViewer_ColTime</span>
                <span role="columnheader">@Resources.Web_Settings_LogViewer_ColLevel</span>
                <span role="columnheader">@Resources.Web_Settings_LogViewer_ColSource</span>
                <span role="columnheader">@Resources.Web_Settings_LogViewer_Category</span>
                <span role="columnheader">@Resources.Web_Settings_LogViewer_ColMessage</span>
                <span role="columnheader" class="log-col-caret"></span>
            </div>
            <div class="log-list" role="rowgroup" aria-live="polite">
                @if (Viewer.Entries.Count == 0 && !Viewer.IsLoading)
                {
                    <div class="log-empty">@Resources.Web_Settings_LogViewer_Empty</div>
                }
                else
                {
                    @foreach (var entry in Viewer.Entries)
                    {
                        <details @key='$"{entry.Instance}:{entry.Sequence}"' class="log-row @(HasDetails(entry) ? "log-row--expandable" : "log-row--static")" role="row">
                            <summary class="log-row-summary">
                                <time title="@entry.TimestampUtc.ToString("O")">@entry.TimestampUtc.ToLocalTime().ToString("HH:mm:ss.fff")<span class="log-date">@entry.TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd")</span></time>
                                <span class="log-level log-level-@entry.Level.ToString().ToLowerInvariant()">@LevelLabel(entry.Level)</span>
                                <span class="log-source" title="@entry.Instance">@entry.Service</span>
                                <span class="log-category" title="@entry.Category">@ShortCategory(entry.Category)</span>
                                <span class="log-message" title="@entry.Message">@entry.Message</span>
                                <span class="log-caret" aria-hidden="true"></span>
                            </summary>
                            @if (HasDetails(entry))
                            {
                                <div class="log-row-detail">
                                    @if (!string.IsNullOrEmpty(entry.Exception))
                                    {
                                        <pre>@entry.Exception</pre>
                                    }
                                    <dl>
                                        <dt>UTC</dt><dd>@entry.TimestampUtc.ToString("O")</dd>
                                        <dt>@Resources.Web_Settings_LogViewer_Instance</dt><dd>@entry.Instance</dd>
                                        <dt>@Resources.Web_Settings_LogViewer_Category</dt><dd>@entry.Category</dd>
                                        @if (entry.EventId != 0 || entry.EventName is not null)
                                        {
                                            <dt>@Resources.Web_Settings_LogViewer_Event</dt><dd>@entry.EventId @entry.EventName</dd>
                                        }
                                        @if (entry.TraceId is not null)
                                        {
                                            <dt>@Resources.Web_Settings_LogViewer_Trace</dt><dd>@entry.TraceId</dd>
                                        }
                                        @if (entry.Properties is not null)
                                        {
                                            @foreach (var property in entry.Properties)
                                            {
                                                <dt>@property.Key</dt><dd>@property.Value</dd>
                                            }
                                        }
                                    </dl>
                                </div>
                            }
                        </details>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private CancellationTokenSource? _searchDelay;
    // Cancels the in-flight query when a newer filter change arrives, so rapid
    // toggling supersedes the previous full scan instead of queuing behind it.
    private CancellationTokenSource? _refreshCts;
    private Task? _refreshLoop;
    private string _excludedPrefixDraft = "";
    private bool _initialized;
    private bool _levelMenuOpen;

    private void ToggleLevelMenu() => _levelMenuOpen = !_levelMenuOpen;
    private void CloseLevelMenu() => _levelMenuOpen = false;

    // Load logs after the first render so selecting the Logging tab paints
    // immediately instead of blocking on the (possibly slow) initial query.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        // Capture the token before awaiting: a fast tab switch disposes _lifetime
        // during InitializeAsync, and reading _lifetime.Token afterwards throws
        // ObjectDisposedException.
        var token = _lifetime.Token;
        await Viewer.InitializeAsync(token);
        if (token.IsCancellationRequested)
            return;
        _initialized = true;
        if (Viewer.IsAuthorized)
            _refreshLoop = RunRefreshLoopAsync(token);
        StateHasChanged();
    }

    private async Task QueueRefreshAsync()
    {
        var previous = _refreshCts;
        var cts = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        _refreshCts = cts;
        previous?.Cancel();
        previous?.Dispose();
        try
        {
            await Viewer.RefreshAsync(cts.Token);
            StateHasChanged();
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
        }
    }

    private async Task SourceChangedAsync(string source, ChangeEventArgs args)
    {
        var selected = args.Value is bool value
            ? value
            : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
        Viewer.SetSourceSelected(source, selected);
        await QueueRefreshAsync();
    }

    private async Task LevelChangedAsync(LogLevel level, ChangeEventArgs args)
    {
        var selected = args.Value is bool value
            ? value
            : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
        Viewer.SetLevelSelected(level, selected);
        await QueueRefreshAsync();
    }

    private string LevelSummary
    {
        get
        {
            var names = Viewer.Levels.Where(Viewer.SelectedLevels.Contains).Select(LevelLabel).ToList();
            return names.Count > 0 ? string.Join(", ", names) : Resources.Web_Settings_LogViewer_LevelsNone;
        }
    }

    private async Task LiveChangedAsync(ChangeEventArgs args)
    {
        var enabled = args.Value is bool value
            ? value
            : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
        Viewer.IsLivePaused = !enabled;
        if (enabled)
            await QueueRefreshAsync();
    }

    private async Task DateChangedAsync(ChangeEventArgs args)
    {
        Viewer.FilterDateUtc = DateOnly.TryParse(args.Value?.ToString(), out var date) ? date : null;
        await QueueRefreshAsync();
    }

    private async Task SearchChangedAsync(ChangeEventArgs args)
    {
        Viewer.SearchText = args.Value?.ToString() ?? "";
        var previousDelay = _searchDelay;
        var delay = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        _searchDelay = delay;
        previousDelay?.Cancel();
        previousDelay?.Dispose();
        try
        {
            await Task.Delay(400, delay.Token);
            await QueueRefreshAsync();
        }
        catch (OperationCanceledException) when (delay.IsCancellationRequested)
        {
        }
    }

    private async Task AddExcludedPrefixAsync()
    {
        if (!Viewer.TryAddExcludedMessagePrefix(_excludedPrefixDraft))
            return;
        _excludedPrefixDraft = "";
        await QueueRefreshAsync();
    }

    private async Task RemoveExcludedPrefixAsync(string prefix)
    {
        if (Viewer.RemoveExcludedMessagePrefix(prefix))
            await QueueRefreshAsync();
    }

    private void Download(string format)
    {
        var url = Viewer.CreateDownloadUrl(Navigation.BaseUri, format);
        if (!string.IsNullOrEmpty(url))
            Navigation.NavigateTo(url, forceLoad: true);
    }

    private async Task RunRefreshLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                // A search may scan the complete retention window. Do not repeat
                // that work every few seconds; live polling resumes when it is cleared.
                if (!Viewer.IsLivePaused && string.IsNullOrWhiteSpace(Viewer.SearchText))
                {
                    var before = Viewer.TopSignature;
                    await Viewer.LiveRefreshAsync(cancellationToken);
                    // Only re-render (and push a SignalR diff) when the result
                    // actually changed; an idle tick must not lag the page.
                    if (Viewer.TopSignature != before)
                        await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    // Service ids are lowercase directory names (web, host, …); title-case them
    // for display without touching the id used for selection and queries.
    private static string DisplayName(string source)
        => string.IsNullOrEmpty(source) ? source : char.ToUpperInvariant(source[0]) + source[1..];

    private static string ShortCategory(string category)
        => category[(category.LastIndexOf('.') + 1)..];

    private static string LevelLabel(LogLevel level) => level switch
    {
        LogLevel.Information => Resources.Web_Settings_LogViewer_LevelInformation,
        LogLevel.Warning => Resources.Web_Settings_LogViewer_LevelWarning,
        LogLevel.Error => Resources.Web_Settings_LogViewer_LevelError,
        LogLevel.Critical => Resources.Web_Settings_LogViewer_LevelCritical,
        _ => level.ToString()
    };

    private static bool HasDetails(LogArchiveEntry entry)
        => entry.Exception is not null || entry.Properties is not null || entry.EventId != 0 || entry.TraceId is not null;

    public async ValueTask DisposeAsync()
    {
        _searchDelay?.Cancel();
        _searchDelay?.Dispose();
        _refreshCts?.Cancel();
        _refreshCts?.Dispose();
        _lifetime.Cancel();
        if (_refreshLoop is not null)
        {
            try { await _refreshLoop; } catch (OperationCanceledException) { }
        }
        _lifetime.Dispose();
    }
}
