@using Kaimo_File_Server.Core.Language

<div class="detail-section">
    <span class="detail-label">@R("Web_Settings_Pw_Title")</span>
    <p class="settings-description">@R("Web_Settings_Pw_Desc")</p>
    <div class="settings-row settings-row-spaced">
        <label class="settings-field-label">@R("Web_Settings_Pw_MinLength")</label>
        <input type="number" min="1" max="128" class="edit-input settings-number" @bind="VM.PwPolicy.MinLength" />
    </div>
    <label class="pw-rule"><input type="checkbox" @bind="VM.PwPolicy.RequireUppercase" /><span>@R("Web_Settings_Pw_RequireUppercase")</span></label>
    <label class="pw-rule"><input type="checkbox" @bind="VM.PwPolicy.RequireLowercase" /><span>@R("Web_Settings_Pw_RequireLowercase")</span></label>
    <label class="pw-rule"><input type="checkbox" @bind="VM.PwPolicy.RequireDigit" /><span>@R("Web_Settings_Pw_RequireDigit")</span></label>
    <label class="pw-rule"><input type="checkbox" @bind="VM.PwPolicy.RequireSpecial" /><span>@R("Web_Settings_Pw_RequireSpecial")</span></label>
    <div class="settings-actions"><button class="btn-primary" @onclick="SavePolicy">@Resources.Web_Settings_Button_Save</button></div>
</div>

<div class="detail-section">
    <span class="detail-label">@R("Web_Settings_Session_Title")</span>
    <p class="settings-description">@R("Web_Settings_Session_Desc")</p>
    <div class="settings-row">
        <label class="settings-field-label">@R("Web_Settings_Session_Interval")</label>
        <input type="number" min="@SettingsViewModel.MinSessionRevalidationSeconds" max="@SettingsViewModel.MaxSessionRevalidationSeconds"
               class="edit-input settings-number" @bind="VM.SessionRevalidationSeconds" />
    </div>
    <p class="settings-description">@string.Format(R("Web_Settings_Session_Allowed"), SettingsViewModel.MinSessionRevalidationSeconds, SettingsViewModel.MaxSessionRevalidationSeconds)</p>
    <div class="settings-actions"><button class="btn-primary" @onclick="SaveSession">@Resources.Web_Settings_Button_Save</button></div>
</div>

@code {
    [Parameter, EditorRequired] public SettingsViewModel VM { get; set; } = default!;
    private static string R(string key) => Resources.ResourceManager.GetString(key) ?? key;
    private async Task SavePolicy() { await VM.SavePasswordPolicyAsync(); StateHasChanged(); }
    private async Task SaveSession() { await VM.SaveSessionSecurityAsync(); StateHasChanged(); }
}
