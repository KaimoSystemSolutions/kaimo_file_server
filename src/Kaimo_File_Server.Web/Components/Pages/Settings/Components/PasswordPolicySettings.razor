@using Kaimo_File_Server.Core.Language

<div class="detail-section">
    <span class="detail-label">Passwort-Anforderungen</span>
    <p class="settings-description">Diese Regeln gelten global beim Anlegen und Ändern von Benutzerpasswörtern.</p>
    <div class="settings-row settings-row-spaced">
        <label class="settings-field-label">Mindestlänge</label>
        <input type="number" min="1" max="128" class="edit-input settings-number" @bind="VM.PwPolicy.MinLength" />
    </div>
    <label class="pw-rule"><input type="checkbox" @bind="VM.PwPolicy.RequireUppercase" /><span>Großbuchstabe erforderlich (A–Z)</span></label>
    <label class="pw-rule"><input type="checkbox" @bind="VM.PwPolicy.RequireLowercase" /><span>Kleinbuchstabe erforderlich (a–z)</span></label>
    <label class="pw-rule"><input type="checkbox" @bind="VM.PwPolicy.RequireDigit" /><span>Ziffer erforderlich (0–9)</span></label>
    <label class="pw-rule"><input type="checkbox" @bind="VM.PwPolicy.RequireSpecial" /><span>Sonderzeichen erforderlich (z. B. ! ? # $)</span></label>
    <div class="settings-actions"><button class="btn-primary" @onclick="SavePolicy">@Resources.Web_Settings_Button_Save</button></div>
</div>

<div class="detail-section">
    <span class="detail-label">Sitzungssicherheit</span>
    <p class="settings-description">Wie oft eine aktive Sitzung prüft, ob das Konto noch aktiv ist. Wird ein Benutzer deaktiviert, verliert er seine Sitzung innerhalb dieses Intervalls.</p>
    <div class="settings-row">
        <label class="settings-field-label">Prüfintervall (Sekunden)</label>
        <input type="number" min="@SettingsViewModel.MinSessionRevalidationSeconds" max="@SettingsViewModel.MaxSessionRevalidationSeconds"
               class="edit-input settings-number" @bind="VM.SessionRevalidationSeconds" />
    </div>
    <p class="settings-description">Erlaubt: @SettingsViewModel.MinSessionRevalidationSeconds–@SettingsViewModel.MaxSessionRevalidationSeconds Sekunden.</p>
    <div class="settings-actions"><button class="btn-primary" @onclick="SaveSession">@Resources.Web_Settings_Button_Save</button></div>
</div>

@code {
    [Parameter, EditorRequired] public SettingsViewModel VM { get; set; } = default!;
    private async Task SavePolicy() { await VM.SavePasswordPolicyAsync(); StateHasChanged(); }
    private async Task SaveSession() { await VM.SaveSessionSecurityAsync(); StateHasChanged(); }
}
