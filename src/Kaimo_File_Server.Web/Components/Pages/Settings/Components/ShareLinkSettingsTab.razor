@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Web.DynamicHelpers
@using Kaimo_File_Server.Web.Services
@inherits AppComponentBase
@inject ShareLinkService ShareLinks
@inject ToastService Toasts

@*
    Settings tab for public share links: the default-domain restriction, the global switch for
    download links, and the global switch and per-file size ceiling for upload links. The address link URLs are built from lives in the
    Domains tab.
*@

<div class="settings-section">
    <h2>@T("Web_Settings_Tab_ShareLinks", "Share Links")</h2>
    <p class="settings-hint">
        @T("Web_ShareLinkSettings_Hint", "Link URLs are built from the default domain; without one, from the address the browser currently uses.")
    </p>
    <a class="btn-secondary btn-secondary--sm sharelink-domains-link" href="/settings?tab=Domains">
        @Assets.SVG("arrow_right.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
        <span>@T("Web_Settings_Tab_Domains", "Domains")</span>
    </a>

    @if (_notPermitted)
    {
        <div class="error-banner">@Resources.Web_Settings_NoPermissionChange</div>
    }

    <div class="toggle-row sharelink-toggle-row">
        <span class="label-with-info">
            @T("Web_ShareLinkSettings_RestrictToDefaultDomain", "Open links only under the default domain")
            <InfoButton Text="@T("Web_ShareLinkSettings_RestrictToDefaultDomainHint", "Download and upload links are unavailable under any other address. Without a default domain, links open under every address.")" />
        </span>
        <label class="toggle-switch">
            <input type="checkbox" @bind="_restrictToDefaultDomain"
                   aria-label="@T("Web_ShareLinkSettings_RestrictToDefaultDomain", "Open links only under the default domain")" />
            <span class="toggle-slider"></span>
        </label>
    </div>

    <h3>@T("Web_ShareLinkSettings_DownloadTitle", "Download links")</h3>
    <p class="settings-hint">
        @T("Web_ShareLinkSettings_DownloadHint", "Download links let anonymous visitors download a file or folder. While disabled, no download link can be created and existing ones do not open.")
    </p>

    <div class="toggle-row sharelink-toggle-row">
        <span class="toggle-label-text">@T("Web_Settings_AllowDownloadLinks", "Enable download links")</span>
        <label class="toggle-switch">
            <input type="checkbox" @bind="_allowDownloadLinks"
                   aria-label="@T("Web_Settings_AllowDownloadLinks", "Enable download links")" />
            <span class="toggle-slider"></span>
        </label>
    </div>

    <h3>@T("Web_ShareLinkSettings_UploadTitle", "Upload links")</h3>
    <p class="settings-hint">
        @T("Web_ShareLinkSettings_UploadHint", "Upload links let anonymous visitors upload files into a folder. While disabled, no upload link can be created and existing ones accept no files.")
    </p>

    <div class="toggle-row sharelink-toggle-row">
        <span class="toggle-label-text">@T("Web_Settings_AllowUploadLinks", "Enable upload links")</span>
        <label class="toggle-switch">
            <input type="checkbox" @bind="_allowUploadLinks"
                   aria-label="@T("Web_Settings_AllowUploadLinks", "Enable upload links")" />
            <span class="toggle-slider"></span>
        </label>
    </div>

    <label class="sharelink-check">
        <span>@T("Web_ShareLinkSettings_MaxUploadSize", "Max. file size per upload (MB, up to 4096)")</span>
        <input type="number" min="1" max="@(ShareLinkSettings.DefaultMaxUploadFileSizeBytes / Mb)" class="edit-input sharelink-size-input"
               @bind="_maxUploadMb" />
    </label>

    <div class="sharelink-actions">
        <button class="btn-primary" @onclick="SaveAsync">@T("Web_Button_Save", "Save")</button>
    </div>
</div>

@code {
    private ShareLinkSettings _settings = ShareLinkSettings.Default();
    private bool _allowUploadLinks;
    private bool _allowDownloadLinks = true;
    private bool _restrictToDefaultDomain = true;
    private long _maxUploadMb = ShareLinkSettings.DefaultMaxUploadFileSizeBytes / Mb;
    private bool _notPermitted;

    private const long Mb = 1024 * 1024;

    private static string T(string key, string fallback)
        => Resources.ResourceManager.GetString(key) ?? fallback;

    protected override async Task OnInitializedAsync() => Apply(await ShareLinks.GetSettingsAsync());

    private void Apply(ShareLinkSettings settings)
    {
        _settings = settings;
        _allowUploadLinks = settings.AllowUploadLinks;
        _allowDownloadLinks = settings.AllowDownloadLinks;
        _restrictToDefaultDomain = settings.RestrictToDefaultDomain;
        _maxUploadMb = settings.MaxUploadFileSizeBytes / Mb;
    }

    private async Task SaveAsync()
    {
        _notPermitted = false;
        try
        {
            // Keep the legacy address fields as stored: they seed the Domains tab until it is saved.
            await ShareLinks.SaveSettingsAsync(new ShareLinkSettings
            {
                BaseAddresses = _settings.BaseAddresses.ToList(),
                DefaultIndex = _settings.DefaultIndex,
                AllowUploadLinks = _allowUploadLinks,
                AllowDownloadLinks = _allowDownloadLinks,
                RestrictToDefaultDomain = _restrictToDefaultDomain,
                MaxUploadFileSizeBytes = _maxUploadMb * Mb,
            });
            Toasts.Show(Resources.Web_ChangesSaved, ToastType.Success);
        }
        catch (UnauthorizedAccessException)
        {
            _notPermitted = true;
            Toasts.Show(Resources.Web_Settings_NoPermissionChange, ToastType.Error);
        }
        Apply(await ShareLinks.GetSettingsAsync());
    }
}
