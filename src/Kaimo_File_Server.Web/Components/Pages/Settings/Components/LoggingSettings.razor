@using Kaimo_File_Server.Core.Language

@if (VM.CanManageSettings)
{
<div class="detail-section logging-global-section">
    <span class="detail-label">@Resources.Web_Settings_Logging_Detail</span>
    <p class="settings-description">@Resources.Web_Settings_Logging_Desc</p>
    @if (VM.LogLevelEnvironmentOverride is not null)
    {
        <p class="settings-description">
            @string.Format(Resources.Web_Settings_Logging_EnvironmentOverride,
                VM.LogLevelEnvironmentOverride)
        </p>
    }
    <div class="settings-row logging-level-row">
        <select class="edit-input settings-select" @bind="VM.LogLevel">
            @foreach (var level in SettingsViewModel.LogLevels) { <option value="@level">@level</option> }
        </select>
        <button class="btn-primary" @onclick="Save">@Resources.Web_Settings_Button_Save</button>
    </div>
</div>
}

@if (VM.CanViewLogs)
{
    <LogViewer />
}

@code {
    [Parameter, EditorRequired] public SettingsViewModel VM { get; set; } = default!;
    private async Task Save() { await VM.SaveLoggingAsync(); StateHasChanged(); }
}
