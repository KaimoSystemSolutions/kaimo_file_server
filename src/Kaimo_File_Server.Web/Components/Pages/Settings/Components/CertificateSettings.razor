
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Web.DynamicHelpers
@using Kaimo_File_Server.Web.Services.Https
@using Microsoft.AspNetCore.Components.Forms
@inject AssetProvider Icons

<div class="detail-section">
    <span class="detail-label">@R("Web_Settings_Cert_Title")</span>
    <p class="settings-description">@R("Web_Settings_Cert_Desc")</p>
    @if (VM.HasCertificate)
    {
        <div class="info-card">
            <div class="info-row"><span class="info-key">@R("Web_Settings_Cert_Subject")</span><span class="info-val">@VM.CertSubject</span></div>
            <div class="info-row"><span class="info-key">@R("Web_Settings_Cert_Type")</span><span class="info-val">@(VM.CertIsSelfSigned ? R("Web_Settings_Cert_SelfSigned") : R("Web_Settings_Cert_Custom")) · @(VM.CertSettings.Mode == CertificateMode.Auto ? R("Web_Settings_Cert_AutoRenew") : R("Web_Settings_Cert_NoRenew"))</span></div>
            <div class="info-row"><span class="info-key">@R("Web_Settings_Cert_Issued")</span><span class="info-val">@(VM.CertIssuedUtc?.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? "—")</span></div>
            <div class="info-row"><span class="info-key">@R("Web_Settings_Cert_Expires")</span><span class="info-val @(VM.CertDaysRemaining is <= 21 ? "is-muted" : "")">@(VM.CertExpiresUtc?.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? "—") @if (VM.CertDaysRemaining is { } d) { <text>(@(d >= 0 ? string.Format(R("Web_Settings_Cert_DaysRemaining"), d) : string.Format(R("Web_Settings_Cert_DaysExpired"), -d)))</text> }</span></div>
            <div class="info-row"><span class="info-key">@R("Web_Settings_Cert_Thumbprint")</span><span class="info-val is-muted">@VM.CertThumbprint</span></div>
            @if (VM.CertSans.Count > 0) { <div class="info-row"><span class="info-key">@R("Web_Settings_Cert_Sans")</span><span class="info-val">@string.Join(" · ", VM.CertSans)</span></div> }
        </div>
        <div class="settings-row settings-actions settings-wrap">
            @if (_crtHref is not null) { <a class="btn-primary settings-download" href="@_crtHref" download="kaimo-fileserver.crt">@R("Web_Settings_Cert_DownloadCrt")</a> }
            @if (_pemHref is not null) { <a class="btn-icon settings-download" href="@_pemHref" download="kaimo-fileserver.pem" title="@R("Web_Settings_Cert_DownloadPem")">.pem</a> }
            <button class="btn-icon" title="@R("Web_Settings_Cert_Refresh")" @onclick="Refresh">@Icons.SVG("refresh.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))</button>
        </div>
    }
    else { <p class="settings-empty">@R("Web_Settings_Cert_None")</p> }
</div>

<div class="detail-section cert-form">
    <span class="detail-label">@R("Web_Settings_Cert_AutoTitle")</span>
    <p class="settings-description">@R("Web_Settings_Cert_AutoDesc")</p>
    <div class="settings-row settings-row-spaced"><label class="settings-field-label">@R("Web_Settings_Cert_Lifetime")</label><select class="edit-input settings-select" @bind="VM.CertSettings.LifetimeDays"><option value="@HttpsCertificateSettings.LifetimeOneMonth">@R("Web_Settings_Cert_Lifetime1M")</option><option value="@HttpsCertificateSettings.LifetimeThreeMonths">@R("Web_Settings_Cert_Lifetime3M")</option></select></div>
    <div class="settings-row settings-row-spaced"><label class="settings-field-label">@R("Web_Settings_Cert_CommonName")</label><input type="text" class="edit-input settings-text" placeholder="@R("Web_Settings_Cert_CommonNamePlaceholder")" @bind="VM.CertSettings.CommonName" /></div>
    <div class="settings-row settings-row-spaced"><label class="settings-field-label">@R("Web_Settings_Cert_AdditionalNames")</label><input type="text" class="edit-input settings-text" placeholder="fileserver.local, 10.0.0.5" @bind="VM.CertAdditionalSansText" /></div>
    <div class="settings-row settings-actions"><button class="btn-primary" @onclick="SaveSettings">@R("Web_Settings_Cert_SaveRegenerate")</button><button class="btn-icon" title="@R("Web_Settings_Cert_RegenerateNow")" @onclick="Regenerate">@Icons.SVG("refresh.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))</button></div>
</div>

<div class="detail-section cert-form">
    <span class="detail-label">@R("Web_Settings_Cert_UploadTitle")</span>
    <p class="settings-description">@((MarkupString)R("Web_Settings_Cert_UploadDesc"))</p>
    <div class="settings-row settings-row-spaced"><label class="settings-field-label">@R("Web_Settings_Cert_FileCert")</label>
        <label class="file-picker">
            <span class="btn-secondary file-picker-btn">@R("Web_Settings_Cert_ChooseFile")</span>
            <InputFile OnChange="OnCertFileSelected" accept=".pfx,.p12,.pem,.crt,.cer" />
            <span class="file-picker-name @(_pendingCertName.Length == 0 ? "is-muted" : "")">@(_pendingCertName.Length > 0 ? _pendingCertName : R("Web_Settings_Cert_NoFile"))</span>
        </label>
    </div>
    <div class="settings-row settings-row-spaced"><label class="settings-field-label">@R("Web_Settings_Cert_FileKey")</label>
        <label class="file-picker">
            <span class="btn-secondary file-picker-btn">@R("Web_Settings_Cert_ChooseFile")</span>
            <InputFile OnChange="OnKeyFileSelected" accept=".key,.pem,.der" />
            <span class="file-picker-name @(_pendingKeyName.Length == 0 ? "is-muted" : "")">@(_pendingKeyName.Length > 0 ? _pendingKeyName : R("Web_Settings_Cert_NoFile"))</span>
        </label>
    </div>
    <div class="settings-row settings-row-spaced"><label class="settings-field-label">@R("Web_Settings_Cert_Password")</label><input type="password" class="edit-input settings-select" @bind="VM.CustomCertPassword" /></div>
    <div class="settings-row settings-actions"><button class="btn-primary" disabled="@(_pendingCert is null)" @onclick="Import">@R("Web_Settings_Cert_Apply")</button></div>
</div>

@code {
    private const long MaxCertUploadSize = 512 * 1024;
    [Parameter, EditorRequired] public SettingsViewModel VM { get; set; } = default!;
    private static string R(string key) => Resources.ResourceManager.GetString(key) ?? key;
    private string? _crtHref;
    private string? _pemHref;
    private byte[]? _pendingCert;
    private string _pendingCertName = "";
    private byte[]? _pendingKey;
    private string _pendingKeyName = "";

    protected override void OnParametersSet() => BuildDownloadLinks();
    private void BuildDownloadLinks() { var der = VM.GetPublicCertDerBase64(); var pem = VM.GetPublicCertPemBase64(); _crtHref = der is null ? null : $"data:application/x-x509-ca-cert;base64,{der}"; _pemHref = pem is null ? null : $"data:application/x-pem-file;base64,{pem}"; }
    private async Task Refresh() { await VM.LoadCertificateStateAsync(); BuildDownloadLinks(); StateHasChanged(); }
    private async Task SaveSettings() { await VM.SaveCertificateSettingsAsync(); BuildDownloadLinks(); StateHasChanged(); }
    private async Task Regenerate() { await VM.RegenerateCertificateNowAsync(); BuildDownloadLinks(); StateHasChanged(); }
    private async Task OnCertFileSelected(InputFileChangeEventArgs e) { _pendingCertName = e.File.Name; using var ms = new MemoryStream(); await e.File.OpenReadStream(MaxCertUploadSize).CopyToAsync(ms); _pendingCert = ms.ToArray(); }
    private async Task OnKeyFileSelected(InputFileChangeEventArgs e) { _pendingKeyName = e.File.Name; using var ms = new MemoryStream(); await e.File.OpenReadStream(MaxCertUploadSize).CopyToAsync(ms); _pendingKey = ms.ToArray(); }
    private async Task Import() { if (_pendingCert is null) return; if (await VM.ImportCustomCertificateAsync(_pendingCert, _pendingKey)) { _pendingCert = null; _pendingCertName = ""; _pendingKey = null; _pendingKeyName = ""; } BuildDownloadLinks(); StateHasChanged(); }
}
