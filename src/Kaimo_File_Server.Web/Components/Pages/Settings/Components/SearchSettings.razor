
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Web.DynamicHelpers
@inject AssetProvider Icons

<div class="detail-section">
    <span class="detail-label">Volltext-Suche (Elasticsearch)</span>
    <p class="settings-description">Ist Elasticsearch aktiviert und erreichbar, werden Dateiinhalte indexiert und durchsuchbar. Andernfalls – oder wenn der Container nicht gestartet wurde – wird automatisch eine einfache Suche nach Dateinamen verwendet.</p>
    <div class="service-row">
        <div class="service-info"><span class="service-name">Elasticsearch</span><span class="service-status service-status--@(VM.SearchEsEffective ? "running" : "stopped")">@SearchStatusLabel()</span></div>
        <label class="toggle-switch" title="Elasticsearch aktivieren/deaktivieren"><input type="checkbox" @bind="VM.SearchEsEnabled" /><span class="toggle-slider"></span></label>
    </div>
    <div class="info-card">
        <div class="info-row"><span class="info-key">Gewünscht</span><span class="info-val">@(VM.SearchEsEnabled ? "Aktiviert" : "Deaktiviert")</span></div>
        <div class="info-row"><span class="info-key">Container erreichbar</span><span class="info-val @(VM.SearchEsReachable ? "" : "is-muted")">@(VM.SearchEsReachable ? "Ja" : "Nein")</span></div>
        <div class="info-row"><span class="info-key">Aktiver Modus</span><span class="info-val">@(VM.SearchEsEffective ? "Elasticsearch (Volltext)" : "Dateinamen-Suche")</span></div>
    </div>
    <div class="settings-row settings-actions">
        <button class="btn-primary" @onclick="Save">@Resources.Web_Settings_Button_Save</button>
        <button class="btn-icon" title="Status aktualisieren" @onclick="Refresh">@Icons.SVG("refresh.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))</button>
    </div>
    <span class="detail-label settings-subheading">Manuelle Indexierung</span>
    <p class="settings-description">Indexiert alle Dateien neu – z. B. wenn Dateien auf anderem Wege hinzugekommen sind oder Elasticsearch zuvor deaktiviert war. Bereits indexierte, unveränderte Dateien werden übersprungen.</p>
    @if (VM.ReindexProgress.Running)
    {
        <div class="usage-bar"><div class="usage-bar-fill" style="width: @VM.ReindexProgress.Percent%;"></div></div>
        <p class="settings-hint">Indexiere… @VM.ReindexProgress.Done / @VM.ReindexProgress.Total (@VM.ReindexProgress.Percent %)</p>
    }
    else if (VM.ReindexProgress.FinishedAt is not null)
    {
        <p class="settings-hint">@(VM.ReindexProgress.Error is null ? $"Letzter Lauf abgeschlossen: {VM.ReindexProgress.Done} / {VM.ReindexProgress.Total} Dateien." : $"Letzter Lauf mit Fehler beendet: {VM.ReindexProgress.Error}")</p>
    }
    <div class="settings-row settings-actions">
        <button class="btn-primary" disabled="@(!VM.SearchEsEffective || VM.ReindexProgress.Running)" @onclick="StartReindex">Indexierung starten</button>
        <button class="btn-icon" title="Fortschritt aktualisieren" @onclick="Refresh">@Icons.SVG("refresh.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public SettingsViewModel VM { get; set; } = default!;
    private async Task Save() { await VM.SaveSearchAsync(); StateHasChanged(); }
    private async Task Refresh() { await VM.LoadSearchStateAsync(); StateHasChanged(); }
    private async Task StartReindex() { await VM.StartReindexAsync(); StateHasChanged(); }
    private string SearchStatusLabel() => VM.SearchEsEffective ? "Aktiv" : VM.SearchEsEnabled && !VM.SearchEsReachable ? "Nicht erreichbar" : "Dateinamen-Modus";
}
