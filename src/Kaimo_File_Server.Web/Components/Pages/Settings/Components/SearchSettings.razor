
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Web.DynamicHelpers
@inject AssetProvider Icons

<div class="detail-section">
    <span class="detail-label">@R("Web_Settings_Search_Title")</span>
    <p class="settings-description">@R("Web_Settings_Search_Description")</p>
    @if (VM.SearchStateLoading)
    {
        <div class="loading-state"><div class="spinner"></div><p>@R("Web_Settings_Search_CheckingStatus")</p></div>
    }
    else
    {
    <div class="service-row">
        <div class="service-info"><span class="service-name">Elasticsearch</span><span class="service-status service-status--@(VM.SearchEsEffective ? "running" : "stopped")">@SearchStatusLabel()</span></div>
        <label class="toggle-switch" title="@R("Web_Settings_Search_Toggle")"><input type="checkbox" @bind="VM.SearchEsEnabled" /><span class="toggle-slider"></span></label>
    </div>
    <div class="info-card">
        <div class="info-row"><span class="info-key">@R("Web_Settings_Search_Desired")</span><span class="info-val">@(VM.SearchEsEnabled ? R("Web_Common_Enabled") : R("Web_Common_Disabled"))</span></div>
        <div class="info-row"><span class="info-key">@R("Web_Settings_Search_ContainerReachable")</span><span class="info-val @(VM.SearchEsReachable ? "" : "is-muted")">@(VM.SearchEsReachable ? R("Web_Common_Yes") : R("Web_Common_No"))</span></div>
        <div class="info-row"><span class="info-key">@R("Web_Settings_Search_ActiveMode")</span><span class="info-val">@(VM.SearchEsEffective ? R("Web_Settings_Search_ModeFulltext") : R("Web_Settings_Search_ModeFilename"))</span></div>
    </div>
    <div class="settings-row settings-actions">
        <button class="btn-primary" @onclick="Save">@Resources.Web_Settings_Button_Save</button>
        <button class="btn-icon" title="@R("Web_Settings_Search_RefreshStatus")" @onclick="Refresh">@Icons.SVG("refresh.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))</button>
    </div>
    <span class="detail-label settings-subheading">@R("Web_Settings_Search_ReindexTitle")</span>
    <p class="settings-description">@R("Web_Settings_Search_ReindexDescription")</p>
    @if (VM.ReindexProgress.Running)
    {
        <div class="usage-bar"><div class="usage-bar-fill" style="width: @VM.ReindexProgress.Percent%;"></div></div>
        <p class="settings-hint">@string.Format(R("Web_Settings_Search_Indexing"), VM.ReindexProgress.Done, VM.ReindexProgress.Total, VM.ReindexProgress.Percent)</p>
    }
    else if (VM.ReindexProgress.FinishedAt is not null)
    {
        <p class="settings-hint">@(VM.ReindexProgress.Error is null ? string.Format(R("Web_Settings_Search_LastRunDone"), VM.ReindexProgress.Done, VM.ReindexProgress.Total) : string.Format(R("Web_Settings_Search_LastRunError"), VM.ReindexProgress.Error))</p>
    }
    <div class="settings-row settings-actions">
        <button class="btn-primary" disabled="@(!VM.SearchEsEffective || VM.ReindexProgress.Running)" @onclick="StartReindex">@R("Web_Settings_Search_StartReindex")</button>
        <button class="btn-icon" title="@R("Web_Settings_Search_RefreshProgress")" @onclick="Refresh">@Icons.SVG("refresh.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))</button>
    </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public SettingsViewModel VM { get; set; } = default!;
    private static string R(string key) => Resources.ResourceManager.GetString(key) ?? key;
    private async Task Save() { await VM.SaveSearchAsync(); StateHasChanged(); }
    private async Task Refresh() { await VM.LoadSearchStateAsync(); StateHasChanged(); }
    private async Task StartReindex() { await VM.StartReindexAsync(); StateHasChanged(); }
    private string SearchStatusLabel() => VM.SearchEsEffective ? R("Web_Settings_Search_StatusActive") : VM.SearchEsEnabled && !VM.SearchEsReachable ? R("Web_Settings_Search_StatusUnreachable") : R("Web_Settings_Search_StatusFilenameMode");
}
