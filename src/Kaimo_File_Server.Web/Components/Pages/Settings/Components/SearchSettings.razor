
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Search
@using Kaimo_File_Server.Web.DynamicHelpers
@inject AssetProvider Icons

<div class="detail-section">
    <span class="detail-label">@R("Web_Settings_Search_Title")</span>
    <p class="settings-description">@R("Web_Settings_Search_Description")</p>
    @if (VM.SearchStateLoading)
    {
        <div class="loading-state"><div class="spinner"></div><p>@R("Web_Settings_Search_CheckingStatus")</p></div>
    }
    else
    {
    <div class="service-row">
        <div class="service-info"><span class="service-name">Elasticsearch</span><span class="service-status service-status--@(VM.SearchEsEffective ? "running" : "stopped")">@EsStatusLabel()</span></div>
        <label class="toggle-switch" title="@R("Web_Settings_Search_Toggle")"><input type="checkbox" checked="@VM.SearchEsEnabled" @onchange="e => VM.ToggleSearchEngine(SearchEngine.Elasticsearch, e.Value is true)" /><span class="toggle-slider"></span></label>
    </div>
    <div class="service-row">
        <div class="service-info"><span class="service-name">@R("Web_Settings_Search_LocalName")</span><span class="service-status service-status--@(VM.SearchLocalEffective ? "running" : "stopped")">@(VM.SearchLocalEffective ? R("Web_Settings_Search_StatusActive") : R("Web_Settings_Search_StatusInactive"))</span></div>
        <label class="toggle-switch" title="@R("Web_Settings_Search_LocalToggle")"><input type="checkbox" checked="@VM.SearchLocalEnabled" @onchange="e => VM.ToggleSearchEngine(SearchEngine.Local, e.Value is true)" /><span class="toggle-slider"></span></label>
    </div>
    <div class="info-card">
        <div class="info-row"><span class="info-key">@R("Web_Settings_Search_Desired")</span><span class="info-val">@EngineLabel(VM.SearchEngineSelected)</span></div>
        @if (VM.SearchLocalEnabled)
        {
            <div class="info-row"><span class="info-key">@R("Web_Settings_Search_LocalDocuments")</span><span class="info-val">@(VM.LocalIndexStats?.Documents.ToString("N0") ?? "–")</span></div>
            <div class="info-row"><span class="info-key">@R("Web_Settings_Search_LocalSize")</span><span class="info-val">@(VM.LocalIndexStats is { } stats ? VM.FormatBytes(stats.Bytes) : "–")</span></div>
        }
        else
        {
            <div class="info-row"><span class="info-key">@R("Web_Settings_Search_ContainerReachable")</span><span class="info-val @(VM.SearchEsReachable ? "" : "is-muted")">@(VM.SearchEsReachable ? R("Web_Common_Yes") : R("Web_Common_No"))</span></div>
        }
        <div class="info-row"><span class="info-key">@R("Web_Settings_Search_ActiveMode")</span><span class="info-val">@ActiveModeLabel()</span></div>
    </div>
    <div class="settings-row settings-actions">
        <button class="btn-primary" @onclick="Save">@Resources.Web_Settings_Button_Save</button>
        <button class="btn-icon" title="@R("Web_Settings_Search_RefreshStatus")" @onclick="Refresh">@Icons.SVG("refresh.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))</button>
    </div>
    <span class="detail-label settings-subheading">@R("Web_Settings_Search_ReindexTitle")</span>
    <p class="settings-description">@R("Web_Settings_Search_ReindexDescription")</p>
    @if (VM.ReindexProgress.Running)
    {
        <div class="usage-bar"><div class="usage-bar-fill" style="width: @VM.ReindexProgress.Percent%;"></div></div>
        <p class="settings-hint">@string.Format(R("Web_Settings_Search_Indexing"), VM.ReindexProgress.Done, VM.ReindexProgress.Total, VM.ReindexProgress.Percent)</p>
        <div class="settings-row settings-actions">
            <button class="btn-danger-outline" @onclick="CancelReindex">@R("Web_Settings_Search_CancelReindex")</button>
        </div>
    }
    else if (VM.ReindexProgress.FinishedAt is not null)
    {
        <p class="settings-hint">@ReindexResultText()</p>
    }
    <div class="settings-row settings-actions">
        <select class="edit-input settings-select" @bind="VM.ReindexSelectedShare" disabled="@VM.ReindexProgress.Running">
            <option value="">@R("Web_Settings_Search_ReindexAllShares")</option>
            @foreach (var share in VM.ReindexShares) { <option value="@share">@share</option> }
        </select>
        <button class="btn-primary" disabled="@(!VM.SearchIndexEffective || VM.ReindexProgress.Running)" @onclick="StartReindex">@R("Web_Settings_Search_StartReindex")</button>
        <button class="btn-icon" title="@R("Web_Settings_Search_RefreshProgress")" @onclick="Refresh">@Icons.SVG("refresh.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))</button>
    </div>
    }
</div>

@implements IDisposable
@code {
    [Parameter, EditorRequired] public SettingsViewModel VM { get; set; } = default!;
    private static string R(string key) => Resources.ResourceManager.GetString(key) ?? key;
    private async Task Save() { await VM.SaveSearchAsync(); StateHasChanged(); }
    private async Task Refresh() { await VM.LoadSearchStateAsync(); StateHasChanged(); }
    private async Task StartReindex() { await VM.StartReindexAsync(); StateHasChanged(); }
    private void CancelReindex() { VM.CancelReindex(); StateHasChanged(); }
    // The toggles mirror the share edit/status/recycle-bin toggles: checked + @onchange instead
    // of @bind. They only update the desired engine; it is persisted on the Save button.
    private string EsStatusLabel() => VM.SearchEsEffective ? R("Web_Settings_Search_StatusActive") : VM.SearchEsEnabled && !VM.SearchEsReachable ? R("Web_Settings_Search_StatusUnreachable") : R("Web_Settings_Search_StatusInactive");
    private static string EngineLabel(SearchEngine engine) => engine switch
    {
        SearchEngine.Elasticsearch => "Elasticsearch",
        SearchEngine.Local => R("Web_Settings_Search_LocalName"),
        _ => R("Web_Settings_Search_ModeFilename")
    };
    private string ActiveModeLabel() => VM.SearchActiveEngine switch
    {
        SearchEngine.Elasticsearch => R("Web_Settings_Search_ModeFulltext"),
        SearchEngine.Local => R("Web_Settings_Search_ModeLocal"),
        _ => R("Web_Settings_Search_ModeFilename")
    };

    private string ReindexResultText()
    {
        var p = VM.ReindexProgress;
        if (p.Error is not null) return string.Format(R("Web_Settings_Search_LastRunError"), p.Error);
        if (p.Canceled) return string.Format(R("Web_Settings_Search_LastRunCanceled"), p.Done, p.Total);
        return string.Format(R("Web_Settings_Search_LastRunDone"), p.Done, p.Total);
    }

    // The reindex reports into an in-memory record, not through an event, and is often started
    // elsewhere: the indexer's automatic local build after Save, a change-log gap, a restored
    // folder, another admin. So poll for the panel's whole lifetime, like the job menu does
    // (GetReindexProgress is a cheap in-memory read), and re-render only when it changes.
    private Timer? _pollTimer;
    private (bool Running, int Done, int Total, DateTime? FinishedAt) _progressSig;

    protected override void OnInitialized()
        => _pollTimer = new Timer(_ => _ = PollProgressAsync(), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));

    private async Task PollProgressAsync()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                await VM.RefreshReindexProgressAsync();
                var p = VM.ReindexProgress;
                var sig = (p.Running, p.Done, p.Total, p.FinishedAt);
                if (sig == _progressSig) return;
                _progressSig = sig;
                StateHasChanged();
            });
        }
        catch { /* circuit torn down mid-tick — nothing to do */ }
    }

    public void Dispose() => _pollTimer?.Dispose();
}
