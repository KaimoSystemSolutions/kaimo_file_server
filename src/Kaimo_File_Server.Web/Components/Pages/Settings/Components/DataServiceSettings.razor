
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Web.Components.ViewModels
@using Kaimo_File_Server.Web.DynamicHelpers
@inject AssetProvider Icons
@inject NavigationManager Nav
@inject FileServiceAccessViewModel Access
@implements IDisposable

<div class="detail-section">
    <span class="detail-label">@R("Web_Settings_Data_Title")</span>
    <p class="settings-description">@R("Web_Settings_Data_Description")</p>
    <FileServiceCards VM="VM" Access="Access" />
    <label class="pw-rule"><span class="toggle-switch"><input type="checkbox" @bind="VM.WebDavRequireHttps" /><span class="toggle-slider"></span></span><span>@R("Web_Settings_Data_WebDavRequireHttps")</span></label>
    <p class="settings-description">@R("Web_Settings_Data_WebDavUrl"): <code>@SettingsViewModel.BuildWebDavUrl(Nav.BaseUri)</code></p>
    <div class="settings-row settings-actions">
        <button class="btn-primary" @onclick="SaveServices">@Resources.Web_Settings_Button_Save</button>
        <button class="btn-icon" title="@R("Web_Settings_Data_RefreshStatus")" @onclick="Refresh"><span>@Icons.SVG("refresh.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))</span></button>
    </div>
</div>

<UserServiceMatrix Access="Access" VM="VM" />

<div class="detail-section">
    <span class="detail-label">@R("Web_Settings_Data_ProtocolTitle")</span>
    <p class="settings-description">@R("Web_Settings_Data_ProtocolDescription")</p>
    <div class="settings-row settings-row-spaced"><label class="settings-field-label">@R("Web_Settings_Data_MinVersion")</label><select class="edit-input settings-select-small" @bind="VM.SmbProtocol.MinVersion">@foreach (var (version, label) in SettingsViewModel.SmbVersions) { <option value="@version">@label</option> }</select></div>
    <div class="settings-row settings-row-spaced"><label class="settings-field-label">@R("Web_Settings_Data_MaxVersion")</label><select class="edit-input settings-select-small" @bind="VM.SmbProtocol.MaxVersion">@foreach (var (version, label) in SettingsViewModel.SmbVersions) { <option value="@version">@label</option> }</select></div>
    <label class="pw-rule"><span class="toggle-switch"><input type="checkbox" @bind="VM.SmbProtocol.RequireSigning" /><span class="toggle-slider"></span></span><span>@R("Web_Settings_Data_RequireSigning")</span></label>
    <label class="pw-rule"><span class="toggle-switch"><input type="checkbox" @bind="VM.SmbProtocol.RequireEncryption" /><span class="toggle-slider"></span></span><span>@R("Web_Settings_Data_RequireEncryption")</span></label>
    <label class="pw-rule"><span class="toggle-switch"><input type="checkbox" @bind="VM.SmbProtocol.EnableWsDiscovery" /><span class="toggle-slider"></span></span><span>@R("Web_Settings_Data_WsDiscovery")</span></label>
    <label class="pw-rule"><span class="toggle-switch"><input type="checkbox" @bind="VM.SmbProtocol.EnableAuditLog" /><span class="toggle-slider"></span></span><span>@R("Web_Settings_Data_AuditLog")</span></label>
    <div class="settings-actions"><button class="btn-primary" @onclick="SaveProtocol">@Resources.Web_Settings_Button_Save</button></div>
</div>

@code {
    [Parameter, EditorRequired] public SettingsViewModel VM { get; set; } = default!;
    private static string R(string key) => Resources.ResourceManager.GetString(key) ?? key;
    private CancellationTokenSource? _statusPoll;

    protected override Task OnInitializedAsync() => Access.LoadAsync();

    private async Task SaveServices()
    {
        bool saved = await VM.SaveDataServicesAsync();
        StateHasChanged();
        if (saved) await PollSmbStatusAsync();
    }

    // The Host applies the SMB toggle on its next reconcile tick (every 5 s). Poll briefly
    // so the page shows the real outcome, or the unreachable Host, instead of a stale status.
    private async Task PollSmbStatusAsync()
    {
        _statusPoll?.Cancel();
        _statusPoll?.Dispose();
        _statusPoll = new CancellationTokenSource();
        var token = _statusPoll.Token;
        var deadline = DateTime.UtcNow.AddSeconds(15);
        try
        {
            while (DateTime.UtcNow < deadline)
            {
                await Task.Delay(TimeSpan.FromMilliseconds(1500), token);
                bool refreshed = await VM.RefreshDataServiceStatusAsync();
                // The page may have been left while the refresh was running.
                token.ThrowIfCancellationRequested();
                StateHasChanged();
                // A failed read is shown as an error; polling on would only repeat it.
                if (!refreshed || VM.SmbStatusMatchesDesired || VM.HostUnreachable) return;
            }
        }
        catch (OperationCanceledException)
        {
            // Page left or a newer save started its own poll.
        }
    }

    public void Dispose()
    {
        _statusPoll?.Cancel();
        _statusPoll?.Dispose();
    }
    private async Task SaveProtocol() { await VM.SaveSmbProtocolAsync(); StateHasChanged(); }
    private async Task Refresh() { await VM.RefreshDataServiceStatusAsync(); StateHasChanged(); }
}
