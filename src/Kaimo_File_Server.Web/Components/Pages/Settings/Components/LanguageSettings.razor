@using Kaimo_File_Server.Core.Language

<div class="detail-section">
    <span class="detail-label">@Resources.Web_Settings_Language_Detail</span>
    <div class="settings-row">
        <select class="edit-input settings-select" @bind="VM.SelectedLanguage">
            @foreach (var lang in SettingsViewModel.AvailableLanguages) { <option value="@lang.Key">@lang.Value</option> }
        </select>
    </div>
</div>

@* Saved together with the date/time format by the button in DateFormatSettings. *@
@code {
    [Parameter, EditorRequired] public SettingsViewModel VM { get; set; } = default!;
}
