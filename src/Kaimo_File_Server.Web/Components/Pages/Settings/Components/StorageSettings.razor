
@using System.Globalization
@using Kaimo_File_Server.Core.Domain
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Core.Services
@using Kaimo_File_Server.Infrastructure.Services
@using Kaimo_File_Server.Web.DynamicHelpers
@inject AssetProvider Icons
@inject DateFormatService DateFmt

<div class="detail-section">
    <span class="detail-label">@Resources.Web_Settings_Storage_DetailLabel</span>
    <p class="settings-description">@Resources.Web_Settings_Storage_Description @Resources.Web_Settings_Storage_PoolNameHint</p>
    @if (VM.StorageUsages.Count > 0)
    {
        <div class="storage-pool-list">
            @foreach (var pool in VM.StorageUsages)
            {
                var poolKey = SettingsViewModel.PoolNameKey(pool.StoragePath);
                <article class="storage-pool-card">
                    <div class="storage-pool-header">
                        <div>
                            @if (_editingKey == poolKey)
                            {
                                <div class="storage-pool-name-edit">
                                    <input class="edit-input"
                                           type="text"
                                           maxlength="64"
                                           placeholder="@SettingsViewModel.PoolDerivedName(pool.StoragePath)"
                                           @bind="VM.PoolNames[poolKey]" />
                                    <button class="btn-icon" title="@Resources.Web_Common_Save" @onclick="() => SaveName(poolKey)">@Icons.SVG("check.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))</button>
                                    <button class="btn-icon" title="@Resources.Web_Common_Cancel" @onclick="CancelEdit">@Icons.SVG("close.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))</button>
                                </div>
                            }
                            else
                            {
                                <div class="storage-pool-name-row">
                                    <span class="storage-pool-name">@VM.ResolvePoolName(pool.StoragePath)</span>
                                    <button class="btn-icon" title="@Resources.Web_Common_Edit" @onclick="() => StartEdit(poolKey)">@Icons.SVG("edit.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))</button>
                                </div>
                            }
                        </div>
                        @if (pool.Available)
                        {
                            <span class="storage-pool-percent">@string.Format(T("Web_Settings_Storage_UsedPercent", "{0} % used"), Pct(pool.UsedPercent))</span>
                        }
                    </div>

                    @if (pool.Available)
                    {
                        <div class="usage-bar" role="progressbar" aria-label="@Resources.Web_Settings_Storage_Utilization @VM.ResolvePoolName(pool.StoragePath)" aria-valuenow="@Pct(pool.UsedPercent)" aria-valuemin="0" aria-valuemax="100">
                            <div class="usage-bar-fill @(pool.UsedPercent >= 90 ? "is-critical" : "")" style="width: @Pct(pool.UsedPercent)%;"></div>
                        </div>
                        <div class="storage-pool-stats">
                            <span><strong>@VM.FormatBytes(pool.UsedBytes)</strong> @Resources.Web_Settings_Storage_Used</span>
                            <span><strong>@VM.FormatBytes(pool.FreeBytes)</strong> @Resources.Web_Settings_Storage_Free</span>
                            <span><strong>@VM.FormatBytes(pool.TotalBytes)</strong> @Resources.Web_Settings_Storage_Total</span>
                            <span>@Resources.Web_Settings_Storage_Drive <strong>@pool.DriveName</strong></span>
                        </div>

                        @* Usage by origin: collapsed by default, since opening it walks the pool's files.
                           What Kaimo stores vs. the rest of the disk; colour is repeated as text in the legend. *@
                        var originOpen = _openOrigins.Contains(pool.StoragePath);
                        <div class="storage-origin">
                            <button class="acl-collapse-toggle storage-origin-toggle" type="button" aria-expanded="@(originOpen ? "true" : "false")"
                                    @onclick="() => ToggleOrigin(pool.StoragePath)">
                                @Icons.SVG("chevron_right.svg", new SvgOptions(Width: 12, Height: 12, StrokeWidth: 2, CssClass: "acl-collapse-chevron" + (originOpen ? " acl-collapse-chevron--open" : "")))
                                <span>@T("Web_Settings_Storage_Origin_Label", "Usage by origin")</span>
                            </button>
                            @if (originOpen && VM.PoolBreakdowns.TryGetValue(pool.StoragePath, out var breakdown) && VM.OutsideKaimoBytes(pool) is not null)
                            {
                                var segments = OriginSegments(pool, breakdown);
                                <div class="storage-origin-bar" role="img"
                                     aria-label="@string.Join(", ", segments.Select(s => $"{s.Label} {VM.FormatBytes(s.Bytes)}"))">
                                    @foreach (var segment in segments.Where(s => s.Bytes > 0))
                                    {
                                        <span class="@SegmentClass(segment)" style="width: @Width(segment.Bytes, pool.TotalBytes)%;"
                                              title="@segment.Label: @VM.FormatBytes(segment.Bytes)"></span>
                                    }
                                </div>
                                <ul class="storage-origin-legend">
                                    @foreach (var segment in segments)
                                    {
                                        <li>
                                            <span class="storage-origin-swatch @SegmentClass(segment)" aria-hidden="true"></span>
                                            <span>@segment.Label</span>
                                            <strong>@VM.FormatBytes(segment.Bytes)</strong>
                                        </li>
                                    }
                                </ul>
                                <span class="settings-hint">
                                    @T("Web_Settings_Storage_Origin_Hint", "Calculated from the files in the pool.")
                                    @string.Format(T("Web_Settings_Storage_Origin_CalculatedAt", "Calculated {0}"), DateFmt.FormatDateTime(breakdown.ScannedAtUtc))
                                </span>
                            }
                            else if (originOpen && VM.IsScanningBreakdown)
                            {
                                <p class="settings-empty">@T("Web_Settings_Storage_Origin_Calculating", "Calculating usage…")</p>
                            }
                            else if (originOpen)
                            {
                                <p class="settings-empty">@T("Web_Settings_Storage_Origin_Unavailable", "The breakdown is not available.")</p>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="settings-empty">@Resources.Web_Settings_Storage_InformationNotAvailable</p>
                    }
                </article>
            }
        </div>
    }
    else
    {
        <p class="settings-empty">@Resources.Web_Settings_Storage_NoStoragePoolsFound</p>
    }
    <div class="settings-actions">
        <button class="btn-icon" title="@Resources.Web_Settings_Storage_Update" @onclick="Refresh">@Icons.SVG("refresh.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))</button>
    </div>
</div>

@* Global recycle-bin default; shares and home folders can override it. *@
<div class="detail-section">
    <span class="detail-label">@T("Web_Recycle_SectionLabel", "Recycle bin")</span>
    <p class="settings-description">@T("Web_Recycle_GlobalDescription", "Deleted items stay in the recycle bin of their share until they are restored or removed. Retention and individual limits are set per share and for home folders.")</p>
    @* Inline feedback: this child re-renders on its own, the page-level banners would stay stale. *@
    @if (_recycleError is not null) { <div class="error-banner">@_recycleError</div> }
    <RecycleLimitFields IsGlobalDefault="true"
                        Value="GlobalLimits"
                        OnSave="SaveRecycleDefault" />
</div>

@code {
    [Parameter, EditorRequired] public SettingsViewModel VM { get; set; } = default!;
    private static string Pct(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);

    // Pools whose "usage by origin" details are expanded (per visit, not persisted).
    private readonly HashSet<string> _openOrigins = new();

    // Opening reuses the last scan if there is one; a scan walks every file of the pool.
    private async Task ToggleOrigin(string poolPath)
    {
        if (!_openOrigins.Remove(poolPath))
        {
            _openOrigins.Add(poolPath);
            await VM.RefreshStorageBreakdownAsync();
        }
    }

    private async Task Refresh()
    {
        VM.RefreshStorageInfo();
        if (_openOrigins.Count > 0)
            await VM.RefreshStorageBreakdownAsync(force: true);
    }

    private sealed record OriginSegment(string Label, long Bytes, TileColor Color);

    private List<OriginSegment> OriginSegments(StorageUsageInfo pool, PoolUsageBreakdown b)
    {
        var segments = new List<OriginSegment>
        {
            new(T("Web_Settings_Storage_Origin_Files", "Files in shares"), b.FileBytes, TileColor.Folder),
            new(T("Web_Settings_Storage_Origin_RecycleBins", "Recycle bins"), b.RecycleBinBytes, TileColor.Department),
            new(T("Web_Settings_Storage_Origin_Versions", "Version history"), b.VersionBytes, TileColor.Info),
            new(T("Web_Settings_Storage_Origin_OtherServer", "Other Kaimo data"), b.OtherServerBytes, TileColor.Group),
        };
        if (VM.OtherPoolsOnDiskBytes(pool) is long otherPools and > 0)
            segments.Add(new(T("Web_Settings_Storage_Origin_OtherPools", "Other pools on this disk"), otherPools, TileColor.User));
        segments.Add(new(T("Web_Settings_Storage_Origin_Outside", "Not Kaimo"), VM.OutsideKaimoBytes(pool) ?? 0, TileColor.Neutral));
        return segments;
    }

    private static string SegmentClass(OriginSegment segment) => "tile-segment--" + segment.Color.ToString().ToLowerInvariant();

    private static string Width(long bytes, long total)
        => (total > 0 ? Math.Min(100d, bytes * 100d / total) : 0d).ToString("0.###", CultureInfo.InvariantCulture);

    private static string T(string key, string fallback) => Resources.ResourceManager.GetString(key) ?? fallback;

    private string? _recycleError;

    private RecycleLimits GlobalLimits => VM.RecycleGlobalMaxSizeBytes > 0
        ? new RecycleLimits(RecycleLimitMode.Custom, VM.RecycleGlobalMaxSizeBytes, null)
        : new RecycleLimits(RecycleLimitMode.Unlimited, null, null);

    private async Task SaveRecycleDefault(RecycleLimits limits)
    {
        var ok = await VM.SaveRecycleGlobalMaxSizeAsync(limits.MaxSizeBytes);
        _recycleError = ok ? null : VM.ErrorMessage;
    }

    // Per-pool inline rename: only one pool edits at a time.
    private string? _editingKey;
    private string _originalName = "";

    private void StartEdit(string poolKey)
    {
        _editingKey = poolKey;
        _originalName = VM.PoolNames.TryGetValue(poolKey, out var v) ? v : "";
    }

    private void CancelEdit()
    {
        if (_editingKey is not null)
            VM.PoolNames[_editingKey] = _originalName;
        _editingKey = null;
    }

    private async Task SaveName(string poolKey)
    {
        _editingKey = null;
        await VM.SavePoolNamesAsync();
        StateHasChanged();
    }
}
