
@using System.Globalization
@using Kaimo_File_Server.Web.DynamicHelpers
@inject AssetProvider Icons

<div class="detail-section">
    <span class="detail-label">Speicher-Pools</span>
    <p class="settings-description">Auslastung der konfigurierten Speicher-Pools. Die bestehende Pool- und Verzeichnisstruktur wird unverändert angezeigt.</p>
    @if (VM.StorageUsages.Count > 0)
    {
        <div class="storage-pool-list">
            @foreach (var pool in VM.StorageUsages)
            {
                <article class="storage-pool-card">
                    <div class="storage-pool-header">
                        <div>
                            <span class="storage-pool-name">@PoolName(pool.StoragePath)</span>
                            <span class="storage-pool-path" title="@pool.StoragePath">@pool.StoragePath</span>
                        </div>
                        @if (pool.Available)
                        {
                            <span class="storage-pool-percent">@Pct(pool.UsedPercent) % belegt</span>
                        }
                    </div>

                    @if (pool.Available)
                    {
                        <div class="usage-bar" role="progressbar" aria-label="Auslastung von @PoolName(pool.StoragePath)" aria-valuenow="@Pct(pool.UsedPercent)" aria-valuemin="0" aria-valuemax="100">
                            <div class="usage-bar-fill @(pool.UsedPercent >= 90 ? "is-critical" : "")" style="width: @Pct(pool.UsedPercent)%;"></div>
                        </div>
                        <div class="storage-pool-stats">
                            <span><strong>@VM.FormatBytes(pool.UsedBytes)</strong> belegt</span>
                            <span><strong>@VM.FormatBytes(pool.FreeBytes)</strong> frei</span>
                            <span><strong>@VM.FormatBytes(pool.TotalBytes)</strong> gesamt</span>
                            <span>Laufwerk <strong>@pool.DriveName</strong></span>
                        </div>
                    }
                    else
                    {
                        <p class="settings-empty">Speicherinformationen sind für diesen Pool nicht verfügbar.</p>
                    }
                </article>
            }
        </div>
    }
    else { <p class="settings-empty">Keine Speicher-Pools gefunden oder Speicherinformationen sind nicht verfügbar.</p> }
    <div class="settings-actions"><button class="btn-icon" title="Aktualisieren" @onclick="Refresh">@Icons.SVG("refresh.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))</button></div>
</div>

@code {
    [Parameter, EditorRequired] public SettingsViewModel VM { get; set; } = default!;
    private static string Pct(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);
    private static string PoolName(string path)
    {
        var trimmed = path.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
        return Path.GetFileName(trimmed) is { Length: > 0 } name ? name : path;
    }
    private void Refresh() { VM.RefreshStorageInfo(); StateHasChanged(); }
}

