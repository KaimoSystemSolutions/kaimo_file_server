
@using Kaimo_File_Server.Web.DynamicHelpers
@inject AssetProvider Icons

<button class="detail-tab @(Active ? "detail-tab--active" : "")" @onclick="OnClick">
    @Icons.SVG(Icon, new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
    @Label
</button>

@code {
    [Parameter] public bool Active { get; set; }
    [Parameter, EditorRequired] public string Icon { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public EventCallback OnClick { get; set; }
}

