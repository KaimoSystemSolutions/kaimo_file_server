@page "/settings"
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Web.Components.Pages.Settings.Components
@inject SettingsViewModel VM

<PageTitle>@Resources.Web_Nav_Settings - Kaimo Files</PageTitle>

<div class="page-header settings-page-header">
    <div>
        <h1>@Resources.Web_Nav_Settings</h1>
        <p class="subtitle">Globale Konfiguration</p>
    </div>
</div>

@if (VM.IsLoading)
{
    <div class="loading-state"><div class="spinner"></div><p>Lade Einstellungen…</p></div>
}
else if (!VM.CanAccessPage)
{
    <div class="error-banner">@Resources.Web_Error_NoPermission Sie haben keine Rechte für die globalen Einstellungen.</div>
}
else
{
    <div class="admin-content settings-workspace">
        <div class="admin-detail settings-page">
            <div class="detail-tabs settings-nav" role="tablist">
                @if (VM.CanManageSettings)
                {
                    <SettingsTabButton Active="@(_activeTab == SettingsTab.Language)" Icon="globe.svg" Label="@Resources.Web_Settings_Tab_Language" OnClick="() => SwitchTab(SettingsTab.Language)" />
                    <SettingsTabButton Active="@(_activeTab == SettingsTab.ContextMenu)" Icon="edit.svg" Label="@Resources.Web_Settings_Tab_ContextMenu" OnClick="() => SwitchTab(SettingsTab.ContextMenu)" />
                    <SettingsTabButton Active="@(_activeTab == SettingsTab.PasswordPolicy)" Icon="shield.svg" Label="@Resources.Web_Settings_Tab_Password" OnClick="() => SwitchTab(SettingsTab.PasswordPolicy)" />
                    <SettingsTabButton Active="@(_activeTab == SettingsTab.Network)" Icon="compass.svg" Label="@Resources.Web_Settings_Tab_IP_Address" OnClick="() => SwitchTab(SettingsTab.Network)" />
                    <SettingsTabButton Active="@(_activeTab == SettingsTab.Storage)" Icon="folder.svg" Label="@Resources.Web_Settings_Tab_Storage" OnClick="() => SwitchTab(SettingsTab.Storage)" />
                    <SettingsTabButton Active="@(_activeTab == SettingsTab.Memory)" Icon="gear.svg" Label="@Resources.Web_Settings_Tab_Ram" OnClick="() => SwitchTab(SettingsTab.Memory)" />
                    <SettingsTabButton Active="@(_activeTab == SettingsTab.Search)" Icon="search.svg" Label="@Resources.Web_Settings_Tab_Search" OnClick="() => SwitchTab(SettingsTab.Search)" />
                    <SettingsTabButton Active="@(_activeTab == SettingsTab.Logging)" Icon="gear.svg" Label="@Resources.Web_Settings_Tab_Logging" OnClick="() => SwitchTab(SettingsTab.Logging)" />
                }
                @if (VM.CanManageDataServices)
                {
                    <SettingsTabButton Active="@(_activeTab == SettingsTab.DataServices)" Icon="archive.svg" Label="@Resources.Web_Settings_Tab_Fileservices" OnClick="() => SwitchTab(SettingsTab.DataServices)" />
                }
                @if (VM.CanManageCertificates)
                {
                    <SettingsTabButton Active="@(_activeTab == SettingsTab.Certificate)" Icon="shield.svg" Label="@Resources.Web_Settings_Tab_Certificate" OnClick="() => SwitchTab(SettingsTab.Certificate)" />
                }
            </div>

            <div class="settings-content">
                @if (VM.SuccessMessage is not null) { <div class="success-banner">@VM.SuccessMessage</div> }
                @if (VM.ErrorMessage is not null) { <div class="error-banner">@VM.ErrorMessage</div> }

                @switch (_activeTab)
                {
                    case SettingsTab.Language when VM.CanManageSettings: <LanguageSettings VM="VM" /> break;
                    case SettingsTab.ContextMenu when VM.CanManageSettings: <ContextMenuSettings VM="VM" /> break;
                    case SettingsTab.PasswordPolicy when VM.CanManageSettings: <PasswordPolicySettings VM="VM" /> break;
                    case SettingsTab.Network when VM.CanManageSettings: <NetworkSettings VM="VM" /> break;
                    case SettingsTab.Storage when VM.CanManageSettings: <StorageSettings VM="VM" /> break;
                    case SettingsTab.Memory when VM.CanManageSettings: <MemorySettings VM="VM" /> break;
                    case SettingsTab.Search when VM.CanManageSettings: <SearchSettings VM="VM" /> break;
                    case SettingsTab.Logging when VM.CanManageSettings: <LoggingSettings VM="VM" /> break;
                    case SettingsTab.DataServices when VM.CanManageDataServices: <DataServiceSettings VM="VM" /> break;
                    case SettingsTab.Certificate when VM.CanManageCertificates: <CertificateSettings VM="VM" /> break;
                }
            </div>
        </div>
    </div>
}
