@page "/settings"
@using System.Globalization
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Web.DynamicHelpers
@using Kaimo_File_Server.Web.Services.Https
@using Microsoft.AspNetCore.Components.Forms
@inject SettingsViewModel VM
@inject NavigationManager Nav
@inject AssetProvider Assets

<PageTitle>@Resources.Web_Nav_Settings - Kaimo Files</PageTitle>

<div class="page-header">
    <div>
        <h1>@Resources.Web_Nav_Settings</h1>
        <p class="subtitle">Globale Konfiguration</p>
    </div>
</div>

@if (VM.IsLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Lade Einstellungen…</p>
    </div>
}
else if (!VM.CanAccessPage)
{
    <div class="error-banner">@Resources.Web_Error_NoPermission Sie haben keine Rechte für die globalen Einstellungen.</div>
}
else
{
    <div class="admin-content">
        <div class="admin-detail" style="width: stretch;">

            @* ── Tab Navigation ── *@
            <div class="detail-tabs">
                @if (VM.CanManageSettings)
                {
                    <button class="detail-tab @(_activeTab == SettingsTab.Language ? "detail-tab--active" : "")"
                            @onclick="() => SwitchTab(SettingsTab.Language)">
                        @Assets.SVG("globe.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                        @Resources.Web_Settings_Tab_Language
                    </button>

                    <button class="detail-tab @(_activeTab == SettingsTab.ContextMenu ? "detail-tab--active" : "")"
                            @onclick="() => SwitchTab(SettingsTab.ContextMenu)">
                        @Assets.SVG("edit.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                        @Resources.Web_Settings_Tab_ContextMenu
                    </button>

                    <button class="detail-tab @(_activeTab == SettingsTab.PasswordPolicy ? "detail-tab--active" : "")"
                            @onclick="() => SwitchTab(SettingsTab.PasswordPolicy)">
                        @Assets.SVG("shield.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                        @Resources.Web_Settings_Tab_Password
                    </button>

                    <button class="detail-tab @(_activeTab == SettingsTab.Network ? "detail-tab--active" : "")"
                            @onclick="() => SwitchTab(SettingsTab.Network)">
                        @Assets.SVG("compass.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                        @Resources.Web_Settings_Tab_IP_Address
                    </button>

                    <button class="detail-tab @(_activeTab == SettingsTab.Storage ? "detail-tab--active" : "")"
                            @onclick="() => SwitchTab(SettingsTab.Storage)">
                        @Assets.SVG("folder.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                        @Resources.Web_Settings_Tab_Storage
                    </button>

                    <button class="detail-tab @(_activeTab == SettingsTab.Memory ? "detail-tab--active" : "")"
                            @onclick="() => SwitchTab(SettingsTab.Memory)">
                        @Assets.SVG("gear.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                        @Resources.Web_Settings_Tab_Ram
                    </button>

                    <button class="detail-tab @(_activeTab == SettingsTab.Search ? "detail-tab--active" : "")"
                            @onclick="() => SwitchTab(SettingsTab.Search)">
                        @Assets.SVG("search.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                        @Resources.Web_Settings_Tab_Search
                    </button>

                    <button class="detail-tab @(_activeTab == SettingsTab.Logging ? "detail-tab--active" : "")"
                            @onclick="() => SwitchTab(SettingsTab.Logging)">
                        @Assets.SVG("gear.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                        @Resources.Web_Settings_Tab_Logging
                    </button>
                }

                @if (VM.CanManageDataServices)
                {
                    <button class="detail-tab @(_activeTab == SettingsTab.DataServices ? "detail-tab--active" : "")"
                            @onclick="() => SwitchTab(SettingsTab.DataServices)">
                        @Assets.SVG("archive.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                        @Resources.Web_Settings_Tab_Fileservices
                    </button>
                }

                @if (VM.CanManageCertificates)
                {
                    <button class="detail-tab @(_activeTab == SettingsTab.Certificate ? "detail-tab--active" : "")"
                            @onclick="() => SwitchTab(SettingsTab.Certificate)">
                        @Assets.SVG("shield.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                        @Resources.Web_Settings_Tab_Certificate
                    </button>
                }
            </div>

            @* ── Messages ── *@
            @if (VM.SuccessMessage is not null)
            {
                <div class="success-banner">@VM.SuccessMessage</div>
            }
            @if (VM.ErrorMessage is not null)
            {
                <div class="error-banner">@VM.ErrorMessage</div>
            }

            @* ── Tab: Language ── *@
            @if (_activeTab == SettingsTab.Language && VM.CanManageSettings)
            {
                <div class="detail-section">
                    <span class="detail-label">@Resources.Web_Settings_Language_Detail</span>

                    <div style="display: flex; align-items: center; gap: 8px;">
                        <select class="edit-input" style="max-width: 240px;"
                                @bind="VM.SelectedLanguage">
                            @foreach (var lang in SettingsViewModel.AvailableLanguages)
                            {
                                <option value="@lang.Key">@lang.Value</option>
                            }
                        </select>

                        <button class="btn-primary" @onclick="SaveLanguage">
                            @Resources.Web_Settings_Button_Save
                        </button>
                    </div>
                </div>
            }

            @* ── Tab: Context Menu ── *@
            @if (_activeTab == SettingsTab.ContextMenu && VM.CanManageSettings)
            {
                <div class="detail-section">
                    <span class="detail-label">@Resources.Web_Settings_ContextMenu_Detail</span>
                    <p style="font-size: 12px; color: var(--text-tertiary); margin-bottom: 12px;">
                        @Resources.Web_Settings_ContextMenu_Desc
                    </p>

                    @* Category selector *@
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
                        <select class="edit-input" style="max-width: 260px;"
                                @bind="SelectedScopeProxy">
                            @foreach (var scope in SettingsViewModel.ContextScopes)
                            {
                                <option value="@scope">@ScopeName(scope)</option>
                            }
                        </select>
                    </div>

                    @* Single checkbox list: tick = in menu, arrows = reorder *@
                    <div class="ctx-list">
                        @foreach (var cmd in VM.ScopeCommandsOrdered)
                        {
                            var assigned = VM.IsAssigned(cmd.Id);
                            <div class="ctx-item @(assigned ? "" : "ctx-item--off")">
                                <label class="ctx-item-label">
                                    <input type="checkbox" checked="@assigned"
                                           @onchange="() => VM.ToggleCommand(cmd.Id)" />
                                    @Assets.SVG(cmd.Icon, new SvgOptions(Width: 14, Height: 14))
                                    <span>@cmd.DisplayLabel</span>
                                </label>
                                <span class="ctx-item-actions">
                                    <button class="btn-icon btn-icon--small" title="@Resources.Web_Settings_CtxMoveUp"
                                            disabled="@(!assigned)" @onclick="() => VM.MoveUp(cmd.Id)">↑</button>
                                    <button class="btn-icon btn-icon--small" title="@Resources.Web_Settings_CtxMoveDown"
                                            disabled="@(!assigned)" @onclick="() => VM.MoveDown(cmd.Id)">↓</button>
                                </span>
                            </div>
                        }
                    </div>

                    <div style="display: flex; align-items: center; gap: 8px; margin-top: 16px;">
                        <button class="btn-primary" @onclick="SaveContextMenu">
                            @Resources.Web_Settings_Button_Save
                        </button>
                        <button class="btn-icon" title="@Resources.Web_Settings_CtxReset"
                                @onclick="ResetContextMenu">
                            @Assets.SVG("refresh.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))
                        </button>
                    </div>
                </div>
            }

            @* ── Tab: Data Services ── *@
            @if (_activeTab == SettingsTab.DataServices && VM.CanManageDataServices)
            {
                <div class="detail-section">
                    <span class="detail-label">Datendienste</span>
                    <p style="font-size: 12px; color: var(--text-tertiary); margin-bottom: 12px;">
                        Aktiviert oder deaktiviert die Freigabe-Protokolle. Änderungen werden vom
                        Dienst innerhalb weniger Sekunden übernommen – ein Neustart ist nicht nötig.
                    </p>

                    <div class="service-row">
                        <div class="service-info">
                            <span class="service-name">SMB / CIFS</span>
                            <span class="service-status service-status--@VM.SmbStatus.ToLowerInvariant()">
                                @StatusLabel(VM.SmbStatus)
                            </span>
                        </div>
                        <label class="toggle-switch" title="SMB aktivieren/deaktivieren">
                            <input type="checkbox" @bind="VM.SmbEnabled" />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>

                    <div style="display: flex; align-items: center; gap: 8px; margin-top: 16px;">
                        <button class="btn-primary" @onclick="SaveDataServices">
                            @Resources.Web_Settings_Button_Save
                        </button>
                        <button class="btn-icon" title="Status aktualisieren" @onclick="RefreshStatus">
                            @Assets.SVG("refresh.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))
                        </button>
                    </div>
                </div>

                <div class="detail-section">
                    <span class="detail-label">SMB-Protokoll & Sicherheit</span>
                    <p style="font-size: 12px; color: var(--text-tertiary); margin-bottom: 16px;">
                        Legt fest, welche SMB-Dialekte ausgehandelt werden und ob Signierung bzw.
                        Verschlüsselung erzwungen werden. SMB 1 ist aus Sicherheitsgründen dauerhaft
                        deaktiviert. Änderungen werden beim nächsten Neustart des SMB-Dienstes wirksam.
                    </p>

                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
                        <label style="font-size: 13px; min-width: 200px;">Mindestversion</label>
                        <select class="edit-input" style="max-width: 160px;" @bind="VM.SmbProtocol.MinVersion">
                            @foreach (var (version, label) in SettingsViewModel.SmbVersions)
                            {
                                <option value="@version">@label</option>
                            }
                        </select>
                    </div>

                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
                        <label style="font-size: 13px; min-width: 200px;">Maximalversion</label>
                        <select class="edit-input" style="max-width: 160px;" @bind="VM.SmbProtocol.MaxVersion">
                            @foreach (var (version, label) in SettingsViewModel.SmbVersions)
                            {
                                <option value="@version">@label</option>
                            }
                        </select>
                    </div>

                    <label class="pw-rule">
                        <input type="checkbox" @bind="VM.SmbProtocol.RequireSigning" />
                        <span>Signierung erzwingen (empfohlen)</span>
                    </label>
                    <label class="pw-rule">
                        <input type="checkbox" @bind="VM.SmbProtocol.RequireEncryption" />
                        <span>Verschlüsselung erzwingen (nur SMB 3.0+; schließt SMB 2.x-Clients aus)</span>
                    </label>
                    <label class="pw-rule">
                        <input type="checkbox" @bind="VM.SmbProtocol.EnableWsDiscovery" />
                        <span>Im Netzwerk sichtbar machen (WS-Discovery – erscheint in der Windows-Netzwerkumgebung)</span>
                    </label>
                    <label class="pw-rule">
                        <input type="checkbox" @bind="VM.SmbProtocol.EnableAuditLog" />
                        <span>Sicherheits-Audit-Protokoll aktivieren (Anmeldungen, Freigabezugriffe, Dateioperationen)</span>
                    </label>

                    <div style="margin-top: 16px;">
                        <button class="btn-primary" @onclick="SaveSmbProtocol">
                            @Resources.Web_Settings_Button_Save
                        </button>
                    </div>
                </div>
            }

            @* ── Tab: Password Policy ── *@
            @if (_activeTab == SettingsTab.PasswordPolicy && VM.CanManageSettings)
            {
                <div class="detail-section">
                    <span class="detail-label">Passwort-Anforderungen</span>
                    <p style="font-size: 12px; color: var(--text-tertiary); margin-bottom: 16px;">
                        Diese Regeln gelten global beim Anlegen und Ändern von Benutzerpasswörtern.
                    </p>

                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
                        <label style="font-size: 13px; min-width: 200px;">Mindestlänge</label>
                        <input type="number" min="1" max="128" class="edit-input" style="max-width: 100px;"
                               @bind="VM.PwPolicy.MinLength" />
                    </div>

                    <label class="pw-rule">
                        <input type="checkbox" @bind="VM.PwPolicy.RequireUppercase" />
                        <span>Großbuchstabe erforderlich (A–Z)</span>
                    </label>
                    <label class="pw-rule">
                        <input type="checkbox" @bind="VM.PwPolicy.RequireLowercase" />
                        <span>Kleinbuchstabe erforderlich (a–z)</span>
                    </label>
                    <label class="pw-rule">
                        <input type="checkbox" @bind="VM.PwPolicy.RequireDigit" />
                        <span>Ziffer erforderlich (0–9)</span>
                    </label>
                    <label class="pw-rule">
                        <input type="checkbox" @bind="VM.PwPolicy.RequireSpecial" />
                        <span>Sonderzeichen erforderlich (z. B. ! ? # $)</span>
                    </label>

                    <div style="margin-top: 16px;">
                        <button class="btn-primary" @onclick="SavePasswordPolicy">@Resources.Web_Settings_Button_Save</button>
                    </div>
                </div>

                <div class="detail-section">
                    <span class="detail-label">Sitzungssicherheit</span>
                    <p style="font-size: 12px; color: var(--text-tertiary); margin-bottom: 16px;">
                        Wie oft eine aktive Sitzung prüft, ob das Konto noch aktiv ist. Wird ein Benutzer
                        deaktiviert, verliert er seine Sitzung innerhalb dieses Intervalls.
                    </p>

                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                        <label style="font-size: 13px; min-width: 200px;">Prüfintervall (Sekunden)</label>
                        <input type="number"
                               min="@SettingsViewModel.MinSessionRevalidationSeconds"
                               max="@SettingsViewModel.MaxSessionRevalidationSeconds"
                               class="edit-input" style="max-width: 100px;"
                               @bind="VM.SessionRevalidationSeconds" />
                    </div>
                    <p style="font-size: 12px; color: var(--text-tertiary); margin-bottom: 16px;">
                        Erlaubt: @SettingsViewModel.MinSessionRevalidationSeconds–@SettingsViewModel.MaxSessionRevalidationSeconds Sekunden.
                    </p>

                    <div style="margin-top: 16px;">
                        <button class="btn-primary" @onclick="SaveSessionSecurity">@Resources.Web_Settings_Button_Save</button>
                    </div>
                </div>
            }

            @* ── Tab: Network / IP ── *@
            @if (_activeTab == SettingsTab.Network && VM.CanManageSettings)
            {
                <div class="detail-section">
                    <span class="detail-label">IP-Adressen</span>
                    <p style="font-size: 12px; color: var(--text-tertiary); margin-bottom: 16px;">
                        Adressen, unter denen dieser Server erreichbar ist.
                    </p>

                    <div class="stat-hero">
                        <span class="stat-hero-value">
                            @(VM.PublicIpLoading ? "…" : (VM.PublicIp ?? "—"))
                        </span>
                        <span class="stat-hero-unit">
                            @(VM.PublicIpLoading
                                ? "globale IP wird ermittelt"
                                : VM.PublicIp is not null ? "globale (öffentliche) IP" : "globale IP nicht verfügbar")
                        </span>
                    </div>

                    <div class="info-card">
                        <div class="info-row">
                            <span class="info-key">Hostname</span>
                            <span class="info-val">@VM.HostName</span>
                        </div>
                        <div class="info-row">
                            <span class="info-key">Globale IP</span>
                            <span class="info-val @(VM.PublicIp is null ? "is-muted" : "")">
                                @(VM.PublicIpLoading ? "wird ermittelt…" : (VM.PublicIp ?? "nicht verfügbar"))
                            </span>
                        </div>
                    </div>

                    <span class="detail-label" style="display: block; margin-top: 20px;">Lokale Adressen</span>
                    @if (VM.NetworkAddresses.Count == 0)
                    {
                        <p style="font-size: 13px; color: var(--text-tertiary); margin-top: 8px;">
                            Keine lokalen Netzwerkadressen gefunden.
                        </p>
                    }
                    else
                    {
                        <div class="info-card">
                            @foreach (var addr in VM.NetworkAddresses)
                            {
                                <div class="info-row">
                                    <span class="info-key">
                                        @addr.Address
                                        <span style="font-size: 11px; color: var(--text-tertiary);">@addr.InterfaceName</span>
                                    </span>
                                    <span class="info-badge">@addr.Family</span>
                                </div>
                            }
                        </div>
                    }

                    <div style="margin-top: 16px;">
                        <button class="btn-icon" title="Aktualisieren" @onclick="RefreshNetwork">
                            @Assets.SVG("refresh.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))
                        </button>
                    </div>
                </div>
            }

            @* ── Tab: Storage ── *@
            @if (_activeTab == SettingsTab.Storage && VM.CanManageSettings)
            {
                <div class="detail-section">
                    <span class="detail-label">Gesamtspeicherauslastung</span>
                    <p style="font-size: 12px; color: var(--text-tertiary); margin-bottom: 16px;">
                        Auslastung des Laufwerks, auf dem die Dateien gespeichert werden.
                    </p>

                    @if (VM.StorageUsage is { Available: true } s)
                    {
                        <div class="stat-hero">
                            <span class="stat-hero-value">@Pct(s.UsedPercent) %</span>
                            <span class="stat-hero-unit">belegt · @VM.FormatBytes(s.UsedBytes) von @VM.FormatBytes(s.TotalBytes)</span>
                        </div>

                        <div class="usage-bar">
                            <div class="usage-bar-fill @(s.UsedPercent >= 90 ? "is-critical" : "")"
                                 style="width: @Pct(s.UsedPercent)%;"></div>
                        </div>

                        <div class="info-card">
                            <div class="info-row">
                                <span class="info-key">Frei</span>
                                <span class="info-val">@VM.FormatBytes(s.FreeBytes)</span>
                            </div>
                            <div class="info-row">
                                <span class="info-key">Gesamt</span>
                                <span class="info-val">@VM.FormatBytes(s.TotalBytes)</span>
                            </div>
                            <div class="info-row">
                                <span class="info-key">Laufwerk</span>
                                <span class="info-val">@s.DriveName</span>
                            </div>
                            <div class="info-row">
                                <span class="info-key">Speicherpfad</span>
                                <span class="info-val is-muted">@s.StoragePath</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p style="font-size: 13px; color: var(--text-tertiary);">
                            Speicherinformationen sind nicht verfügbar.
                        </p>
                    }

                    <div style="margin-top: 16px;">
                        <button class="btn-icon" title="Aktualisieren" @onclick="RefreshSystemInfo">
                            @Assets.SVG("refresh.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))
                        </button>
                    </div>
                </div>
            }

            @* ── Tab: Memory / RAM ── *@
            @if (_activeTab == SettingsTab.Memory && VM.CanManageSettings)
            {
                <div class="detail-section">
                    <span class="detail-label">Aktuelle RAM-Auslastung</span>
                    <p style="font-size: 12px; color: var(--text-tertiary); margin-bottom: 16px;">
                        Speicherverbrauch des laufenden Kaimo-Files-Prozesses.
                    </p>

                    @if (VM.MemoryUsage is { } m)
                    {
                        <div class="stat-hero">
                            <span class="stat-hero-value">@VM.FormatBytes(m.WorkingSetBytes)</span>
                            <span class="stat-hero-unit">Arbeitsspeicher · @Pct(m.WorkingSetPercent) % von @VM.FormatBytes(m.TotalAvailableBytes)</span>
                        </div>

                        <div class="usage-bar">
                            <div class="usage-bar-fill @(m.WorkingSetPercent >= 90 ? "is-critical" : "")"
                                 style="width: @Pct(m.WorkingSetPercent)%;"></div>
                        </div>

                        <div class="info-card">
                            <div class="info-row">
                                <span class="info-key">Privater Speicher</span>
                                <span class="info-val">@VM.FormatBytes(m.PrivateBytes)</span>
                            </div>
                            <div class="info-row">
                                <span class="info-key">.NET-Heap (verwaltet)</span>
                                <span class="info-val">@VM.FormatBytes(m.ManagedHeapBytes)</span>
                            </div>
                            <div class="info-row">
                                <span class="info-key">Verfügbar</span>
                                <span class="info-val">@VM.FormatBytes(m.TotalAvailableBytes)</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p style="font-size: 13px; color: var(--text-tertiary);">
                            Speicherinformationen sind nicht verfügbar.
                        </p>
                    }

                    <div style="margin-top: 16px;">
                        <button class="btn-icon" title="Aktualisieren" @onclick="RefreshSystemInfo">
                            @Assets.SVG("refresh.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))
                        </button>
                    </div>
                </div>
            }

            @* ── Tab: Search (Elasticsearch) ── *@
            @if (_activeTab == SettingsTab.Search && VM.CanManageSettings)
            {
                <div class="detail-section">
                    <span class="detail-label">Volltext-Suche (Elasticsearch)</span>
                    <p style="font-size: 12px; color: var(--text-tertiary); margin-bottom: 12px;">
                        Ist Elasticsearch aktiviert und erreichbar, werden Dateiinhalte indexiert und
                        durchsuchbar. Andernfalls – oder wenn der Container nicht gestartet wurde – wird
                        automatisch eine einfache Suche nach Dateinamen verwendet.
                    </p>

                    <div class="service-row">
                        <div class="service-info">
                            <span class="service-name">Elasticsearch</span>
                            <span class="service-status service-status--@(VM.SearchEsEffective ? "running" : "stopped")">
                                @SearchStatusLabel()
                            </span>
                        </div>
                        <label class="toggle-switch" title="Elasticsearch aktivieren/deaktivieren">
                            <input type="checkbox" @bind="VM.SearchEsEnabled" />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>

                    <div class="info-card">
                        <div class="info-row">
                            <span class="info-key">Gewünscht</span>
                            <span class="info-val">@(VM.SearchEsEnabled ? "Aktiviert" : "Deaktiviert")</span>
                        </div>
                        <div class="info-row">
                            <span class="info-key">Container erreichbar</span>
                            <span class="info-val @(VM.SearchEsReachable ? "" : "is-muted")">
                                @(VM.SearchEsReachable ? "Ja" : "Nein")
                            </span>
                        </div>
                        <div class="info-row">
                            <span class="info-key">Aktiver Modus</span>
                            <span class="info-val">
                                @(VM.SearchEsEffective ? "Elasticsearch (Volltext)" : "Dateinamen-Suche")
                            </span>
                        </div>
                    </div>

                    <div style="display: flex; align-items: center; gap: 8px; margin-top: 16px;">
                        <button class="btn-primary" @onclick="SaveSearch">
                            @Resources.Web_Settings_Button_Save
                        </button>
                        <button class="btn-icon" title="Status aktualisieren" @onclick="RefreshSearch">
                            @Assets.SVG("refresh.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))
                        </button>
                    </div>

                    <span class="detail-label" style="display: block; margin-top: 24px;">Manuelle Indexierung</span>
                    <p style="font-size: 12px; color: var(--text-tertiary); margin-bottom: 12px;">
                        Indexiert alle Dateien neu – z. B. wenn Dateien auf anderem Wege hinzugekommen sind
                        oder Elasticsearch zuvor deaktiviert war. Bereits indexierte, unveränderte Dateien
                        werden übersprungen.
                    </p>

                    @if (VM.ReindexProgress.Running)
                    {
                        <div class="usage-bar">
                            <div class="usage-bar-fill" style="width: @VM.ReindexProgress.Percent%;"></div>
                        </div>
                        <p style="font-size: 13px; color: var(--text-tertiary); margin-top: 8px;">
                            Indexiere… @VM.ReindexProgress.Done / @VM.ReindexProgress.Total (@VM.ReindexProgress.Percent %)
                        </p>
                    }
                    else if (VM.ReindexProgress.FinishedAt is not null)
                    {
                        <p style="font-size: 13px; color: var(--text-tertiary);">
                            @if (VM.ReindexProgress.Error is null)
                            {
                                <text>Letzter Lauf abgeschlossen: @VM.ReindexProgress.Done / @VM.ReindexProgress.Total Dateien.</text>
                            }
                            else
                            {
                                <text>Letzter Lauf mit Fehler beendet: @VM.ReindexProgress.Error</text>
                            }
                        </p>
                    }

                    <div style="display: flex; align-items: center; gap: 8px; margin-top: 12px;">
                        <button class="btn-primary" disabled="@(!VM.SearchEsEffective || VM.ReindexProgress.Running)"
                                @onclick="StartReindex">
                            Indexierung starten
                        </button>
                        <button class="btn-icon" title="Fortschritt aktualisieren" @onclick="RefreshSearch">
                            @Assets.SVG("refresh.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))
                        </button>
                    </div>
                </div>
            }

            @* ── Tab: Logging ── *@
            @if (_activeTab == SettingsTab.Logging && VM.CanManageSettings)
            {
                <div class="detail-section">
                    <span class="detail-label">@Resources.Web_Settings_Logging_Detail</span>
                    <p style="font-size: 12px; color: var(--text-tertiary); margin-bottom: 16px;">
                        @Resources.Web_Settings_Logging_Desc
                    </p>

                    <div style="display: flex; align-items: center; gap: 8px;">
                        <select class="edit-input" style="max-width: 240px;" @bind="VM.LogLevel">
                            @foreach (var level in SettingsViewModel.LogLevels)
                            {
                                <option value="@level">@level</option>
                            }
                        </select>

                        <button class="btn-primary" @onclick="SaveLogging">
                            @Resources.Web_Settings_Button_Save
                        </button>
                    </div>
                </div>
            }

            @* ── Tab: Certificate (HTTPS) ── *@
            @if (_activeTab == SettingsTab.Certificate && VM.CanManageCertificates)
            {
                <div class="detail-section">
                    <span class="detail-label">HTTPS-Zertifikat</span>
                    <p style="font-size: 12px; color: var(--text-tertiary); margin-bottom: 16px;">
                        Der Server erzeugt automatisch ein selbstsigniertes Zertifikat und erneuert es
                        vor Ablauf. Lade die öffentliche Zertifikatsdatei herunter, um sie auf den Clients
                        als vertrauenswürdig zu hinterlegen – oder ersetze sie durch ein eigenes Zertifikat.
                    </p>

                    @if (VM.HasCertificate)
                    {
                        <div class="info-card">
                            <div class="info-row">
                                <span class="info-key">Antragsteller (CN)</span>
                                <span class="info-val">@VM.CertSubject</span>
                            </div>
                            <div class="info-row">
                                <span class="info-key">Typ</span>
                                <span class="info-val">
                                    @(VM.CertIsSelfSigned ? "Selbstsigniert" : "Eigenes Zertifikat")
                                    · @(VM.CertSettings.Mode == CertificateMode.Auto ? "automatische Erneuerung" : "keine Erneuerung")
                                </span>
                            </div>
                            <div class="info-row">
                                <span class="info-key">Ausgestellt</span>
                                <span class="info-val">@(VM.CertIssuedUtc?.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? "—")</span>
                            </div>
                            <div class="info-row">
                                <span class="info-key">Läuft ab</span>
                                <span class="info-val @(VM.CertDaysRemaining is <= 21 ? "is-muted" : "")">
                                    @(VM.CertExpiresUtc?.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? "—")
                                    @if (VM.CertDaysRemaining is { } d)
                                    {
                                        <text> (@(d >= 0 ? $"noch {d} Tage" : $"seit {-d} Tagen abgelaufen"))</text>
                                    }
                                </span>
                            </div>
                            <div class="info-row">
                                <span class="info-key">Fingerabdruck (SHA-1)</span>
                                <span class="info-val is-muted">@VM.CertThumbprint</span>
                            </div>
                            @if (VM.CertSans.Count > 0)
                            {
                                <div class="info-row">
                                    <span class="info-key">Alternative Namen (SAN)</span>
                                    <span class="info-val">@string.Join(" · ", VM.CertSans)</span>
                                </div>
                            }
                        </div>

                        <div style="display: flex; align-items: center; gap: 8px; margin-top: 16px; flex-wrap: wrap;">
                            @if (_crtHref is not null)
                            {
                                <a class="btn-primary" href="@_crtHref" download="kaimo-fileserver.crt"
                                   style="text-decoration: none;">.crt herunterladen</a>
                            }
                            @if (_pemHref is not null)
                            {
                                <a class="btn-icon" href="@_pemHref" download="kaimo-fileserver.pem"
                                   style="text-decoration: none;" title="Als PEM herunterladen">.pem</a>
                            }
                            <button class="btn-icon" title="Aktualisieren" @onclick="RefreshCertificate">
                                @Assets.SVG("refresh.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))
                            </button>
                        </div>
                    }
                    else
                    {
                        <p style="font-size: 13px; color: var(--text-tertiary);">
                            Es ist noch kein Zertifikat geladen.
                        </p>
                    }
                </div>

                <div class="detail-section">
                    <span class="detail-label">Automatisches Zertifikat</span>
                    <p style="font-size: 12px; color: var(--text-tertiary); margin-bottom: 16px;">
                        Gültigkeitsdauer des selbstsigniert erzeugten Zertifikats. Es wird rechtzeitig vor
                        Ablauf automatisch erneuert – ohne Neustart.
                    </p>

                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
                        <label style="font-size: 13px; min-width: 200px;">Laufzeit</label>
                        <select class="edit-input" style="max-width: 200px;" @bind="VM.CertSettings.LifetimeDays">
                            <option value="@HttpsCertificateSettings.LifetimeOneMonth">1 Monat (30 Tage)</option>
                            <option value="@HttpsCertificateSettings.LifetimeThreeMonths">3 Monate (90 Tage)</option>
                        </select>
                    </div>

                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
                        <label style="font-size: 13px; min-width: 200px;">Common Name (optional)</label>
                        <input type="text" class="edit-input" style="max-width: 320px;"
                               placeholder="Standard: Hostname" @bind="VM.CertSettings.CommonName" />
                    </div>

                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
                        <label style="font-size: 13px; min-width: 200px;">Zusätzliche Namen/IPs</label>
                        <input type="text" class="edit-input" style="max-width: 320px;"
                               placeholder="fileserver.local, 10.0.0.5" @bind="VM.CertAdditionalSansText" />
                    </div>

                    <div style="display: flex; align-items: center; gap: 8px;">
                        <button class="btn-primary" @onclick="SaveCertificateSettings">
                            Speichern &amp; neu erzeugen
                        </button>
                        <button class="btn-icon" title="Jetzt neu erzeugen" @onclick="RegenerateCertificate">
                            @Assets.SVG("refresh.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))
                        </button>
                    </div>
                </div>

                <div class="detail-section">
                    <span class="detail-label">Eigenes Zertifikat hochladen</span>
                    <p style="font-size: 12px; color: var(--text-tertiary); margin-bottom: 16px;">
                        Ersetze das automatische Zertifikat durch ein eigenes — das Format wird automatisch erkannt.
                        Es muss der <strong>private Schlüssel</strong> dabei sein. Du hast drei Möglichkeiten:
                        eine <strong>.pfx/.p12</strong>, eine <strong>kombinierte PEM</strong> (Zertifikat + Schlüssel
                        in einer Datei), oder <strong>Zertifikat und Schlüssel als zwei getrennte Dateien</strong>
                        (unten). Die automatische Erneuerung wird dafür pausiert.
                    </p>

                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
                        <label style="font-size: 13px; min-width: 200px;">Zertifikat (.pfx/.p12/.pem/.crt/.cer)</label>
                        <InputFile OnChange="OnCertFileSelected" accept=".pfx,.p12,.pem,.crt,.cer" />
                        @if (_pendingCertName.Length > 0)
                        {
                            <span style="font-size: 12px; color: var(--text-tertiary);">@_pendingCertName</span>
                        }
                    </div>

                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
                        <label style="font-size: 13px; min-width: 200px;">Privater Schlüssel (optional, .key/.pem)</label>
                        <InputFile OnChange="OnKeyFileSelected" accept=".key,.pem,.der" />
                        @if (_pendingKeyName.Length > 0)
                        {
                            <span style="font-size: 12px; color: var(--text-tertiary);">@_pendingKeyName</span>
                        }
                    </div>

                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
                        <label style="font-size: 13px; min-width: 200px;">Passwort (bei .pfx/.p12 oder verschlüsseltem Schlüssel)</label>
                        <input type="password" class="edit-input" style="max-width: 240px;"
                               @bind="VM.CustomCertPassword" />
                    </div>

                    <button class="btn-primary" disabled="@(_pendingCert is null)" @onclick="ImportCustomCertificate">
                        Zertifikat übernehmen
                    </button>
                </div>
            }

        </div>
    </div>
}

@code {
    private enum SettingsTab
    {
        Language,
        ContextMenu,
        PasswordPolicy,
        Network,
        Storage,
        Memory,
        DataServices,
        Search,
        Logging,
        Certificate,
    }

    private SettingsTab _activeTab = SettingsTab.Language;

    // Certificate tab local state.
    private string? _crtHref;
    private string? _pemHref;
    private byte[]? _pendingCert;
    private string _pendingCertName = "";
    private byte[]? _pendingKey;
    private string _pendingKeyName = "";

    /// <summary>Formats a percentage with an invariant '.' separator for inline CSS widths.</summary>
    private static string Pct(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await VM.LoadAsync();

            // Default to the first tab the user is actually allowed to see.
            if (!VM.CanManageSettings)
            {
                if (VM.CanManageDataServices)
                    _activeTab = SettingsTab.DataServices;
                else if (VM.CanManageCertificates)
                    _activeTab = SettingsTab.Certificate;
            }

            if (_activeTab == SettingsTab.Certificate)
                BuildCertDownloadLinks();

            StateHasChanged();
        }
    }

    private async Task SwitchTab(SettingsTab tab)
    {
        _activeTab = tab;
        VM.ClearMessages();

        // The public IP needs an outbound call — resolve it lazily when the tab opens.
        if (tab == SettingsTab.Network)
            await VM.LoadPublicIpAsync();

        // Re-probe Elasticsearch reachability + reindex progress when the tab opens.
        if (tab == SettingsTab.Search)
            await VM.LoadSearchStateAsync();

        if (tab == SettingsTab.Certificate)
        {
            await VM.LoadCertificateStateAsync();
            BuildCertDownloadLinks();
        }

        StateHasChanged();
    }

    private void BuildCertDownloadLinks()
    {
        var der = VM.GetPublicCertDerBase64();
        var pem = VM.GetPublicCertPemBase64();
        _crtHref = der is null ? null : $"data:application/x-x509-ca-cert;base64,{der}";
        _pemHref = pem is null ? null : $"data:application/x-pem-file;base64,{pem}";
    }

    private async Task RefreshCertificate()
    {
        await VM.LoadCertificateStateAsync();
        BuildCertDownloadLinks();
        StateHasChanged();
    }

    private async Task SaveCertificateSettings()
    {
        await VM.SaveCertificateSettingsAsync();
        BuildCertDownloadLinks();
        StateHasChanged();
    }

    private async Task RegenerateCertificate()
    {
        await VM.RegenerateCertificateNowAsync();
        BuildCertDownloadLinks();
        StateHasChanged();
    }

    // Certificates/keys are tiny; cap uploads so a huge file can't exhaust memory.
    private const long MaxCertUploadSize = 512 * 1024;

    private async Task OnCertFileSelected(InputFileChangeEventArgs e)
    {
        _pendingCertName = e.File.Name;
        using var ms = new MemoryStream();
        await e.File.OpenReadStream(MaxCertUploadSize).CopyToAsync(ms);
        _pendingCert = ms.ToArray();
    }

    private async Task OnKeyFileSelected(InputFileChangeEventArgs e)
    {
        _pendingKeyName = e.File.Name;
        using var ms = new MemoryStream();
        await e.File.OpenReadStream(MaxCertUploadSize).CopyToAsync(ms);
        _pendingKey = ms.ToArray();
    }

    private async Task ImportCustomCertificate()
    {
        if (_pendingCert is null) return;
        var ok = await VM.ImportCustomCertificateAsync(_pendingCert, _pendingKey);
        if (ok)
        {
            _pendingCert = null;
            _pendingCertName = "";
            _pendingKey = null;
            _pendingKeyName = "";
        }
        BuildCertDownloadLinks();
        StateHasChanged();
    }

    private async Task SaveLanguage()
    {
        await VM.SaveLanguageAsync();
        StateHasChanged();
    }

    private async Task SaveDataServices()
    {
        await VM.SaveDataServicesAsync();
        StateHasChanged();
    }

    private async Task SaveSmbProtocol()
    {
        await VM.SaveSmbProtocolAsync();
        StateHasChanged();
    }

    private async Task SavePasswordPolicy()
    {
        await VM.SavePasswordPolicyAsync();
        StateHasChanged();
    }

    private async Task SaveSessionSecurity()
    {
        await VM.SaveSessionSecurityAsync();
        StateHasChanged();
    }

    private void RefreshSystemInfo()
    {
        VM.RefreshSystemInfo();
        StateHasChanged();
    }

    private async Task RefreshNetwork()
    {
        VM.RefreshSystemInfo();
        await VM.LoadPublicIpAsync(force: true);
        StateHasChanged();
    }

    private ContextMenuScope SelectedScopeProxy
    {
        get => VM.SelectedScope;
        set
        {
            VM.SelectScope(value);
            VM.ClearMessages();
        }
    }

    private async Task SaveContextMenu()
    {
        await VM.SaveContextMenuAsync();
        StateHasChanged();
    }

    private void ResetContextMenu()
    {
        VM.ResetScopeToDefault();
        VM.ClearMessages();
        StateHasChanged();
    }

    private static string ScopeName(ContextMenuScope scope) => scope switch
    {
        ContextMenuScope.Background => Resources.Web_Settings_CtxScope_Background,
        ContextMenuScope.Folder => Resources.Web_Settings_CtxScope_Folder,
        ContextMenuScope.Archive => Resources.Web_Settings_CtxScope_Archive,
        ContextMenuScope.Image => Resources.Web_Settings_CtxScope_Image,
        ContextMenuScope.Video => Resources.Web_Settings_CtxScope_Video,
        ContextMenuScope.Audio => Resources.Web_Settings_CtxScope_Audio,
        ContextMenuScope.Document => Resources.Web_Settings_CtxScope_Document,
        ContextMenuScope.OtherFile => Resources.Web_Settings_CtxScope_OtherFile,
        ContextMenuScope.MultiSelection => Resources.Web_Settings_CtxScope_Multi,
        _ => scope.ToString(),
    };

    private async Task RefreshStatus()
    {
        await VM.RefreshDataServiceStatusAsync();
        StateHasChanged();
    }

    private async Task SaveSearch()
    {
        await VM.SaveSearchAsync();
        StateHasChanged();
    }

    private async Task SaveLogging()
    {
        await VM.SaveLoggingAsync();
        StateHasChanged();
    }

    private async Task RefreshSearch()
    {
        await VM.LoadSearchStateAsync();
        StateHasChanged();
    }

    private async Task StartReindex()
    {
        await VM.StartReindexAsync();
        StateHasChanged();
    }

    private string SearchStatusLabel()
    {
        if (VM.SearchEsEffective) return "Aktiv";
        if (VM.SearchEsEnabled && !VM.SearchEsReachable) return "Nicht erreichbar";
        return "Dateinamen-Modus";
    }

    private static string StatusLabel(string status) => status switch
    {
        "Running" => "Läuft",
        "Stopped" => "Gestoppt",
        "Starting" => "Startet…",
        "Stopping" => "Stoppt…",
        "Faulted" => "Fehler",
        _ => "Unbekannt",
    };
}
