
@page "/departments"
@using Kaimo_File_Server.Core.Domain
@using Kaimo_File_Server.Core.Domain.Department
@using Kaimo_File_Server.Core.Domain.Identity
@using Kaimo_File_Server.Core.Security
@using Kaimo_File_Server.Core.Helpers
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Web.Components.ViewModels
@using Kaimo_File_Server.Web.Components.Pages.Departments.Components
@using Kaimo_File_Server.Web.DynamicHelpers
@using Kaimo_File_Server.Web.Services
@inject DepartmentViewModel VM
@inherits AppComponentBase

<PageTitle>@Resources.Web_Dept_PageTitle</PageTitle>

@if (VM.IsLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>@Resources.Web_Common_Loading</p>
    </div>
}
else if (!VM.CanAccessPage)
{
    <div class="page-header"><div><h1>@Resources.Web_Dept_Heading</h1></div></div>
    <div class="error-banner">@Resources.Web_Dept_NoPermission</div>
}
else
{
    <div class="page-header department-page-header">
        <div>
            <h1>@Resources.Web_Dept_Heading</h1>
            <p class="subtitle">@string.Format(Resources.Web_Dept_Count, VM.Departments.Count)</p>
        </div>
        <div class="department-page-actions">
            @if (VM.CanEdit)
            {
                <button class="btn-primary department-create-button" type="button" @onclick="() => VM.StartCreate()">
                    @Assets.SVG("plus.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2f))
                    <span>@Resources.Web_Dept_CreateTitle</span>
                </button>
            }
        </div>
    </div>

    @* -- Create Form -- *@
    @if (VM.IsCreating)
    {
        <div class="create-form-card admin-compact">
            <h3>@Resources.Web_Dept_NewDepartment</h3>
            <div class="create-form-fields">
                <div class="form-group">
                    <label>@Resources.Web_Dept_Label_Name</label>
                    <input type="text" class="edit-input" placeholder="@Resources.Web_Dept_Placeholder_Name"
                           @bind="VM.CreateName" @bind:event="oninput"
                           @onkeydown="HandleCreateKeyDown" />
                </div>
                <div class="form-group">
                    <label>@Resources.Web_Admin_Label_Description</label>
                    <input type="text" class="edit-input" placeholder="@Resources.Web_Admin_Placeholder_Optional"
                           @bind="VM.CreateDescription" @bind:event="oninput" />
                </div>
                <div class="form-group">
                    <label>@Resources.Web_Dept_Label_Parent</label>
                    <PrincipalPickerField Mode="SelectionMode.Single"
                                          Items="VM.Departments.ToDepartmentItems()"
                                          SelectedIds="VM.CreateParentId.AsSelection()"
                                          SelectedIdsChanged="ids => VM.CreateParentId = ids.FirstOrNull()"
                                          Title="@Resources.Web_Dept_Label_Parent"
                                          Placeholder="@Resources.Web_Dept_NoParent" />
                </div>
            </div>
            @if (VM.ErrorMessage is not null)
            {
                <div class="error-banner" style="margin-top: 12px;">@VM.ErrorMessage</div>
            }
            <div class="create-form-actions">
                <button class="btn-primary" @onclick="Create" disabled="@VM.IsSaving">
                    @(VM.IsSaving ? Resources.Web_Common_Creating : Resources.Web_Common_Create)
                </button>
                <button class="btn-secondary" @onclick="() => VM.CancelCreate()">@Resources.Web_Common_Cancel</button>
            </div>
        </div>
    }

    @if (VM.ErrorMessage is not null && !VM.IsEditing && !VM.IsCreating)
    {
        <div class="error-banner">@VM.ErrorMessage</div>
    }

    <div class="admin-content department-workspace admin-compact">

        <DepartmentTree VM="VM" OnChanged="StateHasChanged" />

        @* ════════════ DETAIL ════════════ *@
        @if (VM.Selected is not null)
        {
            <aside class="admin-detail department-detail">

                @if (VM.SuccessMessage is not null)
                {
                    <div class="success-banner">@VM.SuccessMessage</div>
                }

                @if (VM.IsEditing)
                {
                    @* -------- EDIT MODE -------- *@
                    <div class="detail-header">
                        <h3>@Resources.Web_Dept_EditDepartment</h3>
                        <span class="detail-subtitle">@VM.Selected.Name</span>
                    </div>

                    <Tabs aria-label="@Resources.Web_Dept_EditDepartment">
                        <Tab Active="@(_activeTab == DepartmentDetailTab.General)" Icon="settings.svg" Label="@Resources.Web_Admin_EditTab_General"
                             OnClick="() => SwitchTab(DepartmentDetailTab.General)" />
                        <Tab Active="@(_activeTab == DepartmentDetailTab.Permissions)" Icon="shield.svg" Label="@Resources.Web_Admin_Label_Permissions"
                             OnClick="() => SwitchTab(DepartmentDetailTab.Permissions)" />
                        <Tab Active="@(_activeTab == DepartmentDetailTab.Assignments)" Icon="users.svg" Label="@Resources.Web_Admin_EditTab_Assignment"
                             OnClick="() => SwitchTab(DepartmentDetailTab.Assignments)" />
                    </Tabs>

                    @if (_activeTab == DepartmentDetailTab.General)
                    {
                    <div class="detail-field-grid">
                        <div class="form-group">
                            <label>@Resources.Web_Common_Name</label>
                            <input type="text" class="edit-input" @bind="VM.EditName" />
                        </div>
                        <div class="form-group">
                            <label>@Resources.Web_Admin_Label_Description</label>
                            <input type="text" class="edit-input" placeholder="@Resources.Web_Admin_Placeholder_Optional"
                                   @bind="VM.EditDescription" @bind:event="oninput" />
                        </div>
                        <div class="form-group">
                            <label>@Resources.Web_Dept_Label_Color</label>
                            <div class="toggle-row">
                                <span class="toggle-label-text">@Resources.Web_Dept_CustomColor</span>
                                <label class="toggle-switch">
                                    <input type="checkbox" @bind="VM.EditUseCustomColor" />
                                    <span class="toggle-slider"></span>
                                </label>
                            </div>
                            @if (VM.EditUseCustomColor)
                            {
                                <input type="color" class="edit-input" @bind="VM.EditColor" />
                            }
                            <span class="form-hint">@Resources.Web_Dept_ColorHint</span>
                        </div>
                        <div class="form-group">
                            <label>@Resources.Web_Dept_Label_InheritsFrom</label>
                            <PrincipalPickerField Mode="SelectionMode.Single"
                                                  Items="VM.AvailableParents.ToDepartmentItems()"
                                                  SelectedIds="VM.EditParentId.AsSelection()"
                                                  SelectedIdsChanged="ids => VM.EditParentId = ids.FirstOrNull()"
                                                  Title="@Resources.Web_Dept_Label_InheritsFrom"
                                                  Placeholder="@Resources.Web_Dept_NoParent" />
                            <span class="form-hint">@Resources.Web_Dept_InheritHint</span>
                        </div>
                    </div>
                    }

                    @* -- Default File Permission -- *@
                    @if (_activeTab == DepartmentDetailTab.Permissions)
                    {
                    <div class="detail-section" style="margin-top: 16px;">
                        <span class="detail-label">@Resources.Web_Dept_DefaultFilePerm</span>
                        <p class="form-hint" style="margin-bottom: 8px;">
                        @Resources.Web_Dept_DefaultFilePermHint
                        </p>
                        <div class="toggle-row" style="margin-bottom: 12px;">
<span class="toggle-label-text">@Resources.Web_Dept_DefineOwnPerm</span>
                            <label class="toggle-switch">
                                <input type="checkbox" @bind="VM.EditHasOwnPermission" />
                                <span class="toggle-slider"></span>
                            </label>
                        </div>
                        @if (VM.EditHasOwnPermission)
                        {
                            <div class="permission-flags" style="margin-left: 4px;">
                                @foreach (var flag in DepartmentViewModel.PermFlags)
                                {
                                    var isChecked = VM.HasPermFlag(flag.Flag);
                                    <label class="permission-flag">
                                        <input type="checkbox" checked="@isChecked"
                                               @onchange="e => VM.TogglePermFlag(flag.Flag, (bool)(e.Value ?? false))" />
                                        <span>@flag.Label</span>
                                        <InfoButton Text="@flag.Description" />
                                    </label>
                                }
                            </div>
                        }
                        else if (VM.EditParentId.HasValue)
                        {
                            <span class="detail-field-value detail-field-value--empty">@Resources.Web_Dept_InheritedFromParent</span>
                        }
                        else
                        {
<span class="detail-field-value detail-field-value--empty">@Resources.Web_Dept_NoParentNoPerm</span>
                        }
                    </div>
                    }

                    @* -- Members (M:N) -- *@
                    @if (_activeTab == DepartmentDetailTab.Assignments)
                    {
                    <div class="detail-section" style="margin-top: 16px;">
<span class="detail-label">@Resources.Web_Dept_Label_Members</span>
                        <PrincipalPickerField Mode="SelectionMode.Multiple"
                                     Items="VM.EditMembers.ToPickerItems(PrincipalKind.User, u => u.Id, u => u.Name, u => u.Username)"
                                     SelectedIds="VM.EditMembers.CheckedIds(u => u.Id)"
                                     SelectedIdsChanged="ids => VM.EditMembers.ApplySelection(ids, u => u.Id)"
                                     Title="@Resources.Web_Dept_Label_Members"
                                     Placeholder="@Resources.Web_Common_NoMembers" />
                    </div>
                    }

                    @* -- Groups (direct FK) -- *@
                    @if (_activeTab == DepartmentDetailTab.Assignments)
                    {
                    <div class="detail-section" style="margin-top: 16px;">
<span class="detail-label">@Resources.Web_Dept_Label_AssignedGroups</span>
                        <p class="form-hint" style="margin-bottom: 4px;">
@Resources.Web_Dept_GroupsHint
                        </p>
                        <PrincipalPickerField Mode="SelectionMode.Multiple"
                                     Items='VM.EditGroups.ToPickerItems(PrincipalKind.Group, g => g.Id, g => g.Name, g => VM.Departments.FirstOrDefault(d => d.Id == g.DepartmentId)?.Name ?? "Global")'
                                     SelectedIds="VM.EditGroups.CheckedIds(g => g.Id)"
                                     SelectedIdsChanged="ids => VM.EditGroups.ApplySelection(ids, g => g.Id)"
                                     Title="@Resources.Web_Dept_Label_AssignedGroups"
                                     Placeholder="@Resources.Web_Common_NoGroupsAssigned" />
                    </div>
                    }

                    @* -- Shares (direct FK) -- *@
                    @if (_activeTab == DepartmentDetailTab.Assignments)
                    {
                    <div class="detail-section" style="margin-top: 16px;">
<span class="detail-label">@Resources.Web_Dept_Label_AssignedShares</span>
                        <p class="form-hint" style="margin-bottom: 4px;">
@Resources.Web_Dept_SharesHint
                        </p>
                        <PrincipalPickerField Mode="SelectionMode.Multiple"
                                     Items='VM.EditShares.ToPickerItems(PrincipalKind.Share, s => s.Id, s => s.Name, s => $"{s.Path} — {VM.Departments.FirstOrDefault(d => d.Id == s.DepartmentId)?.Name ?? "Global"}")'
                                     SelectedIds="VM.EditShares.CheckedIds(s => s.Id)"
                                     SelectedIdsChanged="ids => VM.EditShares.ApplySelection(ids, s => s.Id)"
                                     Title="@Resources.Web_Dept_Label_AssignedShares"
                                     Placeholder="@Resources.Web_Common_NoSharesAvailable" />
                    </div>
                    }

                    @if (VM.ErrorMessage is not null)
                    {
                        <div class="error-banner" style="margin: 12px 0;">@VM.ErrorMessage</div>
                    }
                    <div class="detail-actions">
                        <button class="btn-primary" @onclick="Save" disabled="@VM.IsSaving">
@(VM.IsSaving ? Resources.Web_Common_Saving : Resources.Web_Common_Save)
                        </button>
<button class="btn-secondary" @onclick="CancelEdit" disabled="@VM.IsSaving">@Resources.Web_Common_Cancel</button>
                    </div>
                }
                else
                {
                    @* -------- VIEW MODE -------- *@
                    <div class="detail-header">
                        <h3>@VM.Selected.Name</h3>
                        <span class="detail-subtitle">
@(VM.IsGlobalDepartment(VM.Selected) ? Resources.Web_Dept_GlobalDepartment : Resources.Web_Admin_Label_Department)
                        </span>
                    </div>

                    <Tabs aria-label="@Resources.Web_Admin_Label_Department">
                        <Tab Active="@(_activeTab == DepartmentDetailTab.General)" Icon="settings.svg" Label="@Resources.Web_Admin_EditTab_General"
                             OnClick="() => SwitchTab(DepartmentDetailTab.General)" />
                        <Tab Active="@(_activeTab == DepartmentDetailTab.Permissions)" Icon="shield.svg" Label="@Resources.Web_Admin_Label_Permissions"
                             OnClick="() => SwitchTab(DepartmentDetailTab.Permissions)" />
                        <Tab Active="@(_activeTab == DepartmentDetailTab.Assignments)" Icon="users.svg" Label="@Resources.Web_Admin_EditTab_Assignment"
                             OnClick="() => SwitchTab(DepartmentDetailTab.Assignments)" />
                    </Tabs>

                    @* -------- GENERAL -------- *@
                    @if (_activeTab == DepartmentDetailTab.General)
                    {
                    <div class="dept-overview-list">
                        <div class="dept-overview-row dept-overview-row--multiline">
                            <span class="dept-overview-label">@Resources.Web_Admin_Label_Description</span>
                            <span class="dept-overview-value @(string.IsNullOrWhiteSpace(VM.Selected.Description) ? "dept-overview-value--empty" : "")">
                                @(string.IsNullOrWhiteSpace(VM.Selected.Description) ? Resources.Web_Admin_NoDescription : VM.Selected.Description)
                            </span>
                        </div>
                        <div class="dept-overview-row">
                            <span class="dept-overview-label">@Resources.Web_Dept_Label_InheritsFromView</span>
                            @if (VM.Selected.ParentDepartmentId.HasValue)
                            {
                                <span class="dept-overview-value">@VM.GetParentName(VM.Selected.ParentDepartmentId)</span>
                            }
                            else
                            {
                                <span class="dept-overview-value dept-overview-value--empty">@Resources.Web_Dept_NoParentTopLevel</span>
                            }
                        </div>
                    </div>
                    }

                    @* -------- ASSIGNMENTS -------- *@
                    @if (_activeTab == DepartmentDetailTab.Assignments)
                    {
                    <div class="dept-assign-groups">
                        <section class="dept-assign-section">
                            <div class="dept-assign-heading">
                                <span class="dept-assign-label">@Resources.Web_Dept_Label_Members</span>
                                <span class="dept-assign-count">@VM.Members.Count</span>
                            </div>
                            <div class="dept-chip-list">
                                @if (VM.Members.Any())
                                {
                                    @foreach (var member in VM.Members)
                                    {
                                        <span class="dept-chip">@member.Name</span>
                                    }
                                }
                                else
                                {
                                    <span class="dept-chip-empty">@Resources.Web_Common_NoMembers</span>
                                }
                            </div>
                        </section>
                        <section class="dept-assign-section">
                            <div class="dept-assign-heading">
                                <span class="dept-assign-label">@Resources.Web_Dept_Label_AssignedGroups</span>
                                <span class="dept-assign-count">@VM.Groups.Count</span>
                            </div>
                            <div class="dept-chip-list">
                                @if (VM.Groups.Any())
                                {
                                    @foreach (var group in VM.Groups)
                                    {
                                        <span class="dept-chip">@group.Name</span>
                                    }
                                }
                                else
                                {
                                    <span class="dept-chip-empty">@Resources.Web_Dept_NoGroupsAssigned</span>
                                }
                            </div>
                        </section>
                        <section class="dept-assign-section">
                            <div class="dept-assign-heading">
                                <span class="dept-assign-label">@Resources.Web_Dept_Label_AssignedShares</span>
                                <span class="dept-assign-count">@VM.Shares.Count</span>
                            </div>
                            <div class="dept-chip-list">
                                @if (VM.Shares.Any())
                                {
                                    @foreach (var share in VM.Shares)
                                    {
                                        <span class="dept-chip">@share.Name</span>
                                    }
                                }
                                else
                                {
                                    <span class="dept-chip-empty">@Resources.Web_Dept_NoSharesAssigned</span>
                                }
                            </div>
                        </section>
                    </div>
                    }

                    @* -------- PERMISSIONS -------- *@
                    @if (_activeTab == DepartmentDetailTab.Permissions)
                    {
                    <section class="dept-perm-card">
                        <div class="dept-perm-card-label">@Resources.Web_Dept_DefaultFilePerm</div>
                        @if (VM.PermInfo is not null)
                        {
                            @if (VM.PermInfo.HasNoDefault)
                            {
                                <span class="dept-chip-empty">@Resources.Web_Dept_NoDefaultPerm</span>
                            }
                            else
                            {
                                <div class="permission-tags">
                                    @foreach (var flag in DepartmentViewModel.PermFlags)
                                    {
                                        if ((VM.PermInfo.Permission & flag.Flag) == flag.Flag)
                                        {
                                            <span class="permission-tag">@flag.Label</span>
                                        }
                                    }
                                </div>
                                @if (!VM.PermInfo.IsOwn && VM.PermInfo.InheritedFromName is not null)
                                {
                                    <span class="inherited-hint">
                                        @Assets.SVG("chevron_right.svg", new SvgOptions(
                                            Width: 12, Height: 12,
                                            Color: "var(--text-tertiary)", StrokeWidth: 1.5f,
                                            Style: "vertical-align: -1px; margin-right: 2px;"))
                                        @string.Format(Resources.Web_Dept_InheritedFrom, VM.PermInfo.InheritedFromName)
                                    </span>
                                }
                            }
                        }
                    </section>
                    }

                    <div class="detail-actions">
                        @if (VM.CanEdit && !VM.IsGlobalDepartment(VM.Selected))
                        {
<button class="btn-secondary" @onclick="Edit">@Resources.Web_Common_Edit</button>
                        }
                        @if (VM.CanDelete && !VM.IsGlobalDepartment(VM.Selected))
                        {
                            @if (VM.IsConfirmingDelete)
                            {
                                <div class="confirm-delete">
<p>@Resources.Web_Dept_ConfirmDelete</p>
                                    <div style="display: flex; gap: 8px;">
                                        <button class="btn-danger-outline" @onclick="ConfirmDelete" disabled="@VM.IsSaving">
                                            @(VM.IsSaving ? Resources.Web_Common_Deleting : Resources.Web_Common_YesDelete)
                                        </button>
<button class="btn-secondary" @onclick="() => VM.IsConfirmingDelete = false">@Resources.Web_Common_Cancel</button>
                                    </div>
                                </div>
                            }
                            else
                            {
<button class="btn-danger-outline" @onclick="() => VM.RequestDelete()">@Resources.Web_Dept_DeleteDepartment</button>
                            }
                        }
                    </div>
                }
            </aside>
        }
    </div>
}
