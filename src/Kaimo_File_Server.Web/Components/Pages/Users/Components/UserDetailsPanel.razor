@using System.IO
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Core.Security
@using Kaimo_File_Server.Web.Components.ViewModels
@using Kaimo_File_Server.Web.DynamicHelpers
@inject AssetProvider Icons
@inject IJSRuntime JS

@if (VM.SelectedUser is not null)
{
    @if (VM.IsEditing)
    {
        <div class="user-detail-shell user-detail-shell--editing">
            <div class="user-edit-mode-banner">
                <span class="user-edit-mode-icon" aria-hidden="true">
                    @Icons.SVG("edit.svg", new SvgOptions(Width: 18, Height: 18, StrokeWidth: 2f))
                </span>
                <span>
                    <strong>@Resources.Web_Admin_EditUser</strong>
                    <small>@VM.SelectedUser.Username</small>
                </span>
            </div>

            @{
                // Security holds the password fields (admin reset or self change) and the account
                // toggles; Assignment holds departments + groups. Hide a tab with no content for
                // the actor (e.g. a self-service user has no assignment fields).
                var showSecurity = VM.CanEditSelectedUser
                    || (VM.IsSelfPasswordChange && VM.SelectedUser.CanChangePassword);
                var showAssignment = VM.CanEditSelectedUser;
            }

            <Tabs class="detail-tabs--panel user-edit-tabs">
                <Tab Active="@(_editTab == EditTab.General)" Icon="user.svg"
                     Label="@Resources.Web_Admin_EditTab_General"
                     OnClick="() => _editTab = EditTab.General" />
                @if (showSecurity)
                {
                    <Tab Active="@(_editTab == EditTab.Security)" Icon="shield.svg"
                         Label="@Resources.Web_Admin_EditTab_Security"
                         OnClick="() => _editTab = EditTab.Security" />
                }
                @if (showAssignment)
                {
                    <Tab Active="@(_editTab == EditTab.Assignment)" Icon="users_3.svg"
                         Label="@Resources.Web_Admin_EditTab_Assignment"
                         OnClick="() => _editTab = EditTab.Assignment" />
                }
            </Tabs>

            <div class="user-edit-form detail-field-grid">
                @if (!VM.CanEditSelectedUser)
                {
                    <p class="user-selfservice-hint">@Resources.Web_Profile_SelfServiceHint</p>
                }

                @* ── General: photo, names, email, description ── *@
                <div class="user-edit-tabpanel detail-field-grid" hidden="@(_editTab != EditTab.General)">
                    <div class="form-group user-photo-edit">
                        <label>@Resources.Web_Admin_Label_Photo</label>
                        <div class="user-photo-edit-row">
                            <span class="user-photo-preview" aria-hidden="true">
                                @if (VM.EditPhotoDataUri is { } previewUri)
                                {
                                    <img src="@previewUri" alt="" />
                                }
                                else
                                {
                                    @UserAvatar.Initials(VM.SelectedUser)
                                }
                            </span>
                            <div class="user-photo-actions">
                                <label class="btn-secondary user-photo-upload">
                                    @Resources.Web_Admin_Photo_Change
                                    <InputFile OnChange="OnPhotoSelected" accept="image/*" style="display:none" />
                                </label>
                                @if (VM.HasEditPhoto)
                                {
                                    <button type="button" class="btn-secondary" @onclick="RemovePhoto">
                                        @Resources.Web_Admin_Photo_Remove
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    @if (VM.CanEditSelectedUser)
                    {
                        <div class="form-group">
                            <label>@Resources.Web_Admin_Label_DisplayName</label>
                            <input type="text" class="edit-input" @bind="VM.EditUserName" @attributes="HtmlAttr.NoAutofill" />
                        </div>
                    }

                    <div class="form-group">
                        <label>@Resources.Web_Admin_Label_FirstName</label>
                        <input type="text" class="edit-input" placeholder="@Resources.Web_Admin_Placeholder_Optional"
                               @bind="VM.EditUserFirstName" @bind:event="oninput" @attributes="HtmlAttr.NoAutofill" />
                    </div>
                    <div class="form-group">
                        <label>@Resources.Web_Admin_Label_LastName</label>
                        <input type="text" class="edit-input" placeholder="@Resources.Web_Admin_Placeholder_Optional"
                               @bind="VM.EditUserLastName" @bind:event="oninput" @attributes="HtmlAttr.NoAutofill" />
                    </div>

                    @if (VM.CanEditSelectedUser)
                    {
                        <div class="form-group">
                            <label>@Resources.Web_Admin_Label_Email</label>
                            <input type="email" class="edit-input" placeholder="@Resources.Web_Admin_Placeholder_Email"
                                   @bind="VM.EditUserEmail" @bind:event="oninput" @attributes="HtmlAttr.NoAutofill" />
                        </div>
                        <div class="form-group">
                            <label>@Resources.Web_Admin_Label_Description</label>
                            <input type="text" class="edit-input" placeholder="@Resources.Web_Admin_Placeholder_Optional"
                                   @bind="VM.EditUserDescription" @bind:event="oninput" @attributes="HtmlAttr.NoAutofill" />
                        </div>
                    }
                </div>

                @* ── Security: password + account toggles ── *@
                @if (showSecurity)
                {
                    <div class="user-edit-tabpanel detail-field-grid" hidden="@(_editTab != EditTab.Security)">
                        @if (VM.CanResetPasswordForSelected)
                        {
                            @* Administrator password reset — no current password required. *@
                            <div class="form-group">
                                <div class="label-with-info">
                                    <label>@Resources.Web_Admin_Label_NewPassword</label>
                                    <InfoButton Title="@Resources.Web_Settings_Pw_Title" AriaLabel="@Resources.Web_Settings_Pw_Title" ChildContent="PasswordPolicyList" />
                                </div>
                                <input type="password" class="edit-input" placeholder="@Resources.Web_Admin_Placeholder_PasswordEmpty"
                                       @bind="VM.NewPassword" @bind:event="oninput" @attributes="HtmlAttr.NoAutofillPassword" />
                            </div>
                            @if (!string.IsNullOrEmpty(VM.NewPassword))
                            {
                                <div class="form-group">
                                    <label>@Resources.Web_Admin_Label_ConfirmPassword</label>
                                    <input type="password" class="edit-input" placeholder="@Resources.Web_Admin_Placeholder_ConfirmPassword"
                                           @bind="VM.ConfirmPassword" @bind:event="oninput" @attributes="HtmlAttr.NoAutofillPassword" />
                                </div>
                            }
                        }
                        else if (VM.IsSelfPasswordChange && VM.SelectedUser.CanChangePassword)
                        {
                            @* Self password change — requires the current password. *@
                            <div class="form-group">
                                <label>@Resources.Web_Admin_Label_CurrentPassword</label>
                                <input type="password" class="edit-input" placeholder="@Resources.Web_Admin_Placeholder_PasswordEmpty"
                                       @bind="VM.CurrentPassword" @bind:event="oninput" @attributes="HtmlAttr.NoAutofillPassword" />
                            </div>
                            <div class="form-group">
                                <div class="label-with-info">
                                    <label>@Resources.Web_Admin_Label_NewPassword</label>
                                    <InfoButton Title="@Resources.Web_Settings_Pw_Title" AriaLabel="@Resources.Web_Settings_Pw_Title" ChildContent="PasswordPolicyList" />
                                </div>
                                <input type="password" class="edit-input" placeholder="@Resources.Web_Admin_Placeholder_PasswordEmpty"
                                       @bind="VM.NewPassword" @bind:event="oninput" @attributes="HtmlAttr.NoAutofillPassword" />
                            </div>
                            @if (!string.IsNullOrEmpty(VM.NewPassword))
                            {
                                <div class="form-group">
                                    <label>@Resources.Web_Admin_Label_ConfirmPassword</label>
                                    <input type="password" class="edit-input" placeholder="@Resources.Web_Admin_Placeholder_ConfirmPassword"
                                           @bind="VM.ConfirmPassword" @bind:event="oninput" @attributes="HtmlAttr.NoAutofillPassword" />
                                </div>
                            }
                        }

                        @if (VM.CanEditSelectedUser && !VM.CanEditSecuritySettingsForSelected)
                        {
                            @* Own account: the sign-in toggles are locked (enforced in SaveUserAsync too). *@
                            <p class="form-hint">@R("Web_Admin_OwnSecurityLocked")</p>
                        }
                        @if (VM.CanEditSecuritySettingsForSelected || (VM.CanEditSelectedUser && VM.CanManageHomes))
                        {
                            <div class="create-form-toggles user-edit-toggles">
                                @if (VM.CanEditSecuritySettingsForSelected)
                                {
                                    <div class="toggle-row">
                                        <span class="toggle-label-text">@Resources.Web_Admin_Toggle_AccountEnabled</span>
                                        <label class="toggle-switch">
                                            <input type="checkbox" @bind="VM.EditUserIsEnabled" />
                                            <span class="toggle-slider"></span>
                                        </label>
                                    </div>
                                    <div class="toggle-row">
                                        <span class="toggle-label-text">@Resources.Web_Admin_Toggle_CanChangePassword</span>
                                        <label class="toggle-switch">
                                            <input type="checkbox" @bind="VM.EditUserCanChangePassword" />
                                            <span class="toggle-slider"></span>
                                        </label>
                                    </div>
                                }
                                @if (VM.CanManageHomes)
                                {
                                    <div class="toggle-row">
                                        <span class="toggle-label-text">@(Resources.ResourceManager.GetString("Web_Homes_Toggle_Enabled") ?? "Home folder enabled")</span>
                                        <label class="toggle-switch">
                                            <input type="checkbox" @bind="VM.EditUserHomeDirectoryEnabled" />
                                            <span class="toggle-slider"></span>
                                        </label>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @* ── Assignment: departments + groups (roles are managed on the Roles tab) ── *@
                @if (showAssignment)
                {
                    <div class="user-edit-tabpanel detail-field-grid" hidden="@(_editTab != EditTab.Assignment)">
                        @if (VM.CanAssignDepartments)
                        {
                            <div class="form-group">
                                <label>@Resources.Web_Admin_Label_Departments</label>
                                <PrincipalPickerField Mode="SelectionMode.Multiple"
                                             Items="VM.EditUserDepartments.Select(d => d.Item).ToDepartmentItems()"
                                             SelectedIds="VM.EditUserDepartments.CheckedIds(d => d.Id)"
                                             SelectedIdsChanged="ids => VM.EditUserDepartments.ApplySelection(ids, d => d.Id)"
                                             Title="@Resources.Web_Admin_Label_Departments"
                                             Placeholder="@Resources.Web_Common_NoDepartments" />
                            </div>
                        }

                        <div class="form-group">
                            <label>@Resources.Web_Admin_Label_Groups</label>
                            <PrincipalPickerField Mode="SelectionMode.Multiple"
                                         Items="VM.EditUserGroups.ToGroupItems(VM.GetDepartmentDisplay)"
                                         SelectedIds="VM.EditUserGroups.CheckedIds(g => g.Id)"
                                         SelectedIdsChanged="ids => VM.EditUserGroups.ApplySelection(ids, g => g.Id)"
                                         Title="@Resources.Web_Admin_Label_Groups"
                                         Placeholder="@Resources.Web_Common_NoGroupsAssigned" />
                        </div>
                    </div>
                }
            </div>

            @if (VM.ErrorMessage is not null)
            {
                <div class="error-banner user-edit-error">@VM.ErrorMessage</div>
            }

            <div class="detail-actions user-edit-actions">
                <button class="btn-primary" @onclick="SaveUser" disabled="@VM.IsSaving">
                    @(VM.IsSaving ? Resources.Web_Common_Saving : Resources.Web_Common_Save)
                </button>
                <button class="btn-secondary" @onclick="CancelEdit" disabled="@VM.IsSaving">
                    @Resources.Web_Common_Cancel
                </button>
            </div>
        </div>
    }
    else
    {
        var user = VM.SelectedUser;

        <DetailHeader Title="@DisplayName(user.Name, user.Username)" Subtitle="@("@" + user.Username)">
            <Leading>
                <span class="detail-head-icon detail-head-icon--round" aria-hidden="true">
                    @if (UserAvatar.DataUri(user) is { } avatarUri)
                    {
                        <img src="@avatarUri" alt="" />
                    }
                    else
                    {
                        @UserAvatar.Initials(user)
                    }
                </span>
            </Leading>
            <Status>
                @if (user.IsEnabled)
                {
                    <StatusBadge Tone="StatusTone.Positive" Label="@Resources.Web_Common_Active" />
                }
                else
                {
                    <StatusBadge Tone="StatusTone.Negative" Label="@Resources.Web_Common_Disabled" />
                }
            </Status>
            <Actions>
                @if (VM.CanEditSelectedProfile)
                {
                    <button class="btn-tinted" type="button" @onclick="EditUser">
                        @Icons.SVG("edit.svg", new SvgOptions(Width: 14, Height: 14))
                        <span>@Resources.Web_Common_Edit</span>
                    </button>
                }
            </Actions>
            <MoreActions>
                @if (VM.CanDeleteSelectedUser)
                {
                    <MenuItem Icon="trash.svg" Label="@Resources.Web_Admin_DeleteUser" Danger Disabled="@VM.IsSaving"
                              OnClick="() => VM.RequestDeleteUser()" />
                }
            </MoreActions>
        </DetailHeader>

        <DetailSection Title="@Resources.Web_Admin_EditTab_General">
            @if (!string.IsNullOrWhiteSpace(user.FirstName) || !string.IsNullOrWhiteSpace(user.LastName))
            {
                <PropertyRow Label="@Resources.Web_Admin_Label_FirstName" Value="@user.FirstName" />
                <PropertyRow Label="@Resources.Web_Admin_Label_LastName" Value="@user.LastName" />
            }
            <PropertyRow Label="@Resources.Web_Admin_Label_Email" Value="@user.Email" Copyable />
            <PropertyRow Label="@Resources.Web_Admin_Label_Description" Value="@user.Description" />
            <PropertyRow Label="@Resources.Web_Admin_Label_PasswordChange"
                         Value="@(user.CanChangePassword ? Resources.Web_Admin_PasswordChange_Allowed : Resources.Web_Admin_PasswordChange_Locked)" />
        </DetailSection>

        @* One list for every role assignment; Global (the whole system) is just the topmost
           department. Rows keep their inline removal (plans/detail-view-layout.md §9). *@
        <DetailSection Title="@Resources.Web_Admin_ScopedAssignments">
            <TitleInfo>
                <InfoButton Title="@Resources.Web_Admin_ScopedAssignments" AriaLabel="@Resources.Web_Admin_RoleScopes_InfoLabel" IconSize="16">
                    <p>@Resources.Web_Admin_DelegatedRoles_Hint</p>
                    <p>@Resources.Web_Admin_RoleScopes_Info</p>
                </InfoButton>
            </TitleInfo>
            <Body>
                @if (VM.UserScopedAssignments.Any())
                {
                    <div class="user-delegated-role-list">
                        @foreach (var assignment in VM.UserScopedAssignments)
                        {
                            <div class="user-delegated-role-row">
                                <span class="user-delegated-role-name">@assignment.RoleName</span>
                                <span class="user-delegated-role-scope">
                                    <span class="user-delegated-scope-type">@FormatScopeType(assignment.ScopeType)</span>
                                    <span class="user-delegated-scope-line">
                                        <span class="user-delegated-scope-name">@assignment.ScopeName</span>
                                    </span>
                                </span>
                                @if (VM.CanManageRoles)
                                {
                                    <button class="btn-icon btn-icon--small user-delegated-role-remove"
                                            title="@Resources.Web_Admin_RemoveAssignment"
                                            aria-label="@Resources.Web_Admin_RemoveAssignment"
                                            @onclick="() => DeleteAssignment(assignment.AssignmentId)">
                                        @Icons.SVG("cross.svg", new SvgOptions(Width: 14, Height: 14, Color: "var(--danger)", StrokeWidth: 2f))
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
                else if (!VM.IsAddingAssignment)
                {
                    <span class="property-empty">@Resources.Web_Admin_NoDelegatedRoles</span>
                }

                @if (VM.IsAddingAssignment)
                {
                    @* Principal is this user; the scope is a department (Global = the whole system) or a share. *@
                    <ScopedRoleAssignmentForm Roles="VM.AllRoles.ToRoleItems()"
                                              @bind-RoleId="VM.NewAssignmentRoleId"
                                              RolePermissionsById="VM.AllRoles.ToDictionary(r => r.Id, r => r.ManagementPermissions)"
                                              Departments="VM.AllDepartments.ToDepartmentItems()"
                                              Shares="ShareItems()"
                                              @bind-ScopeType="VM.NewAssignmentScopeType"
                                              @bind-ScopeId="VM.NewAssignmentScopeId"
                                              Error="@VM.ErrorMessage" IsSaving="@VM.IsSaving"
                                              OnSubmit="CreateAssignment" OnCancel="() => VM.CancelAddAssignment()" />
                }
                else if (VM.CanManageRoles)
                {
                    <div>
                        <button class="btn-secondary btn-secondary--sm" type="button" @onclick="StartAddAssignment">
                            @Icons.SVG("plus.svg", new SvgOptions(Width: 12, Height: 12, StrokeWidth: 2f))
                            <span>@Resources.Web_Admin_AddAssignment</span>
                        </button>
                    </div>
                }
            </Body>
        </DetailSection>

        <DetailSection Title="@R("Web_Admin_Section_Memberships")">
            <PropertyRow Label="@Resources.Web_Admin_Label_Departments">
                @if (VM.UserDepartments.Any())
                {
                    <span class="user-chip-list">
                        @foreach (var department in VM.UserDepartments.Take(ChipPreview))
                        {
                            <span class="user-chip">@department.Name</span>
                        }
                        @if (VM.UserDepartments.Count > ChipPreview)
                        {
                            <span class="user-chip user-chip--more">+@(VM.UserDepartments.Count - ChipPreview)</span>
                        }
                    </span>
                }
                else
                {
                    <span class="property-empty">@Resources.Web_Common_NoDepartments</span>
                }
            </PropertyRow>
            <PropertyRow Label="@Resources.Web_Admin_Label_Groups">
                @if (VM.UserGroups.Any())
                {
                    <span class="user-chip-list">
                        @foreach (var group in VM.UserGroups.Take(ChipPreview))
                        {
                            <span class="user-chip">@group.Name</span>
                        }
                        @if (VM.UserGroups.Count > ChipPreview)
                        {
                            <span class="user-chip user-chip--more">+@(VM.UserGroups.Count - ChipPreview)</span>
                        }
                    </span>
                }
                else
                {
                    <span class="property-empty">@Resources.Web_Common_NoGroupsAssigned</span>
                }
            </PropertyRow>
        </DetailSection>

        @if (VM.IsConfirmingDelete && VM.CanDeleteSelectedUser)
        {
            <div class="modal-backdrop" @onclick="() => VM.IsConfirmingDelete = false">
                <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="user-delete-title" @onclick:stopPropagation="true">
                    <h2 class="modal-title" id="user-delete-title">@Resources.Web_Admin_ConfirmDeleteUser</h2>
                    <p class="modal-text"><strong>@DisplayName(user.Name, user.Username)</strong> (@@@user.Username)</p>
                    <div class="modal-actions">
                        <button type="button" class="btn-secondary" @onclick="() => VM.IsConfirmingDelete = false">@Resources.Web_Common_Cancel</button>
                        <button type="button" class="btn-danger" disabled="@VM.IsSaving" @onclick="ConfirmDeleteUser">
                            @(VM.IsSaving ? Resources.Web_Common_Deleting : Resources.Web_Admin_DeleteUser)
                        </button>
                    </div>
                </div>
            </div>
        }
    }
}

@if (_cropOpen)
{
    <div class="avatar-crop-overlay" @onclick="CloseCrop">
        <div class="avatar-crop-dialog" @onclick:stopPropagation="true">
            <h3 class="avatar-crop-title">@Resources.Web_Admin_Photo_Change</h3>
            <div class="avatar-crop-frame">
                <canvas @ref="_cropCanvas" width="@CropSize" height="@CropSize"></canvas>
            </div>
            <div class="avatar-crop-zoom">
                <button type="button" class="btn-secondary" @onclick="() => ZoomCrop(0.8)" aria-label="Zoom out">&minus;</button>
                <button type="button" class="btn-secondary" @onclick="() => ZoomCrop(1.25)" aria-label="Zoom in">+</button>
            </div>
            <div class="avatar-crop-actions">
                <button type="button" class="btn-primary" @onclick="ConfirmCrop">@Resources.Web_Common_Save</button>
                <button type="button" class="btn-secondary" @onclick="CloseCrop">@Resources.Web_Common_Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public UserListViewModel VM { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private static string R(string key) => Resources.ResourceManager.GetString(key) ?? key;

    // Departments and groups show this many chips, then a "+n" chip.
    private const int ChipPreview = 4;

    // Active password-complexity rules, shown in the InfoButton next to new-password fields.
    private RenderFragment PasswordPolicyList => @<ul>
        <li>@R("Web_Settings_Pw_MinLength"): @VM.PasswordPolicy.MinLength</li>
        @if (VM.PasswordPolicy.RequireUppercase) { <li>@R("Web_Settings_Pw_RequireUppercase")</li> }
        @if (VM.PasswordPolicy.RequireLowercase) { <li>@R("Web_Settings_Pw_RequireLowercase")</li> }
        @if (VM.PasswordPolicy.RequireDigit) { <li>@R("Web_Settings_Pw_RequireDigit")</li> }
        @if (VM.PasswordPolicy.RequireSpecial) { <li>@R("Web_Settings_Pw_RequireSpecial")</li> }
    </ul>;

    private enum EditTab { General, Security, Assignment }
    private EditTab _editTab = EditTab.General;

    private async Task EditUser() { await VM.StartEditUserAsync(); _editTab = EditTab.General; StateHasChanged(); }
    private async Task SaveUser() { await VM.SaveUserAsync(); await OnChanged.InvokeAsync(); }

    // Crop-dialog state.
    private bool _cropOpen;
    private bool _cropInited;
    private string? _cropSourceUri;
    private ElementReference _cropCanvas;
    private const int CropSize = 256;

    private async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        { VM.ReportError(Resources.Web_Admin_Photo_InvalidType); StateHasChanged(); return; }
        // The source may be larger than the stored cap; we downscale it in the crop step,
        // so allow a generous ceiling here (still bounded to avoid loading huge files).
        if (file.Size > 12 * 1024 * 1024)
        { VM.ReportError(Resources.Web_Admin_Photo_TooLarge); StateHasChanged(); return; }

        using var ms = new MemoryStream();
        await file.OpenReadStream(12 * 1024 * 1024).CopyToAsync(ms);
        _cropSourceUri = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
        _cropInited = false;
        _cropOpen = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_cropOpen && !_cropInited && _cropSourceUri is not null)
        {
            _cropInited = true;
            await JS.InvokeVoidAsync("kaimoAvatarCrop.init", _cropCanvas, _cropSourceUri, CropSize);
        }
    }

    private async Task ZoomCrop(double factor)
        => await JS.InvokeVoidAsync("kaimoAvatarCrop.zoom", _cropCanvas, factor);

    private async Task ConfirmCrop()
    {
        var dataUrl = await JS.InvokeAsync<string>("kaimoAvatarCrop.result", _cropCanvas);
        var comma = dataUrl.IndexOf(',');
        if (comma > 0)
        {
            var bytes = Convert.FromBase64String(dataUrl[(comma + 1)..]);
            VM.SetEditPhoto(bytes, "image/jpeg");
        }
        CloseCrop();
    }

    private void CloseCrop()
    {
        _cropOpen = false;
        _cropInited = false;
        _cropSourceUri = null;
        StateHasChanged();
    }

    private void RemovePhoto() { VM.ClearEditPhoto(); StateHasChanged(); }
    private void CancelEdit() { VM.CancelEdit(); StateHasChanged(); }
    private async Task ConfirmDeleteUser() { await VM.ConfirmDeleteUserAsync(); await OnChanged.InvokeAsync(); }
    private async Task DeleteAssignment(Guid id) { await VM.DeleteAssignmentAsync(id); StateHasChanged(); }
    private async Task StartAddAssignment()
    {
        VM.StartAddAssignment();
        VM.NewAssignmentPrincipalId = VM.SelectedUser?.Id;
        VM.NewAssignmentScopeType = ScopeType.Department;
        await VM.LoadAssignmentFormDataAsync();
        StateHasChanged();
    }
    private async Task CreateAssignment() { await VM.CreateAssignmentAsync(); StateHasChanged(); }
    private IReadOnlyList<PrincipalPickerItem> ShareItems() =>
        VM.AllShares.Select(s => new PrincipalPickerItem(s.Id, s.Name, PrincipalKind.Share)).ToList();
    private static string DisplayName(string? name, string username) => string.IsNullOrWhiteSpace(name) ? username : name;
    // Global is shown as what it is to the user: the topmost department.
    private static string FormatScopeType(ScopeType type) => type switch { ScopeType.Global => R("Web_Admin_ScopeChoice_System"), ScopeType.Department => Resources.Web_Admin_ScopeType_Department, ScopeType.Share => Resources.Web_Admin_ScopeType_Share, _ => type.ToString() };
}
