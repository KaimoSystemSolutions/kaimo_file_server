
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Core.Helpers
@using Kaimo_File_Server.Web.Components.ViewModels
@* ════════════════════ LIST ════════════════════ *@
                @switch (VM.ActiveTab)
                {
                    case AdminTab.Users:
                        @if (!VM.Users.Any())
                        {
                            <div class="user-list-container empty-state"><p>@Resources.Web_Common_NoUsers</p></div>
                        }
                        else
                        {
                            <div class="user-list-container">
                                <div class="user-list-row user-list-header">
                                    <div class="user-cell-name">@Resources.Web_Common_Name</div>
                                    <div class="user-cell-username">@Resources.Web_Admin_Label_Username</div>
                                    <div class="user-cell-status">@Resources.Web_Admin_Label_Status</div>
                                </div>
                                @foreach (var user in VM.Users)
                                {
                                    var isSelected = VM.SelectedUser?.Id == user.Id;
                                    <button class="user-list-row user-list-selectable @(isSelected ? "user-list-selected" : "")" type="button"
                                        @onclick="() => SelectUser(user)">
                                        <div class="user-cell-name">
                                            <span>@user.Name</span>
                                        </div>
                                        <div class="user-cell-username">@user.Username</div>
                                        <div class="user-cell-status">
                                            @if (user.IsEnabled)
                                            {
                                                <span class="status-badge status-badge--active">
                                                    <span class="status-dot status-dot--active"></span>@Resources.Web_Common_Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-badge--disabled">
                                                    <span class="status-dot status-dot--disabled"></span>@Resources.Web_Common_Disabled
                                                </span>
                                            }
                                        </div>
                                    </button>
                                }
                            </div>
                        }
                        break;


                    case AdminTab.Groups:
                        @if (!VM.Groups.Any())
                        {
                            <div class="user-list-container empty-state"><p>@Resources.Web_Common_NoGroups</p></div>
                        }
                        else
                        {
                            <div class="user-list-container entity-list-container">
                                <div class="user-list-row entity-list-row user-list-header">
                                    <div class="user-cell-name">@Resources.Web_Admin_Label_GroupName</div>
                                </div>
                                @foreach (var departmentGroup in VM.Groups
                                    .GroupBy(group => new { group.DepartmentId, Name = VM.GetDepartmentName(group.DepartmentId) })
                                    .OrderBy(group => group.Key.DepartmentId == WellKnownGUIDs.DEPARTMENT_GLOBAL ? 0 : 1)
                                    .ThenBy(group => group.Key.Name))
                                {
                                    <div class="entity-list-department-heading">@departmentGroup.Key.Name</div>
                                    @foreach (var group in departmentGroup.OrderBy(group => group.Name))
                                    {
                                        var isSelected = VM.SelectedGroup?.Id == group.Id;
                                        <button class="user-list-row entity-list-row user-list-selectable @(isSelected ? "user-list-selected" : "")" type="button"
                                             @onclick="() => SelectGroup(group)">
                                            <div class="user-cell-name"><span>@group.Name</span></div>
                                        </button>
                                    }
                                }
                            </div>
                        }
                        break;

                    case AdminTab.Roles:
                        @if (!VM.Roles.Any())
                        {
                            <div class="user-list-container empty-state"><p>@Resources.Web_Common_NoRoles</p></div>
                        }
                        else
                        {
                            <div class="user-list-container entity-list-container">
                                <div class="user-list-row entity-list-row user-list-header">
                                    <div class="user-cell-name">@Resources.Web_Admin_Label_RoleName</div>
                                    <div class="user-cell-meta">@Resources.Web_Admin_Label_Type</div>
                                </div>
                                @foreach (var role in VM.Roles)
                                {
                                    var isSelected = VM.SelectedRole?.Id == role.Id;
                                    <button class="user-list-row entity-list-row user-list-selectable @(isSelected ? "user-list-selected" : "")" type="button"
                                         @onclick="() => SelectRole(role)">
                                        <div class="user-cell-name">
                                            <span>@role.Name</span>
                                        </div>
                                        <div class="user-cell-meta">
                                            @(role.IsSystemRole ? Resources.Web_Common_System : Resources.Web_Common_Custom)
                                        </div>
                                    </button>
                                }
                            </div>
                        }
                        break;
                }

@code {
    [Parameter, EditorRequired] public UserListViewModel VM { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private async Task SelectUser(User user) { await VM.SelectUserAsync(user); await OnChanged.InvokeAsync(); }
    private async Task SelectGroup(Group group) { await VM.SelectGroupAsync(group); await OnChanged.InvokeAsync(); }
    private async Task SelectRole(Role role) { await VM.SelectRoleAsync(role); await OnChanged.InvokeAsync(); }
}

