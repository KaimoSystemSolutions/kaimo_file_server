@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Core.Security
@using Kaimo_File_Server.Web.Components.ViewModels
@using Kaimo_File_Server.Web.DynamicHelpers
@inject AssetProvider Icons

@* ------------ GROUP DETAIL ------------ *@
                    @if (VM.SelectedGroup is not null)
                    {
                        @if (VM.IsEditing)
                        {
                            <div class="detail-header">
<h3>@Resources.Web_Admin_EditGroup</h3>
                                <span class="detail-subtitle">@VM.SelectedGroup.Name</span>
                            </div>
                            <div class="detail-section">
<span class="detail-label">@Resources.Web_Admin_Label_GroupName</span>
                                <input type="text" class="edit-input" @bind="VM.EditGroupName" @bind:event="oninput" />
                            </div>
                            <div class="detail-section">
<span class="detail-label">@Resources.Web_Admin_Label_Users</span>
                                <PrincipalPickerField Mode="SelectionMode.Multiple"
                                             Items="VM.EditGroupMembers.ToPickerItems(PrincipalKind.User, u => u.Id, u => u.Name, u => u.Username)"
                                             SelectedIds="VM.EditGroupMembers.CheckedIds(u => u.Id)"
                                             SelectedIdsChanged="ids => VM.EditGroupMembers.ApplySelection(ids, u => u.Id)"
                                             Title="@Resources.Web_Admin_Label_Users"
                                             Placeholder="@Resources.Web_Common_NoMembers" />
                            </div>
                            @if (VM.EditGroupDeptWarning is not null)
                            {
                                <div class="warning-banner">@VM.EditGroupDeptWarning</div>
                            }
                            @if (VM.ErrorMessage is not null)
                            {
                                <div class="error-banner" style="margin-bottom: 12px;">@VM.ErrorMessage</div>
                            }
                            <div class="detail-actions">
                                <button class="btn-primary" @onclick="SaveGroup" disabled="@VM.IsSaving">
                                    @(VM.IsSaving ? Resources.Web_Common_Saving : Resources.Web_Common_Save)
                                </button>
<button class="btn-secondary" @onclick="CancelEdit" disabled="@VM.IsSaving">@Resources.Web_Common_Cancel</button>
                            </div>
                        }
                        else
                        {
                            var group = VM.SelectedGroup;
                            var canEdit = VM.CanManageGroups && VM.SelectedGroupIsEditable;
                            <DetailHeader Icon="users.svg" Title="@group.Name" Subtitle="@Resources.Web_Admin_Label_Group">
                                <Actions>
                                    @if (canEdit)
                                    {
                                        <button class="btn-tinted" type="button" @onclick="EditGroup">
                                            @Icons.SVG("edit.svg", new SvgOptions(Width: 14, Height: 14))
                                            <span>@Resources.Web_Common_Edit</span>
                                        </button>
                                    }
                                </Actions>
                                <MoreActions>
                                    @if (VM.CanDeleteGroups)
                                    {
                                        <MenuItem Icon="trash.svg" Label="@Resources.Web_Admin_DeleteGroup" Danger Disabled="@VM.IsSaving"
                                                  OnClick="() => VM.RequestDeleteGroup()" />
                                    }
                                </MoreActions>
                            </DetailHeader>

                            <DetailSection Title="@Resources.Web_Admin_EditTab_General">
                                <PropertyRow Label="@Resources.Web_Admin_Label_Department" Value="@VM.GetDepartmentName(group.DepartmentId)" />
                            </DetailSection>

                            <DetailSection Title="@($"{Resources.Web_Admin_DirectMembers} ({VM.GroupMembers.Count})")">
                                <Body>
                                    <div class="user-chip-list">
                                        @if (VM.GroupMembers.Any())
                                        {
                                            @foreach (var member in VM.GroupMembers.Take(MemberPreview))
                                            {
                                                <span class="user-chip">@member.Name</span>
                                            }
                                            @if (VM.GroupMembers.Count > MemberPreview)
                                            {
                                                <span class="user-chip user-chip--more">+@(VM.GroupMembers.Count - MemberPreview)</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="user-membership-empty">@Resources.Web_Common_NoMembers</span>
                                        }
                                    </div>
                                </Body>
                            </DetailSection>

                            @if (VM.IsConfirmingDelete && VM.CanDeleteGroups)
                            {
                                <div class="modal-backdrop" @onclick="() => VM.IsConfirmingDelete = false">
                                    <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="group-delete-title" @onclick:stopPropagation="true">
                                        <h2 class="modal-title" id="group-delete-title">@Resources.Web_Admin_ConfirmDeleteGroup</h2>
                                        <p class="modal-text"><strong>@group.Name</strong></p>
                                        <div class="modal-actions">
                                            <button type="button" class="btn-secondary" @onclick="() => VM.IsConfirmingDelete = false">@Resources.Web_Common_Cancel</button>
                                            <button type="button" class="btn-danger" disabled="@VM.IsSaving" @onclick="ConfirmDeleteGroup">
                                                @(VM.IsSaving ? Resources.Web_Common_Deleting : Resources.Web_Admin_DeleteGroup)
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    }
@code {
    [Parameter, EditorRequired] public UserListViewModel VM { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }
    private async Task EditGroup() { await VM.StartEditGroupAsync(); StateHasChanged(); }
    private async Task SaveGroup() { await VM.SaveGroupAsync(); await OnChanged.InvokeAsync(); }
    private void CancelEdit() { VM.CancelEdit(); StateHasChanged(); }
    private async Task ConfirmDeleteGroup() { await VM.ConfirmDeleteGroupAsync(); await OnChanged.InvokeAsync(); }
    private const int MemberPreview = 12;
}
