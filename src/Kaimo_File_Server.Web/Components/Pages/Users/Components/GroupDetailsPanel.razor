@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Core.Security
@using Kaimo_File_Server.Web.Components.ViewModels
@using Kaimo_File_Server.Web.DynamicHelpers
@inject AssetProvider Icons

@* ------------ GROUP DETAIL ------------ *@
                    @if (VM.SelectedGroup is not null)
                    {
                        @if (VM.IsEditing)
                        {
                            <div class="detail-header">
<h3>@Resources.Web_Admin_ManageMembers</h3>
                                <span class="detail-subtitle">@VM.SelectedGroup.Name</span>
                            </div>
                            <div class="detail-section">
<span class="detail-label">@Resources.Web_Admin_Label_Users</span>
                                <div class="multi-select @(membersOpen ? "open" : "")">
                                    <div class="multi-select-display" @onclick="() => membersOpen = !membersOpen">
                                        <span class="multi-select-text">
@Checked(VM.EditGroupMembers.Where(m => m.IsChecked).Select(m => m.Item.Name), Resources.Web_Common_NoMembers)
                                        </span>
                                        @Icons.SVG("chevron_down_transparent.svg", new SvgOptions(
                                                Width: 14,
                                                Height: 14,
                                                StrokeWidth: 2f,
                                                CssClass: "multi-select-chevron"
                                            ))
                                    </div>
                                    @if (membersOpen)
                                    {
                                        <div class="multi-select-backdrop" @onclick="() => membersOpen = false"></div>
                                        <div class="multi-select-dropdown">
                                            @foreach (var item in VM.EditGroupMembers)
                                            {
                                                <label class="multi-select-option">
                                                    <input type="checkbox" @bind="item.IsChecked" />
                                                    <span>@item.Item.Name</span>
                                                    <span class="multi-select-hint">@item.Item.Username</span>
                                                </label>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                            @if (VM.ErrorMessage is not null)
                            {
                                <div class="error-banner" style="margin-bottom: 12px;">@VM.ErrorMessage</div>
                            }
                            <div class="detail-actions">
                                <button class="btn-primary" @onclick="SaveGroup" disabled="@VM.IsSaving">
                                    @(VM.IsSaving ? "Speichert…" : "Speichern")
                                </button>
<button class="btn-secondary" @onclick="CancelEdit" disabled="@VM.IsSaving">@Resources.Web_Common_Cancel</button>
                            </div>
                        }
                        else
                        {
                            <div class="detail-header">
                                <h3>@VM.SelectedGroup.Name</h3>
<span class="detail-subtitle">@Resources.Web_Admin_Label_Group</span>
                            </div>
                            <div class="detail-field-grid">
                                <div class="detail-field">
<span class="detail-field-label">@Resources.Web_Admin_Label_Department</span>
                                    <span class="detail-field-value">@VM.GetDepartmentName(VM.SelectedGroup.DepartmentId)</span>
                                </div>
                                <div class="detail-field">
<span class="detail-field-label">@Resources.Web_Admin_DirectMembers (@VM.GroupMembers.Count)</span>
                                    <span class="detail-field-value">

@(VM.GroupMembers.Any() ? Format(VM.GroupMembers.Select(u => u.Name), 5) : Resources.Web_Common_NoMembers)
                                    </span>
                                </div>
                                <div class="detail-field">
                                    <span class="detail-field-label">ID</span>
                                    <span class="detail-field-value" style="font-size: 11px; font-family: monospace;">@VM.SelectedGroup.Id</span>
                                </div>
                            </div>
                            <div class="detail-actions">
                                @if (VM.CanManageGroups)
                                {
<button class="btn-secondary" @onclick="EditGroup">@Resources.Web_Admin_ManageMembers</button>
                                }
                                @if (VM.CanDeleteGroups)
                                {
                                    @if (VM.IsConfirmingDelete)
                                    {
                                        <div class="confirm-delete">
<p>@Resources.Web_Admin_ConfirmDeleteGroup</p>
                                            <div style="display: flex; gap: 8px;">
                                                <button class="btn-danger-outline" @onclick="ConfirmDeleteGroup" disabled="@VM.IsSaving">
                                                    @(VM.IsSaving ? "Löscht…" : "Ja, löschen")
                                                </button>
<button class="btn-secondary" @onclick="() => VM.IsConfirmingDelete = false">@Resources.Web_Common_Cancel</button>
                                            </div>
                                        </div>

                                    }
                                    else
                                    {
<button class="btn-danger-outline" @onclick="() => VM.RequestDeleteGroup()">@Resources.Web_Admin_DeleteGroup</button>
                                    }
                                }
                            </div>
                        }
                    }
@code {
    [Parameter, EditorRequired] public UserListViewModel VM { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }
    private bool membersOpen;
    private async Task EditGroup() { await VM.StartEditGroupAsync(); StateHasChanged(); }
    private async Task SaveGroup() { await VM.SaveGroupAsync(); await OnChanged.InvokeAsync(); }
    private void CancelEdit() { membersOpen = false; VM.CancelEdit(); StateHasChanged(); }
    private async Task ConfirmDeleteGroup() { await VM.ConfirmDeleteGroupAsync(); await OnChanged.InvokeAsync(); }
    private static string Checked(IEnumerable<string> names, string fallback) { var list = names.ToList(); return list.Count > 0 ? string.Join(", ", list) : fallback; }
    private static string Format(IEnumerable<string> items, int max) { var list = items.ToList(); if (list.Count == 0) return ""; var visible = string.Join(", ", list.Take(max)); if (list.Count > max) visible += " " + string.Format(Resources.Web_Common_MoreItems, list.Count - max); return visible; }
}
