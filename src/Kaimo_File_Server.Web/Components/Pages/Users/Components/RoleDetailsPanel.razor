@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Core.Security
@using Kaimo_File_Server.Web.Components.ViewModels
@using Kaimo_File_Server.Web.DynamicHelpers
@inject AssetProvider Icons

@* ------------ ROLE DETAIL ------------ *@
                    @if (VM.SelectedRole is not null)
                    {
                        @* Role detail remains unchanged — same as original *@
                        @if (VM.IsEditing)
                        {
                            @* The role being edited stays named in the header (live with the name field). *@
                            <DetailHeader Icon="shield.svg"
                                          Title="@(string.IsNullOrWhiteSpace(VM.EditRoleName) ? VM.SelectedRole.Name : VM.EditRoleName)"
                                          Subtitle="@Resources.Web_Admin_EditRole">
                                <Status>
                                    @if (!VM.SelectedRole.IsSystemRole)
                                    {
                                        <span class="role-edit-count">@string.Format(R("Web_Role_PermissionCount", "{0} of {1} permissions"), GrantedTotal(), PermissionTotal)</span>
                                    }
                                </Status>
                            </DetailHeader>
                            @if (!VM.SelectedRole.IsSystemRole)
                            {
                                <div class="form-group" style="margin-top: 16px;">
                                    <label>@Resources.Web_Admin_Label_RoleName</label>
                                    <input type="text" class="edit-input" @bind="VM.EditRoleName" @bind:event="oninput" />
                                </div>
                                <div class="detail-section" style="margin-top: 16px;">
<span class="detail-label">@Resources.Web_Admin_Label_Permissions</span>
                                    <RolePermissionEditor VM="VM" Disabled="@VM.IsSaving" />
                                </div>
                            }
                            else
                            {
                                <div class="detail-info" style="margin-top: 16px;">
                                    @Icons.SVG("circle_info.svg", new SvgOptions(
                                            Width: 14,
                                            Height: 14,
                                            Color: "var(--text-tertiary)"
                                        ))
<span>@Resources.Web_Admin_SystemRoleHint</span>
                                </div>
                            }
                            @if (VM.ErrorMessage is not null)
                            {
                                <div class="error-banner" style="margin: 12px 0;">@VM.ErrorMessage</div>
                            }
                            <div class="detail-actions">
                                <button class="btn-primary" @onclick="SaveRole" disabled="@VM.IsSaving">
                                    @(VM.IsSaving ? Resources.Web_Common_Saving : Resources.Web_Common_Save)
                                </button>
<button class="btn-secondary" @onclick="CancelEdit" disabled="@VM.IsSaving">@Resources.Web_Common_Cancel</button>
                            </div>
                        }
                        else
                        {
                            var role = VM.SelectedRole;
                            var canEditRole = VM.CanEditRoleDefinitions && !role.IsSystemRole;
                            var canDeleteRole = VM.CanDeleteRoles && !role.IsSystemRole;
                            <DetailHeader Icon="shield.svg" Title="@role.Name"
                                          Subtitle="@(role.IsSystemRole ? Resources.Web_Admin_SystemRole : Resources.Web_Admin_CustomRole)">
                                <Actions>
                                    @if (canEditRole)
                                    {
                                        <button class="btn-tinted" type="button" @onclick="EditRole">
                                            @Icons.SVG("edit.svg", new SvgOptions(Width: 14, Height: 14))
                                            <span>@Resources.Web_Common_Edit</span>
                                        </button>
                                    }
                                </Actions>
                                <MoreActions>
                                    @if (canDeleteRole)
                                    {
                                        <MenuItem Icon="trash.svg" Label="@Resources.Web_Admin_DeleteRole" Danger Disabled="@VM.IsSaving"
                                                  OnClick="() => VM.RequestDeleteRole()" />
                                    }
                                </MoreActions>
                            </DetailHeader>

                            @* One row per permission area, listing only the granted permissions. *@
                            <DetailSection Title="@Resources.Web_Admin_Label_Permissions">
                                @if (role.ManagementPermissions == ManagementPermission.None)
                                {
                                    <PropertyRow Label="@Resources.Web_Admin_Label_Permissions" Value="@Resources.Web_Admin_NoPermissions" />
                                }
                                else
                                {
                                    @foreach (var group in UserListViewModel.PermissionGroups)
                                    {
                                        var granted = group.Flags.Where(f => (role.ManagementPermissions & f.Flag) == f.Flag).ToList();
                                        if (granted.Count == 0)
                                            continue;
                                        <PropertyRow Label="@group.Label">
                                            <span class="permission-tags">
                                                @foreach (var flag in granted)
                                                {
                                                    <span class="permission-tag">@flag.Label</span>
                                                }
                                            </span>
                                        </PropertyRow>
                                    }
                                }
                            </DetailSection>

                            <DetailSection Title="@Resources.Web_Admin_DelegatedAssignments">
                                <Body>
                                    @if (VM.IsAddingAssignment)
                                    {
                                        <ScopedRoleAssignmentForm Principals="VM.AllUsers.ToAssigneeItems(VM.AllGroups)"
                                                                  @bind-PrincipalId="VM.NewAssignmentPrincipalId"
                                                                  RolePermissions="@role.ManagementPermissions"
                                                                  Departments="VM.AllDepartments.ToDepartmentItems()"
                                                                  Shares="ShareItems()"
                                                                  @bind-ScopeType="VM.NewAssignmentScopeType"
                                                                  @bind-ScopeId="VM.NewAssignmentScopeId"
                                                                  Error="@VM.ErrorMessage" IsSaving="@VM.IsSaving"
                                                                  OnSubmit="CreateAssignment" OnCancel="() => VM.CancelAddAssignment()" />
                                    }

                                    @if (VM.RoleScopedAssignments.Any())
                                    {
                                        <div class="scoped-assignments-list">
                                            @foreach (var a in VM.RoleScopedAssignments)
                                            {
                                                <div class="scoped-assignment-row">
                                                    <div class="scoped-assignment-info">
                                                        <span class="scoped-assignment-principal">@a.PrincipalName</span>
                                                        <span class="scoped-assignment-scope">
                                                            @FormatScopeType(a.ScopeType): @a.ScopeName
                                                        </span>
                                                    </div>
                                                    @if (VM.CanManageRoles)
                                                    {
                                                        <button class="btn-icon btn-icon--small" title="@Resources.Web_Admin_RemoveAssignment"
                                                                aria-label="@Resources.Web_Admin_RemoveAssignment"
                                                                @onclick="() => DeleteAssignment(a.AssignmentId)">
                                                            @Icons.SVG("cross.svg", new SvgOptions(Width: 14, Height: 14, Color: "var(--danger)", StrokeWidth: 2f))
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    else if (!VM.IsAddingAssignment)
                                    {
                                        <span class="property-empty">@Resources.Web_Admin_NoDelegatedAssignments</span>
                                    }

                                    @if (!VM.IsAddingAssignment && VM.CanManageRoles)
                                    {
                                        <div>
                                            <button class="btn-secondary btn-secondary--sm" type="button" @onclick="StartAddAssignment">
                                                @Icons.SVG("plus.svg", new SvgOptions(Width: 12, Height: 12, StrokeWidth: 2f))
                                                <span>@Resources.Web_Admin_AddAssignment</span>
                                            </button>
                                        </div>
                                    }
                                </Body>
                            </DetailSection>

                            @if (VM.IsConfirmingDelete && canDeleteRole)
                            {
                                <div class="modal-backdrop" @onclick="() => VM.IsConfirmingDelete = false">
                                    <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="role-delete-title" @onclick:stopPropagation="true">
                                        <h2 class="modal-title" id="role-delete-title">@Resources.Web_Admin_ConfirmDeleteRole</h2>
                                        <p class="modal-text"><strong>@role.Name</strong></p>
                                        <div class="modal-actions">
                                            <button type="button" class="btn-secondary" @onclick="() => VM.IsConfirmingDelete = false">@Resources.Web_Common_Cancel</button>
                                            <button type="button" class="btn-danger" disabled="@VM.IsSaving" @onclick="ConfirmDeleteRole">
                                                @(VM.IsSaving ? Resources.Web_Common_Deleting : Resources.Web_Admin_DeleteRole)
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    }
@code {
    [Parameter, EditorRequired] public UserListViewModel VM { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private IReadOnlyList<PrincipalPickerItem> ShareItems() =>
        VM.AllShares.Select(s => new PrincipalPickerItem(s.Id, s.Name, PrincipalKind.Share)).ToList();

    private async Task EditRole() { await VM.StartEditRoleAsync(); StateHasChanged(); }
    private async Task SaveRole() { await VM.SaveRoleAsync(); await OnChanged.InvokeAsync(); }
    private void CancelEdit() { VM.CancelEdit(); StateHasChanged(); }
    private async Task ConfirmDeleteRole() { await VM.ConfirmDeleteRoleAsync(); await OnChanged.InvokeAsync(); }
    private async Task StartAddAssignment() { VM.StartAddAssignment(); await VM.LoadAssignmentFormDataAsync(); StateHasChanged(); }
    private async Task CreateAssignment() { await VM.CreateAssignmentAsync(); StateHasChanged(); }
    private async Task DeleteAssignment(Guid id) { await VM.DeleteAssignmentAsync(id); StateHasChanged(); }
    private static string R(string key) => Resources.ResourceManager.GetString(key) ?? key;
    private static string R(string key, string fallback) => Resources.ResourceManager.GetString(key) ?? fallback;

    private static int PermissionTotal => UserListViewModel.PermissionGroups.Sum(g => g.Flags.Count);
    private int GrantedTotal() => UserListViewModel.PermissionGroups.Sum(VM.GrantedCount);

    // Global is shown as what it is to the user: the topmost department.
    private static string FormatScopeType(ScopeType type) => type switch { ScopeType.Global => R("Web_Admin_ScopeChoice_System"), ScopeType.Department => Resources.Web_Admin_ScopeType_Department, ScopeType.Share => Resources.Web_Admin_ScopeType_Share, _ => type.ToString() };
}
