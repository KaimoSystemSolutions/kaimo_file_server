


@page "/users"
@using Kaimo_File_Server.Core.Domain.Identity
@using Kaimo_File_Server.Core.Security
@using Kaimo_File_Server.Core.Helpers
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Web.Components.ViewModels
@using Kaimo_File_Server.Web.Components.Pages.Users.Components
@using Kaimo_File_Server.Web.DynamicHelpers
@inject UserListViewModel VM
@inject AssetProvider Icons

<PageTitle>@Resources.Web_Admin_PageTitle</PageTitle>

@if (VM.IsLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>@Resources.Web_Common_Loading</p>
    </div>
}
else if (!VM.CanAccessPage)
{
    <div class="page-header"><div><h1>@Resources.Web_Admin_Heading</h1></div></div>
    <div class="error-banner">@Resources.Web_Admin_NoPermission</div>
}
else
{
    <div class="page-header">
        <div>
            <h1>@Resources.Web_Admin_Heading</h1>
            <p class="subtitle">@VM.TabSubtitle</p>
        </div>
        <div style="display: flex; gap: 0.5rem;">
            @if (VM.ActiveTab == AdminTab.Users && VM.CanCreateUsers)
            {
                <button class="btn-icon" title="@Resources.Web_Admin_CreateUser" @onclick="() => VM.StartCreateUser()">
                    @Icons.SVG("plus.svg", new SvgOptions(Width: 20, Height: 20, StrokeWidth: 2))
                </button>
            }
            else if (VM.ActiveTab == AdminTab.Groups && VM.CanManageGroups)
            {
                <button class="btn-icon" title="@Resources.Web_Admin_CreateGroup" @onclick="() => VM.StartCreateGroup()">
                    @Icons.SVG("plus.svg", new SvgOptions(Width: 20, Height: 20, StrokeWidth: 2))
                </button>
            }
            else if (VM.ActiveTab == AdminTab.Roles && VM.CanEditRoleDefinitions)
            {
                <button class="btn-icon" title="@Resources.Web_Admin_CreateRole" @onclick="() => VM.StartCreateRole()">
                    @Icons.SVG("plus.svg", new SvgOptions(Width: 20, Height: 20, StrokeWidth: 2))
                </button>
            }
        </div>
    </div>

    @* -- Tabs -- *@
    <div class="admin-tabs">
        @if (VM.CanCreateUsers || VM.AuthorizedDepartmentsForView.Any())
        {
            <button class="admin-tab @(VM.ActiveTab == AdminTab.Users ? "active" : "")"
                    @onclick="() => SwitchTab(AdminTab.Users)">
                @Icons.SVG("user_transparent.svg", new SvgOptions())
                @Resources.Web_Admin_Tab_Users
            </button>
        }
        @if (VM.CanManageGroups)
        {
            <button class="admin-tab @(VM.ActiveTab == AdminTab.Groups ? "active" : "")"
                    @onclick="() => SwitchTab(AdminTab.Groups)">
                @Icons.SVG("users_transparent.svg", new SvgOptions())
                @Resources.Web_Admin_Tab_Groups
            </button>
        }
        @if (VM.CanManageRoles)
        {
            <button class="admin-tab @(VM.ActiveTab == AdminTab.Roles ? "active" : "")"
                    @onclick="() => SwitchTab(AdminTab.Roles)">
                @Icons.SVG("shield_transparent.svg", new SvgOptions())
                @Resources.Web_Admin_Tab_Roles
            </button>
        }
    </div>

    <AdminCreateForms VM="VM" OnChanged="StateHasChanged" />

    @* -- Main Content -- *@
    @if (VM.ErrorMessage is not null && !VM.IsEditing && !VM.IsCreatingUser && !VM.IsCreatingGroup && !VM.IsCreatingRole)
    {
        <div class="error-banner">@VM.ErrorMessage</div>
    }
    else
    {
        <div class="admin-content">

            <AdminEntityList VM="VM" OnChanged="StateHasChanged" />

            @* ════════════════════ DETAIL PANEL ════════════════════ *@
            @if (VM.SelectedUser is not null || VM.SelectedGroup is not null || VM.SelectedRole is not null)
            {
                <div class="admin-detail">

                    @if (VM.SuccessMessage is not null)
                    {
                        <div class="success-banner">@VM.SuccessMessage</div>
                    }

                    <UserDetailsPanel VM="VM" OnChanged="StateHasChanged" />
                    <GroupDetailsPanel VM="VM" OnChanged="StateHasChanged" />
                    <RoleDetailsPanel VM="VM" OnChanged="StateHasChanged" />

                </div>
            }

        </div>
    }
}
