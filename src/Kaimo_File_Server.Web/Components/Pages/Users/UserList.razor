@page "/users"
@using Kaimo_File_Server.Core.Domain.Identity
@using Kaimo_File_Server.Core.Security
@using Kaimo_File_Server.Core.Helpers
@using Kaimo_File_Server.Web.Components.ViewModels
@using Kaimo_File_Server.Web.DynamicHelpers
@inject UserListViewModel VM
@inject NavigationManager Nav
@inject AssetProvider Assets

<PageTitle>Kaimo Files – Verwaltung</PageTitle>

@if (VM.IsLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Lade...</p>
    </div>
}
else if (!VM.CanAccessPage)
{
    <div class="page-header"><div><h1>Verwaltung</h1></div></div>
    <div class="error-banner">Keine Berechtigung. Sie haben keine Verwaltungsrechte zugewiesen.</div>
}
else
{
    <div class="page-header">
        <div>
            <h1>Verwaltung</h1>
            <p class="subtitle">@VM.TabSubtitle</p>
        </div>
        <div style="display: flex; gap: 0.5rem;">
            @if (VM.ActiveTab == AdminTab.Users && VM.CanCreateUsers)
            {
                <button class="btn-icon" title="Benutzer erstellen" @onclick="() => VM.StartCreateUser()">
                    @Assets.SVG("plus.svg", new SvgOptions(Width: 20, Height: 20, StrokeWidth: 2))
                </button>
            }
            else if (VM.ActiveTab == AdminTab.Groups && VM.CanManageGroups)
            {
                <button class="btn-icon" title="Gruppe erstellen" @onclick="() => VM.StartCreateGroup()">
                    @Assets.SVG("plus.svg", new SvgOptions(Width: 20, Height: 20, StrokeWidth: 2))
                </button>
            }
            else if (VM.ActiveTab == AdminTab.Roles && VM.CanEditRoleDefinitions)
            {
                <button class="btn-icon" title="Rolle erstellen" @onclick="() => VM.StartCreateRole()">
                    @Assets.SVG("plus.svg", new SvgOptions(Width: 20, Height: 20, StrokeWidth: 2))
                </button>
            }
        </div>
    </div>

    @* -- Tabs -- *@
    <div class="admin-tabs">
        @if (VM.CanCreateUsers || VM.AuthorizedDepartmentsForView.Any())
        {
            <button class="admin-tab @(VM.ActiveTab == AdminTab.Users ? "active" : "")"
                    @onclick="() => SwitchTab(AdminTab.Users)">
                @Assets.SVG("user_transparent.svg", new SvgOptions())
                Benutzer
            </button>
        }
        @if (VM.CanManageGroups)
        {
            <button class="admin-tab @(VM.ActiveTab == AdminTab.Groups ? "active" : "")"
                    @onclick="() => SwitchTab(AdminTab.Groups)">
                @Assets.SVG("users_transparent.svg", new SvgOptions())
                Gruppen
            </button>
        }
        @if (VM.CanManageRoles)
        {
            <button class="admin-tab @(VM.ActiveTab == AdminTab.Roles ? "active" : "")"
                    @onclick="() => SwitchTab(AdminTab.Roles)">
                @Assets.SVG("shield_transparent.svg", new SvgOptions())
                Rollen
            </button>
        }
    </div>

    @* -- Create User Form -- *@
    @if (VM.IsCreatingUser)
    {
        <div class="create-form-card">
            <h3>Neuen Benutzer erstellen</h3>
            <div class="create-form-fields">
                <div class="form-group">
                    <label>Abteilung</label>
                    <select class="edit-input" @bind="CreateUserDepartmentIdString">
                        @if (!VM.AuthorizedDepartmentsForCreate.Any())
                        {
                            <option value="">— Keine Abteilungen verfügbar —</option>
                        }
                        else
                        {
                            @foreach (var dept in VM.AuthorizedDepartmentsForCreate)
                            {
                                <option value="@dept.Id">@dept.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Anzeigename</label>
                    <input type="text" class="edit-input" placeholder="z.B. Max Mustermann"
                           @bind="VM.CreateUserName" @bind:event="oninput" />
                </div>
                <div class="form-group">
                    <label>Benutzername</label>
                    <input type="text" class="edit-input" placeholder="z.B. mmustermann"
                           @bind="VM.CreateUserUsername" @bind:event="oninput" />
                </div>
                <div class="form-group">
                    <label>E-Mail</label>
                    <input type="email" class="edit-input" placeholder="z.B. max@firma.de"
                           @bind="VM.CreateUserEmail" @bind:event="oninput" />
                </div>
                <div class="form-group">
                    <label>Beschreibung</label>
                    <input type="text" class="edit-input" placeholder="Optional"
                           @bind="VM.CreateUserDescription" @bind:event="oninput" />
                </div>
                <div class="form-group">
                    <label>Passwort</label>
                    <input type="password" class="edit-input" placeholder="Mindestens 6 Zeichen"
                           @bind="VM.CreateUserPassword" @bind:event="oninput" />
                </div>
                <div class="create-form-toggles">
                    <div class="toggle-row">
                        <span class="toggle-label-text">Konto aktiviert</span>
                        <label class="toggle-switch">
                            <input type="checkbox" @bind="VM.CreateUserIsEnabled" />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                    <div class="toggle-row">
                        <span class="toggle-label-text">Passwort ändern erlaubt</span>
                        <label class="toggle-switch">
                            <input type="checkbox" @bind="VM.CreateUserCanChangePassword" />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                </div>
            </div>
            @if (VM.ErrorMessage is not null)
            {
                <div class="error-banner" style="margin-top: 12px;">@VM.ErrorMessage</div>
            }
            <div class="create-form-actions">
                <button class="btn-primary" @onclick="CreateUser" disabled="@VM.IsSaving">
                    @(VM.IsSaving ? "Erstellt…" : "Erstellen")
                </button>
                <button class="btn-secondary" @onclick="() => VM.CancelCreate()">Abbrechen</button>
            </div>
        </div>
    }

    @* -- Create Group Form (with Department selector) -- *@
    @if (VM.IsCreatingGroup)
    {
        <div class="create-form-card">
            <h3>Neue Gruppe erstellen</h3>
            <div class="create-form-fields">
                <div class="form-group">
                    <label>Gruppenname</label>
                    <input type="text" class="edit-input" placeholder="z.B. Entwickler"
                           @bind="VM.CreateGroupName" @bind:event="oninput"
                           @onkeydown="HandleCreateGroupKeyDown" />
                </div>
                <div class="form-group">
                    <label>Abteilung</label>
                    <select class="edit-input" @bind="CreateGroupDepartmentIdString">
                        @foreach (var dept in VM.AllDepartments)
                        {
                            <option value="@dept.Id">@dept.Name</option>
                        }
                    </select>
                    <span class="form-hint">Jede Gruppe gehört genau einer Abteilung. Standard: Global.</span>
                </div>
            </div>
            @if (VM.ErrorMessage is not null)
            {
                <div class="error-banner" style="margin-top: 12px;">@VM.ErrorMessage</div>
            }
            <div class="create-form-actions">
                <button class="btn-primary" @onclick="CreateGroup" disabled="@VM.IsSaving">
                    @(VM.IsSaving ? "Erstellt…" : "Erstellen")
                </button>
                <button class="btn-secondary" @onclick="() => VM.CancelCreate()">Abbrechen</button>
            </div>
        </div>
    }

    @* -- Create Role Form -- *@
    @if (VM.IsCreatingRole)
    {
        <div class="create-form-card">
            <h3>Neue Rolle erstellen</h3>
            <div class="create-form-fields">
                <div class="form-group">
                    <label>Rollenname</label>
                    <input type="text" class="edit-input" placeholder="z.B. Abteilungsleiter"
                           @bind="VM.CreateRoleName" @bind:event="oninput"
                           @onkeydown="HandleCreateRoleKeyDown" />
                </div>
            </div>
            @if (VM.ErrorMessage is not null)
            {
                <div class="error-banner" style="margin-top: 12px;">@VM.ErrorMessage</div>
            }
            <div class="create-form-actions">
                <button class="btn-primary" @onclick="CreateRole" disabled="@VM.IsSaving">
                    @(VM.IsSaving ? "Erstellt…" : "Erstellen")
                </button>
                <button class="btn-secondary" @onclick="() => VM.CancelCreate()">Abbrechen</button>
            </div>
        </div>
    }

    @* -- Main Content -- *@
    @if (VM.ErrorMessage is not null && !VM.IsEditing && !VM.IsCreatingUser && !VM.IsCreatingGroup && !VM.IsCreatingRole)
    {
        <div class="error-banner">@VM.ErrorMessage</div>
    }
    else
    {
        <div class="admin-content">

            @* ════════════════════ LIST ════════════════════ *@
            <div class="admin-list">
                @switch (VM.ActiveTab)
                {
                    case AdminTab.Users:
                        @if (!VM.Users.Any())
                        {
                            <div class="empty-state"><p>Keine Benutzer vorhanden.</p></div>
                        }
                        else
                        {
                            <div class="user-list-container">
                                <div class="user-list-row user-list-header">
                                    <div class="user-cell-name">Name</div>
                                    <div class="user-cell-username">Benutzername</div>
                                    <div class="user-cell-status">Status</div>
                                </div>
                                @foreach (var user in VM.Users)
                                {
                                    var isSelected = VM.SelectedUser?.Id == user.Id;
                                    <div class="user-list-row user-list-selectable @(isSelected ? "user-list-selected" : "")"
                                         @onclick="() => SelectUser(user)">
                                        <div class="user-cell-name">
                                            @Assets.SVG("user_transparent.svg", new SvgOptions(
                                                Width: 20,
                                                Height: 20,
                                                Color: isSelected ? "var(--accent)" : "var(--text-tertiary)"
                                            ))
                                            <span>@user.Name</span>
                                        </div>
                                        <div class="user-cell-username">@user.Username</div>
                                        <div class="user-cell-status">
                                            @if (user.IsEnabled)
                                            {
                                                <span class="status-badge status-badge--active">
                                                    <span class="status-dot status-dot--active"></span>Aktiv
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-badge--disabled">
                                                    <span class="status-dot status-dot--disabled"></span>Deaktiviert
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        break;

                    case AdminTab.Groups:
                        @if (!VM.Groups.Any())
                        {
                            <div class="empty-state"><p>Keine Gruppen vorhanden.</p></div>
                        }
                        else
                        {
                            <div class="file-list">
                                <div class="file-row admin-row-header">
                                    <div class="file-cell user-name">Gruppenname</div>
                                    <div class="file-cell user-size">Abteilung</div>
                                </div>
                                @foreach (var group in VM.Groups)
                                {
                                    var isSelected = VM.SelectedGroup?.Id == group.Id;
                                    <div class="file-row admin-row-selectable @(isSelected ? "admin-row-selected" : "")"
                                         @onclick="() => SelectGroup(group)">
                                        <div class="file-cell user-name">
                                            @Assets.SVG("users_transparent.svg", new SvgOptions(
                                                Width: 20,
                                                Height: 20,
                                                Color: isSelected ? "var(--accent)" : "var(--text-tertiary)"
                                            ))
                                            <span>@group.Name</span>
                                        </div>
                                        <div class="file-cell user-size" style="color: var(--text-tertiary); font-size: 12px;">
                                            @VM.GetDepartmentName(group.DepartmentId)
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        break;

                    case AdminTab.Roles:
                        @if (!VM.Roles.Any())
                        {
                            <div class="empty-state"><p>Keine Rollen vorhanden.</p></div>
                        }
                        else
                        {
                            <div class="file-list">
                                <div class="file-row admin-row-header">
                                    <div class="file-cell user-name">Rollenname</div>
                                    <div class="file-cell user-size">Typ</div>
                                </div>
                                @foreach (var role in VM.Roles)
                                {
                                    var isSelected = VM.SelectedRole?.Id == role.Id;
                                    <div class="file-row admin-row-selectable @(isSelected ? "admin-row-selected" : "")"
                                         @onclick="() => SelectRole(role)">
                                        <div class="file-cell user-name">
                                            @Assets.SVG("shield_transparent.svg", new SvgOptions(
                                                Width: 20,
                                                Height: 20,
                                                Color: isSelected ? "var(--accent)" : "var(--text-tertiary)"
                                            ))
                                            <span>@role.Name</span>
                                        </div>
                                        <div class="file-cell user-size" style="color: var(--text-tertiary); font-size: 12px;">
                                            @(role.IsSystemRole ? "System" : "Benutzerdefiniert")
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        break;
                }
            </div>

            @* ════════════════════ DETAIL PANEL ════════════════════ *@
            @if (VM.SelectedUser is not null || VM.SelectedGroup is not null || VM.SelectedRole is not null)
            {
                <div class="admin-detail">

                    @if (VM.SuccessMessage is not null)
                    {
                        <div class="success-banner">@VM.SuccessMessage</div>
                    }

                    @* ------------ USER DETAIL ------------ *@
                    @if (VM.SelectedUser is not null)
                    {
                        @if (VM.IsEditing)
                        {
                            <div class="detail-header">
                                <h3>Benutzer bearbeiten</h3>
                                <span class="detail-subtitle">@VM.SelectedUser.Username</span>
                            </div>
                            <div class="detail-field-grid">
                                <div class="form-group">
                                    <label>Name</label>
                                    <input type="text" class="edit-input" @bind="VM.EditUserName" />
                                </div>
                                <div class="form-group">
                                    <label>E-Mail</label>
                                    <input type="email" class="edit-input" placeholder="z.B. max@firma.de"
                                           @bind="VM.EditUserEmail" @bind:event="oninput" />
                                </div>
                                <div class="form-group">
                                    <label>Beschreibung</label>
                                    <input type="text" class="edit-input" placeholder="Optional"
                                           @bind="VM.EditUserDescription" @bind:event="oninput" />
                                </div>
                                @if (VM.CanResetPasswordForSelected)
                                {
                                    <div class="form-group">
                                        <label>Neues Passwort (optional)</label>
                                        <input type="password" class="edit-input" placeholder="Leer lassen = unverändert"
                                               @bind="VM.NewPassword" @bind:event="oninput" />
                                    </div>
                                    @if (!string.IsNullOrEmpty(VM.NewPassword))
                                    {
                                        <div class="form-group">
                                            <label>Passwort bestätigen</label>
                                            <input type="password" class="edit-input" placeholder="Passwort wiederholen"
                                                   @bind="VM.ConfirmPassword" @bind:event="oninput" />
                                        </div>
                                    }
                                }
                                <div class="create-form-toggles">
                                    <div class="toggle-row">
                                        <span class="toggle-label-text">Konto aktiviert</span>
                                        <label class="toggle-switch">
                                            <input type="checkbox" @bind="VM.EditUserIsEnabled" />
                                            <span class="toggle-slider"></span>
                                        </label>
                                    </div>
                                    <div class="toggle-row">
                                        <span class="toggle-label-text">Passwort ändern erlaubt</span>
                                        <label class="toggle-switch">
                                            <input type="checkbox" @bind="VM.EditUserCanChangePassword" />
                                            <span class="toggle-slider"></span>
                                        </label>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label>Gruppen</label>
                                    <div class="multi-select @(groupsOpen ? "open" : "")">
                                        <div class="multi-select-display" @onclick="() => groupsOpen = !groupsOpen">
                                            <span class="multi-select-text">
                                                @Checked(VM.EditUserGroups.Where(g => g.IsChecked).Select(g => g.Item.Name), "Keine Gruppen")
                                            </span>
                                            @Assets.SVG("chevron_down_transparent.svg", new SvgOptions(
                                                    Width: 14,
                                                    Height: 14,
                                                    StrokeWidth: 2f,
                                                    CssClass: "multi-select-chevron"
                                                ))
                                        </div>
                                        @if (groupsOpen)
                                        {
                                            <div class="multi-select-backdrop" @onclick="() => groupsOpen = false"></div>
                                            <div class="multi-select-dropdown">
                                                @foreach (var item in VM.EditUserGroups)
                                                {
                                                    <label class="multi-select-option">
                                                        <input type="checkbox" @bind="item.IsChecked" />
                                                        <span>@item.Item.Name</span>
                                                        <span class="multi-select-hint">@VM.GetDepartmentName(item.Item.DepartmentId)</span>
                                                    </label>
                                                }
                                                @if (!VM.EditUserGroups.Any())
                                                {
                                                    <span class="empty-hint">Keine Gruppen vorhanden</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label>Rollen</label>
                                    <div class="multi-select @(rolesOpen ? "open" : "")">
                                        <div class="multi-select-display" @onclick="() => rolesOpen = !rolesOpen">
                                            <span class="multi-select-text">
                                                @Checked(VM.EditUserRoles.Where(r => r.IsChecked).Select(r => r.Item.Name), "Keine Rollen")
                                            </span>
                                            @Assets.SVG("chevron_down_transparent.svg", new SvgOptions(
                                                    Width: 14,
                                                    Height: 14,
                                                    StrokeWidth: 2f,
                                                    CssClass: "multi-select-chevron"
                                                ))
                                        </div>
                                        @if (rolesOpen)
                                        {
                                            <div class="multi-select-backdrop" @onclick="() => rolesOpen = false"></div>
                                            <div class="multi-select-dropdown">
                                                @foreach (var item in VM.EditUserRoles)
                                                {
                                                    <label class="multi-select-option">
                                                        <input type="checkbox" @bind="item.IsChecked" />
                                                        <span>@item.Item.Name</span>
                                                    </label>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                            @if (VM.ErrorMessage is not null)
                            {
                                <div class="error-banner" style="margin: 12px 0;">@VM.ErrorMessage</div>
                            }
                            <div class="detail-actions">
                                <button class="btn-primary" @onclick="SaveUser" disabled="@VM.IsSaving">
                                    @(VM.IsSaving ? "Speichert…" : "Speichern")
                                </button>
                                <button class="btn-secondary" @onclick="CancelEdit" disabled="@VM.IsSaving">Abbrechen</button>
                            </div>
                        }
                        else
                        {
                            <div class="detail-header">
                                <h3>@VM.SelectedUser.Name</h3>
                                <span class="detail-subtitle">@VM.SelectedUser.Username</span>
                            </div>
                            <div class="detail-field-grid">
                                <div class="detail-field">
                                    <span class="detail-field-label">Status</span>
                                    <span>
                                        @if (VM.SelectedUser.IsEnabled)
                                        {
                                            <span class="status-badge status-badge--active"><span class="status-dot status-dot--active"></span>Aktiv</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-badge--disabled"><span class="status-dot status-dot--disabled"></span>Deaktiviert</span>
                                        }
                                    </span>
                                </div>
                                <div class="detail-field">
                                    <span class="detail-field-label">E-Mail</span>
                                    <span class="detail-field-value">
                                        @(string.IsNullOrWhiteSpace(VM.SelectedUser.Email) ? "Nicht angegeben" : VM.SelectedUser.Email)
                                    </span>
                                </div>
                                <div class="detail-field">
                                    <span class="detail-field-label">Beschreibung</span>
                                    <span class="detail-field-value">
                                        @(string.IsNullOrWhiteSpace(VM.SelectedUser.Description) ? "Keine Beschreibung" : VM.SelectedUser.Description)
                                    </span>
                                </div>
                                <div class="detail-field">
                                    <span class="detail-field-label">Passwort ändern</span>
                                    <span class="detail-field-value">@(VM.SelectedUser.CanChangePassword ? "Erlaubt" : "Gesperrt")</span>
                                </div>
                                <div class="detail-field">
                                    <span class="detail-field-label">Abteilungen</span>
                                    <span class="detail-field-value">
                                        @(VM.UserDepartments.Any() ? Format(VM.UserDepartments.Select(d => d.Name), 5) : "Keine Abteilungen")
                                    </span>
                                </div>
                                <div class="detail-field">
                                    <span class="detail-field-label">Rollen</span>
                                    <span class="detail-field-value">
                                        @(VM.UserRoles.Any() ? Format(VM.UserRoles.Select(r => r.Name), 5) : "Keine Rollen")
                                    </span>
                                </div>
                                <div class="detail-field">
                                    <span class="detail-field-label">Gruppen</span>
                                    <span class="detail-field-value">
                                        @(VM.UserGroups.Any() ? Format(VM.UserGroups.Select(g => g.Name), 5) : "Keine Gruppen")
                                    </span>
                                </div>
                                <div class="detail-field">
                                    <span class="detail-field-label">ID</span>
                                    <span class="detail-field-value" style="font-size: 11px; font-family: monospace;">@VM.SelectedUser.Id</span>
                                </div>
                            </div>

                            @if (VM.UserScopedAssignments.Any())
                            {
                                <div class="detail-section" style="margin-top: 16px;">
                                    <span class="detail-label">Delegierte Rollenzuweisungen</span>
                                    <div class="scoped-assignments-list">
                                        @foreach (var a in VM.UserScopedAssignments)
                                        {
                                            <div class="scoped-assignment-row">
                                                <div class="scoped-assignment-info">
                                                    <span class="scoped-assignment-role">@a.RoleName</span>
                                                    <span class="scoped-assignment-scope">@FormatScopeType(a.ScopeType): @a.ScopeName</span>
                                                </div>
                                                @if (VM.CanManageRoles)
                                                {
                                                    <button class="btn-icon btn-icon--small" title="Zuweisung entfernen"
                                                            @onclick="() => DeleteAssignment(a.AssignmentId)">
                                                        @Assets.SVG("cross.svg", new SvgOptions(
                                                                Width: 14,
                                                                Height: 14,
                                                                Color: "var(--danger)",
                                                                StrokeWidth: 2f
                                                            ))
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="detail-actions">
                                @if (VM.CanEditSelectedUser)
                                {
                                    <button class="btn-secondary" @onclick="EditUser">Bearbeiten</button>
                                }
                                @if (VM.CanDeleteSelectedUser)
                                {
                                    @if (VM.IsConfirmingDelete)
                                    {
                                        <div class="confirm-delete">
                                            <p>Benutzer wirklich löschen?</p>
                                            <div style="display: flex; gap: 8px;">
                                                <button class="btn-danger-outline" @onclick="ConfirmDeleteUser" disabled="@VM.IsSaving">
                                                    @(VM.IsSaving ? "Löscht…" : "Ja, löschen")
                                                </button>
                                                <button class="btn-secondary" @onclick="() => VM.IsConfirmingDelete = false">Abbrechen</button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn-danger-outline" @onclick="() => VM.RequestDeleteUser()">Benutzer löschen</button>
                                    }
                                }
                            </div>
                        }
                    }

                    @* ------------ GROUP DETAIL ------------ *@
                    else if (VM.SelectedGroup is not null)
                    {
                        @if (VM.IsEditing)
                        {
                            <div class="detail-header">
                                <h3>Mitglieder verwalten</h3>
                                <span class="detail-subtitle">@VM.SelectedGroup.Name</span>
                            </div>
                            <div class="detail-section">
                                <span class="detail-label">Benutzer</span>
                                <div class="multi-select @(membersOpen ? "open" : "")">
                                    <div class="multi-select-display" @onclick="() => membersOpen = !membersOpen">
                                        <span class="multi-select-text">
                                            @Checked(VM.EditGroupMembers.Where(m => m.IsChecked).Select(m => m.Item.Name), "Keine Mitglieder")
                                        </span>
                                        @Assets.SVG("chevron_down_transparent.svg", new SvgOptions(
                                                Width: 14,
                                                Height: 14,
                                                StrokeWidth: 2f,
                                                CssClass: "multi-select-chevron"
                                            ))
                                    </div>
                                    @if (membersOpen)
                                    {
                                        <div class="multi-select-backdrop" @onclick="() => membersOpen = false"></div>
                                        <div class="multi-select-dropdown">
                                            @foreach (var item in VM.EditGroupMembers)
                                            {
                                                <label class="multi-select-option">
                                                    <input type="checkbox" @bind="item.IsChecked" />
                                                    <span>@item.Item.Name</span>
                                                    <span class="multi-select-hint">@item.Item.Username</span>
                                                </label>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                            @if (VM.ErrorMessage is not null)
                            {
                                <div class="error-banner" style="margin-bottom: 12px;">@VM.ErrorMessage</div>
                            }
                            <div class="detail-actions">
                                <button class="btn-primary" @onclick="SaveGroup" disabled="@VM.IsSaving">
                                    @(VM.IsSaving ? "Speichert…" : "Speichern")
                                </button>
                                <button class="btn-secondary" @onclick="CancelEdit" disabled="@VM.IsSaving">Abbrechen</button>
                            </div>
                        }
                        else
                        {
                            <div class="detail-header">
                                <h3>@VM.SelectedGroup.Name</h3>
                                <span class="detail-subtitle">Gruppe</span>
                            </div>
                            <div class="detail-section">
                                <span class="detail-label">Abteilung</span>
                                <span class="detail-value">@VM.GetDepartmentName(VM.SelectedGroup.DepartmentId)</span>
                                <span class="detail-label">Mitglieder</span>
                                <span class="detail-value">
                                    @(VM.GroupMembers.Any() ? Format(VM.GroupMembers.Select(u => u.Name), 5) : "Keine Mitglieder")
                                </span>
                                <span class="detail-label">ID</span>
                                <span class="detail-value" style="font-size: 11px; font-family: monospace;">@VM.SelectedGroup.Id</span>
                            </div>
                            <div class="detail-actions">
                                @if (VM.CanManageGroups)
                                {
                                    <button class="btn-secondary" @onclick="EditGroup">Mitglieder verwalten</button>
                                }
                                @if (VM.CanDeleteGroups)
                                {
                                    @if (VM.IsConfirmingDelete)
                                    {
                                        <div class="confirm-delete">
                                            <p>Gruppe wirklich löschen?</p>
                                            <div style="display: flex; gap: 8px;">
                                                <button class="btn-danger-outline" @onclick="ConfirmDeleteGroup" disabled="@VM.IsSaving">
                                                    @(VM.IsSaving ? "Löscht…" : "Ja, löschen")
                                                </button>
                                                <button class="btn-secondary" @onclick="() => VM.IsConfirmingDelete = false">Abbrechen</button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn-danger-outline" @onclick="() => VM.RequestDeleteGroup()">Gruppe löschen</button>
                                    }
                                }
                            </div>
                        }
                    }

                    @* ------------ ROLE DETAIL ------------ *@
                    else if (VM.SelectedRole is not null)
                    {
                        @* Role detail remains unchanged — same as original *@
                        @if (VM.IsEditing)
                        {
                            <div class="detail-header">
                                <h3>Rolle bearbeiten</h3>
                                <span class="detail-subtitle">@VM.SelectedRole.Name</span>
                            </div>
                            @if (!VM.SelectedRole.IsSystemRole)
                            {
                                <div class="detail-section" style="margin-top: 16px;">
                                    <span class="detail-label">Berechtigungen</span>
                                    <div class="permission-presets">
                                        @foreach (var preset in UserListViewModel.PermissionPresets)
                                        {
                                            var isActive = VM.EditRolePermissions == preset.Permissions;
                                            <button class="preset-chip @(isActive ? "preset-chip--active" : "")"
                                                    @onclick="() => VM.ApplyPermissionPreset(preset.Permissions)">
                                                @preset.Label
                                            </button>
                                        }
                                        <button class="preset-chip" @onclick="() => VM.ApplyPermissionPreset(ManagementPermission.None)">Keine</button>
                                    </div>
                                    <div class="permission-groups">
                                        @foreach (var permGroup in UserListViewModel.PermissionGroups)
                                        {
                                            <div class="permission-group">
                                                <span class="permission-group-label">@permGroup.Label</span>
                                                <div class="permission-flags">
                                                    @foreach (var flag in permGroup.Flags)
                                                    {
                                                        var isChecked = VM.HasEditPermission(flag.Flag);
                                                        <label class="permission-flag">
                                                            <input type="checkbox" checked="@isChecked"
                                                                   @onchange="e => VM.ToggleEditPermission(flag.Flag, (bool)(e.Value ?? false))" />
                                                            <span>@flag.Label</span>
                                                        </label>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="detail-info" style="margin-top: 16px;">
                                    @Assets.SVG("circle_info.svg", new SvgOptions(
                                            Width: 14,
                                            Height: 14,
                                            Color: "var(--text-tertiary)"
                                        ))
                                    <span>Berechtigungen von Systemrollen werden automatisch verwaltet.</span>
                                </div>
                            }
                            @if (VM.ErrorMessage is not null)
                            {
                                <div class="error-banner" style="margin: 12px 0;">@VM.ErrorMessage</div>
                            }
                            <div class="detail-actions">
                                <button class="btn-primary" @onclick="SaveRole" disabled="@VM.IsSaving">
                                    @(VM.IsSaving ? "Speichert…" : "Speichern")
                                </button>
                                <button class="btn-secondary" @onclick="CancelEdit" disabled="@VM.IsSaving">Abbrechen</button>
                            </div>
                        }
                        else
                        {
                            <div class="detail-header">
                                <h3>@VM.SelectedRole.Name</h3>
                                <span class="detail-subtitle">@(VM.SelectedRole.IsSystemRole ? "Systemrolle" : "Benutzerdefinierte Rolle")</span>
                            </div>
                            <div class="detail-field-grid">
                                <div class="detail-field">
                                    <span class="detail-field-label">Berechtigungen</span>
                                    <span class="detail-field-value">
                                        @if (VM.SelectedRole.ManagementPermissions == ManagementPermission.None)
                                        {
                                            <span class="detail-field-value--empty">Keine Berechtigungen</span>
                                        }
                                        else
                                        {
                                            <div class="permission-tags">
                                                @foreach (var permGroup in UserListViewModel.PermissionGroups)
                                                {
                                                    @foreach (var flag in permGroup.Flags)
                                                    {
                                                        if ((VM.SelectedRole.ManagementPermissions & flag.Flag) == flag.Flag)
                                                        {
                                                            <span class="permission-tag">@flag.Label</span>
                                                        }
                                                    }
                                                }
                                            </div>
                                        }
                                    </span>
                                </div>
                                <div class="detail-field">
                                    <span class="detail-field-label">ID</span>
                                    <span class="detail-field-value" style="font-size: 11px; font-family: monospace;">@VM.SelectedRole.Id</span>
                                </div>
                            </div>

                            <div class="detail-section" style="margin-top: 16px;">
                                <div style="display: flex; align-items: center; justify-content: space-between;">
                                    <span class="detail-label">Delegierte Zuweisungen</span>
                                    @if (!VM.IsAddingAssignment && VM.CanManageRoles)
                                    {
                                        <button class="btn-icon btn-icon--small" title="Zuweisung hinzufügen" @onclick="StartAddAssignment">
                                            @Assets.SVG("plus.svg", new SvgOptions(
                                                    Width: 14,
                                                    Height: 14,
                                                    StrokeWidth: 2f
                                                ))
                                        </button>
                                    }
                                </div>

                                @if (VM.IsAddingAssignment)
                                {
                                    <div class="assignment-form">
                                        <div class="form-group">
                                            <label>Zuweisen an</label>
                                            <div class="toggle-button-group">
                                                <button class="toggle-btn @(!VM.NewAssignmentPrincipalIsGroup ? "toggle-btn--active" : "")"
                                                        @onclick="() => { VM.NewAssignmentPrincipalIsGroup = false; VM.NewAssignmentPrincipalId = null; }">Benutzer</button>
                                                <button class="toggle-btn @(VM.NewAssignmentPrincipalIsGroup ? "toggle-btn--active" : "")"
                                                        @onclick="() => { VM.NewAssignmentPrincipalIsGroup = true; VM.NewAssignmentPrincipalId = null; }">Gruppe</button>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label>@(VM.NewAssignmentPrincipalIsGroup ? "Gruppe" : "Benutzer")</label>
                                            <select class="edit-input" @bind="SelectedPrincipalIdString">
                                                <option value="">— Auswählen —</option>
                                                @if (VM.NewAssignmentPrincipalIsGroup)
                                                {
                                                    @foreach (var g in VM.AllGroups) { <option value="@g.Id">@g.Name</option> }
                                                }
                                                else
                                                {
                                                    @foreach (var u in VM.AllUsers) { <option value="@u.Id">@u.Name (@u.Username)</option> }
                                                }
                                            </select>
                                        </div>
                                        <div class="form-group">
                                            <label>Geltungsbereich</label>
                                            <select class="edit-input" @bind="SelectedScopeTypeString">
                                                <option value="Global">Global (systemweit)</option>
                                                <option value="Department">Abteilung</option>
                                                <option value="Share">Freigabe</option>
                                            </select>
                                        </div>
                                        @if (VM.NewAssignmentScopeType == ScopeType.Department)
                                        {
                                            <div class="form-group">
                                                <label>Abteilung</label>
                                                <select class="edit-input" @bind="SelectedScopeIdString">
                                                    <option value="">— Auswählen —</option>
                                                    @foreach (var dept in VM.AllDepartments)
                                                    {
                                                        <option value="@dept.Id">@dept.Name</option>
                                                    }
                                                </select>
                                            </div>
                                        }
                                        else if (VM.NewAssignmentScopeType == ScopeType.Share)
                                        {
                                            <div class="form-group">
                                                <label>Freigabe-ID</label>
                                                <input type="text" class="edit-input" placeholder="GUID der Freigabe"
                                                       @bind="ShareScopeIdInput" @bind:event="oninput" />
                                            </div>
                                        }
                                        @if (VM.ErrorMessage is not null)
                                        {
                                            <div class="error-banner" style="margin: 8px 0;">@VM.ErrorMessage</div>
                                        }
                                        <div class="create-form-actions" style="margin-top: 8px;">
                                            <button class="btn-primary" @onclick="CreateAssignment" disabled="@VM.IsSaving">
                                                @(VM.IsSaving ? "Erstellt…" : "Zuweisen")
                                            </button>
                                            <button class="btn-secondary" @onclick="() => VM.CancelAddAssignment()">Abbrechen</button>
                                        </div>
                                    </div>
                                }

                                @if (VM.RoleScopedAssignments.Any())
                                {
                                    <div class="scoped-assignments-list">
                                        @foreach (var a in VM.RoleScopedAssignments)
                                        {
                                            <div class="scoped-assignment-row">
                                                <div class="scoped-assignment-info">
                                                    <span class="scoped-assignment-principal">@a.PrincipalName</span>
                                                    <span class="scoped-assignment-scope">@FormatScopeType(a.ScopeType): @a.ScopeName</span>
                                                </div>
                                                @if (VM.CanManageRoles)
                                                {
                                                    <button class="btn-icon btn-icon--small" title="Entfernen"
                                                            @onclick="() => DeleteAssignment(a.AssignmentId)">
                                                        @Assets.SVG("cross.svg", new SvgOptions(
                                                                Width: 14,
                                                                Height: 14,
                                                                Color: "var(--danger)",
                                                                StrokeWidth: 2f
                                                            ))
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else if (!VM.IsAddingAssignment)
                                {
                                    <span class="detail-field-value detail-field-value--empty">Keine delegierten Zuweisungen</span>
                                }
                            </div>

                            <div class="detail-actions">
                                @if (VM.CanEditRoleDefinitions)
                                {
                                    <button class="btn-secondary" @onclick="EditRole">Bearbeiten</button>
                                }
                                @if (VM.CanDeleteRoles && !VM.SelectedRole.IsSystemRole)
                                {
                                    @if (VM.IsConfirmingDelete)
                                    {
                                        <div class="confirm-delete">
                                            <p>Rolle wirklich löschen?</p>
                                            <div style="display: flex; gap: 8px;">
                                                <button class="btn-danger-outline" @onclick="ConfirmDeleteRole" disabled="@VM.IsSaving">
                                                    @(VM.IsSaving ? "Löscht…" : "Ja, löschen")
                                                </button>
                                                <button class="btn-secondary" @onclick="() => VM.IsConfirmingDelete = false">Abbrechen</button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn-danger-outline" @onclick="() => VM.RequestDeleteRole()">Rolle löschen</button>
                                    }
                                }
                            </div>
                        }
                    }
                </div>
            }
        </div>
    }
}

@code {
    private bool groupsOpen, rolesOpen, membersOpen;

    // -- Binding helpers --

    private string SelectedPrincipalIdString
    {
        get => VM.NewAssignmentPrincipalId?.ToString() ?? "";
        set => VM.NewAssignmentPrincipalId = Guid.TryParse(value, out var id) ? id : null;
    }

    private string SelectedScopeTypeString
    {
        get => VM.NewAssignmentScopeType.ToString();
        set
        {
            VM.NewAssignmentScopeType = Enum.TryParse<ScopeType>(value, out var st) ? st : ScopeType.Global;
            VM.NewAssignmentScopeId = null;
        }
    }

    private string SelectedScopeIdString
    {
        get => VM.NewAssignmentScopeId?.ToString() ?? "";
        set => VM.NewAssignmentScopeId = Guid.TryParse(value, out var id) ? id : null;
    }

    private string ShareScopeIdInput
    {
        get => VM.NewAssignmentScopeId?.ToString() ?? "";
        set => VM.NewAssignmentScopeId = Guid.TryParse(value, out var id) ? id : null;
    }

    private string CreateUserDepartmentIdString
    {
        get => VM.CreateUserDepartmentId?.ToString() ?? "";
        set => VM.CreateUserDepartmentId = Guid.TryParse(value, out var id) ? id : null;
    }

    private string CreateGroupDepartmentIdString
    {
        get => VM.CreateGroupDepartmentId.ToString();
        set => VM.CreateGroupDepartmentId = Guid.TryParse(value, out var id) ? id : WellKnownDepartments.GlobalId;
    }

    // -- Lifecycle --

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await VM.LoadAsync();
            StateHasChanged();
        }
    }

    // -- Tab switching --
    private async Task SwitchTab(AdminTab tab) { CloseDropdowns(); await VM.SwitchTabAsync(tab); StateHasChanged(); }

    // -- Selection --
    private async Task SelectUser(User user) { CloseDropdowns(); await VM.SelectUserAsync(user); StateHasChanged(); }
    private async Task SelectGroup(Group group) { CloseDropdowns(); await VM.SelectGroupAsync(group); StateHasChanged(); }
    private async Task SelectRole(Role role) { CloseDropdowns(); await VM.SelectRoleAsync(role); StateHasChanged(); }

    // -- Edit / Save / Create / Delete --
    private async Task EditUser() { CloseDropdowns(); await VM.StartEditUserAsync(); StateHasChanged(); }
    private async Task EditGroup() { CloseDropdowns(); await VM.StartEditGroupAsync(); StateHasChanged(); }
    private async Task EditRole() { CloseDropdowns(); await VM.StartEditRoleAsync(); StateHasChanged(); }

    private async Task SaveUser() { CloseDropdowns(); await VM.SaveUserAsync(); StateHasChanged(); }
    private async Task SaveGroup() { CloseDropdowns(); await VM.SaveGroupAsync(); StateHasChanged(); }
    private async Task SaveRole() { CloseDropdowns(); await VM.SaveRoleAsync(); StateHasChanged(); }

    private async Task CreateUser() { await VM.CreateUserAsync(); StateHasChanged(); }
    private async Task CreateGroup() { await VM.CreateGroupAsync(); StateHasChanged(); }
    private async Task CreateRole() { await VM.CreateRoleAsync(); StateHasChanged(); }

    private async Task ConfirmDeleteUser() { await VM.ConfirmDeleteUserAsync(); StateHasChanged(); }
    private async Task ConfirmDeleteGroup() { await VM.ConfirmDeleteGroupAsync(); StateHasChanged(); }
    private async Task ConfirmDeleteRole() { await VM.ConfirmDeleteRoleAsync(); StateHasChanged(); }

    private void CancelEdit() { CloseDropdowns(); VM.CancelEdit(); StateHasChanged(); }

    // -- Scoped Assignments --
    private async Task StartAddAssignment() { VM.StartAddAssignment(); await VM.LoadAssignmentFormDataAsync(); StateHasChanged(); }
    private async Task CreateAssignment() { await VM.CreateAssignmentAsync(); StateHasChanged(); }
    private async Task DeleteAssignment(Guid id) { await VM.DeleteAssignmentAsync(id); StateHasChanged(); }

    // -- Helpers --
    private void CloseDropdowns() { groupsOpen = false; rolesOpen = false; membersOpen = false; }
    private async Task HandleCreateGroupKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") await CreateGroup(); }
    private async Task HandleCreateRoleKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") await CreateRole(); }

    private static string Checked(IEnumerable<string> names, string fallback)
    {
        var list = names.ToList();
        return list.Count > 0 ? string.Join(", ", list) : fallback;
    }

    private static string Format(IEnumerable<string> items, int max)
    {
        var list = items.ToList();
        if (list.Count == 0) return "";
        var visible = string.Join(", ", list.Take(max));
        if (list.Count > max) visible += $" +{list.Count - max} weitere";
        return visible;
    }

    private static string FormatScopeType(ScopeType type) => type switch
    {
        ScopeType.Global => "Global",
        ScopeType.Department => "Abteilung",
        ScopeType.Share => "Freigabe",
        _ => type.ToString()
    };
}
