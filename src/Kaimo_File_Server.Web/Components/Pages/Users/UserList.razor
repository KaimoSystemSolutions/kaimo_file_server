@page "/users"
@using Kaimo_File_Server.Core.Domain.Department
@using Kaimo_File_Server.Core.Domain.Identity
@using Kaimo_File_Server.Core.Security
@inject UserListViewModel VM
@inject NavigationManager Nav

<PageTitle>Kaimo Files – Verwaltung</PageTitle>

@if (VM.IsLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Lade...</p>
    </div>
}
else if (!VM.CanAccessPage)
{
    <div class="page-header">
        <div>
            <h1>Verwaltung</h1>
        </div>
    </div>
    <div class="error-banner">Keine Berechtigung. Sie haben keine Verwaltungsrechte zugewiesen.</div>
}
else
{
    <div class="page-header">
        <div>
            <h1>Verwaltung</h1>
            <p class="subtitle">@VM.TabSubtitle</p>
        </div>
        <div style="display: flex; gap: 0.5rem;">
            @if (VM.ActiveTab == AdminTab.Users && VM.CanCreateUsers)
            {
                <button class="btn-icon" title="Benutzer erstellen" @onclick="() => VM.StartCreateUser()">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19" />
                        <line x1="5" y1="12" x2="19" y2="12" />
                    </svg>
                </button>
            }
            else if (VM.ActiveTab == AdminTab.Groups && (VM.CanManageGroups || VM.IsGlobalAdmin))
            {
                <button class="btn-icon" title="Gruppe erstellen" @onclick="() => VM.StartCreateGroup()">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19" />
                        <line x1="5" y1="12" x2="19" y2="12" />
                    </svg>
                </button>
            }
            else if (VM.ActiveTab == AdminTab.Roles && (VM.CanManageRoles || VM.IsGlobalAdmin))
            {
                <button class="btn-icon" title="Rolle erstellen" @onclick="() => VM.StartCreateRole()">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19" />
                        <line x1="5" y1="12" x2="19" y2="12" />
                    </svg>
                </button>
            }
            else if (VM.ActiveTab == AdminTab.Departments && (VM.CanManageDepartments || VM.IsGlobalAdmin))
            {
                <button class="btn-icon" title="Abteilung erstellen" @onclick="() => VM.StartCreateDepartment()">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19" />
                        <line x1="5" y1="12" x2="19" y2="12" />
                    </svg>
                </button>
            }
        </div>
    </div>

    @* ── Tabs (only show tabs the actor has permissions for) ── *@
    <div class="admin-tabs">
        @if (VM.CanCreateUsers || VM.IsGlobalAdmin || VM.AuthorizedDepartmentsForView.Any())
        {
            <button class="admin-tab @(VM.ActiveTab == AdminTab.Users ? "active" : "")"
                    @onclick="() => SwitchTab(AdminTab.Users)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                </svg>
                Benutzer
            </button>
        }
        @if (VM.CanManageGroups || VM.IsGlobalAdmin)
        {
            <button class="admin-tab @(VM.ActiveTab == AdminTab.Groups ? "active" : "")"
                    @onclick="() => SwitchTab(AdminTab.Groups)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" />
                </svg>
                Gruppen
            </button>
        }
        @if (VM.CanManageRoles || VM.IsGlobalAdmin)
        {
            <button class="admin-tab @(VM.ActiveTab == AdminTab.Roles ? "active" : "")"
                    @onclick="() => SwitchTab(AdminTab.Roles)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
                Rollen
            </button>
        }
        @if (VM.CanManageDepartments || VM.IsGlobalAdmin)
        {
            <button class="admin-tab @(VM.ActiveTab == AdminTab.Departments ? "active" : "")"
                    @onclick="() => SwitchTab(AdminTab.Departments)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                    <polyline points="9 22 9 12 15 12 15 22" />
                </svg>
                Abteilungen
            </button>
        }
    </div>

    @* ── Create User Form (with Department dropdown) ── *@

    @if (VM.IsCreatingUser)
    {
        <div class="create-form-card">
            <h3>Neuen Benutzer erstellen</h3>
            <div class="create-form-fields">
                <div class="form-group">
                    <label>Abteilung</label>
                    <select class="edit-input" @bind="CreateUserDepartmentIdString">
                        @if (!VM.AuthorizedDepartmentsForCreate.Any())
                        {
                            <option value="">— Keine Abteilungen verfügbar —</option>
                        }
                        else
                        {
                            @foreach (var dept in VM.AuthorizedDepartmentsForCreate)
                            {
                                <option value="@dept.Id">@dept.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Anzeigename</label>
                    <input type="text" class="edit-input" placeholder="z.B. Max Mustermann"
                           @bind="VM.CreateUserName" @bind:event="oninput" />
                </div>
                <div class="form-group">
                    <label>Benutzername</label>
                    <input type="text" class="edit-input" placeholder="z.B. mmustermann"
                           @bind="VM.CreateUserUsername" @bind:event="oninput" />
                </div>
                <div class="form-group">
                    <label>E-Mail</label>
                    <input type="email" class="edit-input" placeholder="z.B. max@firma.de"
                           @bind="VM.CreateUserEmail" @bind:event="oninput" />
                </div>
                <div class="form-group">
                    <label>Beschreibung</label>
                    <input type="text" class="edit-input" placeholder="Optional"
                           @bind="VM.CreateUserDescription" @bind:event="oninput" />
                </div>
                <div class="form-group">
                    <label>Passwort</label>
                    <input type="password" class="edit-input" placeholder="Mindestens 6 Zeichen"
                           @bind="VM.CreateUserPassword" @bind:event="oninput" />
                </div>
                <div class="create-form-toggles">
                    <div class="toggle-row">
                        <span class="toggle-label-text">Konto aktiviert</span>
                        <label class="toggle-switch">
                            <input type="checkbox" @bind="VM.CreateUserIsEnabled" />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                    <div class="toggle-row">
                        <span class="toggle-label-text">Passwort ändern erlaubt</span>
                        <label class="toggle-switch">
                            <input type="checkbox" @bind="VM.CreateUserCanChangePassword" />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                </div>
            </div>
            @if (VM.ErrorMessage is not null)
            {
                <div class="error-banner" style="margin-top: 12px;">@VM.ErrorMessage</div>
            }
            <div class="create-form-actions">
                <button class="btn-primary" @onclick="CreateUser" disabled="@VM.IsSaving">
                    @(VM.IsSaving ? "Erstellt…" : "Erstellen")
                </button>
                <button class="btn-secondary" @onclick="() => VM.CancelCreate()">Abbrechen</button>
            </div>
        </div>
    }

    @if (VM.IsCreatingGroup)
    {
        <div class="create-form-card">
            <h3>Neue Gruppe erstellen</h3>
            <div class="create-form-fields">
                <div class="form-group">
                    <label>Gruppenname</label>
                    <input type="text" class="edit-input" placeholder="z.B. Entwickler"
                           @bind="VM.CreateGroupName" @bind:event="oninput"
                           @onkeydown="HandleCreateGroupKeyDown" />
                </div>
            </div>
            @if (VM.ErrorMessage is not null)
            {
                <div class="error-banner" style="margin-top: 12px;">@VM.ErrorMessage</div>
            }
            <div class="create-form-actions">
                <button class="btn-primary" @onclick="CreateGroup" disabled="@VM.IsSaving">
                    @(VM.IsSaving ? "Erstellt…" : "Erstellen")
                </button>
                <button class="btn-secondary" @onclick="() => VM.CancelCreate()">Abbrechen</button>
            </div>
        </div>
    }

    @if (VM.IsCreatingRole)
    {
        <div class="create-form-card">
            <h3>Neue Rolle erstellen</h3>
            <div class="create-form-fields">
                <div class="form-group">
                    <label>Rollenname</label>
                    <input type="text" class="edit-input" placeholder="z.B. Abteilungsleiter"
                           @bind="VM.CreateRoleName" @bind:event="oninput"
                           @onkeydown="HandleCreateRoleKeyDown" />
                </div>
            </div>
            @if (VM.ErrorMessage is not null)
            {
                <div class="error-banner" style="margin-top: 12px;">@VM.ErrorMessage</div>
            }
            <div class="create-form-actions">
                <button class="btn-primary" @onclick="CreateRole" disabled="@VM.IsSaving">
                    @(VM.IsSaving ? "Erstellt…" : "Erstellen")
                </button>
                <button class="btn-secondary" @onclick="() => VM.CancelCreate()">Abbrechen</button>
            </div>
        </div>
    }

    @if (VM.IsCreatingDepartment)
    {
        <div class="create-form-card">
            <h3>Neue Abteilung erstellen</h3>
            <div class="create-form-fields">
                <div class="form-group">
                    <label>Abteilungsname</label>
                    <input type="text" class="edit-input" placeholder="z.B. Vertrieb"
                           @bind="VM.CreateDepartmentName" @bind:event="oninput"
                           @onkeydown="HandleCreateDepartmentKeyDown" />
                </div>
            </div>
            @if (VM.ErrorMessage is not null)
            {
                <div class="error-banner" style="margin-top: 12px;">@VM.ErrorMessage</div>
            }
            <div class="create-form-actions">
                <button class="btn-primary" @onclick="CreateDepartment" disabled="@VM.IsSaving">
                    @(VM.IsSaving ? "Erstellt…" : "Erstellen")
                </button>
                <button class="btn-secondary" @onclick="() => VM.CancelCreate()">Abbrechen</button>
            </div>
        </div>
    }

    @* ── Main Content ── *@

    @if (VM.ErrorMessage is not null && !VM.IsEditing && !VM.IsCreatingUser && !VM.IsCreatingGroup && !VM.IsCreatingRole && !VM.IsCreatingDepartment)
    {
        <div class="error-banner">@VM.ErrorMessage</div>
    }
    else
    {
        <div class="admin-content">

            @* ════════════════════ LIST (left) ════════════════════ *@
            <div class="admin-list">
                @switch (VM.ActiveTab)
                {
                    case AdminTab.Users:
                        @if (!VM.Users.Any())
                        {
                            <div class="empty-state"><p>Keine Benutzer vorhanden.</p></div>
                        }
                        else
                        {
                            <div class="user-list-container">
                                <div class="user-list-row user-list-header">
                                    <div class="user-cell-name">Name</div>
                                    <div class="user-cell-username">Benutzername</div>
                                    <div class="user-cell-status">Status</div>
                                </div>
                                @foreach (var user in VM.Users)
                                {
                                    var isSelected = VM.SelectedUser?.Id == user.Id;
                                    <div class="user-list-row user-list-selectable @(isSelected ? "user-list-selected" : "")"
                                         @onclick="() => SelectUser(user)">
                                        <div class="user-cell-name">
                                            <svg class="file-icon" width="20" height="20" viewBox="0 0 24 24"
                                                 fill="none" stroke="@(isSelected ? "var(--accent)" : "var(--text-tertiary)")" stroke-width="1.5">
                                                <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
                                                <circle cx="12" cy="7" r="4" />
                                            </svg>
                                            <span>@user.Name</span>
                                        </div>
                                        <div class="user-cell-username">@user.Username</div>
                                        <div class="user-cell-status">
                                            @if (user.IsEnabled)
                                            {
                                                <span class="status-badge status-badge--active">
                                                    <span class="status-dot status-dot--active"></span>Aktiv
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-badge--disabled">
                                                    <span class="status-dot status-dot--disabled"></span>Deaktiviert
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        break;

                    case AdminTab.Groups:
                        @if (!VM.Groups.Any())
                        {
                            <div class="empty-state"><p>Keine Gruppen vorhanden.</p></div>
                        }
                        else
                        {
                            <div class="file-list">
                                <div class="file-row admin-row-header">
                                    <div class="file-cell user-name">Gruppenname</div>
                                    <div class="file-cell user-size">ID</div>
                                </div>
                                @foreach (var group in VM.Groups)
                                {
                                    var isSelected = VM.SelectedGroup?.Id == group.Id;
                                    <div class="file-row admin-row-selectable @(isSelected ? "admin-row-selected" : "")"
                                         @onclick="() => SelectGroup(group)">
                                        <div class="file-cell user-name">
                                            <svg class="file-icon" width="20" height="20" viewBox="0 0 24 24"
                                                 fill="none" stroke="@(isSelected ? "var(--accent)" : "var(--text-tertiary)")" stroke-width="1.5">
                                                <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" />
                                                <circle cx="9" cy="7" r="4" />
                                                <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" />
                                            </svg>
                                            <span>@group.Name</span>
                                        </div>
                                        <div class="file-cell user-size" style="color: var(--text-tertiary); font-size: 12px;">
                                            @group.Id.ToString()
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        break;

                    case AdminTab.Roles:
                        @if (!VM.Roles.Any())
                        {
                            <div class="empty-state"><p>Keine Rollen vorhanden.</p></div>
                        }
                        else
                        {
                            <div class="file-list">
                                <div class="file-row admin-row-header">
                                    <div class="file-cell user-name">Rollenname</div>
                                    <div class="file-cell user-size">Typ</div>
                                </div>
                                @foreach (var role in VM.Roles)
                                {
                                    var isSelected = VM.SelectedRole?.Id == role.Id;
                                    <div class="file-row admin-row-selectable @(isSelected ? "admin-row-selected" : "")"
                                         @onclick="() => SelectRole(role)">
                                        <div class="file-cell user-name">
                                            <svg class="file-icon" width="20" height="20" viewBox="0 0 24 24"
                                                 fill="none" stroke="@(isSelected ? "var(--accent)" : "var(--text-tertiary)")" stroke-width="1.5">
                                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                                            </svg>
                                            <span>@role.Name</span>
                                        </div>
                                        <div class="file-cell user-size" style="color: var(--text-tertiary); font-size: 12px;">
                                            @(role.IsSystemRole ? "System" : "Benutzerdefiniert")
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        break;

                    case AdminTab.Departments:
                        @if (!VM.Departments.Any())
                        {
                            <div class="empty-state"><p>Keine Abteilungen vorhanden.</p></div>
                        }
                        else
                        {
                            <div class="file-list">
                                <div class="file-row admin-row-header">
                                    <div class="file-cell user-name">Abteilungsname</div>
                                    <div class="file-cell user-size">ID</div>
                                </div>
                                @foreach (var dept in VM.Departments)
                                {
                                    var isSelected = VM.SelectedDepartment?.Id == dept.Id;
                                    <div class="file-row admin-row-selectable @(isSelected ? "admin-row-selected" : "")"
                                         @onclick="() => SelectDepartment(dept)">
                                        <div class="file-cell user-name">
                                            <svg class="file-icon" width="20" height="20" viewBox="0 0 24 24"
                                                 fill="none" stroke="@(isSelected ? "var(--accent)" : "var(--text-tertiary)")" stroke-width="1.5">
                                                <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                                                <polyline points="9 22 9 12 15 12 15 22" />
                                            </svg>
                                            <span>@dept.Name</span>
                                        </div>
                                        <div class="file-cell user-size" style="color: var(--text-tertiary); font-size: 12px;">
                                            @dept.Id.ToString()
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        break;
                }
            </div>

            @* ════════════════════ DETAIL PANEL (right) ════════════════════ *@
            @if (VM.SelectedUser is not null || VM.SelectedGroup is not null || VM.SelectedRole is not null || VM.SelectedDepartment is not null)
            {
                <div class="admin-detail">

                    @if (VM.SuccessMessage is not null)
                    {
                        <div class="success-banner">@VM.SuccessMessage</div>
                    }

                    @* ──────────── USER DETAIL ──────────── *@
                    @if (VM.SelectedUser is not null)
                    {
                        @if (VM.IsEditing)
                        {
                            <div class="detail-header">
                                <h3>Benutzer bearbeiten</h3>
                                <span class="detail-subtitle">@VM.SelectedUser.Username</span>
                            </div>

                            <div class="detail-field-grid">
                                <div class="form-group">
                                    <label>Name</label>
                                    <input type="text" class="edit-input" @bind="VM.EditUserName" />
                                </div>
                                <div class="form-group">
                                    <label>E-Mail</label>
                                    <input type="email" class="edit-input" placeholder="z.B. max@firma.de"
                                           @bind="VM.EditUserEmail" @bind:event="oninput" />
                                </div>
                                <div class="form-group">
                                    <label>Beschreibung</label>
                                    <input type="text" class="edit-input" placeholder="Optional"
                                           @bind="VM.EditUserDescription" @bind:event="oninput" />
                                </div>

                                @* Password reset — only if actor has ResetPasswords permission *@
                                @if (VM.CanResetPasswordForSelected)
                                {
                                    <div class="form-group">
                                        <label>Neues Passwort (optional)</label>
                                        <input type="password" class="edit-input" placeholder="Leer lassen = unverändert"
                                               @bind="VM.NewPassword" @bind:event="oninput" />
                                    </div>
                                    @if (!string.IsNullOrEmpty(VM.NewPassword))
                                    {
                                        <div class="form-group">
                                            <label>Passwort bestätigen</label>
                                            <input type="password" class="edit-input" placeholder="Passwort wiederholen"
                                                   @bind="VM.ConfirmPassword" @bind:event="oninput" />
                                        </div>
                                    }
                                }

                                <div class="create-form-toggles">
                                    <div class="toggle-row">
                                        <span class="toggle-label-text">Konto aktiviert</span>
                                        <label class="toggle-switch">
                                            <input type="checkbox" @bind="VM.EditUserIsEnabled" />
                                            <span class="toggle-slider"></span>
                                        </label>
                                    </div>
                                    <div class="toggle-row">
                                        <span class="toggle-label-text">Passwort ändern erlaubt</span>
                                        <label class="toggle-switch">
                                            <input type="checkbox" @bind="VM.EditUserCanChangePassword" />
                                            <span class="toggle-slider"></span>
                                        </label>
                                    </div>
                                </div>

                                @* Groups multi-select *@
                                <div class="form-group">
                                    <label>Gruppen</label>
                                    <div class="multi-select @(groupsOpen ? "open" : "")">
                                        <div class="multi-select-display" @onclick="() => groupsOpen = !groupsOpen">
                                            <span class="multi-select-text">
                                                @{
                                                    var selGroups = VM.EditUserGroups.Where(g => g.IsChecked).Select(g => g.Item.Name);
                                                }
                                                @(selGroups.Any() ? string.Join(", ", selGroups) : "Keine Gruppen")
                                            </span>
                                            <svg class="multi-select-chevron" width="14" height="14" viewBox="0 0 24 24"
                                                 fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M6 9l6 6 6-6" />
                                            </svg>
                                        </div>
                                        @if (groupsOpen)
                                        {
                                            <div class="multi-select-backdrop" @onclick="() => groupsOpen = false"></div>
                                            <div class="multi-select-dropdown">
                                                @foreach (var item in VM.EditUserGroups)
                                                {
                                                    <label class="multi-select-option">
                                                        <input type="checkbox" @bind="item.IsChecked" />
                                                        <span>@item.Item.Name</span>
                                                    </label>
                                                }
                                                @if (!VM.EditUserGroups.Any())
                                                {
                                                    <span class="empty-hint">Keine Gruppen vorhanden</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>

                                @* Roles multi-select *@
                                <div class="form-group">
                                    <label>Rollen</label>
                                    <div class="multi-select @(rolesOpen ? "open" : "")">
                                        <div class="multi-select-display" @onclick="() => rolesOpen = !rolesOpen">
                                            <span class="multi-select-text">
                                                @{
                                                    var selRoles = VM.EditUserRoles.Where(r => r.IsChecked).Select(r => r.Item.Name);
                                                }
                                                @(selRoles.Any() ? string.Join(", ", selRoles) : "Keine Rollen")
                                            </span>
                                            <svg class="multi-select-chevron" width="14" height="14" viewBox="0 0 24 24"
                                                 fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M6 9l6 6 6-6" />
                                            </svg>
                                        </div>
                                        @if (rolesOpen)
                                        {
                                            <div class="multi-select-backdrop" @onclick="() => rolesOpen = false"></div>
                                            <div class="multi-select-dropdown">
                                                @foreach (var item in VM.EditUserRoles)
                                                {
                                                    <label class="multi-select-option">
                                                        <input type="checkbox" @bind="item.IsChecked" />
                                                        <span>@item.Item.Name</span>
                                                    </label>
                                                }
                                                @if (!VM.EditUserRoles.Any())
                                                {
                                                    <span class="empty-hint">Keine Rollen vorhanden</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            @if (VM.ErrorMessage is not null)
                            {
                                <div class="error-banner" style="margin: 12px 0;">@VM.ErrorMessage</div>
                            }

                            <div class="detail-actions">
                                <button class="btn-primary" @onclick="SaveUser" disabled="@VM.IsSaving">
                                    @(VM.IsSaving ? "Speichert…" : "Speichern")
                                </button>
                                <button class="btn-secondary" @onclick="CancelEdit" disabled="@VM.IsSaving">Abbrechen</button>
                            </div>
                        }
                        else
                        {
                            @* ── User View Mode ── *@
                            <div class="detail-header">
                                <h3>@VM.SelectedUser.Name</h3>
                                <span class="detail-subtitle">@VM.SelectedUser.Username</span>
                            </div>

                            <div class="detail-field-grid">
                                <div class="detail-field">
                                    <span class="detail-field-label">Status</span>
                                    <span>
                                        @if (VM.SelectedUser.IsEnabled)
                                        {
                                            <span class="status-badge status-badge--active">
                                                <span class="status-dot status-dot--active"></span>Aktiv
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-badge--disabled">
                                                <span class="status-dot status-dot--disabled"></span>Deaktiviert
                                            </span>
                                        }
                                    </span>
                                </div>
                                <div class="detail-field">
                                    <span class="detail-field-label">E-Mail</span>
                                    @if (!string.IsNullOrWhiteSpace(VM.SelectedUser.Email))
                                    {
                                        <span class="detail-field-value">@VM.SelectedUser.Email</span>
                                    }
                                    else
                                    {
                                        <span class="detail-field-value detail-field-value--empty">Nicht angegeben</span>
                                    }
                                </div>
                                <div class="detail-field">
                                    <span class="detail-field-label">Beschreibung</span>
                                    @if (!string.IsNullOrWhiteSpace(VM.SelectedUser.Description))
                                    {
                                        <span class="detail-field-value">@VM.SelectedUser.Description</span>
                                    }
                                    else
                                    {
                                        <span class="detail-field-value detail-field-value--empty">Keine Beschreibung</span>
                                    }
                                </div>
                                <div class="detail-field">
                                    <span class="detail-field-label">Passwort ändern</span>
                                    <span class="detail-field-value">
                                        @(VM.SelectedUser.CanChangePassword ? "Erlaubt" : "Gesperrt")
                                    </span>
                                </div>
                                <div class="detail-field">
                                    <span class="detail-field-label">Rollen</span>
                                    <span class="detail-field-value">
                                        @if (VM.UserRoles.Any())
                                        {
                                            @string.Join(", ", VM.UserRoles.Select(r => r.Name).Take(5))
                                            @if (VM.UserRoles.Count > 5)
                                            {
                                                <span class="truncated-hint"> +@(VM.UserRoles.Count - 5) weitere</span>
                                            }
                                        }
                                        else
                                        {
                                            <text>Keine Rollen</text>
                                        }
                                    </span>
                                </div>
                                <div class="detail-field">
                                    <span class="detail-field-label">Gruppen</span>
                                    <span class="detail-field-value">
                                        @if (VM.UserGroups.Any())
                                        {
                                            @string.Join(", ", VM.UserGroups.Select(g => g.Name).Take(5))
                                            @if (VM.UserGroups.Count > 5)
                                            {
                                                <span class="truncated-hint"> +@(VM.UserGroups.Count - 5) weitere</span>
                                            }
                                        }
                                        else
                                        {
                                            <text>Keine Gruppen</text>
                                        }
                                    </span>
                                </div>
                                <div class="detail-field">
                                    <span class="detail-field-label">ID</span>
                                    <span class="detail-field-value" style="font-size: 11px; font-family: monospace;">@VM.SelectedUser.Id</span>
                                </div>
                            </div>

                            @* ── User Scoped Assignments ── *@
                            @if (VM.UserScopedAssignments.Any())
                            {
                                <div class="detail-section" style="margin-top: 16px;">
                                    <span class="detail-label">Delegierte Rollenzuweisungen</span>
                                    <div class="scoped-assignments-list">
                                        @foreach (var a in VM.UserScopedAssignments)
                                        {
                                            <div class="scoped-assignment-row">
                                                <div class="scoped-assignment-info">
                                                    <span class="scoped-assignment-role">@a.RoleName</span>
                                                    <span class="scoped-assignment-scope">
                                                        @FormatScopeType(a.ScopeType): @a.ScopeName
                                                    </span>
                                                </div>
                                                @if (VM.IsGlobalAdmin || VM.CanManageRoles)
                                                {
                                                    <button class="btn-icon btn-icon--small" title="Zuweisung entfernen"
                                                            @onclick="() => DeleteAssignment(a.AssignmentId)">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                             stroke="var(--danger)" stroke-width="2">
                                                            <line x1="18" y1="6" x2="6" y2="18" />
                                                            <line x1="6" y1="6" x2="18" y2="18" />
                                                        </svg>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="detail-actions">
                                @if (VM.CanEditSelectedUser)
                                {
                                    <button class="btn-secondary" @onclick="EditUser">Bearbeiten</button>
                                }
                                @if (VM.CanDeleteSelectedUser)
                                {
                                    @if (VM.IsConfirmingDelete)
                                    {
                                        <div class="confirm-delete">
                                            <p>Benutzer wirklich löschen?</p>
                                            <div style="display: flex; gap: 8px;">
                                                <button class="btn-danger-outline" @onclick="ConfirmDeleteUser" disabled="@VM.IsSaving">
                                                    @(VM.IsSaving ? "Löscht…" : "Ja, löschen")
                                                </button>
                                                <button class="btn-secondary" @onclick="() => VM.IsConfirmingDelete = false">Abbrechen</button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn-danger-outline" @onclick="() => VM.RequestDeleteUser()">Benutzer löschen</button>
                                    }
                                }
                            </div>
                        }
                    }

                    @* ──────────── GROUP DETAIL ──────────── *@
                    else if (VM.SelectedGroup is not null)
                    {
                        @if (VM.IsEditing)
                        {
                            <div class="detail-header">
                                <h3>Mitglieder verwalten</h3>
                                <span class="detail-subtitle">@VM.SelectedGroup.Name</span>
                            </div>
                            <div class="detail-section">
                                <span class="detail-label">Benutzer</span>
                                <div class="multi-select @(membersOpen ? "open" : "")">
                                    <div class="multi-select-display" @onclick="() => membersOpen = !membersOpen">
                                        <span class="multi-select-text">
                                            @{
                                                var selGroupMembers = VM.EditGroupMembers.Where(m => m.IsChecked).Select(m => m.Item.Name);
                                            }
                                            @(selGroupMembers.Any() ? string.Join(", ", selGroupMembers) : "Keine Mitglieder")
                                        </span>
                                        <svg class="multi-select-chevron" width="14" height="14" viewBox="0 0 24 24"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M6 9l6 6 6-6" />
                                        </svg>
                                    </div>
                                    @if (membersOpen)
                                    {
                                        <div class="multi-select-backdrop" @onclick="() => membersOpen = false"></div>
                                        <div class="multi-select-dropdown">
                                            @foreach (var item in VM.EditGroupMembers)
                                            {
                                                <label class="multi-select-option">
                                                    <input type="checkbox" @bind="item.IsChecked" />
                                                    <span>@item.Item.Name</span>
                                                    <span class="multi-select-hint">@item.Item.Username</span>
                                                </label>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                            @if (VM.ErrorMessage is not null)
                            {
                                <div class="error-banner" style="margin-bottom: 12px;">@VM.ErrorMessage</div>
                            }
                            <div class="detail-actions">
                                <button class="btn-primary" @onclick="SaveGroup" disabled="@VM.IsSaving">
                                    @(VM.IsSaving ? "Speichert…" : "Speichern")
                                </button>
                                <button class="btn-secondary" @onclick="CancelEdit" disabled="@VM.IsSaving">Abbrechen</button>
                            </div>
                        }
                        else
                        {
                            <div class="detail-header">
                                <h3>@VM.SelectedGroup.Name</h3>
                                <span class="detail-subtitle">Gruppe</span>
                            </div>
                            <div class="detail-section">
                                <span class="detail-label">Mitglieder</span>
                                <span class="detail-value">
                                    @if (VM.GroupMembers.Any())
                                    {
                                        @string.Join(", ", VM.GroupMembers.Select(u => u.Name).Take(5))
                                        @if (VM.GroupMembers.Count > 5)
                                        {
                                            <span class="truncated-hint"> +@(VM.GroupMembers.Count - 5) weitere</span>
                                        }
                                    }
                                    else
                                    {
                                        <text>Keine Mitglieder</text>
                                    }
                                </span>
                                <span class="detail-label">ID</span>
                                <span class="detail-value">@VM.SelectedGroup.Id</span>
                            </div>
                            <div class="detail-actions">
                                @if (VM.CanManageGroups || VM.IsGlobalAdmin)
                                {
                                    <button class="btn-secondary" @onclick="EditGroup">Mitglieder verwalten</button>
                                }
                                @if (VM.IsGlobalAdmin)
                                {
                                    @if (VM.IsConfirmingDelete)
                                    {
                                        <div class="confirm-delete">
                                            <p>Gruppe wirklich löschen?</p>
                                            <div style="display: flex; gap: 8px;">
                                                <button class="btn-danger-outline" @onclick="ConfirmDeleteGroup" disabled="@VM.IsSaving">
                                                    @(VM.IsSaving ? "Löscht…" : "Ja, löschen")
                                                </button>
                                                <button class="btn-secondary" @onclick="() => VM.IsConfirmingDelete = false">Abbrechen</button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn-danger-outline" @onclick="() => VM.RequestDeleteGroup()">Gruppe löschen</button>
                                    }
                                }
                            </div>
                        }
                    }

                    @* ──────────── ROLE DETAIL ──────────── *@
                    else if (VM.SelectedRole is not null)
                    {
                        @if (VM.IsEditing)
                        {
                            @* ── Role Edit Mode ── *@
                            <div class="detail-header">
                                <h3>Rolle bearbeiten</h3>
                                <span class="detail-subtitle">@VM.SelectedRole.Name</span>
                            </div>

                            @* ── Members ── *@
                            <div class="detail-section">
                                <span class="detail-label">Direkte Mitglieder</span>
                                <div class="multi-select @(membersOpen ? "open" : "")">
                                    <div class="multi-select-display" @onclick="() => membersOpen = !membersOpen">
                                        <span class="multi-select-text">
                                            @{
                                                var selRoleMembers = VM.EditRoleMembers.Where(m => m.IsChecked).Select(m => m.Item.Name);
                                            }
                                            @(selRoleMembers.Any() ? string.Join(", ", selRoleMembers) : "Keine Mitglieder")
                                        </span>
                                        <svg class="multi-select-chevron" width="14" height="14" viewBox="0 0 24 24"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M6 9l6 6 6-6" />
                                        </svg>
                                    </div>
                                    @if (membersOpen)
                                    {
                                        <div class="multi-select-backdrop" @onclick="() => membersOpen = false"></div>
                                        <div class="multi-select-dropdown">
                                            @foreach (var item in VM.EditRoleMembers)
                                            {
                                                <label class="multi-select-option">
                                                    <input type="checkbox" @bind="item.IsChecked" />
                                                    <span>@item.Item.Name</span>
                                                    <span class="multi-select-hint">@item.Item.Username</span>
                                                </label>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            @* ── Management Permissions (only for non-system roles) ── *@
                            @if (!VM.SelectedRole.IsSystemRole)
                            {
                                <div class="detail-section" style="margin-top: 16px;">
                                    <span class="detail-label">Berechtigungen</span>

                                    @* Presets *@
                                    <div class="permission-presets">
                                        @foreach (var preset in UserListViewModel.PermissionPresets)
                                        {
                                            var isActive = VM.EditRolePermissions == preset.Permissions;
                                            <button class="preset-chip @(isActive ? "preset-chip--active" : "")"
                                                    @onclick="() => VM.ApplyPermissionPreset(preset.Permissions)">
                                                @preset.Label
                                            </button>
                                        }
                                        <button class="preset-chip" @onclick="() => VM.ApplyPermissionPreset(ManagementPermission.None)">
                                            Keine
                                        </button>
                                    </div>

                                    @* Grouped checkboxes *@
                                    <div class="permission-groups">
                                        @foreach (var group in UserListViewModel.PermissionGroups)
                                        {
                                            <div class="permission-group">
                                                <span class="permission-group-label">@group.Label</span>
                                                <div class="permission-flags">
                                                    @foreach (var flag in group.Flags)
                                                    {
                                                        var isChecked = VM.HasEditPermission(flag.Flag);
                                                        <label class="permission-flag">
                                                            <input type="checkbox" checked="@isChecked"
                                                                   @onchange="e => VM.ToggleEditPermission(flag.Flag, (bool)(e.Value ?? false))" />
                                                            <span>@flag.Label</span>
                                                        </label>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            @if (VM.ErrorMessage is not null)
                            {
                                <div class="error-banner" style="margin: 12px 0;">@VM.ErrorMessage</div>
                            }

                            <div class="detail-actions">
                                <button class="btn-primary" @onclick="SaveRole" disabled="@VM.IsSaving">
                                    @(VM.IsSaving ? "Speichert…" : "Speichern")
                                </button>
                                <button class="btn-secondary" @onclick="CancelEdit" disabled="@VM.IsSaving">Abbrechen</button>
                            </div>
                        }
                        else
                        {
                            @* ── Role View Mode ── *@
                            <div class="detail-header">
                                <h3>@VM.SelectedRole.Name</h3>
                                <span class="detail-subtitle">
                                    @(VM.SelectedRole.IsSystemRole ? "Systemrolle" : "Benutzerdefinierte Rolle")
                                </span>
                            </div>

                            <div class="detail-field-grid">
                                <div class="detail-field">
                                    <span class="detail-field-label">Direkte Mitglieder</span>
                                    <span class="detail-field-value">
                                        @if (VM.RoleMembers.Any())
                                        {
                                            @string.Join(", ", VM.RoleMembers.Select(u => u.Name).Take(5))
                                            @if (VM.RoleMembers.Count > 5)
                                            {
                                                <span class="truncated-hint"> +@(VM.RoleMembers.Count - 5) weitere</span>
                                            }
                                        }
                                        else
                                        {
                                            <text>Keine Mitglieder</text>
                                        }
                                    </span>
                                </div>

                                @* ── Current Permissions Display ── *@
                                <div class="detail-field">
                                    <span class="detail-field-label">Berechtigungen</span>
                                    <span class="detail-field-value">
                                        @if (VM.SelectedRole.ManagementPermissions == ManagementPermission.None)
                                        {
                                            <span class="detail-field-value--empty">Keine Berechtigungen</span>
                                        }
                                        else
                                        {
                                            <div class="permission-tags">
                                                @foreach (var group in UserListViewModel.PermissionGroups)
                                                {
                                                    @foreach (var flag in group.Flags)
                                                    {
                                                        if ((VM.SelectedRole.ManagementPermissions & flag.Flag) == flag.Flag)
                                                        {
                                                            <span class="permission-tag">@flag.Label</span>
                                                        }
                                                    }
                                                }
                                            </div>
                                        }
                                    </span>
                                </div>

                                <div class="detail-field">
                                    <span class="detail-field-label">ID</span>
                                    <span class="detail-field-value" style="font-size: 11px; font-family: monospace;">
                                        @VM.SelectedRole.Id
                                    </span>
                                </div>
                            </div>

                            @* ── Scoped Assignments for this Role ── *@
                            <div class="detail-section" style="margin-top: 16px;">
                                <div style="display: flex; align-items: center; justify-content: space-between;">
                                    <span class="detail-label">Delegierte Zuweisungen</span>
                                    @if (!VM.IsAddingAssignment && (VM.IsGlobalAdmin || VM.CanManageRoles))
                                    {
                                        <button class="btn-icon btn-icon--small" title="Zuweisung hinzufügen"
                                                @onclick="StartAddAssignment">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="2">
                                                <line x1="12" y1="5" x2="12" y2="19" />
                                                <line x1="5" y1="12" x2="19" y2="12" />
                                            </svg>
                                        </button>
                                    }
                                </div>

                                @if (VM.IsAddingAssignment)
                                {
                                    <div class="assignment-form">
                                        @* Principal Type *@
                                        <div class="form-group">
                                            <label>Zuweisen an</label>
                                            <div class="toggle-button-group">
                                                <button class="toggle-btn @(!VM.NewAssignmentPrincipalIsGroup ? "toggle-btn--active" : "")"
                                                        @onclick="() => { VM.NewAssignmentPrincipalIsGroup = false; VM.NewAssignmentPrincipalId = null; }">
                                                    Benutzer
                                                </button>
                                                <button class="toggle-btn @(VM.NewAssignmentPrincipalIsGroup ? "toggle-btn--active" : "")"
                                                        @onclick="() => { VM.NewAssignmentPrincipalIsGroup = true; VM.NewAssignmentPrincipalId = null; }">
                                                    Gruppe
                                                </button>
                                            </div>
                                        </div>

                                        @* Principal Select *@
                                        <div class="form-group">
                                            <label>@(VM.NewAssignmentPrincipalIsGroup ? "Gruppe" : "Benutzer")</label>
                                            <select class="edit-input" @bind="SelectedPrincipalIdString">
                                                <option value="">— Auswählen —</option>
                                                @if (VM.NewAssignmentPrincipalIsGroup)
                                                {
                                                    @foreach (var g in VM.AllGroups)
                                                    {
                                                        <option value="@g.Id">@g.Name</option>
                                                    }
                                                }
                                                else
                                                {
                                                    @foreach (var u in VM.AllUsers)
                                                    {
                                                        <option value="@u.Id">@u.Name (@u.Username)</option>
                                                    }
                                                }
                                            </select>
                                        </div>

                                        @* Scope Type *@
                                        <div class="form-group">
                                            <label>Geltungsbereich</label>
                                            <select class="edit-input" @bind="SelectedScopeTypeString">
                                                <option value="Global">Global (systemweit)</option>
                                                <option value="Department">Abteilung</option>
                                                <option value="Share">Freigabe</option>
                                            </select>
                                        </div>

                                        @* Scope ID (if not Global) *@
                                        @if (VM.NewAssignmentScopeType == ScopeType.Department)
                                        {
                                            <div class="form-group">
                                                <label>Abteilung</label>
                                                <select class="edit-input" @bind="SelectedScopeIdString">
                                                    <option value="">— Auswählen —</option>
                                                    @foreach (var dept in VM.AllDepartments)
                                                    {
                                                        <option value="@dept.Id">@dept.Name</option>
                                                    }
                                                </select>
                                            </div>
                                        }
                                        else if (VM.NewAssignmentScopeType == ScopeType.Share)
                                        {
                                            <div class="form-group">
                                                <label>Freigabe-ID</label>
                                                <input type="text" class="edit-input" placeholder="GUID der Freigabe"
                                                       @bind="ShareScopeIdInput" @bind:event="oninput" />
                                            </div>
                                        }

                                        @if (VM.ErrorMessage is not null)
                                        {
                                            <div class="error-banner" style="margin: 8px 0;">@VM.ErrorMessage</div>
                                        }

                                        <div class="create-form-actions" style="margin-top: 8px;">
                                            <button class="btn-primary" @onclick="CreateAssignment" disabled="@VM.IsSaving">
                                                @(VM.IsSaving ? "Erstellt…" : "Zuweisen")
                                            </button>
                                            <button class="btn-secondary" @onclick="() => VM.CancelAddAssignment()">Abbrechen</button>
                                        </div>
                                    </div>
                                }

                                @if (VM.RoleScopedAssignments.Any())
                                {
                                    <div class="scoped-assignments-list">
                                        @foreach (var a in VM.RoleScopedAssignments)
                                        {
                                            <div class="scoped-assignment-row">
                                                <div class="scoped-assignment-info">
                                                    <span class="scoped-assignment-principal">
                                                        @if (a.IsGroup)
                                                        {
                                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                                                                 stroke="var(--text-tertiary)" stroke-width="1.5" style="vertical-align: -1px; margin-right: 4px;">
                                                                <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" />
                                                                <circle cx="9" cy="7" r="4" />
                                                            </svg>
                                                        }
                                                        else
                                                        {
                                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                                                                 stroke="var(--text-tertiary)" stroke-width="1.5" style="vertical-align: -1px; margin-right: 4px;">
                                                                <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
                                                                <circle cx="12" cy="7" r="4" />
                                                            </svg>
                                                        }
                                                        @a.PrincipalName
                                                    </span>
                                                    <span class="scoped-assignment-scope">
                                                        @FormatScopeType(a.ScopeType): @a.ScopeName
                                                    </span>
                                                </div>
                                                @if (VM.IsGlobalAdmin || VM.CanManageRoles)
                                                {
                                                    <button class="btn-icon btn-icon--small" title="Zuweisung entfernen"
                                                            @onclick="() => DeleteAssignment(a.AssignmentId)">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                             stroke="var(--danger)" stroke-width="2">
                                                            <line x1="18" y1="6" x2="6" y2="18" />
                                                            <line x1="6" y1="6" x2="18" y2="18" />
                                                        </svg>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else if (!VM.IsAddingAssignment)
                                {
                                    <span class="detail-field-value detail-field-value--empty">
                                        Keine delegierten Zuweisungen
                                    </span>
                                }
                            </div>

                            @* ── Actions ── *@
                            @if (VM.SelectedRole.IsSystemRole)
                            {
                                <div class="detail-info">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                         stroke="var(--text-tertiary)" stroke-width="1.5">
                                        <circle cx="12" cy="12" r="10" />
                                        <line x1="12" y1="16" x2="12" y2="12" />
                                        <line x1="12" y1="8" x2="12.01" y2="8" />
                                    </svg>
                                    <span>Systemrollen können nicht gelöscht werden. Berechtigungen und Mitglieder können verwaltet werden.</span>
                                </div>
                                @if (VM.IsGlobalAdmin || VM.CanManageRoles)
                                {
                                    <div class="detail-actions">
                                        <button class="btn-secondary" @onclick="EditRole">Bearbeiten</button>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="detail-actions">
                                    @if (VM.IsGlobalAdmin || VM.CanManageRoles)
                                    {
                                        <button class="btn-secondary" @onclick="EditRole">Bearbeiten</button>
                                    }
                                    @if (VM.IsGlobalAdmin)
                                    {
                                        @if (VM.IsConfirmingDelete)
                                        {
                                            <div class="confirm-delete">
                                                <p>Rolle wirklich löschen?</p>
                                                <div style="display: flex; gap: 8px;">
                                                    <button class="btn-danger-outline" @onclick="ConfirmDeleteRole" disabled="@VM.IsSaving">
                                                        @(VM.IsSaving ? "Löscht…" : "Ja, löschen")
                                                    </button>
                                                    <button class="btn-secondary" @onclick="() => VM.IsConfirmingDelete = false">Abbrechen</button>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <button class="btn-danger-outline" @onclick="() => VM.RequestDeleteRole()">Rolle löschen</button>
                                        }
                                    }
                                </div>
                            }
                        }
                    }

                    @* ──────────── DEPARTMENT DETAIL ──────────── *@
                    else if (VM.SelectedDepartment is not null)
                    {
                        @if (VM.IsEditing)
                        {
                            @* ── Department Edit Mode ── *@
                            <div class="detail-header">
                                <h3>Abteilung bearbeiten</h3>
                                <span class="detail-subtitle">@VM.SelectedDepartment.Name</span>
                            </div>

                            <div class="detail-field-grid">
                                @* Name *@
                                <div class="form-group">
                                    <label>Name</label>
                                    <input type="text" class="edit-input" @bind="VM.EditDepartmentName" />
                                </div>

                                @* Parent Department (Hierarchy / Inheritance) *@
                                <div class="form-group">
                                    <label>Erbt von (Elternabteilung)</label>
                                    <select class="edit-input" @bind="EditDepartmentParentIdString">
                                        <option value="">— Keine (Oberste Ebene) —</option>
                                        @foreach (var dept in VM.AvailableParentDepartments)
                                        {
                                            <option value="@dept.Id">@dept.Name</option>
                                        }
                                    </select>
                                    <span class="form-hint">
                                        Wie in OOP: Diese Abteilung erbt Admin-Rechte und Default-Berechtigungen
                                        von der gewählten Elternabteilung.
                                    </span>
                                </div>
                            </div>

                            @* ── Default File Permission ── *@
                            <div class="detail-section" style="margin-top: 16px;">
                                <span class="detail-label">Standard-Dateiberechtigung</span>
                                <p class="form-hint" style="margin-bottom: 8px;">
                                    Diese Berechtigung wird automatisch auf alle Abteilungsmitglieder
                                    für alle zugeordneten Freigaben angewandt.
                                </p>

                                @* Toggle: own vs inherit *@
                                <div class="toggle-row" style="margin-bottom: 12px;">
                                    <span class="toggle-label-text">Eigene Berechtigung definieren</span>
                                    <label class="toggle-switch">
                                        <input type="checkbox" @bind="VM.EditDepartmentHasOwnPermission" />
                                        <span class="toggle-slider"></span>
                                    </label>
                                </div>

                                @if (VM.EditDepartmentHasOwnPermission)
                                {
                                    @* Permission checkboxes *@
                                    <div class="permission-flags" style="margin-left: 4px;">
                                        @foreach (var flag in DepartmentPermissionDisplay.AllFlags)
                                        {
                                            var isChecked = VM.HasDeptPermFlag(flag.Flag);
                                            <label class="permission-flag" title="@flag.Description">
                                                <input type="checkbox" checked="@isChecked"
                                                       @onchange="e => VM.ToggleDeptPermFlag(flag.Flag, (bool)(e.Value ?? false))" />
                                                <span>@flag.Label</span>
                                            </label>
                                        }
                                    </div>
                                }
                                else
                                {
                                    @* Show what will be inherited *@
                                    @if (VM.EditDepartmentParentId.HasValue)
                                    {
                                        <span class="detail-field-value detail-field-value--empty">
                                            Wird von Elternabteilung geerbt.
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="detail-field-value detail-field-value--empty">
                                            Keine Elternabteilung — keine Default-Berechtigung.
                                        </span>
                                    }
                                }
                            </div>

                            @* ── Members ── *@
                            <div class="detail-section" style="margin-top: 16px;">
                                <span class="detail-label">Mitglieder</span>
                                <div class="multi-select @(membersOpen ? "open" : "")">
                                    <div class="multi-select-display" @onclick="() => membersOpen = !membersOpen">
                                        <span class="multi-select-text">
                                            @{
                                                var selDeptMembers = VM.EditDepartmentMembers
                                                    .Where(m => m.IsChecked).Select(m => m.Item.Name);
                                            }
                                            @(selDeptMembers.Any() ? string.Join(", ", selDeptMembers) : "Keine Mitglieder")
                                        </span>
                                        <svg class="multi-select-chevron" width="14" height="14" viewBox="0 0 24 24"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M6 9l6 6 6-6" />
                                        </svg>
                                    </div>
                                    @if (membersOpen)
                                    {
                                        <div class="multi-select-backdrop" @onclick="() => membersOpen = false"></div>
                                        <div class="multi-select-dropdown">
                                            @foreach (var item in VM.EditDepartmentMembers)
                                            {
                                                <label class="multi-select-option">
                                                    <input type="checkbox" @bind="item.IsChecked" />
                                                    <span>@item.Item.Name</span>
                                                    <span class="multi-select-hint">@item.Item.Username</span>
                                                </label>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            @* ── Share Assignment ── *@
                            <div class="detail-section" style="margin-top: 16px;">
                                <span class="detail-label">Zugeordnete Freigaben</span>
                                <div class="multi-select @(sharesOpen ? "open" : "")">
                                    <div class="multi-select-display" @onclick="() => sharesOpen = !sharesOpen">
                                        <span class="multi-select-text">
                                            @{
                                                var selShares = VM.EditDepartmentShares
                                                    .Where(s => s.IsChecked).Select(s => s.Item.Name);
                                            }
                                            @(selShares.Any() ? string.Join(", ", selShares) : "Keine Freigaben")
                                        </span>
                                        <svg class="multi-select-chevron" width="14" height="14" viewBox="0 0 24 24"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M6 9l6 6 6-6" />
                                        </svg>
                                    </div>
                                    @if (sharesOpen)
                                    {
                                        <div class="multi-select-backdrop" @onclick="() => sharesOpen = false"></div>
                                        <div class="multi-select-dropdown">
                                            @foreach (var item in VM.EditDepartmentShares)
                                            {
                                                <label class="multi-select-option">
                                                    <input type="checkbox" @bind="item.IsChecked" />
                                                    <span>@item.Item.Name</span>
                                                    <span class="multi-select-hint">@item.Item.Path</span>
                                                </label>
                                            }
                                            @if (!VM.EditDepartmentShares.Any())
                                            {
                                                <span class="empty-hint">Keine Freigaben vorhanden</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            @if (VM.ErrorMessage is not null)
                            {
                                <div class="error-banner" style="margin: 12px 0;">@VM.ErrorMessage</div>
                            }

                            <div class="detail-actions">
                                <button class="btn-primary" @onclick="SaveDepartment" disabled="@VM.IsSaving">
                                    @(VM.IsSaving ? "Speichert…" : "Speichern")
                                </button>
                                <button class="btn-secondary" @onclick="CancelEdit" disabled="@VM.IsSaving">Abbrechen</button>
                            </div>
                        }
                        else
                        {
                            @* ── Department View Mode ── *@
                            <div class="detail-header">
                                <h3>@VM.SelectedDepartment.Name</h3>
                                <span class="detail-subtitle">Abteilung</span>
                            </div>

                            <div class="detail-field-grid">
                                @* Parent / Hierarchy *@
                                <div class="detail-field">
                                    <span class="detail-field-label">Erbt von</span>
                                    @if (VM.SelectedDepartment.ParentDepartmentId.HasValue)
                                    {
                                        
                                        var parentDept = VM.Departments
                                            .FirstOrDefault(d => d.Id == VM.SelectedDepartment.ParentDepartmentId);
                                        
                                        <span class="detail-field-value">
                                            @(parentDept?.Name ?? VM.SelectedDepartment.ParentDepartmentId.ToString())
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="detail-field-value detail-field-value--empty">
                                            Keine (Oberste Ebene)
                                        </span>
                                    }
                                </div>

                                @* Members *@
                                <div class="detail-field">
                                    <span class="detail-field-label">Mitglieder</span>
                                    <span class="detail-field-value">
                                        @if (VM.DepartmentMembers.Any())
                                        {
                                            @string.Join(", ", VM.DepartmentMembers.Select(u => u.Name).Take(8))
                                            @if (VM.DepartmentMembers.Count > 8)
                                            {
                                                <span class="truncated-hint"> +@(VM.DepartmentMembers.Count - 8) weitere</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="detail-field-value--empty">Keine Mitglieder</span>
                                        }
                                    </span>
                                </div>

                                <div class="detail-field">
                                    <span class="detail-field-label">Anzahl Mitglieder</span>
                                    <span class="detail-field-value">@VM.DepartmentMembers.Count</span>
                                </div>

                                @* Shares *@
                                <div class="detail-field">
                                    <span class="detail-field-label">Zugeordnete Freigaben</span>
                                    <span class="detail-field-value">
                                        @if (VM.DepartmentShares.Any())
                                        {
                                            @string.Join(", ", VM.DepartmentShares.Select(s => s.Name).Take(5))
                                            @if (VM.DepartmentShares.Count > 5)
                                            {
                                                <span class="truncated-hint"> +@(VM.DepartmentShares.Count - 5) weitere</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="detail-field-value--empty">Keine Freigaben zugeordnet</span>
                                        }
                                    </span>
                                </div>

                                @* Default File Permission *@
                                <div class="detail-field">
                                    <span class="detail-field-label">Standard-Dateiberechtigung</span>
                                    <span class="detail-field-value">
                                        @if (VM.DepartmentPermInfo is not null)
                                        {
                                            @if (VM.DepartmentPermInfo.HasNoDefault)
                                            {
                                                <span class="detail-field-value--empty">Keine Default-Berechtigung</span>
                                            }
                                            else if (VM.DepartmentPermInfo.IsOwnPermission)
                                            {
                                                <div class="permission-tags">
                                                    @foreach (var flag in DepartmentPermissionDisplay.AllFlags)
                                                    {
                                                        if (DepartmentPermissionDisplay.HasFlag(
                                                            VM.DepartmentPermInfo.EffectivePermission, flag.Flag))
                                                        {
                                                            <span class="permission-tag">@flag.Label</span>
                                                        }
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div>
                                                    <div class="permission-tags">
                                                        @foreach (var flag in DepartmentPermissionDisplay.AllFlags)
                                                        {
                                                            if (DepartmentPermissionDisplay.HasFlag(
                                                                VM.DepartmentPermInfo.EffectivePermission, flag.Flag))
                                                            {
                                                                <span class="permission-tag">@flag.Label</span>
                                                            }
                                                        }
                                                    </div>
                                                    <span class="inherited-hint">
                                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                                                             stroke="var(--text-tertiary)" stroke-width="1.5"
                                                             style="vertical-align: -1px; margin-right: 2px;">
                                                            <path d="M9 18l6-6-6-6" />
                                                        </svg>
                                                        Geerbt von: @VM.DepartmentPermInfo.InheritedFromDepartmentName
                                                    </span>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="detail-field-value--empty">Wird geladen…</span>
                                        }
                                    </span>
                                </div>

                                <div class="detail-field">
                                    <span class="detail-field-label">ID</span>
                                    <span class="detail-field-value" style="font-size: 11px; font-family: monospace;">
                                        @VM.SelectedDepartment.Id
                                    </span>
                                </div>
                            </div>

                            <div class="detail-actions">
                                @if (VM.IsGlobalAdmin || VM.CanManageDepartments)
                                {
                                    <button class="btn-secondary" @onclick="EditDepartment">Bearbeiten</button>
                                }
                                @if (VM.IsGlobalAdmin)
                                {
                                    @if (VM.IsConfirmingDelete)
                                    {
                                        <div class="confirm-delete">
                                            <p>Abteilung wirklich löschen?</p>
                                            <div style="display: flex; gap: 8px;">
                                                <button class="btn-danger-outline" @onclick="ConfirmDeleteDepartment"
                                                        disabled="@VM.IsSaving">
                                                    @(VM.IsSaving ? "Löscht…" : "Ja, löschen")
                                                </button>
                                                <button class="btn-secondary"
                                                        @onclick="() => VM.IsConfirmingDelete = false">
                                                    Abbrechen
                                                </button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn-danger-outline"
                                                @onclick="() => VM.RequestDeleteDepartment()">
                                            Abteilung löschen
                                        </button>
                                    }
                                }
                            </div>
                        }
                    }

                </div>
            }

        </div>
    }
}

@code {
    private bool groupsOpen;
    private bool rolesOpen;
    private bool membersOpen;
    private bool sharesOpen;
    private bool groupsDeptOpen;

    // ── Binding helpers for select elements (Guid <-> string) ──

    private string SelectedPrincipalIdString
    {
        get => VM.NewAssignmentPrincipalId?.ToString() ?? "";
        set => VM.NewAssignmentPrincipalId = Guid.TryParse(value, out var id) ? id : null;
    }

    private string SelectedScopeTypeString
    {
        get => VM.NewAssignmentScopeType.ToString();
        set
        {
            VM.NewAssignmentScopeType = Enum.TryParse<ScopeType>(value, out var st) ? st : ScopeType.Global;
            VM.NewAssignmentScopeId = null;
        }
    }

    private string SelectedScopeIdString
    {
        get => VM.NewAssignmentScopeId?.ToString() ?? "";
        set => VM.NewAssignmentScopeId = Guid.TryParse(value, out var id) ? id : null;
    }

    private string ShareScopeIdInput
    {
        get => VM.NewAssignmentScopeId?.ToString() ?? "";
        set => VM.NewAssignmentScopeId = Guid.TryParse(value, out var id) ? id : null;
    }

    private string CreateUserDepartmentIdString
    {
        get => VM.CreateUserDepartmentId?.ToString() ?? "";
        set => VM.CreateUserDepartmentId = Guid.TryParse(value, out var id) ? id : null;
    }

    // ── Lifecycle ──

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await VM.LoadAsync();
            StateHasChanged();
        }
    }

    private string EditDepartmentParentIdString
    {
        get => VM.EditDepartmentParentId?.ToString() ?? "";
        set => VM.EditDepartmentParentId = Guid.TryParse(value, out var id) ? id : (Guid?)null;
    }

    // ── Tab switching ──

    private async Task SwitchTab(AdminTab tab)
    {
        CloseDropdowns();
        await VM.SwitchTabAsync(tab);
        StateHasChanged();
    }

    // ── Selection ──

    private async Task SelectUser(User user) { CloseDropdowns(); await VM.SelectUserAsync(user); StateHasChanged(); }
    private async Task SelectGroup(Group group) { CloseDropdowns(); await VM.SelectGroupAsync(group); StateHasChanged(); }
    private async Task SelectRole(Role role) { CloseDropdowns(); await VM.SelectRoleAsync(role); StateHasChanged(); }
    private async Task SelectDepartment(Department dept) { CloseDropdowns(); await VM.SelectDepartmentAsync(dept); StateHasChanged(); }

    // ── Edit ──

    private async Task EditUser() { CloseDropdowns(); await VM.StartEditUserAsync(); StateHasChanged(); }
    private async Task EditGroup() { CloseDropdowns(); await VM.StartEditGroupAsync(); StateHasChanged(); }
    private async Task EditRole() { CloseDropdowns(); await VM.StartEditRoleAsync(); StateHasChanged(); }
    private async Task EditDepartment() { CloseDropdowns(); await VM.StartEditDepartmentAsync(); StateHasChanged(); }

    
    // ── Save ──

    private async Task SaveUser() { CloseDropdowns(); await VM.SaveUserAsync(); StateHasChanged(); }
    private async Task SaveGroup() { CloseDropdowns(); await VM.SaveGroupAsync(); StateHasChanged(); }
    private async Task SaveRole() { CloseDropdowns(); await VM.SaveRoleAsync(); StateHasChanged(); }
    private async Task SaveDepartment() { CloseDropdowns(); await VM.SaveDepartmentAsync(); StateHasChanged(); }

    // ── Create ──

    private async Task CreateUser() { await VM.CreateUserAsync(); StateHasChanged(); }
    private async Task CreateGroup() { await VM.CreateGroupAsync(); StateHasChanged(); }
    private async Task CreateRole() { await VM.CreateRoleAsync(); StateHasChanged(); }
    private async Task CreateDepartment() { await VM.CreateDepartmentAsync(); StateHasChanged(); }

    // ── Delete ──

    private async Task ConfirmDeleteUser() { await VM.ConfirmDeleteUserAsync(); StateHasChanged(); }
    private async Task ConfirmDeleteGroup() { await VM.ConfirmDeleteGroupAsync(); StateHasChanged(); }
    private async Task ConfirmDeleteRole() { await VM.ConfirmDeleteRoleAsync(); StateHasChanged(); }
    private async Task ConfirmDeleteDepartment() { await VM.ConfirmDeleteDepartmentAsync(); StateHasChanged(); }

    // ── Cancel ──

    private void CancelEdit() { CloseDropdowns(); VM.CancelEdit(); StateHasChanged(); }

    // ── Scoped Assignments ──

    private async Task StartAddAssignment()
    {
        VM.StartAddAssignment();
        await VM.LoadAssignmentFormDataAsync();
        StateHasChanged();
    }

    private async Task CreateAssignment()
    {
        await VM.CreateAssignmentAsync();
        StateHasChanged();
    }

    private async Task DeleteAssignment(Guid id)
    {
        await VM.DeleteAssignmentAsync(id);
        StateHasChanged();
    }

    // ── Helpers ──

    private void CloseDropdowns()
    {
        groupsOpen = false;
        rolesOpen = false;
        membersOpen = false;
        sharesOpen = false;
        groupsDeptOpen = false;
    }

    private async Task HandleCreateGroupKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CreateGroup();
    }

    private async Task HandleCreateRoleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CreateRole();
    }

    private async Task HandleCreateDepartmentKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CreateDepartment();
    }

    private static string FormatScopeType(ScopeType type) => type switch
    {
        ScopeType.Global => "Global",
        ScopeType.Department => "Abteilung",
        ScopeType.Share => "Freigabe",
        _ => type.ToString()
    };
}
