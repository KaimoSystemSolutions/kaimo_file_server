@using Kaimo_File_Server.Web.Components.Pages.Acl
@using Kaimo_File_Server.Web.DynamicHelpers
@using Kaimo_File_Server.Web.Helpers

@page "/files/{ShareName}/{*SubPath}"
@page "/files/{ShareName}"
@implements IDisposable
@inject FileBrowserViewModel VM
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject ToastService Toast
@inject FileUploadCoordinator UploadCoordinator
@inject AssetProvider Assets

<PageTitle>@(VM.CurrentShare?.Name ?? "Dateien") – Kaimo Files</PageTitle>

<div class="page-header">
    <div class="breadcrumb-bar">
        <a class="breadcrumb-link" href="/files">Shares</a>
        <span class="breadcrumb-sep">/</span>
        <a class="breadcrumb-link" href="/files/@ShareName">@ShareName</a>
        @foreach (var (name, fullPath) in VM.Breadcrumbs)
        {
            <span class="breadcrumb-sep">/</span>
            <a class="breadcrumb-link" href="/files/@ShareName/@fullPath">@name</a>
        }
    </div>
    <div style="display: flex; gap: 0.5rem; align-items: center;">
        <button class="btn-icon" title="Neuen Ordner erstellen"
                @onclick="ShowCreateFolderDialog"
                @onkeydown="OnCreateFolderKeyDown">
            @Assets.SVG("folder.svg", new SvgOptions())
        </button>
        @if (_isAdmin)
        {
            <button class="btn-icon" title="Berechtigungen verwalten"
                    @onclick="ToggleAclPanel">
                
                @Assets.SVG("acl_panel.svg", new SvgOptions(Color: _showAclPanel ? "var(--accent)" : "currentColor"))
            </button>
            var rootCount = GetAclCount(_aclPath);
            @if (rootCount > 0)
            {
                <span class="acl-badge">@rootCount</span>
            }
        }
    </div>
</div>

@* -- Toolbar für selektierte Einträge -- *@
<div class="selection-toolbar @(_selectedItems.Count == 0 ? "selection-toolbar--inactive" : "")">
    <div class="toolbar-left">
        <span class="toolbar-count">
            @(_selectedItems.Count == 0
                ? "Keine Auswahl"
                : $"{_selectedItems.Count} ausgewählt")
        </span>
    </div>
    <div class="toolbar-actions">
        <button class="toolbar-btn" title="Öffnen"
                disabled="@(!CanOpenSelection)" @onclick="OpenSelected">
            
            @Assets.SVG("arrow_right.svg", new SvgOptions(Width: 16, Height: 16))
            <span>Öffnen</span>
        </button>
        <button class="toolbar-btn" title="Umbenennen"
                disabled="@(!CanRenameSelection)" @onclick="RenameSelected">
            @Assets.SVG("edit.svg", new SvgOptions(Width: 16, Height: 16))
            <span>Umbenennen</span>
        </button>
        <button class="toolbar-btn toolbar-btn--danger" title="Löschen"
                disabled="@(!CanDeleteSelection)" @onclick="DeleteSelected">
            
            @Assets.SVG("trash.svg", new SvgOptions(Width: 16, Height: 16))
            <span>Löschen</span>
        </button>
        <button class="toolbar-btn" title="Berechtigungen"
                disabled="@(!CanAclSelection)" @onclick="AclSelected">
            
            @Assets.SVG("shield.svg", new SvgOptions(Width: 16, Height: 16, Style: "vertical-align: -2px; margin-right: 6px;"))
            <span>Berechtigungen</span>
        </button>
    </div>
</div>

@* -- Dialog: Neuen Ordner erstellen -- *@
@if (_showCreateFolder)
{
    <div class="modal-backdrop" @onkeydown="OnCreateFolderKeyDown" tabindex="0">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <h3 class="modal-title">Neuen Ordner erstellen</h3>
            <input class="modal-input" type="text" placeholder="Ordnername…"
                   @bind="_newFolderName" @bind:event="oninput"
                   @onkeydown="OnCreateFolderKeyDown" />
            @if (_createFolderError is not null)
            {
                <div class="modal-error">@_createFolderError</div>
            }
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="CancelCreateFolder">Abbrechen</button>
                <button class="btn btn-primary" @onclick="ConfirmCreateFolder"
                        disabled="@string.IsNullOrWhiteSpace(_newFolderName)">
                    Erstellen
                </button>
            </div>
        </div>
    </div>
}

@* -- Dialog: Löschen bestätigen -- *@
@if (_showDeleteConfirm)
{
    <div class="modal-backdrop" @onclick="CancelDelete">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <h3 class="modal-title">Löschen bestätigen</h3>
            @if (_deleteTargets.Count == 1)
            {
                <p class="modal-text">
                    Möchten Sie <strong>„@_deleteTargets[0].Name"</strong> wirklich löschen?
                    @if (_deleteTargets[0].IsDirectory)
                    {
                        <br /><span class="modal-warning">Alle Inhalte des Ordners werden ebenfalls gelöscht.</span>
                    }
                </p>
            }
            else
            {
                <p class="modal-text">
                    Möchten Sie <strong>@_deleteTargets.Count Elemente</strong> wirklich löschen?
                    @if (_deleteTargets.Any(t => t.IsDirectory))
                    {
                        <br /><span class="modal-warning">Alle Inhalte enthaltener Ordner werden ebenfalls gelöscht.</span>
                    }
                </p>
            }
            @if (_deleteError is not null)
            {
                <div class="modal-error">@_deleteError</div>
            }
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="CancelDelete">Abbrechen</button>
                <button class="btn btn-danger" @onclick="ConfirmDelete">Löschen</button>
            </div>
        </div>
    </div>
}


@if (VM.IsLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
    </div>
}
else if (VM.ErrorMessage is not null)
{
    <div class="error-banner">@VM.ErrorMessage</div>
}
else
{
    @* -- ACL Panel (Slide-Down) Root -- *@
    @if (_showAclPanel && _isAdmin)
    {
        <div class="acl-panel">
            <div class="acl-panel-header">
                <h3>
                    @Assets.SVG("shield.svg", new SvgOptions(Width: 12, Height: 12, StrokeWidth: 2, CssClass: "acl-indicator-icon"))
                </h3>
                <span class="detail-subtitle">@(_aclPath == "" ? "(Share-Root)" : _aclPath)</span>
            </div>
            <AclEditor @key="@($"acl-{VM.CurrentShare?.Id}-{_aclPath}-{_showAclPanel}")"
                       Path="@_aclPath"
                       ShareId="@VM.CurrentShare.Id"
                       IsDirectory="true"
                       OnChanged="LoadAclCounts" />
        </div>
    }

    @* ══════════════════════════════════════════════════
       Resizable Column Table – 5 Spalten (ohne Actions)
       Name-Spalte (1fr) nimmt den Rest.
       ══════════════════════════════════════════════════ *@
    <div class="file-table-wrap" @ref="_fileDropZone"
         style="grid-template-columns: @GridColumns">

        @* -- Header (sortierbar) -- *@
        <div class="file-grid-header">
            <div class="col-name col-sortable" @onclick="@(() => OnHeaderClick("name"))">
                <span class="col-header-text">Name</span>
                @if (_sortColumn == "name")
                {
                    <span class="sort-arrow @(_sortDirection == 1 ? "sort-arrow--desc" : "sort-arrow--asc")"></span>
                }
                <div class="col-resize-handle"
                     @onmousedown="@(e => OnResizeStart(e, 0))"
                     @onmousedown:stopPropagation="true"
                     @onclick:stopPropagation="true"></div>
            </div>
            <div class="col-size col-sortable" @onclick="@(() => OnHeaderClick("size"))">
                <span class="col-header-text">Größe</span>
                @if (_sortColumn == "size")
                {
                    <span class="sort-arrow @(_sortDirection == 1 ? "sort-arrow--desc" : "sort-arrow--asc")"></span>
                }
                <div class="col-resize-handle"
                     @onmousedown="@(e => OnResizeStart(e, 1))"
                     @onmousedown:stopPropagation="true"
                     @onclick:stopPropagation="true"></div>
            </div>
            <div class="col-created col-sortable" @onclick="@(() => OnHeaderClick("created"))">
                <span class="col-header-text">Erstellt</span>
                @if (_sortColumn == "created")
                {
                    <span class="sort-arrow @(_sortDirection == 1 ? "sort-arrow--desc" : "sort-arrow--asc")"></span>
                }
                <div class="col-resize-handle"
                     @onmousedown="@(e => OnResizeStart(e, 2))"
                     @onmousedown:stopPropagation="true"
                     @onclick:stopPropagation="true"></div>
            </div>
            <div class="col-modified col-sortable" @onclick="@(() => OnHeaderClick("modified"))">
                <span class="col-header-text">Geändert</span>
                @if (_sortColumn == "modified")
                {
                    <span class="sort-arrow @(_sortDirection == 1 ? "sort-arrow--desc" : "sort-arrow--asc")"></span>
                }
                <div class="col-resize-handle"
                     @onmousedown="@(e => OnResizeStart(e, 3))"
                     @onmousedown:stopPropagation="true"
                     @onclick:stopPropagation="true"></div>
            </div>
            <div class="col-lastaccess col-sortable" @onclick="@(() => OnHeaderClick("lastaccess"))">
                <span class="col-header-text">Letzter Zugriff</span>
            </div>
        </div>

        @* -- ".." Elternverzeichnis -- *@
        @if (VM.HasParent)
        {
            <div class="file-grid-row file-row-dir" @ondblclick="NavigateUp">
                <div class="col-name">
                    
                    @Assets.SVG("chevron_left.svg", new SvgOptions(Width: 20, Height: 20, Color: "var(--text-tertiary)", CssClass: "file-icon"))
                    <span>..</span>
                </div>
                <div class="col-size"></div>
                <div class="col-created"></div>
                <div class="col-modified"></div>
                <div class="col-lastaccess"></div>
            </div>
        }

        @* -- Ordner -- *@
        @foreach (var dir in SortedDirectories)
        {
            var isSelected = _selectedItems.Contains(dir);
            var dirAclCount = _isAdmin ? GetAclCount(GetDirAclPath(dir)) : 0;

            <div class="file-grid-row file-row-dir @(isSelected ? "file-row--selected" : "")"
                 @onclick="(e) => OnItemClick(e, dir)"
                 @onclick:stopPropagation="true"
                 @ondblclick="() => NavigateTo(dir)"
                 @oncontextmenu="(e) => OnItemContextMenu(e, dir)"
                 @oncontextmenu:preventDefault="true"
                 @oncontextmenu:stopPropagation="true">

                <div class="col-name">
                    @if (dir.Name == ".RECYCLE_BIN")
                    {
                        Assets.SVG("trash.svg", new SvgOptions(Width: 20, Height: 20, CssClass: "file-icon"));
                    }
                    else
                    {
                        
                        @Assets.SVG("folder.svg", new SvgOptions(Width: 20, Height: 20, Color: "var(--folder-stroke)", Fill: "var(--folder-fill)", CssClass: "file-icon"))                    }
                    <span>@dir.Name</span>
                    @if (dirAclCount > 0)
                    {
                        <span class="acl-indicator"
                              title="@dirAclCount Berechtigungsregel@(dirAclCount != 1 ? "n" : "")"
                              @onclick="() => OpenFolderAcl(dir)"
                              @onclick:stopPropagation="true">
                            @Assets.SVG("shield.svg", new SvgOptions(Width: 12, Height: 12, StrokeWidth: 2, CssClass: "acl-indicator-icon"))
                            <span class="acl-indicator-count">@dirAclCount</span>
                        </span>
                    }
                </div>

                <div class="col-size">
                    @{
                        var dirSize = VM.GetDirectorySize(dir);
                    }
                    @if (dirSize.HasValue)
                    {
                        @FormatHelper.FormatFileSize(dirSize.Value)
                    }
                    else
                    {
                        <span class="size-loading">…</span>
                    }
                </div>

                <div class="col-created">@dir.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                <div class="col-modified">@dir.ModifiedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                <div class="col-lastaccess">@(dir.LastAccessedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "–")</div>
            </div>

            @if (_showFolderAcl && _aclFolderPath == GetDirAclPath(dir))
            {
                <div class="file-row-acl-expand-wrap">
                    <div class="file-row-acl-expand">
                        <div class="acl-panel-header" style="padding: 0 0 8px 0;">
                            <span class="detail-subtitle">Berechtigungen für „@dir.Name"</span>
                            <button class="btn-icon btn-icon--small" title="Schließen" @onclick="CloseFolderAcl">
                                @Assets.SVG("close.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                            </button>
                        </div>
                        <AclEditor @key="@($"acl-{VM.CurrentShare?.Id}-{_aclFolderPath}-{_showFolderAcl}")"
                                   Path="@_aclFolderPath" ShareId="@VM.CurrentShare.Id"
                                   IsDirectory="true" OnChanged="LoadAclCounts" />
                    </div>
                </div>
            }
        }

        @* -- Dateien -- *@
        @foreach (var file in SortedFiles)
        {
            var isSelected = _selectedItems.Contains(file);
            var fileAclCount = _isAdmin ? GetAclCount(GetFileAclPath(file)) : 0;

            <div class="file-grid-row @(isSelected ? "file-row--selected" : "")"
                 @onclick="(e) => OnItemClick(e, file)"
                 @onclick:stopPropagation="true"
                 @ondblclick="() => OpenFilePreview(file)"
                 @oncontextmenu="(e) => OnItemContextMenu(e, file)"
                 @oncontextmenu:preventDefault="true"
                 @oncontextmenu:stopPropagation="true">

                <div class="col-name">
                    @Assets.SVG("file.svg", new SvgOptions(Width: 20, Height: 20, Color: "var(--text-tertiary)", CssClass: "file-icon"))
                    <span>@file.Name</span>
                    @if (fileAclCount > 0)
                    {
                        <span class="acl-indicator"
                              title="@fileAclCount Berechtigungsregel@(fileAclCount != 1 ? "n" : "")"
                              @onclick="() => OpenFileAcl(file)"
                              @onclick:stopPropagation="true">
                            @Assets.SVG("shield.svg", new SvgOptions(Width: 12, Height: 12, StrokeWidth: 2, CssClass: "acl-indicator-icon"))
                            <span class="acl-indicator-count">@fileAclCount</span>
                        </span>
                    }
                </div>

                <div class="col-size">@FormatHelper.FormatFileSize(file.Size)</div>
                <div class="col-created">@file.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                <div class="col-modified">@file.ModifiedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                <div class="col-lastaccess">@(file.LastAccessedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "–")</div>
            </div>

            @if (_showFolderAcl && _aclFolderPath == GetFileAclPath(file))
            {
                <div class="file-row-acl-expand-wrap">
                    <div class="file-row-acl-expand">
                        <div class="acl-panel-header" style="padding: 0 0 8px 0;">
                            <span class="detail-subtitle">Berechtigungen für „@file.Name"</span>
                            <button class="btn-icon btn-icon--small" title="Schließen" @onclick="CloseFolderAcl">
                                @Assets.SVG("close.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                            </button>
                        </div>
                        <AclEditor @key="@($"acl-{VM.CurrentShare?.Id}-{_aclFolderPath}-{_showFolderAcl}")"
                                   Path="@_aclFolderPath" ShareId="@VM.CurrentShare.Id"
                                   IsDirectory="false" OnChanged="LoadAclCounts" />
                    </div>
                </div>
            }
        }

        @if (!VM.Items.Any())
        {
            <div class="file-grid-empty">
                <p>Dieser Ordner ist leer.</p>
            </div>
        }
    </div>
}

@* -- Kontextmenü (Rechtsklick) -- *@
@if (_showContextMenu)
{
    <div class="context-menu-backdrop" @onclick="CloseContextMenu" @oncontextmenu="CloseContextMenu"
         @oncontextmenu:preventDefault="true"></div>
    <div class="context-menu" style="top: @(_contextMenuY)px; left: @(_contextMenuX)px;">
        @if (_contextTarget is not null)
        {
            <div class="context-menu-header">@_contextTarget.Name</div>
            @if (_contextTarget.IsDirectory)
            {
                <button class="context-menu-item" @onclick="() => ContextNavigateTo(_contextTarget)">
                    
                    @Assets.SVG("arrow_right.svg", new SvgOptions(Width: 14, Height: 14))
                    Öffnen
                </button>
            }
            <button class="context-menu-item" @onclick="() => ContextRename(_contextTarget)">
                
                @Assets.SVG("edit.svg", new SvgOptions(Width: 14, Height: 14))
                Umbenennen
            </button>
            <button class="context-menu-item context-menu-item--danger" @onclick="() => ContextDelete(_contextTarget)">
                @Assets.SVG("trash.svg", new SvgOptions(Width: 14, Height: 14))
                Löschen
            </button>
            @if (_isAdmin)
            {
                <button class="context-menu-item" @onclick="() => ContextAcl(_contextTarget)">
                    @Assets.SVG("shield.svg", new SvgOptions(Width: 12, Height: 12, StrokeWidth: 2, CssClass: "acl-indicator-icon"))
                    Berechtigungen
                </button>
            }
            <div class="context-menu-separator"></div>
            <div class="context-menu-header">General</div>
            <button class="context-menu-item" @onclick="ContextNewFolder">
                @Assets.SVG("folder.svg", new SvgOptions(Width: 14, Height: 14))
                Neuer Ordner
            </button>
            <button class="context-menu-item" @onclick="ContextRefresh">
                @Assets.SVG("refresh.svg", new SvgOptions(Width: 14, Height: 14))
                Aktualisieren
            </button>
        }
        else
        {
            <button class="context-menu-item" @onclick="ContextNewFolder">
                @Assets.SVG("folder.svg", new SvgOptions(Width: 14, Height: 14))
                Neuer Ordner
            </button>
            <button class="context-menu-item" @onclick="ContextRefresh">
                
                @Assets.SVG("refresh.svg", new SvgOptions(Width: 14, Height: 14))
                Aktualisieren
            </button>
        }
    </div>
}

@* -- Dialog: Umbenennen -- *@
@if (_showRenameDialog)
{
    <div class="modal-backdrop" @onclick="CancelRename">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <h3 class="modal-title">Umbenennen</h3>
            <input class="modal-input" type="text" placeholder="Neuer Name…"
                   @bind="_renameNewName" @bind:event="oninput"
                   @onkeydown="OnRenameKeyDown" />
            @if (_renameError is not null)
            {
                <div class="modal-error">@_renameError</div>
            }
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="CancelRename">Abbrechen</button>
                <button class="btn btn-primary" @onclick="ConfirmRename"
                        disabled="@string.IsNullOrWhiteSpace(_renameNewName)">
                    Umbenennen
                </button>
            </div>
        </div>
    </div>
}

@if (_showFilePreview)
{
    <div class="modal-backdrop" @onclick="CloseFilePreview">
        <div class="preview-dialog" @onclick:stopPropagation="true">
            <div class="preview-header">
                <span class="preview-title">@_previewFileName</span>
                <button class="btn-icon" title="Schließen" @onclick="CloseFilePreview">
                    @Assets.SVG("close.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                </button>
            </div>
            @if (_previewLoading)
            {
                <div class="preview-loading">
                    <div class="preview-spinner"></div>
                    <span class="preview-loading-text">Datei wird geladen…</span>
                </div>
            }
            else if (_previewIsImage)
            {
                <div class="preview-image-container">
                    <img class="preview-image" src="@_previewUrl" alt="@_previewFileName" />
                </div>
            }
            else
            {
                <iframe class="preview-frame" src="@_previewUrl"></iframe>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string ShareName { get; set; } = "";
    [Parameter] public string? SubPath { get; set; }

    // ========== Column Resize (5 Spalten, ohne Actions) ==========

    private Dictionary<string, double> _colWidths = new()
    {
        ["size"] = 90,
        ["created"] = 140,
        ["modified"] = 140,
        ["lastaccess"] = 140
    };

    // Name-Breite: 0 = noch nicht resized → 1fr; > 0 = feste px
    private double _nameWidth = 0;

    private const double ColMinWidth = 50;
    private DotNetObjectReference<FileBrowser>? _dotNetRef;

    /// <summary>Baut den grid-template-columns String (5 Spalten).</summary>
    private string GridColumns =>
        $"{(_nameWidth > 0 ? $"{_nameWidth}px" : "1fr")} " +
        $"{_colWidths["size"]}px " +
        $"{_colWidths["created"]}px " +
        $"{_colWidths["modified"]}px " +
        $"{_colWidths["lastaccess"]}px";

    private async Task OnResizeStart(MouseEventArgs e, int colIndex)
    {
        _dotNetRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("columnResize.start",
            _dotNetRef, colIndex, e.ClientX, ColMinWidth);
    }

    [JSInvokable]
    public void OnResizeEnd(string jsonWidths)
    {
        try
        {
            var widths = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, double>>(jsonWidths);
            if (widths is null) return;

            foreach (var (col, w) in widths)
            {
                if (col == "name")
                {
                    _nameWidth = w >= ColMinWidth ? Math.Round(w) : 0;
                    continue;
                }
                if (_colWidths.ContainsKey(col) && w >= ColMinWidth)
                    _colWidths[col] = Math.Round(w);
            }
        }
        catch { }

        InvokeAsync(StateHasChanged);
    }

    // ========== Column Sorting ==========

    private string? _sortColumn;
    private int _sortDirection; // 0 = default, 1 = descending, 2 = ascending

    private void OnHeaderClick(string column)
    {
        if (_sortColumn == column)
        {
            _sortDirection = (_sortDirection + 1) % 3;
            if (_sortDirection == 0)
                _sortColumn = null;
        }
        else
        {
            _sortColumn = column;
            _sortDirection = 1; // Erst absteigend
        }
    }

    private IEnumerable<FileMetadata> SortedDirectories => ApplySort(VM.Directories);
    private IEnumerable<FileMetadata> SortedFiles => ApplySort(VM.Files);

    private IEnumerable<FileMetadata> ApplySort(IEnumerable<FileMetadata> items)
    {
        if (_sortColumn is null || _sortDirection == 0)
            return items; // Default: alphabetisch nach Name (vom VM)

        Func<FileMetadata, object> keySelector = _sortColumn switch
        {
            "name" => f => f.Name.ToLowerInvariant(),
            "size" => f => f.IsDirectory ? (VM.GetDirectorySize(f) ?? 0L) : f.Size,
            "created" => f => f.CreatedAt,
            "modified" => f => f.ModifiedAt,
            "lastaccess" => f => f.LastAccessedAt ?? DateTime.MinValue,
            _ => f => f.Name.ToLowerInvariant()
        };

        return _sortDirection == 1
            ? items.OrderByDescending(keySelector)
            : items.OrderBy(keySelector);
    }

    // ========== File Uploading (UploadCoordinator + ProgressStream) ==========

    protected override void OnInitialized()
    {
        UploadCoordinator.OnFilesSelected += OnFileUploaded;
    }

    [JSInvokable]
    public void OnFilesDropped(int fileCount)
    {
        StateHasChanged();
    }

    private async Task OnFileUploaded(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles())
        {
            var toastId = Toast.Show($"Uploading \"{file.Name}\"…", ToastType.Progress);

            Stream stream;
            try
            {
                stream = file.OpenReadStream(maxAllowedSize: VM.GetMaxUploadSizeBytes());
            }
            catch (IOException)
            {
                Toast.Update(toastId, $"\"{file.Name}\" ist zu groß (max. 1.1 GB).", type: ToastType.Error);
                continue;
            }

            try
            {
                await using (stream)
                {
                    var progressStream = new ProgressStream(stream, file.Size, (bytesRead, total) =>
                    {
                        var percent = (int)(bytesRead * 100 / total);
                        InvokeAsync(() =>
                        {
                            Toast.Update(toastId, progress: percent);
                            StateHasChanged();
                        });
                    });

                    var result = await VM.UploadFileAsync(file.Name, progressStream);

                    if (result.Success)
                        Toast.Update(toastId, $"\"{file.Name}\" hochgeladen.", type: ToastType.Success);
                    else
                        Toast.Update(toastId, result.Error ?? "Upload fehlgeschlagen.", type: ToastType.Error);
                }
            }
            catch (JSException)
            {
                Toast.Update(toastId, $"\"{file.Name}\" abgebrochen — Seite verlassen.", type: ToastType.Error);
                break; // remaining files are also dead, no point continuing
            }
        }

        await VM.LoadShareAsync(VM.CurrentShare!.Name, VM.CurrentPath);
    }

    // ========== State ==========

    private Dictionary<string, int> _aclCounts = new();
    private bool _isAdmin;
    private bool _showAclPanel;
    private string _aclPath = "";
    private bool _showFolderAcl;
    private string _aclFolderPath = "";
    private bool _showCreateFolder;
    private string _newFolderName = "";
    private string? _createFolderError;
    private bool _showDeleteConfirm;
    private List<FileMetadata> _deleteTargets = new();
    private string? _deleteError;
    private HashSet<FileMetadata> _selectedItems = new();
    private bool _showContextMenu;
    private double _contextMenuX;
    private double _contextMenuY;
    private FileMetadata? _contextTarget;
    private bool _showRenameDialog;
    private FileMetadata? _renameTarget;
    private string _renameNewName = "";
    private string? _renameError;

    private bool _showFilePreview;
    private string _previewUrl = "";
    private string _previewFileName = "";

    private ElementReference _fileDropZone;
    private bool _jsInitialized = false;

    // ========== Toolbar Computed ==========

    private bool CanOpenSelection => _selectedItems.Count == 1;
    private bool CanRenameSelection => _selectedItems.Count == 1;
    private bool CanDeleteSelection => _selectedItems.Count > 0;
    private bool CanAclSelection => _isAdmin && _selectedItems.Count == 1;

    // ========== Selektion ==========

    private void OnItemClick(MouseEventArgs e, FileMetadata item)
    {
        if (e.CtrlKey || e.MetaKey)
        {
            if (!_selectedItems.Remove(item))
                _selectedItems.Add(item);
        }
        else if (e.ShiftKey && _selectedItems.Count > 0)
        {
            var allItems = VM.Directories.Cast<FileMetadata>().Concat(VM.Files).ToList();
            var lastSelected = _selectedItems.Last();
            var idxStart = allItems.IndexOf(lastSelected);
            var idxEnd = allItems.IndexOf(item);
            if (idxStart >= 0 && idxEnd >= 0)
            {
                var from = Math.Min(idxStart, idxEnd);
                var to = Math.Max(idxStart, idxEnd);
                for (int i = from; i <= to; i++)
                    _selectedItems.Add(allItems[i]);
            }
        }
        else
        {
            if (_selectedItems.Count == 1 && _selectedItems.First() == item)
                _selectedItems.Clear();
            else
            {
                _selectedItems.Clear();
                _selectedItems.Add(item);
            }
        }
    }

    private void OnListBackgroundClick(MouseEventArgs e) => _selectedItems.Clear();

    // ========== Toolbar Aktionen ==========

    private async Task OpenSelected()
    {
        if (_selectedItems.Count != 1) return;
        var item = _selectedItems.First();

        if (item.IsDirectory)
            NavigateTo(item);
        else
            await OpenFilePreview(item);
    }

    private void RenameSelected()
    {
        if (_selectedItems.Count != 1) return;
        var item = _selectedItems.First();
        _renameTarget = item;
        _renameNewName = item.Name;
        _renameError = null;
        _showRenameDialog = true;
    }

    private void DeleteSelected()
    {
        if (_selectedItems.Count == 0) return;
        _deleteTargets = _selectedItems.ToList();
        _deleteError = null;
        _showDeleteConfirm = true;
    }

    private void AclSelected()
    {
        if (_selectedItems.Count != 1) return;
        var item = _selectedItems.First();
        if (item.IsDirectory) OpenFolderAcl(item); else OpenFileAcl(item);
    }

    // ========== Lifecycle ==========

    protected override async Task OnParametersSetAsync()
    {
        _showFolderAcl = false;
        _aclFolderPath = "";
        _selectedItems.Clear();
        _sortColumn = null;
        _sortDirection = 0;
        CloseContextMenu();

        await VM.LoadShareAsync(ShareName, SubPath ?? "");
        UpdateAclPath();
        await LoadAclCounts();
        VM.OnStateChanged -= OnVmStateChanged;
        VM.OnStateChanged += OnVmStateChanged;
    }

    private void OnVmStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        VM.OnStateChanged -= OnVmStateChanged;
        _dotNetRef?.Dispose();
        UploadCoordinator.OnFilesSelected -= OnFileUploaded;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            _isAdmin = state.User.IsInRole("Administrator")
                    || state.User.IsInRole("ShareManager");

            StateHasChanged();
        }

        if (!_jsInitialized && _fileDropZone.Id is not null)
        {
            _jsInitialized = true;
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initFileUpload", _fileDropZone, _dotNetRef);
        }
    }

    private void UpdateAclPath() => _aclPath = VM.CurrentPath ?? "";

    private void ToggleAclPanel()
    {
        _showAclPanel = !_showAclPanel;
        _showFolderAcl = false;
    }

    // ========== Ordner erstellen ==========

    private void ShowCreateFolderDialog()
    {
        _newFolderName = "";
        _createFolderError = null;
        _showCreateFolder = true;
    }

    private void CancelCreateFolder() => _showCreateFolder = false;

    private async Task OnCreateFolderKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_newFolderName))
            await ConfirmCreateFolder();
        else if (e.Key == "Escape")
            CancelCreateFolder();
    }

    private async Task ConfirmCreateFolder()
    {
        if (string.IsNullOrWhiteSpace(_newFolderName)) return;
        var result = await VM.CreateFolderAsync(_newFolderName.Trim());
        if (result.Success)
        {
            _showCreateFolder = false;
            await VM.LoadShareAsync(ShareName, SubPath ?? "");
        }
        else
            _createFolderError = result.Error;
    }

    // ========== Löschen ==========

    private void RequestDelete(FileMetadata item)
    {
        _deleteTargets = new List<FileMetadata> { item };
        _deleteError = null;
        _showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        _showDeleteConfirm = false;
        _deleteTargets.Clear();
    }

    private async Task ConfirmDelete()
    {
        if (!_deleteTargets.Any()) return;
        foreach (var target in _deleteTargets.ToList())
        {
            var result = await VM.DeleteAsync(target);
            if (!result.Success) { _deleteError = result.Error; return; }
        }
        _showDeleteConfirm = false;
        _deleteTargets.Clear();
        _selectedItems.Clear();
        await VM.LoadShareAsync(ShareName, SubPath ?? "");
    }

    // ========== Kontextmenü ==========

    private void OnItemContextMenu(MouseEventArgs e, FileMetadata item)
    {
        if (!_selectedItems.Contains(item))
        {
            _selectedItems.Clear();
            _selectedItems.Add(item);
        }
        _contextTarget = item;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _showContextMenu = true;
    }

    private void OnBackgroundContextMenu(MouseEventArgs e)
    {
        _contextTarget = null;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _showContextMenu = true;
    }

    private void CloseContextMenu()
    {
        _showContextMenu = false;
        _contextTarget = null;
    }

    private void ContextNavigateTo(FileMetadata dir) { CloseContextMenu(); NavigateTo(dir); }
    private void ContextDelete(FileMetadata item) { CloseContextMenu(); RequestDelete(item); }

    private void ContextRename(FileMetadata item)
    {
        CloseContextMenu();
        _renameTarget = item;
        _renameNewName = item.Name;
        _renameError = null;
        _showRenameDialog = true;
    }

    private void ContextAcl(FileMetadata item)
    {
        CloseContextMenu();
        if (item.IsDirectory) OpenFolderAcl(item); else OpenFileAcl(item);
    }

    private void ContextNewFolder() { CloseContextMenu(); ShowCreateFolderDialog(); }

    private async Task ContextRefresh()
    {
        _selectedItems.Clear();
        CloseContextMenu();
        await VM.LoadShareAsync(ShareName, SubPath ?? "");
    }

    // ========== Umbenennen ==========

    private void CancelRename()
    {
        _showRenameDialog = false;
        _renameTarget = null;
    }

    private async Task OnRenameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_renameNewName))
            await ConfirmRename();
        else if (e.Key == "Escape")
            CancelRename();
    }

    private async Task ConfirmRename()
    {
        if (_renameTarget is null || string.IsNullOrWhiteSpace(_renameNewName)) return;
        var result = await VM.RenameAsync(_renameTarget, _renameNewName.Trim());
        if (result.Success)
        {
            _showRenameDialog = false;
            _renameTarget = null;
            _selectedItems.Clear();
            await VM.LoadShareAsync(ShareName, SubPath ?? "");
            await LoadAclCounts();
        }
        else
            _renameError = result.Error;
    }

    // ========== ACL Helpers ==========

    private int GetAclCount(string path) => VM.GetAclCount(path);
    private async Task LoadAclCounts() => await VM.LoadAclCountsAsync();

    private string GetDirAclPath(FileMetadata dir)
    {
        var relativePath = dir.Path;
        if (VM.CurrentShare is not null && relativePath.StartsWith(VM.CurrentShare.Path))
            relativePath = relativePath[VM.CurrentShare.Path.Length..].TrimStart('/');
        return relativePath;
    }

    private string GetFileAclPath(FileMetadata file)
    {
        var relativePath = file.Path;
        if (VM.CurrentShare is not null && relativePath.StartsWith(VM.CurrentShare.Path))
            relativePath = relativePath[VM.CurrentShare.Path.Length..].TrimStart('/');
        return relativePath;
    }

    private void OpenFolderAcl(FileMetadata dir)
    {
        var path = GetDirAclPath(dir);
        if (_showFolderAcl && _aclFolderPath == path) { _showFolderAcl = false; _aclFolderPath = ""; }
        else { _showFolderAcl = true; _aclFolderPath = path; }
    }

    private void OpenFileAcl(FileMetadata file)
    {
        var path = GetFileAclPath(file);
        if (_showFolderAcl && _aclFolderPath == path) { _showFolderAcl = false; _aclFolderPath = ""; }
        else { _showFolderAcl = true; _aclFolderPath = path; }
    }

    private void CloseFolderAcl() { _showFolderAcl = false; _aclFolderPath = ""; }

    // ========== Navigation ==========

    private void NavigateTo(FileMetadata dir)
    {
        var relativePath = dir.Path;
        if (VM.CurrentShare is not null && relativePath.StartsWith(VM.CurrentShare.Path))
            relativePath = relativePath[VM.CurrentShare.Path.Length..].TrimStart('/');
        Nav.NavigateTo($"/files/{ShareName}/{relativePath}");
    }

    private bool _previewIsImage;
    private bool _previewLoading;

    private async Task OpenFilePreview(FileMetadata file)
    {
        _previewFileName = file.Name;
        _previewIsImage = false;
        _previewUrl = "";
        _previewLoading = true;
        _showFilePreview = true;
        StateHasChanged();

        var result = await VM.ReadFileForPreviewAsync(file);
        if (result is null)
        {
            _showFilePreview = false;
            _previewLoading = false;
            return;
        }

        var (data, contentType) = result.Value;

        _previewUrl = await JS.InvokeAsync<string>(
            "filePreview.showBlob", data, contentType);

        _previewIsImage = contentType.StartsWith("image/");
        _previewLoading = false;
    }

    private async Task CloseFilePreview()
    {
        if (!string.IsNullOrEmpty(_previewUrl))
            await JS.InvokeVoidAsync("filePreview.revokeBlob", _previewUrl);

        _showFilePreview = false;
        _previewUrl = "";
    }

    private void NavigateUp()
    {
        if (string.IsNullOrEmpty(VM.ParentPath))
            Nav.NavigateTo($"/files/{ShareName}");
        else
            Nav.NavigateTo($"/files/{ShareName}/{VM.ParentPath}");
    }
}
