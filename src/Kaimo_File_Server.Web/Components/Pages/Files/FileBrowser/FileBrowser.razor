@using System.Collections
@using System.Diagnostics
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Web.Components.Pages.Acl
@using Kaimo_File_Server.Web.Components.Pages.Files.FileBrowser.components
@using Kaimo_File_Server.Web.DynamicHelpers
@using Kaimo_File_Server.Web.Helpers

@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ToastService Toast
@inject JobService Jobs
@inject FileUploadCoordinator UploadCoordinator
@inject FileSelectionCoordinator FileSelectionCoordinator
@inherits AppComponentBase
@inject CloudToLocalTransferService CloudTransfer
@inject CrossShareTransferService CrossShareTransfer
@inject FileBrowserClipboardService BrowserClipboard

<PageTitle>@(VM.CurrentBrowserShare?.Name ?? Resources.Web_Files) - Kaimo Files</PageTitle>

<div class="page-header file-page-header">
    <div class="breadcrumb-bar">
        <a class="breadcrumb-link" href="@OverviewRoute">@Resources.Web_Breadcrumb_Shares</a>
        <span class="breadcrumb-sep">/</span>
        <a class="breadcrumb-link" href="@CurrentShareRoute">@CurrentShareDisplayName</a>
        @foreach (var (name, fullPath) in VM.Breadcrumbs)
        {
            <span class="breadcrumb-sep">/</span>
            <a class="breadcrumb-link" href="@($"{CurrentShareRoute}/{fullPath}")">@name</a>
        }
    </div>
    <div class="file-page-actions">
        @if (VM.Capabilities.CanCreateDirectory)
        {
            <button class="btn-secondary page-command" title="@Resources.Web_CreateFolder_Title"
                    @onclick="ShowCreateFolderDialog"
                    @onkeydown="OnCreateFolderKeyDown"
                    disabled="@(VM.IsLoading || VM.ErrorMessage is not null)">
                @Assets.SVG("folder.svg", new SvgOptions(Width: 16, Height: 16, Color: "var(--folder-stroke)", Fill: "var(--folder-fill)"))
                <span>@Resources.Web_CreateFolder_Title</span>
            </button>
        }
        @if (CanManageAcls())
        {
            <button class="btn-secondary page-command @(_showAclPanel ? "page-command--active" : "")" title="@Resources.Web_ManagePermissions"
                    @onclick="ToggleAclPanel">

                @Assets.SVG("acl_panel.svg", new SvgOptions(Color: _showAclPanel ? "var(--accent)" : "currentColor"))
                <span>@Resources.Web_ManagePermissions</span>
            </button>
            var rootCount = GetAclCount(_aclPath);
            @if (rootCount > 0)
            {
                <span class="acl-badge">@rootCount</span>
            }
        }
    </div>
</div>

@* -- Toolbar for selected items -- *@
<div class="selection-toolbar @(_selectedItems.Count == 0 ? "selection-toolbar--inactive" : "")">
    <div class="toolbar-left">
        <span class="toolbar-count">
            @(_selectedItems.Count == 0
                ? Resources.Web_Selection_None
                : string.Format(Resources.Web_Selection_Count, _selectedItems.Count))
        </span>
    </div>
    <div class="toolbar-actions">
        <button class="toolbar-btn" title="@Resources.Web_Action_Open"
                disabled="@(!CanOpenSelection)" @onclick="OpenSelected">

            @Assets.SVG("arrow_right.svg", new SvgOptions(Width: 16, Height: 16))
            <span>@Resources.Web_Action_Open</span>
        </button>
        @if (VM.Capabilities.CanCopy)
        {
            <button class="toolbar-btn" title="@T("Web_Transfer_Copy")"
                    disabled="@(_selectedItems.Count == 0)" @onclick="() => PutIntoClipboard(false)">
                @Assets.SVG("download.svg", new SvgOptions(Width: 16, Height: 16))
                <span>@T("Web_Transfer_Copy")</span>
            </button>
        }
        @if (VM.Capabilities.CanCut)
        {
            <button class="toolbar-btn" title="@T("Web_Transfer_Cut")"
                    disabled="@(_selectedItems.Count == 0)" @onclick="() => PutIntoClipboard(true)">
                @Assets.SVG("edit.svg", new SvgOptions(Width: 16, Height: 16))
                <span>@T("Web_Transfer_Cut")</span>
            </button>
        }
        @if (VM.Capabilities.CanCopy)
        {
            <button class="toolbar-btn" title="@T("Web_Transfer_Paste")"
                    disabled="@(!CanPasteClipboard)" @onclick="PasteClipboard">
                @Assets.SVG("arrow_right.svg", new SvgOptions(Width: 16, Height: 16))
                <span>@T("Web_Transfer_Paste")</span>
            </button>
        }
        @if (VM.Capabilities.CanRename)
        {
            <button class="toolbar-btn" title="@Resources.Web_Action_Rename"
                    disabled="@(!CanRenameSelection)" @onclick="RenameSelected">
                @Assets.SVG("edit.svg", new SvgOptions(Width: 16, Height: 16))
                <span>@Resources.Web_Action_Rename</span>
            </button>
        }
        @if (VM.Capabilities.CanDelete)
        {
            <button class="toolbar-btn toolbar-btn--danger" title="@Resources.Web_Action_Delete"
                    disabled="@(!CanDeleteSelection)" @onclick="DeleteSelected">
                @Assets.SVG("trash.svg", new SvgOptions(Width: 16, Height: 16))
                <span>@Resources.Web_Action_Delete</span>
            </button>
        }
        @if (VM.Capabilities.HasFileAcls)
        {
            <button class="toolbar-btn" title="@Resources.Web_Action_Permissions"
                    disabled="@(!CanAclSelection)" @onclick="AclSelected">
                @Assets.SVG("shield.svg", new SvgOptions(Width: 16, Height: 16, Style: "vertical-align: -2px; margin-right: 6px;"))
                <span>@Resources.Web_Action_Permissions</span>
            </button>
        }
        @if (VM.Capabilities.CanCopyToLocal)
        {
            <button class="toolbar-btn" title="@T("Web_CloudAccess_CopyToLocal")"
                    disabled="@(_selectedItems.Count == 0)" @onclick="ShowCloudToLocalDialogAsync">
                @Assets.SVG("download.svg", new SvgOptions(Width: 16, Height: 16))
                <span>@T("Web_CloudAccess_CopyToLocal")</span>
            </button>
        }
    </div>
</div>

@* -- Dialog: Create new folder -- *@
@if (_showCreateFolder)
{
    var createFolderError = LiveNameError(_newFolderName, null);
    <div class="modal-backdrop" @onkeydown="OnCreateFolderKeyDown" tabindex="0">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <h3 class="modal-title">@Resources.Web_CreateFolder_Title</h3>
            <input class="modal-input" type="text" placeholder="@Resources.Web_CreateFolder_Placeholder"
                   @bind="_newFolderName" @bind:event="oninput"
                   @onkeydown="OnCreateFolderKeyDown"
                   @onkeydown:stopPropagation="true"/>
            @if (createFolderError is not null)
            {
                <div class="modal-error">@createFolderError</div>
            }
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="CancelCreateFolder">@Resources.Web_Button_Cancel</button>
                <button class="btn btn-primary" @onclick="ConfirmCreateFolder"
                        disabled="@(createFolderError is not null || string.IsNullOrWhiteSpace(_newFolderName))">
                    @Resources.Web_Button_Create
                </button>
            </div>
        </div>
    </div>
}

@* -- Dialog: confirm deletion -- *@


@if (_showDeleteConfirm)
{
    <div class="modal-backdrop" @onclick="CancelDelete" @onkeydown="OnDeleteKeyDown" tabindex="0"
         @ref="_deleteModalRef">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <h3 class="modal-title">@Resources.Web_DeleteConfirm_Title</h3>
            @if (_deleteTargets.Count == 1)
            {
                <p class="modal-text">
                    @((MarkupString)string.Format(Resources.Web_DeleteConfirm_Single, $"<strong>{System.Net.WebUtility.HtmlEncode(_deleteTargets[0].Name)}</strong>"))
                    @if (_deleteTargets[0].IsDirectory)
                    {
                        <br/>
                        <span class="modal-warning">@Resources.Web_DeleteConfirm_FolderWarning</span>
                    }
                </p>
            }
            else
            {
                <p class="modal-text">
                    @((MarkupString)string.Format(Resources.Web_DeleteConfirm_Multiple, $"<strong>{_deleteTargets.Count}</strong>"))
                    @if (_deleteTargets.Any(t => t.IsDirectory))
                    {
                        <br/>
                        <span class="modal-warning">@Resources.Web_DeleteConfirm_FoldersWarning</span>
                    }
                </p>
            }
            @if (_deleteError is not null)
            {
                <div class="modal-error">@_deleteError</div>
            }
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="CancelDelete">@Resources.Web_Button_Cancel</button>
                <button class="btn btn-danger" @onclick="ConfirmDelete">@Resources.Web_Action_Delete</button>
            </div>
        </div>
    </div>
}


@if (_showCloudToLocal)
{
    <div class="modal-backdrop" @onclick="CancelCloudToLocal">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <h3 class="modal-title">@T("Web_CloudAccess_CopyToLocal")</h3>
            <p class="modal-text">@T("Web_CloudAccess_CopyDescription")</p>
            <label class="detail-field"><span class="detail-label">@T("Web_CloudAccess_TargetShare")</span>
                <select class="modal-input" @bind="_cloudToLocalTargetId">
                    <option value="@Guid.Empty">@T("Web_CloudAccess_Select")</option>
                    @foreach (var target in _cloudToLocalTargets)
                    { <option value="@target.Id">@target.Name</option> }
                </select>
            </label>
            <label class="detail-field"><span class="detail-label">@T("Web_CloudAccess_TargetFolder")</span>
                <input class="modal-input" @bind="_cloudToLocalPath" placeholder="@T("Web_CloudAccess_TargetFolderPlaceholder")" />
            </label>
            @if (_cloudToLocalError is not null)
            {
                <div class="modal-error">@_cloudToLocalError</div>
            }
            <div class="modal-actions">
                <button class="btn-secondary" type="button" disabled="@_cloudToLocalBusy" @onclick="CancelCloudToLocal">@Resources.Web_Button_Cancel</button>
                <button class="btn-primary" type="button" disabled="@(_cloudToLocalBusy || _cloudToLocalTargetId == Guid.Empty)" @onclick="ConfirmCloudToLocalAsync">
                    @(_cloudToLocalBusy ? T("Web_CloudAccess_CopyProgress") : T("Web_CloudAccess_Copy"))
                </button>
            </div>
        </div>
    </div>
}


@if (VM.IsLoading)
{
    @* Skeleton placeholder that mirrors the file table's grid so the layout does not
       jump when the real rows arrive, and the shimmer makes the wait feel shorter than
       a bare spinner would. Uses the same --grid-cols variable as the real table so the
       columns line up exactly, including at the responsive breakpoints. *@
    <div class="file-skeleton" style="--grid-cols: @GridColumns" role="status" aria-busy="true"
         aria-label="@Resources.Web_Common_Loading">
        <div class="file-grid-header">
            <div class="col-name"><span class="col-header-text">@Resources.Web_Folder_Name</span></div>
            <div class="col-size"><span class="col-header-text">@Resources.Web_Folder_Size</span></div>
            <div class="col-created"><span class="col-header-text">@Resources.Web_Folder_Created</span></div>
            <div class="col-modified"><span class="col-header-text">@Resources.Web_Folder_Modified</span></div>
            <div class="col-lastaccess"><span class="col-header-text">@Resources.Web_Folder_Last_Access</span></div>
        </div>
        @for (var i = 0; i < SkeletonRowCount; i++)
        {
            <div class="file-skeleton-row" style="--skeleton-delay: @($"{i * 90}ms")">
                <div class="col-name">
                    <span class="skeleton-box skeleton-icon"></span>
                    <span class="skeleton-box skeleton-bar" style="width: @(SkeletonNameWidths[i % SkeletonNameWidths.Length])"></span>
                </div>
                <div class="col-size"><span class="skeleton-box skeleton-bar" style="width: 46px"></span></div>
                <div class="col-created"><span class="skeleton-box skeleton-bar" style="width: 74%"></span></div>
                <div class="col-modified"><span class="skeleton-box skeleton-bar" style="width: 74%"></span></div>
                <div class="col-lastaccess"><span class="skeleton-box skeleton-bar" style="width: 60%"></span></div>
            </div>
        }
    </div>
}
else if (VM.ErrorMessage is not null)
{
    <div class="error-banner">@VM.ErrorMessage</div>
}
else
{
    @* -- ACL Panel (Slide-Down) Root -- *@
    @if (_showAclPanel && CanManageAcls())
    {
        <div class="acl-panel">
            <div class="acl-panel-header">
                <h3>
                    @Assets.SVG("shield.svg", new SvgOptions(Width: 12, Height: 12, StrokeWidth: 2, CssClass: "acl-indicator-icon"))
                </h3>
                <span class="detail-subtitle">@(_aclPath == "" ? Resources.Web_Acl_ShareRoot : _aclPath)</span>
            </div>
            <AclEditor @key="@($"acl-{VM.CurrentShare?.Id}-{_aclPath}-{_showAclPanel}")"
                       Path="@_aclPath"
                       ShareId="@VM.CurrentShare!.Id"
                       IsDirectory="true"
                       OnChanged="LoadAclCounts"/>
        </div>
    }

    @* ══════════════════════════════════════════════════
       Resizable Column Table – 5 Spalten (ohne Actions)
       Name-Spalte (1fr) nimmt den Rest.
       ══════════════════════════════════════════════════ *@
    <div id="file-selection-area" class="file-browser-selection-area"
         @oncontextmenu="(e) => _contextMenuComponent.OnItemContextMenu(e)"
         @oncontextmenu:preventDefault="true">
    <div class="file-table-wrap" id="file-drop-zone" @ref="_fileDropZone" @onkeydown="OnKeyDownItemList" tabindex="0"
         style="--grid-cols: @GridColumns; padding-bottom: @GetTableExtraPaddingPx()px"
         @oncontextmenu="(e) => _contextMenuComponent.OnItemContextMenu(e)"
         @oncontextmenu:preventDefault="true"
         @oncontextmenu:stopPropagation="true"
    >

        @* -- Header (sortierbar) -- *@
        <div class="file-grid-header">
            <div class="col-name col-sortable" @onclick="@(() => OnHeaderClick("name"))">
                <span class="col-header-text">@Resources.Web_Folder_Name</span>
                @if (_sortColumn == "name")
                {
                    <span class="sort-arrow @(_sortDirection == 1 ? "sort-arrow--desc" : "sort-arrow--asc")"></span>
                }
                <div class="col-resize-handle"
                     @onmousedown="@(e => OnResizeStart(e, 0))"
                     @onmousedown:stopPropagation="true"
                     @onclick:stopPropagation="true"></div>
            </div>
            <div class="col-size col-sortable" @onclick="@(() => OnHeaderClick("size"))">
                <span class="col-header-text">@Resources.Web_Folder_Size</span>
                @if (_sortColumn == "size")
                {
                    <span class="sort-arrow @(_sortDirection == 1 ? "sort-arrow--desc" : "sort-arrow--asc")"></span>
                }
                <div class="col-resize-handle"
                     @onmousedown="@(e => OnResizeStart(e, 1))"
                     @onmousedown:stopPropagation="true"
                     @onclick:stopPropagation="true"></div>
            </div>
            <div class="col-created col-sortable" @onclick="@(() => OnHeaderClick("created"))">
                <span class="col-header-text">@Resources.Web_Folder_Created</span>
                @if (_sortColumn == "created")
                {
                    <span class="sort-arrow @(_sortDirection == 1 ? "sort-arrow--desc" : "sort-arrow--asc")"></span>
                }
                <div class="col-resize-handle"
                     @onmousedown="@(e => OnResizeStart(e, 2))"
                     @onmousedown:stopPropagation="true"
                     @onclick:stopPropagation="true"></div>
            </div>
            <div class="col-modified col-sortable" @onclick="@(() => OnHeaderClick("modified"))">
                <span class="col-header-text">@Resources.Web_Folder_Modified</span>
                @if (_sortColumn == "modified")
                {
                    <span class="sort-arrow @(_sortDirection == 1 ? "sort-arrow--desc" : "sort-arrow--asc")"></span>
                }
                <div class="col-resize-handle"
                     @onmousedown="@(e => OnResizeStart(e, 3))"
                     @onmousedown:stopPropagation="true"
                     @onclick:stopPropagation="true"></div>
            </div>
            <div class="col-lastaccess col-sortable" @onclick="@(() => OnHeaderClick("lastaccess"))">
                <span class="col-header-text">@Resources.Web_Folder_Last_Access</span>
            </div>
        </div>

        @* -- ".." Parent directory -- *@
        @if (VM.HasParent)
        {
            <div class="file-grid-row file-row-dir @(_dragOverPath == ".." ? "file-row--drop-target" : "")"
                 @ondblclick="NavigateUp"
                 ondragover="event.preventDefault()"
                 @ondragenter="OnDragEnterParent"
                 @ondragleave="OnDragLeave"
                 @ondrop="OnDropOnParent">
                <div class="col-name">
                    @Assets.SVG("chevron_left.svg", new SvgOptions(Width: 20, Height: 20, Color: "var(--text-tertiary)", CssClass: "file-icon"))
                    <span>..</span>
                </div>
                <div class="col-size"></div>
                <div class="col-created"></div>
                <div class="col-modified"></div>
                <div class="col-lastaccess"></div>
            </div>
        }

        @* -- Entries (folders first, then files) — virtualized -- *@
        <Virtualize Items="SortedEntries" Context="entry" ItemSize="ItemHeightPx" OverscanCount="8">
            @{
                var isSelected = _selectedItems.Contains(entry);
                var aclPath = entry.IsDirectory ? GetDirAclPath(entry) : GetFileAclPath(entry);
                var aclCount = CanManageAcls() ? GetAclCount(aclPath) : 0;
            }
            <div
                class="file-grid-row @(entry.IsDirectory ? "file-row-dir" : "") @(isSelected ? "file-row--selected" : "")"
                data-path="@entry.Path"
                data-is-dir="@(entry.IsDirectory ? "true" : "false")"
                @onclick="(e) => OnItemClick(e, entry)"
                @onclick:stopPropagation="true"
                @ondblclick="() => OnItemActivate(entry)"
                @ondrop="() => OnDropOnEntry(entry)"
                ondragover="event.preventDefault()"
                @oncontextmenu="(e) => _contextMenuComponent.OnItemContextMenu(e, entry)"
                @oncontextmenu:preventDefault="true"
                @oncontextmenu:stopPropagation="true">

                <div class="col-name"
                     draggable="@VM.Capabilities.CanMove"
                     data-path="@entry.Path"
                     @ondragstart="() => OnDragStart(entry)"
                     @ondragend="OnDragEnd">
                    @if (IsRecycleBinEntry(entry))
                    {
                        @Assets.SVG("trash.svg", new SvgOptions(Width: 20, Height: 20, CssClass: "file-icon"))
                    }
                    else if (entry.IsDirectory)
                    {
                        @Assets.SVG("folder.svg", new SvgOptions(Width: 20, Height: 20, Color: "var(--folder-stroke)", Fill: "var(--folder-fill)", CssClass: "file-icon"))
                    }
                    else
                    {
                        @Assets.SVG(FileHelper.GetIcon(entry.Name), new SvgOptions(Width: 20, Height: 20, Color: "var(--text-tertiary)", CssClass: "file-icon"))
                    }
                    <span>@entry.Name</span>
                    @if (aclCount > 0)
                    {
                        <span class="acl-indicator"
                              title="@(aclCount != 1 ? string.Format(Resources.Web_Acl_RulesPlural, aclCount) : string.Format(Resources.Web_Acl_RulesSingular, aclCount))"
                              @onclick="() => OpenEntryAcl(entry)"
                              @onclick:stopPropagation="true">
                @Assets.SVG("shield.svg", new SvgOptions(Width: 12, Height: 12, StrokeWidth: 2, CssClass: "acl-indicator-icon"))
                            <span class="acl-indicator-count">@aclCount</span>
            </span>
                    }
                </div>

                <div class="col-size">
                    @if (entry.IsDirectory && VM.Capabilities.ShowDirectorySizes)
                    {
                        var dirSize = VM.GetDirectorySize(entry);
                        if (dirSize.HasValue)
                        {
                            @FormatHelper.FormatFileSize(dirSize.Value)
                        }
                        else
                        {
                            <span class="size-loading">…</span>
                        }
                    }
                    else if (!entry.IsDirectory)
                    {
                        @FormatHelper.FormatFileSize(entry.Size)
                    }
                    else
                    {
                        <span>–</span>
                    }
                </div>

                <div class="col-created">@entry.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                <div class="col-modified">@entry.ModifiedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                <div
                    class="col-lastaccess">@(entry.LastAccessedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "–")</div>
            </div>

            @if (_showFolderAcl && _aclFolderPath == aclPath)
            {
                <div class="file-row-acl-expand-wrap">
                    <div class="file-row-acl-expand">
                        <div class="acl-panel-header" style="padding: 0 0 8px 0;">
                            <span
                                class="detail-subtitle">@string.Format(Resources.Web_Acl_PermissionsFor, entry.Name)</span>
                            <button class="btn-icon btn-icon--small" title="@Resources.Web_Button_Close"
                                    @onclick="CloseFolderAcl">
                                @Assets.SVG("close.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                            </button>
                        </div>
                        <AclEditor @key="@($"acl-{VM.CurrentShare?.Id}-{_aclFolderPath}-{_showFolderAcl}")"
                                   Path="@_aclFolderPath" ShareId="@VM.CurrentShare!.Id"
                                   IsDirectory="@entry.IsDirectory" OnChanged="LoadAclCounts"/>
                    </div>
                </div>
            }
        </Virtualize>

        @if (!VM.Items.Any())
        {
            <div class="file-grid-empty">
                <p>@Resources.Web_Folder_Empty</p>
            </div>
        }
    </div>
    </div>
}

@* -- Context menu (right-click) -- *@
<ContextMenu @ref="_contextMenuComponent" FileBrowser="this" FilePreviewComponent="_filePreviewComponent"/>

@* -- Dialog: Rename -- *@
@if (_showRenameDialog)
{
    var renameError = LiveNameError(_renameNewName, _renameTarget);
    <div class="modal-backdrop" @onclick="CancelRename" @onkeydown="OnRenameKeyDown" tabindex="0"
         @ref="_renameModalRef">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <h3 class="modal-title">@Resources.Web_Action_Rename</h3>
            <input id="rename-input" class="modal-input" type="text"
                   placeholder="@Resources.Web_Rename_Placeholder"
                   @bind="_renameNewName" @bind:event="oninput"
                   @onkeydown="OnRenameKeyDown"
                   @onkeydown:stopPropagation="true"/>
            @if (renameError is not null)
            {
                <div class="modal-error">@renameError</div>
            }
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="CancelRename">@Resources.Web_Button_Cancel</button>
                <button class="btn btn-primary" @onclick="ConfirmRename"
                        disabled="@(renameError is not null || string.IsNullOrWhiteSpace(_renameNewName))">
                    @Resources.Web_Action_Rename
                </button>
            </div>
        </div>
    </div>
}


<FilePreview @ref="_filePreviewComponent" VM="VM"/>

@* -- Version history / point-in-time dialog -- *@
<VersionDialog @ref="_versionDialogComponent"
               VM="VM"
               FilePreviewComponent="_filePreviewComponent"
               OnRestored="OnVersionRestored"/>

@* -- Properties dialog (size / metadata / ACL) -- *@
<PropertiesDialog @ref="_propertiesDialogComponent" VM="VM"/>

<SyncDialog @ref="_syncDialogComponent" />
