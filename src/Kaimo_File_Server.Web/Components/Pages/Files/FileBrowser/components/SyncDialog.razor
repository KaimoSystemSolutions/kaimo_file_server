@inject NavigationManager Navigation

@code {
    /// <summary>
    /// Opens the central cloud-sync workspace with the current folder preselected.
    /// Keeping this compatibility component means file-browser callers do not
    /// need to know how the cloud administration page is routed.
    /// </summary>
    public Task Open(Guid shareId, string folderPath)
    {
        Navigation.NavigateTo(
            $"/sync?targetShare={Uri.EscapeDataString(shareId.ToString())}" +
            $"&targetPath={Uri.EscapeDataString(folderPath ?? string.Empty)}");
        return Task.CompletedTask;
    }
}
