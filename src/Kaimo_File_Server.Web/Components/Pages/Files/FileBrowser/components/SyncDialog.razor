@using Kaimo_File_Server.Infrastructure.Clouds
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Core.Repositories
@inject NavigationManager Navigation
@inject ToastService Toast
@inject ICloudProviderFactory CloudProviderFactory
@inject IShareRepository ShareRepository

@if (_isOpen)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <h3 class="modal-title">Sync Folder</h3>
            <p class="share-help-text">@_folderPath</p>

            <div class="detail-section">
                <span class="detail-label">Cloud Provider</span>
                <select class="edit-input"
                        @bind="_selectedProvider"
                        disabled="@(_googleConnection is not null)">
                    <option value="">None</option>
                    <option value="Google">Google Drive</option>
                    <option value="Dropbox">Dropbox</option>
                    <option value="OneDrive">Microsoft OneDrive</option>
                    <option value="Nextcloud">Nextcloud</option>
                </select>
            </div>

            @if (_selectedProvider == "Google")
            {
                <div class="detail-section">
                    <span class="detail-label">Google Drive</span>

                    @if (_googleConnection is not null)
                    {
                        <div class="cloud-account">
                            @if (!string.IsNullOrEmpty(_googleUserPhoto))
                            {
                                <img class="cloud-avatar" src="@_googleUserPhoto" alt="Google account" referrerpolicy="no-referrer"/>
                            }
                            <span class="share-help-text">@_googleUserEmail</span>
                            <button class="btn-primary" @onclick="Disconnect">Unsync</button>
                        </div>
                    }
                    else
                    {
                        <div class="drive-login-container">
                            <button class="btn-primary" @onclick="ConnectGoogle">
                                Sync with Google
                            </button>
                        </div>
                    }
                </div>
            }
            else if (_selectedProvider is "Dropbox" or "OneDrive" or "Nextcloud")
            {
                <div class="detail-section">
                    <p class="share-help-text">@_selectedProvider support is not available yet.</p>
                </div>
            }

            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="Close">@Resources.Web_Button_Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _isOpen;
    private Guid _shareId;
    private string _folderPath = "";

    private string _selectedProvider = "";
    private GoogleDriveConnection? _googleConnection;
    private string? _googleUserEmail;
    private string? _googleUserPhoto;

    public async Task Open(Guid shareId, string folderPath)
    {
        _shareId = shareId;
        _folderPath = folderPath;
        _isOpen = true;

        _selectedProvider = "";
        _googleConnection = null;
        _googleUserEmail = null;
        _googleUserPhoto = null;

        await LoadExistingConnection();
        StateHasChanged();
    }

    public void Close()
    {
        _isOpen = false;
        StateHasChanged();
    }

    private async Task LoadExistingConnection()
    { 
        SyncedFolder? folder = await GetSyncedFlder();
        
        // there is no exsting connection
        if(folder is null)
            return;
        
        // load existing or establish new connection
        ICloudConnection connection = CloudProviderFactory.CreateOrLoad(_shareId, folder);
        
        if (connection is not GoogleDriveConnection)
            return;
        
        GoogleDriveConnection googleConnection = connection as GoogleDriveConnection;

        _googleConnection = googleConnection;
        _selectedProvider = googleConnection.getServiceName();

        StateHasChanged();
        
        _googleUserEmail = await googleConnection.GetAccountEmailAsync();
        _googleUserPhoto = await googleConnection.GetProfilePictureUrlAsync();
        
        await Task.CompletedTask;
    }

    private async Task<SyncedFolder?> GetSyncedFlder()
    {
        ShareDefinition? share = await ShareRepository.GetByIdAsync(_shareId);
        if (share == null)
            return null;
        
        CloudSettings settings = share.CloudSettings;
        
        // folder isn't synced at all
        if(!settings.Folders.TryGetValue(_folderPath, out SyncedFolder folder))
            return folder;
        return folder;
    }

    private void ConnectGoogle()
    {
        var shareId = Uri.EscapeDataString(_shareId.ToString());
        var path = Uri.EscapeDataString(_folderPath ?? "");

        // Both shareId and path need to survive the OAuth round trip so the
        // callback can persist the refresh token against this exact
        // (share, folder) pair rather than just the share.
        Navigation.NavigateTo(
            $"/api/google/connect?shareId={shareId}&path={path}",
            forceLoad: true);
    }

    private async Task Disconnect()
    {
        _googleConnection = null;
        _googleUserEmail = null;
        _googleUserPhoto = null;
        _selectedProvider = "";

        Toast.Show("Disconnected Cloud Provider from Folder");
        StateHasChanged();

        SyncedFolder? syncedFolder = await GetSyncedFlder();
        
        if(syncedFolder != null)
            CloudProviderFactory.DisposeConnection(syncedFolder);

        await unsyncFolder();
        await Task.CompletedTask;
    }
    
    private async Task unsyncFolder()
    {
        ShareDefinition? share = await ShareRepository.GetByIdAsync(_shareId);
        if (share == null)
            return;
        
        CloudSettings settings = share.CloudSettings;
        settings.Folders.Remove(_folderPath);
        await ShareRepository.UpdateAsync(share);
    }


}