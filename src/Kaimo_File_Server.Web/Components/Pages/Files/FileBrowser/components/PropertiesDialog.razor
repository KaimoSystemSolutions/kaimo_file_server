@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Web.Components.Pages.Acl
@using Kaimo_File_Server.Web.DynamicHelpers
@inherits AppComponentBase
@inject DateFormatService DateFmt

@*
    Compact, Windows-Explorer-style "Properties" dialog for a single file or folder, or for a
    multi-selection.

    Opened from the file browser context menu via <see cref="Open(FileMetadata)" />. The dialog is
    deliberately small and read-only: the "General" tab lists metadata (type, size,
    timestamps, owner, MIME type, …) and the optional "Security" tab embeds the shared
    <see cref="AclEditor" /> so ACL managers can inspect and edit permissions in place.
    The Security tab is only rendered when the current user may manage the share's ACLs.

    For a multi-selection the size is the combined total, every other value is shown when it
    is the same for all items and "Varies" otherwise, and the Security tab is not offered.
*@
@if (_show && _target is not null)
{
    var multi = _targets.Count > 1;
    var title = multi
        ? string.Format(Resources.Context_Menu_SelectedItems, _targets.Count).Trim()
        : _target.Name;
    var allDirectories = _targets.All(t => t.IsDirectory);

    <div class="modal-backdrop" @onclick="Close">
        <div class="properties-dialog" @onclick:stopPropagation="true">

            @* -- Header: icon + name + close -- *@
            <div class="properties-header">
                <span class="properties-header-icon">
                    @if (allDirectories)
                    {
                        @Assets.SVG("folder.svg", new SvgOptions(Width: 22, Height: 22, Color: "var(--folder-stroke)", Fill: "var(--folder-fill)"))
                    }
                    else
                    {
                        @Assets.SVG(multi ? "file.svg" : FileHelper.GetIcon(_target.Name), new SvgOptions(Width: 22, Height: 22, Color: "var(--text-tertiary)"))
                    }
                </span>
                <span class="properties-header-name" title="@title">@title</span>
                <button class="btn-icon" title="@Resources.Web_Button_Close" @onclick="Close">
                    @Assets.SVG("close.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                </button>
            </div>

            @* -- Tabs -- *@
            <div class="properties-tabs">
                <button class="properties-tab @(_activeTab == Tab.General ? "properties-tab--active" : "")"
                        @onclick="() => _activeTab = Tab.General">
                    @Resources.Web_Properties_Tab_General
                </button>
                @if (_showSecurityTab)
                {
                    <button class="properties-tab @(_activeTab == Tab.Security ? "properties-tab--active" : "")"
                            @onclick="() => _activeTab = Tab.Security">
                        @Resources.Web_Properties_Tab_Security
                    </button>
                }
            </div>

            @* -- Body -- *@
            <div class="properties-body">
                @if (_activeTab == Tab.General)
                {
                    var location = Common(LocationOf);

                    <dl class="properties-grid">
                        <dt>@Resources.Web_Properties_Type</dt>
                        <dd>@Common(TypeDescription)</dd>

                        <dt>@Resources.Web_Properties_Location</dt>
                        <dd title="@location">@location</dd>

                        <dt>@(multi ? T("Web_Properties_SizeTotal") : Resources.Web_Properties_Size)</dt>
                        <dd>@SizeDescription()</dd>

                        @if (!allDirectories)
                        {
                            <dt>@Resources.Web_Properties_Extension</dt>
                            <dd>@Common(ExtensionDescription)</dd>

                            <dt>@Resources.Web_Properties_MimeType</dt>
                            <dd>@(Common(t => t.IsDirectory ? "" : FileHelper.GetContentType(t.Name)))</dd>
                        }

                        <div class="properties-divider"></div>

                        <dt>@Resources.Web_Properties_Created</dt>
                        <dd>@(Common(t => DateFmt.FormatDateTime(t.CreatedAt)))</dd>

                        <dt>@Resources.Web_Properties_Modified</dt>
                        <dd>@(Common(t => DateFmt.FormatDateTime(t.ModifiedAt)))</dd>

                        <dt>@Resources.Web_Properties_Accessed</dt>
                        <dd>@(Common(t => DateFmt.FormatDateTime(t.LastAccessedAt)))</dd>

                        <div class="properties-divider"></div>

                        <dt>@Resources.Web_Properties_Owner</dt>
                        <dd>@(_ownerName ?? "–")</dd>

                        <dt>@Resources.Web_Properties_Share</dt>
                        <dd>@(VM.CurrentBrowserShare?.Name ?? "–")</dd>

                        @* Only persisted items carry a stable id; hide the row otherwise
                           instead of showing a meaningless all-zero GUID. *@
                        @if (_itemId is { } id)
                        {
                            <dt>@Resources.Web_Properties_ItemId</dt>
                            <dd class="properties-mono" title="@id.ToString()">@id.ToString()</dd>
                        }
                    </dl>
                }
                else if (_showSecurityTab)
                {
                    <AclEditor @key="@($"props-acl-{VM.CurrentShare?.Id}-{_relativePath}")"
                               Path="@_relativePath"
                               ShareId="@VM.CurrentShare!.Id"
                               IsDirectory="@_target.IsDirectory" />
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public IFileBrowserViewModel VM { get; set; } = default!;

    private enum Tab { General, Security }

    private bool _show;
    public bool IsOpen => _show;
    private Tab _activeTab = Tab.General;
    private List<FileMetadata> _targets = new();
    // First target; the only one for a single-item dialog (ACL tab, item id).
    private FileMetadata? _target;

    // Precomputed on open so the render path stays synchronous.
    private string _relativePath = "";
    private string? _ownerName;
    private Guid? _itemId;
    private bool _showSecurityTab;
    private long? _totalSize;
    private bool _sizeResolved;

    /// <summary>Opens the properties dialog for a single file or directory.</summary>
    public Task Open(FileMetadata target) => Open(new[] { target });

    /// <summary>Opens the properties dialog for one or more files/directories.</summary>
    public async Task Open(IReadOnlyList<FileMetadata> targets)
    {
        if (targets.Count == 0) return;

        var list = targets.ToList();
        _targets = list;
        _target = list[0];
        _activeTab = Tab.General;
        _relativePath = VM.ShareRelativeOf(_target);
        _showSecurityTab = list.Count == 1 && VM.CanManageAcls && VM.CurrentShare is not null;
        _ownerName = null;
        _itemId = null;
        _show = true;

        // Sum the sizes known right away; folders without a cached size are calculated
        // after the first paint.
        long total = 0;
        var pending = new List<FileMetadata>();
        foreach (var item in list)
        {
            if ((item.IsDirectory ? VM.GetDirectorySize(item) : item.Size) is { } size)
                total += size;
            else
                pending.Add(item);
        }
        _sizeResolved = pending.Count == 0;
        _totalSize = _sizeResolved ? total : null;

        StateHasChanged();

        if (pending.Count > 0)
        {
            var unavailable = false;
            foreach (var directory in pending)
            {
                if (await VM.CalculateDirectorySizeAsync(directory) is { } size)
                    total += size;
                else
                    unavailable = true;
                if (!IsCurrent(list)) return;
            }
            _totalSize = unavailable ? null : total;
            _sizeResolved = true;
            StateHasChanged();
        }

        // Identity/owner live in the database, not in the filesystem listing (whose
        // Id/OwnerId are always empty). Resolve the persisted record after the first
        // paint; fall back to the listing's owner id when no row exists yet.
        // ponytail: one lookup per item until a second owner shows up; batch it if huge
        // selections with a single owner get slow.
        Guid? itemId = null;
        var owners = new HashSet<string>();
        foreach (var item in list)
        {
            var persisted = await VM.GetPersistedMetadataAsync(item);
            itemId = persisted?.Id;
            owners.Add(await VM.GetOwnerDisplayNameAsync(persisted?.OwnerId ?? item.OwnerId) ?? "–");
            if (owners.Count > 1) break;
        }
        if (!IsCurrent(list)) return;

        _itemId = list.Count == 1 ? itemId : null;
        _ownerName = owners.Count == 1 ? owners.First() : T("Web_Properties_Varies");
        StateHasChanged();
    }

    public void Close()
    {
        _show = false;
        _targets = new();
        _target = null;
        StateHasChanged();
    }

    private bool IsCurrent(List<FileMetadata> targets) => _show && ReferenceEquals(_targets, targets);

    /// <summary>The value shared by all targets, or "Varies" when they differ.</summary>
    private string Common(Func<FileMetadata, string> value)
    {
        var first = value(_targets[0]);
        return _targets.Skip(1).All(t => value(t) == first) ? first : T("Web_Properties_Varies");
    }

    /// <summary>Share name + share-relative parent folder (empty at the root).</summary>
    private string LocationOf(FileMetadata item)
    {
        var parent = Kaimo_File_Server.Core.Helpers.ShareRelativePath.GetParent(VM.ShareRelativeOf(item));
        var shareName = VM.CurrentBrowserShare?.Name ?? "";
        return string.IsNullOrEmpty(parent) ? shareName : $"{shareName}/{parent}";
    }

    /// <summary>Human-readable type label, mirroring Windows Explorer's wording.</summary>
    private static string TypeDescription(FileMetadata item)
    {
        if (item.IsDirectory) return Resources.Web_Properties_TypeFolder;

        var ext = System.IO.Path.GetExtension(item.Name);
        return string.IsNullOrEmpty(ext)
            ? Resources.Web_Properties_TypeFile
            : string.Format(Resources.Web_Properties_TypeFileExt, ext.TrimStart('.').ToUpperInvariant());
    }

    /// <summary>Size (the total for a multi-selection) as a human-readable value plus the exact byte count.</summary>
    private string SizeDescription()
    {
        if (_totalSize is not { } bytes)
            return _sizeResolved ? T("Web_Properties_SizeUnavailable") : Resources.Web_Properties_Calculating;

        return $"{FormatHelper.FormatFileSize(bytes)} " +
               string.Format(Resources.Web_Properties_Bytes, bytes.ToString("N0"));
    }

    private static string ExtensionDescription(FileMetadata item)
    {
        if (item.IsDirectory) return "";
        var ext = System.IO.Path.GetExtension(item.Name);
        return string.IsNullOrEmpty(ext) ? "–" : ext.ToLowerInvariant();
    }

    private static string T(string key) => Resources.ResourceManager.GetString(key) ?? key;
}
