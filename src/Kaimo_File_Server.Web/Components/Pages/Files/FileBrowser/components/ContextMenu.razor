@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Web.DynamicHelpers
@using Kaimo_File_Server.Infrastructure.Configuration
@inherits AppComponentBase
@inject IConfigRepository Config
@inject IJSRuntime JS


@if (_showContextMenu)
{
    <div class="context-menu-backdrop" @onclick="CloseContextMenu" @oncontextmenu="CloseContextMenu"
         @oncontextmenu:preventDefault="true"></div>
    <div class="context-menu" @ref="_menuRef" style="top: @(_contextMenuY)px; left: @(_contextMenuX)px;">
        <ContextMenu Items="BuildContextMenuItems()" />
    </div>
}

@foreach (var item in Items)
{
    if (item.IsSeparator)
    {
        <div class="context-menu-separator"></div>
    }
    else if (item.IsHeader)
    {
        <div class="context-menu-header">@item.Label</div>
    }
    else
    {
        <button class="context-menu-item @(item.IsDanger ? "context-menu-item--danger" : "")"
                @onclick="item.Action">
            @Assets.SVG(item.Icon, item.IconOptions)
            @item.Label
        </button>
    }
}

@code {
    [Parameter] public FileBrowser FileBrowser { get; set; } = default!;
    [Parameter] public FilePreview FilePreviewComponent { get; set; } = default!;
    [Parameter] public List<ContextMenuItem> Items { get; set; } = new();
    
    private bool _showContextMenu;
    private double _contextMenuX;
    private double _contextMenuY;

    private ElementReference _menuRef;
    // Set when the menu is (re)opened so OnAfterRenderAsync nudges it back on-screen once.
    private bool _needsReposition;
    public bool IsOpen => _showContextMenu;

    // Globally configured, per-scope menu layout (Settings → Kontextmenü).
    // Reloaded on every right-click (see ReloadMenuConfig) so a saved change
    // takes effect immediately. Not loaded in OnInitializedAsync on purpose:
    // that would race with the FileBrowser's own use of the scoped DbContext.
    private ContextMenuConfig _menuConfig = ContextMenuConfig.Default();

    private List<ContextMenuItem> BuildContextMenuItems()
    {
        var builder = new ContextMenuBuilder();

        HashSet<FileMetadata> selectedItems = FileBrowser.getSelectedItems();
        var scope = ContextMenuScopeResolver.ResolveScope(selectedItems);

        // Top header: target name (single) / "n selected" (multi) / none (background).
        if (scope == ContextMenuScope.MultiSelection)
            builder.AddHeader(string.Format(Resources.Context_Menu_SelectedItems, selectedItems.Count));
        else if (scope != ContextMenuScope.Background)
            builder.AddHeader(FileBrowser.getFirstSelectedItem().Name);

        var target = scope is ContextMenuScope.Background or ContextMenuScope.MultiSelection
            ? null
            : FileBrowser.getFirstSelectedItem();

        var generalGroupStarted = false;
        var emittedAny = false;

        foreach (var id in _menuConfig.ForScope(scope))
        {
            var command = ContextCommandCatalog.ById(id);
            if (command is null || !command.IsValidFor(scope)) continue;
            if (!PassesRuntimeGuard(id, scope, selectedItems)) continue;

            // The "general" commands (new folder / refresh) render as a trailing
            // group, separated and headed like the previous hard-coded menu.
            if (ContextCommandCatalog.GeneralIds.Contains(id) && !generalGroupStarted)
            {
                if (emittedAny) builder.AddSeparator();
                builder.AddHeader(Resources.Context_Menu_General);
                generalGroupStarted = true;
            }

            builder.Add(command.DisplayLabel, command.Icon,
                BuildAction(id, scope, target, selectedItems),
                isDanger: command.IsDanger,
                iconOptions: command.ResolvedIconOptions);
            emittedAny = true;
        }

        return builder.Build();
    }

    /// <summary>Extra conditions that the scope alone can't express.</summary>
    private bool PassesRuntimeGuard(string id, ContextMenuScope scope, HashSet<FileMetadata> selected)
        => id switch
        {
            "open" => FileBrowser.VM.Capabilities.CanOpen,
            "rename" => FileBrowser.VM.Capabilities.CanRename,
            "delete" => FileBrowser.VM.Capabilities.CanDelete,
            // "Empty recycle bin" only applies to the recycle-bin root folder itself.
            "recycle.empty" => scope == ContextMenuScope.Folder
                               && FileBrowser.VM.Capabilities.CanDelete
                               && FileBrowser.IsRecycleBinRoot(selected.FirstOrDefault()),
            "compress.zip" or "compress.targz" => FileBrowser.VM.Capabilities.CanArchive,
            "versions" => FileBrowser.VM.Capabilities.HasVersions,
            "properties" => FileBrowser.VM.Capabilities.HasProperties,
            "newfolder" => FileBrowser.VM.Capabilities.CanCreateDirectory,
            // Permissions stay manager-only regardless of configuration.
            "permissions" => FileBrowser.CanManageAcls(),
            // Sharing a public link requires the scoped ManageShareLinks permission.
            "sharelink" => FileBrowser.CanManageShareLinks(),
            // Bulk extract only makes sense when every selected item is an archive.
            "extract" when scope == ContextMenuScope.MultiSelection
                => FileBrowser.VM.Capabilities.CanExtract
                   && selected.All(f => !f.IsDirectory && FileHelper.IsArchive(f.Name)),
            "extract" => FileBrowser.VM.Capabilities.CanExtract,

            // Hashing streams the file server-side — only local shares can read content.
            "hash" => FileBrowser.VM.CurrentShare is not null,

            _ => true,
        };

    /// <summary>Maps a command id (+ current target) to its concrete action.</summary>
    private Func<Task> BuildAction(string id, ContextMenuScope scope,
        FileMetadata? target, HashSet<FileMetadata> selected) => id switch
    {
        "open" when target is { IsDirectory: true }
            => () => {  CloseContextMenu(); ContextNavigateTo(target); return Task.CompletedTask; },
        "open"
            => async () => {  CloseContextMenu(); await FilePreviewComponent.OpenFilePreview(target!); },

        // Folder / multi-selection downloads stream as a ZIP; a single file streams directly.
        "download" when scope is ContextMenuScope.Folder or ContextMenuScope.MultiSelection
            => async () => { CloseContextMenu(); await FileBrowser.DownloadSelectionAsync(); },
        "download"
            => async () => {  CloseContextMenu(); await FileBrowser.DownloadFileAsync(target!); },

        "sharelink"
            => async () => { CloseContextMenu(); await FileBrowser.OpenShareLinkDialog(target!); },

        "hash"
            => async () => {  CloseContextMenu(); await FileBrowser.OpenHashDialog(target!); },


        "extract" when scope == ContextMenuScope.MultiSelection
            => async () =>
            {
                CloseContextMenu();
                foreach (var item in selected) await FileBrowser.UnzipFile(item);
            },
        "extract"
            => async () => {  CloseContextMenu(); await FileBrowser.UnzipFile(target!); },

        
        "compress.zip" => async () =>
        {
            CloseContextMenu();
            await FileBrowser.ArchiveFiles(CompressTargets(scope, target, selected), ".zip");
        },
        "compress.targz" => async () =>
        {
            CloseContextMenu();
            await FileBrowser.ArchiveFiles(CompressTargets(scope, target, selected), ".tar.gz");
        },

        "versions" => async () => { CloseContextMenu(); await FileBrowser.OpenVersionDialog(target!); },

        "rename" => async () => await ContextRename(target!),

        "delete" when scope == ContextMenuScope.MultiSelection
            => async () => { foreach (var item in selected) await ContextDelete(item); },
        "delete"
            => async () => { await ContextDelete(target!); },

        "recycle.empty" => async () => { CloseContextMenu(); await FileBrowser.EmptyRecycleBin(target!); },

        "permissions" => () => { ContextAcl(target!); return Task.CompletedTask; },

        "properties" => async () => { CloseContextMenu(); await FileBrowser.OpenPropertiesDialog(target!); },

        "newfolder" => () => { ContextNewFolder(); return Task.CompletedTask; },
        "refresh" => async () => { await ContextRefresh(); },
        
        
        _ => () => Task.CompletedTask,
    };

    private static IEnumerable<FileMetadata> CompressTargets(ContextMenuScope scope,
        FileMetadata? target, HashSet<FileMetadata> selected)
        => scope == ContextMenuScope.MultiSelection ? selected : new[] { target! };

    public async Task OnItemContextMenu(MouseEventArgs e, FileMetadata? item = null)
    {
        if (item is not null && !FileBrowser.SelectedItemsContain(item))
        {
            FileBrowser.ClearSelection();
            FileBrowser.AddItemToSelection(item);
        }

        await ReloadMenuConfig();
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _showContextMenu = true;
        _needsReposition = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnBackgroundContextMenu(MouseEventArgs e)
    {
        await ReloadMenuConfig();
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _showContextMenu = true;
        _needsReposition = true;
        await InvokeAsync(StateHasChanged);
    }

    // After the menu renders at the click point, ask the browser to shift it back
    // into the viewport if it would overflow the bottom/right edge — so entries near
    // the screen edge stay fully reachable. Runs once per open.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_showContextMenu && _needsReposition)
        {
            _needsReposition = false;
            await JS.InvokeVoidAsync("contextMenu.reposition", _menuRef);
        }
    }

    // Re-read the layout on every open so an admin's saved change in
    // Settings → Kontextmenü takes effect immediately (cache is cleared on save).
    private async Task ReloadMenuConfig()
    {
        _menuConfig = await Config.GetAsync(ContextMenuConfig.ConfigKey, ContextMenuConfig.Default());
    }

    public void CloseContextMenu()
    {
        _showContextMenu = false;
        StateHasChanged();
    }

    private void ContextNavigateTo(FileMetadata dir) { CloseContextMenu(); FileBrowser.NavigateTo(dir); }

    private async Task ContextDelete(FileMetadata item)
    {
        CloseContextMenu(); 
        await FileBrowser.DeleteSelected();
        FileBrowser.TriggerReRender();
    }

    private async Task ContextRename(FileMetadata item)
    {
        CloseContextMenu();
        await FileBrowser.RenameSelected();
        FileBrowser.TriggerReRender();
    }

    private void ContextAcl(FileMetadata item)
    {
        CloseContextMenu();
        if (item.IsDirectory) 
            FileBrowser.OpenFolderAcl(item); 
        else 
            FileBrowser.OpenFileAcl(item);
        FileBrowser.TriggerReRender();
    }

    private void ContextNewFolder()
    {
        CloseContextMenu(); 
        FileBrowser.ShowCreateFolderDialog();
        FileBrowser.TriggerReRender();
    }

    private async Task ContextRefresh()
    {
        CloseContextMenu();
        await FileBrowser.Refresh();
    }
}
