@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Web.DynamicHelpers
@using Kaimo_File_Server.Web.Helpers
@inject AssetProvider Assets
@inject FileBrowserViewModel VM
@inject IJSRuntime JS


@if (_showFilePreview)
{
    <div class="modal-backdrop" @onclick="CloseFilePreview">
        <div class="preview-dialog" @onclick:stopPropagation="true">
            <div class="preview-header">
                <span class="preview-title">@_previewFileName</span>
                <div class="preview-actions">
                    @if (!string.IsNullOrEmpty(_downloadUrl))
                    {
                        <a class="btn-icon" href="@_downloadUrl" download="@_previewFileName" title="Herunterladen">
                            @Assets.SVG("download.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                        </a>
                    }
                    <button class="btn-icon" title="Schließen" @onclick="CloseFilePreview">
                        @Assets.SVG("close.svg", new SvgOptions(Width: 14, Height: 14, StrokeWidth: 2))
                    </button>
                </div>
            </div>
            @if (_previewLoading)
            {
                <div class="preview-loading">
                    <div class="preview-spinner"></div>
                    <span class="preview-loading-text">@Resources.Web_File_Loading</span>
                </div>
            }
            else if (_previewKind == PreviewKind.Image)
            {
                <div class="preview-image-container">
                    <img class="preview-image" src="@_displayUrl" alt="@_previewFileName" />
                </div>
            }
            else if (_previewKind == PreviewKind.Video)
            {
                <div class="preview-media-container">
                    <video class="preview-media" src="@_displayUrl" controls autoplay></video>
                </div>
            }
            else if (_previewKind == PreviewKind.Audio)
            {
                <div class="preview-media-container">
                    <audio class="preview-audio" src="@_displayUrl" controls autoplay></audio>
                </div>
            }
            else if (_previewKind == PreviewKind.Pdf)
            {
                <iframe class="preview-frame" src="@_displayUrl"></iframe>
            }
            else if (_previewKind == PreviewKind.Text || _previewKind == PreviewKind.Docx)
            {
                @* Generated, self-contained HTML — sandbox blocks any script execution. *@
                <iframe class="preview-frame" src="@_displayUrl" sandbox="allow-same-origin"></iframe>
            }
            else
            {
                <div class="preview-fallback">
                    @Assets.SVG(FileHelper.GetIcon(_previewFileName), new SvgOptions(Width: 64, Height: 64, StrokeWidth: 1.5f, Color: "var(--text-tertiary)"))
                    <span class="preview-fallback-name">@_previewFileName</span>
                    <span class="preview-fallback-hint">
                        @(_previewTooLarge
                            ? $"Die Datei ist zu groß für die Vorschau (max. {FormatHelper.FormatFileSize(VM.GetMaxPreviewSizeBytes())})."
                            : "Für diesen Dateityp ist keine Vorschau verfügbar.")
                    </span>
                    @if (_previewSize > 0)
                    {
                        <span class="preview-fallback-size">@FormatHelper.FormatFileSize(_previewSize)</span>
                    }
                    @if (!string.IsNullOrEmpty(_downloadUrl))
                    {
                        <a class="btn-primary preview-fallback-download" href="@_downloadUrl" download="@_previewFileName">
                            @Assets.SVG("download.svg", new SvgOptions(Width: 16, Height: 16, StrokeWidth: 2))
                            Herunterladen
                        </a>
                    }
                </div>
            }
        </div>
    </div>
}


@code {

    private string _displayUrl = "";
    private string _downloadUrl = "";
    private string _previewFileName = "";
    private long _previewSize;
    private PreviewKind _previewKind = PreviewKind.Unsupported;
    private bool _previewLoading;
    private bool _previewTooLarge;
    private bool _showFilePreview;

    public async Task CloseFilePreview()
    {
        await RevokeUrlsAsync();

        _showFilePreview = false;
        _displayUrl = "";
        _downloadUrl = "";
    }


    public async Task OpenFilePreview(FileMetadata file)
    {
        // Revoke any blobs left over from a previously opened preview.
        await RevokeUrlsAsync();

        _previewFileName = file.Name;
        _previewSize = file.Size;
        _displayUrl = "";
        _downloadUrl = "";
        _previewKind = PreviewKind.Unsupported;
        _previewTooLarge = false;
        _showFilePreview = true;

        // Files above the inline-preview cap are never buffered into memory — show the
        // download fallback directly instead of spinning and then silently closing.
        if (file.Size > VM.GetMaxPreviewSizeBytes())
        {
            _previewTooLarge = true;
            _previewLoading = false;
            StateHasChanged();
            return;
        }

        _previewLoading = true;
        StateHasChanged();

        var result = await VM.ReadFileForPreviewAsync(file);
        if (result is null)
        {
            _showFilePreview = false;
            _previewLoading = false;
            StateHasChanged();
            return;
        }

        var (data, contentType, kind) = result.Value;
        _previewKind = kind;

        var urls = await JS.InvokeAsync<PreviewUrls>(
            "filePreview.preparePreview", data, contentType, kind.ToString());

        _downloadUrl = urls.DownloadUrl ?? "";
        _displayUrl = urls.DisplayUrl ?? "";

        // No inline content produced (e.g. docx conversion failed) -> download fallback.
        if (string.IsNullOrEmpty(_displayUrl))
            _previewKind = PreviewKind.Unsupported;

        _previewLoading = false;
        StateHasChanged();
    }

    /// <summary>
    /// Opens the preview modal for content already held in memory (e.g. a specific
    /// file version), rather than reading the current file from storage.
    /// </summary>
    public async Task OpenPreviewFromDataAsync(byte[] data, string contentType, PreviewKind kind, string fileName)
    {
        await RevokeUrlsAsync();

        _previewFileName = fileName;
        _previewSize = data.Length;
        _displayUrl = "";
        _downloadUrl = "";
        _previewTooLarge = false;
        _previewKind = kind;
        _showFilePreview = true;
        _previewLoading = true;
        StateHasChanged();

        var urls = await JS.InvokeAsync<PreviewUrls>(
            "filePreview.preparePreview", data, contentType, kind.ToString());

        _downloadUrl = urls.DownloadUrl ?? "";
        _displayUrl = urls.DisplayUrl ?? "";

        if (string.IsNullOrEmpty(_displayUrl))
            _previewKind = PreviewKind.Unsupported;

        _previewLoading = false;
        StateHasChanged();
    }

    private async Task RevokeUrlsAsync()
    {
        if (!string.IsNullOrEmpty(_displayUrl))
            await JS.InvokeVoidAsync("filePreview.revokeBlob", _displayUrl);

        // Display and download URLs are the same blob for media/pdf — avoid a double revoke.
        if (!string.IsNullOrEmpty(_downloadUrl) && _downloadUrl != _displayUrl)
            await JS.InvokeVoidAsync("filePreview.revokeBlob", _downloadUrl);
    }

    private sealed record PreviewUrls
    {
        public string? DisplayUrl { get; init; }
        public string? DownloadUrl { get; init; }
    }
}
