@page "/files/{ShareName}/{*SubPath}"
@page "/files/{ShareName}"
@page "/files"
@using Kaimo_File_Server.Web.Components.Pages.Files.FileBrowser
@using Kaimo_File_Server.Web.Components.Pages.Files.FileBrowser.components
@using Kaimo_File_Server.Infrastructure.Services
@inject FileBrowserViewModel LocalViewModel
@inject NavigationManager Nav

@if (string.IsNullOrWhiteSpace(ShareName))
{
    <FileBrowserShareOverview />
}
else if (!IsHomesShare || _homesAllowed)
{
    <FileBrowser VM="LocalViewModel" ShareName="@ShareName" ShareDisplayName="@ShareName" SubPath="@SubPath" />
}

@code {
    [Parameter] public string ShareName { get; set; } = "";
    [Parameter] public string? SubPath { get; set; }

    private bool _homesAllowed;

    private bool IsHomesShare
        => string.Equals(ShareName, HomeDirectoryService.ShareName, StringComparison.OrdinalIgnoreCase);

    // The home-folder share is browsed as a whole only by holders of AccessHomeContents (the ACL
    // service decides which homes they reach). Everyone else sees their own folder as "user"
    // (/files/user); /files/users itself leads to the metadata-only overview on /home-folders.
    protected override async Task OnParametersSetAsync()
    {
        // Checked once on entering the share: navigating inside /files/users then completes
        // synchronously, so the browser is neither re-mounted nor loaded twice. The view model
        // re-checks the permission on every load.
        if (!IsHomesShare)
        {
            _homesAllowed = false;
            return;
        }
        if (_homesAllowed)
            return;
        _homesAllowed = await LocalViewModel.CanBrowseAllHomesAsync();
        if (!_homesAllowed)
            Nav.NavigateTo(string.IsNullOrEmpty(SubPath) ? "/home-folders" : "/files/user", replace: true);
    }
}
