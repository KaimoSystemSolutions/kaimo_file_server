@page "/files"
@using Kaimo_File_Server.Web.DynamicHelpers
@inject ShareBrowserViewModel VM
@inject NavigationManager Nav
@inject AssetProvider Assets

<PageTitle>Kaimo Files – Browse</PageTitle>

<div class="page-header">
    <div>
        <h1>Browse - Shares</h1>
    </div>
    <div style="display: flex; gap: 0.5rem;">
        @if (VM.CanManageShares)
        {
            <button class="btn-icon" title="Share erstellen" @onclick="() => { VM.IsCreating = !VM.IsCreating; }">
                <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">
                    @Assets.SVG("folder.svg", new SvgOptions())
                    Shares Verwalten
                </NavLink>
            </button>
        }
    </div>
</div>

@if (VM.IsLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Lade Shares...</p>
    </div>
}
else if (VM.ErrorMessage is not null)
{
    <div class="error-banner">@VM.ErrorMessage</div>
}
else if (!VM.Shares.Any())
{
    <div class="empty-state">
        @Assets.SVG("folder.svg", new SvgOptions(Width: 64, Height: 64, Color: "var(--text-tertiary)"))
        <p>Keine Shares verfügbar.</p>
    </div>
}
else
{
    <div class="file-list">
        @foreach (var share in VM.Shares)
        {
            <div class="file-row file-row-dir" @onclick="() => OpenShare(share.Name)">
                <div class="file-cell file-name">
                    @Assets.SVG("folder.svg", new SvgOptions(Width: 20, Height: 20, Color: "var(--folder-stroke)", Fill: "var(--folder-fill)", CssClass: "file-icon"))
                    <span>@share.Name</span>
                </div>
                <div class="file-cell file-size">@share.Path</div>
                <div class="file-cell file-date"></div>
            </div>
        }
    </div>
}
@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await VM.LoadAsync();
            StateHasChanged();
        }
    }

    private void OpenShare(string name) => Nav.NavigateTo($"/files/{name}");


}
