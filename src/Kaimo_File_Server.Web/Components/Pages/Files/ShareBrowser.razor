@page "/files"
@using Kaimo_File_Server.Core.Language
@using Kaimo_File_Server.Web.DynamicHelpers
@inject ShareBrowserViewModel VM
@inject NavigationManager Nav
@inject AssetProvider Assets

<PageTitle>Kaimo Files – @Resources.Web_ShareBrowser_PageTitle</PageTitle>

<div class="page-header share-browser-header">
    <div>
        <h1>@Resources.Web_ShareBrowser_Heading</h1>
    </div>
    <div class="share-browser-actions">
        @if (VM.CanManageShares)
        {
            <NavLink class="btn-secondary share-manage-link" href="/" Match="NavLinkMatch.All" title="@Resources.Web_ShareBrowser_ManageShares">
                @Assets.SVG("folder.svg", new SvgOptions())
                @Resources.Web_ShareBrowser_ManageShares
            </NavLink>
        }
    </div>
</div>

@if (VM.IsLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>@Resources.Web_ShareBrowser_Loading</p>
    </div>
}
else if (VM.ErrorMessage is not null)
{
    <div class="error-banner">@VM.ErrorMessage</div>
}
else if (!VM.Shares.Any())
{
    <div class="empty-state">
        @Assets.SVG("folder.svg", new SvgOptions(Width: 64, Height: 64, Color: "var(--text-tertiary)"))
        <p>@Resources.Web_ShareBrowser_Empty</p>
    </div>
}
else
{
    <div class="file-list">
        <div class="file-list-header">
            <div class="file-cell file-name">@Resources.Web_Folder_Name</div>
            <div class="file-cell file-share-path">@Resources.Web_ShareList_Label_Path</div>
        </div>
        @foreach (var share in VM.Shares)
        {
            <button class="file-row file-row-dir share-browser-row" type="button" @onclick="() => OpenShare(share.Name)">
                <div class="file-cell file-name">
                    @Assets.SVG("folder.svg", new SvgOptions(Width: 20, Height: 20, Color: "var(--folder-stroke)", Fill: "var(--folder-fill)", CssClass: "file-icon"))
                    <span>@share.Name</span>
                </div>
                <div class="file-cell file-share-path">@share.Path</div>
            </button>
        }
    </div>
}

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await VM.LoadAsync();
            StateHasChanged();
        }
    }

    private void OpenShare(string name) => Nav.NavigateTo($"/files/{name}");


}
