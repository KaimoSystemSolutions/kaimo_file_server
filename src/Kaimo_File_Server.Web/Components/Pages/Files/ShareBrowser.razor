@page "/files"
@inject ShareBrowserViewModel VM
@inject NavigationManager Nav

<PageTitle>Kaimo Files – Browse</PageTitle>

<div class="page-header">
    <div>
        <h1>Browse - Shares</h1>
    </div>
    <div style="display: flex; gap: 0.5rem;">
        @if (VM.CanCreateShare)
        {
            <button class="btn-icon" title="Share erstellen" @onclick="() => { VM.IsCreating = !VM.IsCreating; }">
                <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                    </svg>
                    Shares Verwalten
                </NavLink>
            </button>
        }
    </div>
</div>

@if (VM.IsCreating && VM.CanCreateShare)
{
    <div class="create-share-form">
        <input type="text"
               placeholder="Name des neuen Shares"
               @bind="VM.NewShareName"
               @bind:event="oninput"
               @onkeydown="HandleCreateKeyDown" />
        <button class="btn-primary" @onclick="CreateShare">Erstellen</button>
        <button class="btn-secondary" @onclick="() => { VM.IsCreating = false; }">Abbrechen</button>
        @if (VM.CreateErrorMessage is not null)
        {
            <div class="error-banner">@VM.CreateErrorMessage</div>
        }
    </div>
}

@if (VM.IsLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Lade Shares...</p>
    </div>
}
else if (VM.ErrorMessage is not null)
{
    <div class="error-banner">@VM.ErrorMessage</div>
}
else if (!VM.Shares.Any())
{
    <div class="empty-state">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--text-tertiary)" stroke-width="1.5">
            <path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
        </svg>
        <p>Keine Shares verfügbar.</p>
    </div>
}
else
{
    <div class="file-list">
        @foreach (var share in VM.Shares)
        {
            <div class="file-row file-row-dir" @onclick="() => OpenShare(share.Name)">
                <div class="file-cell file-name">
                    <svg class="file-icon" width="20" height="20" viewBox="0 0 24 24"
                         fill="var(--folder-fill)" stroke="var(--folder-stroke)" stroke-width="1.5">
                        <path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                    </svg>
                    <span>@share.Name</span>
                </div>
                <div class="file-cell file-size">@share.Path</div>
                <div class="file-cell file-date"></div>
            </div>
        }
    </div>
}

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await VM.LoadAsync();
            StateHasChanged();
        }
    }

    private void OpenShare(string name) => Nav.NavigateTo($"/files/{name}");

    private async Task CreateShare()
    {
        if (!VM.CanCreateShare) return;
        await VM.CreateShareAsync();
        StateHasChanged();
    }

    private async Task HandleCreateKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await CreateShare();
    }
}
