@* 
    Decides which Layout (base page) to load for every url.
    for any given url, it checks if the user is authenticated.
    if so, they will be granted the MainLayout, which cointains e.g the navbar
    
    if they are not, they will be redirced to the login page, and granted the EmptyLayout, if they already are there
*@
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeView>
                <Authorized>
                    <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
                </Authorized>
                <NotAuthorized>
                    @{
                        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
                        // The login page and anonymous public share links render without a session;
                        // everything else redirects to login.
                        if (string.Equals(path, "/login", StringComparison.OrdinalIgnoreCase)
                            || string.Equals(path, "/shared", StringComparison.OrdinalIgnoreCase)
                            || path.StartsWith("/shared/", StringComparison.OrdinalIgnoreCase))
                        {
                            <RouteView RouteData="@routeData" DefaultLayout="@typeof(EmptyLayout)" />
                        }
                        else
                        {
                            <RedirectToLogin />
                        }
                    }
                </NotAuthorized>
            </AuthorizeView>
        </Found>
    </Router>
</CascadingAuthenticationState>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;
}