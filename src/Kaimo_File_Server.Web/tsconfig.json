{
  // Browser scripts: Scripts/*.ts compile 1:1 to wwwroot/js/*.js (loaded as classic <script> tags
  // from App.razor). No import/export, so every file stays a plain script exposing its API on window.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleDetection": "legacy",
    "types": [],
    "strict": true,
    "removeComments": false,
    "sourceMap": false,
    "noEmitOnError": true,
    "rootDir": "Scripts",
    "outDir": "wwwroot/js"
  },
  "include": ["Scripts/**/*.ts"]
}
