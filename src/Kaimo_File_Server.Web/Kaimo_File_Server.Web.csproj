<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Kaimo_File_Server.Web</RootNamespace>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>9573d0b4-8b32-4bb5-a949-9934a4f80f0d</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<DockerfileContext>..\..</DockerfileContext>
		<!-- Docker restores before it copies the .razor files. Explicitly opt in
		     so the .NET 10 restore adds the Blazor framework web assets. -->
		<RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Kaimo_File_Server.Core\Kaimo_File_Server.Core.csproj" />
		<ProjectReference Include="..\Kaimo_File_Server.Infrastructure\Kaimo_File_Server.Infrastructure.csproj" />
		<ProjectReference Include="..\Kaimo_File_Server.Search\Kaimo_File_Server.Search.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Expose internal members (e.g. JwtAuthenticationStateProvider revalidation seam) to tests. -->
		<InternalsVisibleTo Include="Kaimo_File_Server.Tests" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="wwwroot\js\columnResize.js" />
	</ItemGroup>
	
	<ItemGroup>
	  <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
	  <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
	  <PackageReference Include="Microsoft.Build.Tasks.Git">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	  <!-- Pin the patched Microsoft.OpenApi 2.x (NU1903, GHSA-v5pm-xwqc-g5wc affects 2.0.0).
	       Must stay on 2.x: the AspNetCore.OpenApi 10.0.x XML-comment source generator targets
	       the 2.x API (settable IOpenApiMediaType.Example); 3.x makes it read-only and breaks the
	       build (CS0200). Do not bump to 3.x until AspNetCore.OpenApi requires it. -->
	  <PackageReference Include="Microsoft.OpenApi" />
	  <PackageReference Include="Microsoft.IdentityModel.Protocols" />
	  <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
	  <PackageReference Include="Microsoft.IdentityModel.Tokens" />
	  <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
	  <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
	</ItemGroup>

</Project>
