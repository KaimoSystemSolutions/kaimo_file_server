# syntax=docker/dockerfile:1
#
# Phase-0-Spike, step B: own VFS module + Samba from ONE source.
#
# Self-contained so `docker compose build` can build it without prerequisites.
#
# FAST ITERATION (why the stages are split the way they are):
#   The expensive part is compiling ALL of Samba (`./configure && make`, many
#   minutes). That must run EXACTLY ONCE and then stay in Docker's layer cache.
#   The trap: if the frequently-changed module source is an input to that step,
#   every edit busts the cache and rebuilds all of Samba. Re-running `./configure`
#   alone already regenerates the global config env -> waf invalidates ~1500
#   targets even with a build cache mount.
#
#   Solution: the `sambabuild` stage configures + builds + installs Samba against
#   a CONSTANT stub of vfs_kaimo_bridge.c (registration strings are constant too),
#   so its inputs never change on a module edit -> Docker caches it forever.
#   The `runtime` stage copies the REAL module over the stub and rebuilds ONLY
#   that one waf target (no ./configure) -> a module edit relinks a single .so in
#   seconds. The stub exists solely to let configure/make/install produce a
#   complete tree that the real module is incrementally relinked into.
#
#   The base rebuilds only when YOU change the sambabuild stage (Samba version,
#   configure flags, build deps). That is the manual "base image" behaviour, but
#   managed automatically by the layer cache -- nothing to tag or build by hand.
#
# Finding from Phase 0: `samba-dev` doesn't provide internal VFS headers, and
# an upstream-built module doesn't load into distro Samba
# (libsmbd-base-samba4.so: cannot open shared object). Solution + production path:
# Build and operate Samba ourselves so module, smbd, and private libs come from
# the same build (ABI 49, Samba 4.19.5).

# ---------- Stage 1: Samba source tree (own layer -> highly cacheable) ----------
FROM ubuntu:24.04 AS src
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y -qq wget && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY samba-build.env /usr/local/share/kaimo/samba-build.env
RUN set -eu; \
    . /usr/local/share/kaimo/samba-build.env; \
    archive="samba-${SAMBA_VERSION}.tar.gz"; \
    wget -q "https://download.samba.org/pub/samba/stable/${archive}"; \
    printf '%s  %s\n' "$SAMBA_TARBALL_SHA256" "$archive" | sha256sum -c -; \
    mkdir /build/samba-source; \
    tar -xzf "$archive" --strip-components=1 -C /build/samba-source; \
    rm "$archive"

# ---------- Stage 2: expensive, cache-stable Samba build (stub module) ----------
# This stage MUST NOT depend on the real module content. Its only module input is
# a constant stub written inline below. Rebuilds only when this stage changes.
FROM src AS sambabuild
ENV DEBIAN_FRONTEND=noninteractive

# Enable deb-src and fetch Samba build dependencies.
RUN sed -i 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update \
    && apt-get build-dep -y samba \
    && apt-get install -y --no-install-recommends build-essential patch python3 \
       samba-common-bin smbclient acl \
    && rm -rf /var/lib/apt/lists/*

# Toolchain for the gRPC C++ sidecar clients. Installed here (rarely changes) so a
# module edit in the build-runtime stage never re-triggers this apt install.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       protobuf-compiler protobuf-compiler-grpc \
       libgrpc++-dev libprotobuf-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build/samba-source

# Samba otherwise converts every failure from a VFS connect hook to the generic
# NT_STATUS_UNSUCCESSFUL. Preserve EACCES as NT_STATUS_ACCESS_DENIED so Windows
# treats an ACL denial like a normal file-server denial instead of reporting
# "A device attached to the system is not functioning."
COPY patches/0001-map-vfs-connect-errno.patch /tmp/
RUN patch -p1 < /tmp/0001-map-vfs-connect-errno.patch \
    && grep -F "map_nt_error_from_unix(connect_errno)" source3/smbd/smb2_service.c

# Samba 4.19.5 labels control-channel PING receipt as INFO but emits it at
# warning level 1. Our accountless Docker healthcheck pings every 15 seconds,
# so align that message with Samba's actual DBGLVL_INFO (5).
COPY patches/0002-log-control-ping-at-info.patch /tmp/
RUN patch -p1 < /tmp/0002-log-control-ping-at-info.patch \
    && grep -F 'DEBUG(DBGLVL_INFO, ("INFO: Received PING message' source3/lib/messages.c

# 1) Register module in build system (template: vfs_fake_perms). Constant strings.
RUN cat >> source3/modules/wscript_build <<'PYEOF'

bld.SAMBA3_MODULE('vfs_kaimo_bridge',
                 subsystem='vfs',
                 source='vfs_kaimo_bridge.c',
                 deps='samba-util',
                 init_function='',
                 internal_module=bld.SAMBA3_IS_STATIC_MODULE('vfs_kaimo_bridge'),
                 enabled=bld.SAMBA3_IS_ENABLED_MODULE('vfs_kaimo_bridge'))
PYEOF

# 2) Enable module as shared module.
RUN sed -i "s/default_shared_modules.extend(\['vfs_recycle'/default_shared_modules.extend(['vfs_kaimo_bridge', 'vfs_recycle'/" source3/wscript \
    && grep -n "vfs_kaimo_bridge" source3/wscript

# 3) CONSTANT build-time stub of the module. The real implementation is compiled
#    in the build-runtime stage. This only needs to be a registrable, compilable VFS
#    module so configure/make/install complete and produce all object files +
#    private libs the real module later links against (same ABI).
RUN cat > source3/modules/vfs_kaimo_bridge.c <<'CEOF'
/* Build-time stub -- replaced by the real module in the build-runtime stage.
 * See the header of Dockerfile.vfs for why this exists. */
#include "includes.h"
#include "smbd/smbd.h"

#undef DBGC_CLASS
#define DBGC_CLASS DBGC_VFS

static struct vfs_fn_pointers kaimo_bridge_fns = {
	.connect_fn = NULL,
};

static_decl_vfs;
NTSTATUS vfs_kaimo_bridge_init(TALLOC_CTX *ctx)
{
	return smb_register_vfs(SMB_VFS_INTERFACE_VERSION, "kaimo_bridge",
				&kaimo_bridge_fns);
}
CEOF

# 4) Build and install Samba to /opt/samba (incl. the stub module). The waf build
#    tree under bin/ is kept in the build image (no cache mount, no clean) so the
#    build-runtime stage inherits a fully configured tree with all object files and
#    can relink a single module target without reconfiguring. The large build tree
#    is intentionally excluded from the slim production stage.
RUN ./configure --without-ad-dc --enable-debug --prefix=/opt/samba \
    && PYTHONHASHSEED=1 make -j"$(nproc)" \
    && PYTHONHASHSEED=1 make install \
    && find /opt/samba -name '*kaimo_bridge*.so' | sed 's/^/installed stub module: /'

# ---------- Stage 3: build-runtime (cheap; reruns on source edits) ----------
# This remains a build image on purpose. The final runtime stage below copies
# only the installed Samba tree, Kaimo helpers/scripts and required shared
# libraries; compiler, source tree and waf object files never reach production.
FROM sambabuild AS build-runtime
ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# WS-Discovery responder (backlog #7): `wsdd` makes the server visible in Windows
# Explorer's "Network" view; started/stopped by sync-config.sh per the DB toggle.
# `procps` provides pgrep/pkill used to manage it. The `full_audit` VFS (audit-log
# toggle) is a standard Samba module already built into /opt/samba by the source
# build above — no extra package needed.
RUN apt-get update \
    && apt-get install -y --no-install-recommends wsdd procps jq \
    && rm -rf /var/lib/apt/lists/*

# Phase 1: build gRPC C++ clients (authsync/authd/sharesync/configsync) for
# NT-Hash + share + config sync. Toolchain already present from sambabuild.
WORKDIR /build/authsync
COPY protos/kaimo_smb_bridge.proto ./
COPY module/authsync.cpp ./
COPY module/authd.cpp ./
COPY module/sharesync.cpp ./
COPY module/configsync.cpp ./
COPY module/bridge_channel.h ./
COPY module/decision_cache.h ./
COPY module/event_spool.h ./
COPY module/local_protocol.h ./
COPY module/snapshot_enumeration.h ./
COPY module/rename_event.h ./
COPY module/recycle_move.h ./
COPY module/sync_json.h ./
COPY tests/test-decision-cache.cpp ./
COPY tests/test-event-spool.cpp ./
COPY tests/test-local-protocol.cpp ./
COPY tests/test-snapshot-enumeration.cpp ./
COPY tests/test-rename-event.cpp ./
COPY tests/test-recycle-move.cpp ./
COPY module/share_path.h ./
COPY tests/test-share-path.cpp ./
COPY tests/test-sync-json.cpp ./
RUN protoc --cpp_out=. kaimo_smb_bridge.proto \
    && protoc --grpc_out=. --plugin=protoc-gen-grpc="$(which grpc_cpp_plugin)" kaimo_smb_bridge.proto \
    && g++ -std=c++17 -O2 \
       authsync.cpp kaimo_smb_bridge.pb.cc kaimo_smb_bridge.grpc.pb.cc \
       $(pkg-config --cflags grpc++ protobuf) \
       $(pkg-config --libs grpc++ protobuf) \
       -o /usr/local/bin/kaimo_authsync \
    && g++ -std=c++17 -O2 -pthread \
       authd.cpp kaimo_smb_bridge.pb.cc kaimo_smb_bridge.grpc.pb.cc \
       $(pkg-config --cflags grpc++ protobuf) \
       $(pkg-config --libs grpc++ protobuf) \
       -o /usr/local/bin/kaimo_authd \
    && g++ -std=c++17 -O2 \
       sharesync.cpp kaimo_smb_bridge.pb.cc kaimo_smb_bridge.grpc.pb.cc \
       $(pkg-config --cflags grpc++ protobuf) \
       $(pkg-config --libs grpc++ protobuf) \
       -o /usr/local/bin/kaimo_sharesync \
    && g++ -std=c++17 -O2 \
       configsync.cpp kaimo_smb_bridge.pb.cc kaimo_smb_bridge.grpc.pb.cc \
       $(pkg-config --cflags grpc++ protobuf) \
       $(pkg-config --libs grpc++ protobuf) \
       -o /usr/local/bin/kaimo_configsync \
    && g++ -std=c++17 -O2 -pthread -I. \
       test-decision-cache.cpp -o /tmp/test-decision-cache \
    && /tmp/test-decision-cache \
    && rm /tmp/test-decision-cache \
    && g++ -std=c++17 -O2 -pthread -I. \
       test-event-spool.cpp -o /tmp/test-event-spool \
    && /tmp/test-event-spool \
    && rm /tmp/test-event-spool \
    && g++ -std=c++17 -O2 -pthread -I. \
       test-local-protocol.cpp -o /tmp/test-local-protocol \
    && /tmp/test-local-protocol \
    && rm /tmp/test-local-protocol \
    && g++ -std=c++17 -O2 -I. \
       test-snapshot-enumeration.cpp -o /tmp/test-snapshot-enumeration \
    && /tmp/test-snapshot-enumeration \
    && rm /tmp/test-snapshot-enumeration \
    && g++ -std=c++17 -O2 -I. \
       test-rename-event.cpp -o /tmp/test-rename-event \
    && /tmp/test-rename-event \
    && rm /tmp/test-rename-event \
    && g++ -std=c++17 -O2 -I. \
       test-recycle-move.cpp -o /tmp/test-recycle-move \
    && /tmp/test-recycle-move \
    && rm /tmp/test-recycle-move \
    && g++ -std=c++17 -O2 -I. \
       test-share-path.cpp -o /tmp/test-share-path \
    && /tmp/test-share-path \
    && rm /tmp/test-share-path \
    && g++ -std=c++17 -O2 -I. \
       test-sync-json.cpp -o /tmp/test-sync-json \
    && /tmp/test-sync-json \
    && rm /tmp/test-sync-json \
    && test -x /usr/local/bin/kaimo_authsync \
    && test -x /usr/local/bin/kaimo_authd \
    && test -x /usr/local/bin/kaimo_sharesync \
    && test -x /usr/local/bin/kaimo_configsync

# Real VFS module: overwrite the stub and relink ONLY this target (no reconfigure).
# This is the layer that reruns on a module edit -> a single object + relink.
# The installed .so is located by name (not a hardcoded path) and overwritten.
WORKDIR /build/samba-source
COPY module/vfs_kaimo_bridge.c module/local_protocol.h module/recycle_move.h module/rename_event.h module/share_path.h module/snapshot_enumeration.h source3/modules/
RUN PYTHONHASHSEED=1 ./buildtools/bin/waf build --targets=vfs_kaimo_bridge \
    && built="bin/modules/vfs/kaimo_bridge.so" \
    && dest="$(find /opt/samba -name '*kaimo_bridge*.so' | head -n1)" \
    && test -f "$built" && test -n "$dest" \
    && cp "$built" "$dest" \
    && strings "$dest" | grep -F "kaimo_bridge build [" \
    && echo "updated real module: $dest"

# 5) Config, entrypoint, sync and self-test scripts for self-built Samba.
COPY conf/smb.conf.vfs        /opt/samba/etc/smb.conf
COPY entrypoint.vfs.sh        /usr/local/bin/entrypoint.sh
COPY selftest.sh              /usr/local/bin/selftest.sh
COPY sync-users.sh            /usr/local/bin/sync-users.sh
COPY sync-shares.sh           /usr/local/bin/sync-shares.sh
COPY sync-config.sh           /usr/local/bin/sync-config.sh
COPY run-sync.sh              /usr/local/bin/run-sync.sh
COPY sync-cycle.sh            /usr/local/bin/sync-cycle.sh
COPY revoke-samba-sessions.sh /usr/local/bin/revoke-samba-sessions.sh
COPY validate-sync-interval.sh /usr/local/bin/validate-sync-interval.sh
COPY sync-health.sh           /usr/local/bin/sync-health.sh
COPY supervise-samba.sh       /usr/local/bin/supervise-samba.sh
COPY authd-health.sh          /usr/local/bin/authd-health.sh
COPY smbd-health.sh           /usr/local/bin/smbd-health.sh
COPY verify-samba-build.sh    /tmp/verify-samba-build.sh
COPY tests/test-sync-users.sh /tmp/test-sync-users.sh
COPY tests/test-sync-shares.sh /tmp/test-sync-shares.sh
COPY tests/test-sync-config.sh /tmp/test-sync-config.sh
COPY tests/test-sync-config-samba-registry.sh /tmp/test-sync-config-samba-registry.sh
COPY tests/test-sync-runner.sh /tmp/test-sync-runner.sh
COPY tests/test-revocation-policy.sh /tmp/test-revocation-policy.sh
COPY tests/test-authd-supervisor.sh /tmp/test-authd-supervisor.sh
COPY tests/test-operational-credentials.sh /tmp/test-operational-credentials.sh
COPY entrypoint.sh /tmp/phase0-entrypoint.sh
COPY tests/test-vfs-io-deadline.py /usr/local/bin/test-vfs-io-deadline.py
COPY tests/test-vfs-snapshot-readonly.py /usr/local/bin/test-vfs-snapshot-readonly.py
COPY tests/test-vfs-operation-compatibility.py /tmp/test-vfs-operation-compatibility.py
RUN sed -i 's/\r$//' /usr/local/bin/entrypoint.sh /usr/local/bin/selftest.sh \
                       /usr/local/bin/sync-users.sh /usr/local/bin/sync-shares.sh \
                       /usr/local/bin/sync-config.sh \
                       /usr/local/bin/run-sync.sh /usr/local/bin/sync-cycle.sh \
                       /usr/local/bin/revoke-samba-sessions.sh \
                       /usr/local/bin/validate-sync-interval.sh \
                       /usr/local/bin/sync-health.sh \
                       /usr/local/bin/supervise-samba.sh \
                       /usr/local/bin/authd-health.sh \
                       /usr/local/bin/smbd-health.sh \
                       /tmp/verify-samba-build.sh \
                       /tmp/test-sync-users.sh \
                       /tmp/test-sync-shares.sh /tmp/test-sync-config.sh \
                       /tmp/test-sync-config-samba-registry.sh \
                       /tmp/test-sync-runner.sh /tmp/test-revocation-policy.sh \
                       /tmp/test-authd-supervisor.sh \
                       /tmp/test-operational-credentials.sh \
                       /tmp/phase0-entrypoint.sh \
                       /usr/local/bin/test-vfs-io-deadline.py \
                       /usr/local/bin/test-vfs-snapshot-readonly.py \
                       /tmp/test-vfs-operation-compatibility.py \
    && chmod +x /usr/local/bin/entrypoint.sh /usr/local/bin/selftest.sh \
             /usr/local/bin/sync-users.sh /usr/local/bin/sync-shares.sh \
             /usr/local/bin/sync-config.sh \
             /usr/local/bin/run-sync.sh /usr/local/bin/sync-cycle.sh \
             /usr/local/bin/revoke-samba-sessions.sh \
             /usr/local/bin/validate-sync-interval.sh \
             /usr/local/bin/sync-health.sh \
             /usr/local/bin/supervise-samba.sh \
             /usr/local/bin/authd-health.sh \
             /usr/local/bin/smbd-health.sh \
             /tmp/verify-samba-build.sh \
             /usr/local/bin/test-vfs-io-deadline.py \
             /usr/local/bin/test-vfs-snapshot-readonly.py \
    && SYNC_USERS_SUT=/usr/local/bin/sync-users.sh bash /tmp/test-sync-users.sh \
    && SYNC_SHARES_SUT=/usr/local/bin/sync-shares.sh bash /tmp/test-sync-shares.sh \
    && SYNC_CONFIG_SUT=/usr/local/bin/sync-config.sh bash /tmp/test-sync-config.sh \
    && SYNC_CONFIG_SUT=/usr/local/bin/sync-config.sh \
       SAMBA_NET_BIN=/opt/samba/bin/net \
       bash /tmp/test-sync-config-samba-registry.sh \
    && SYNC_RUNNER_SUT=/usr/local/bin/run-sync.sh \
       SYNC_HEALTH_SUT=/usr/local/bin/sync-health.sh \
       bash /tmp/test-sync-runner.sh \
    && SESSION_REVOKER_SUT=/usr/local/bin/revoke-samba-sessions.sh \
       SYNC_CYCLE_SUT=/usr/local/bin/sync-cycle.sh \
       SYNC_INTERVAL_VALIDATOR_SUT=/usr/local/bin/validate-sync-interval.sh \
       bash /tmp/test-revocation-policy.sh \
    && AUTHD_SUPERVISOR_SUT=/usr/local/bin/supervise-samba.sh \
       AUTHD_HEALTH_SUT=/usr/local/bin/authd-health.sh \
       SMBD_HEALTH_SUT=/usr/local/bin/smbd-health.sh \
       bash /tmp/test-authd-supervisor.sh \
    && CREDENTIAL_ENTRYPOINT_SUT=/usr/local/bin/entrypoint.sh \
       CREDENTIAL_PHASE0_ENTRYPOINT_SUT=/tmp/phase0-entrypoint.sh \
       CREDENTIAL_SELFTEST_SUT=/usr/local/bin/selftest.sh \
       CREDENTIAL_SYNC_USERS_SUT=/usr/local/bin/sync-users.sh \
       CREDENTIAL_SYNC_CONFIG_SUT=/usr/local/bin/sync-config.sh \
       bash /tmp/test-operational-credentials.sh \
    && /tmp/verify-samba-build.sh \
    && python3 /tmp/test-vfs-operation-compatibility.py \
    && rm /tmp/test-sync-users.sh /tmp/test-sync-shares.sh \
          /tmp/test-sync-config.sh /tmp/test-sync-config-samba-registry.sh \
          /tmp/test-sync-runner.sh \
          /tmp/test-revocation-policy.sh \
          /tmp/test-authd-supervisor.sh \
          /tmp/test-operational-credentials.sh /tmp/phase0-entrypoint.sh \
          /tmp/verify-samba-build.sh \
          /tmp/test-vfs-operation-compatibility.py

# Package the installed runtime separately. Stripping is intentionally performed
# on the copy only: `docker build --target build-runtime` still yields the full
# unstripped tree for native diagnostics, while the default image stays small.
#
# The runtime package list is derived from every installed Samba/helper ELF file.
# This follows Samba feature/configuration changes automatically and avoids a
# brittle hand-maintained list of dozens of transitive shared-library packages.
RUN set -eux; \
    mkdir -p /runtime/opt /runtime/usr/local; \
    cp -a /opt/samba /runtime/opt/samba; \
    cp -a /usr/local/bin /runtime/usr/local/bin; \
    find /runtime/opt/samba /runtime/usr/local/bin -type f \
        \( -perm /111 -o -name '*.so' -o -name '*.so.*' \) -print0 \
      | while IFS= read -r -d '' file_path; do \
            file -b "$file_path" | grep -q ELF || continue; \
            ldd "$file_path" 2>/dev/null || true; \
            strip --strip-unneeded "$file_path" 2>/dev/null || true; \
        done \
      | awk '/=> \/(lib|usr\/lib)/ { print $(NF-1) } /^\/(lib|usr\/lib)/ { print $1 }' \
      | xargs -r -n1 readlink -f \
      | sort -u > /tmp/runtime-libraries.txt; \
    { \
        printf '%s\n' acl ca-certificates jq login passwd procps sysvinit-utils util-linux wsdd; \
        while IFS= read -r library_path; do \
            owner="$(dpkg-query -S "$library_path" | head -n1)"; \
            printf '%s\n' "${owner%%:*}"; \
        done < /tmp/runtime-libraries.txt; \
    } | sort -u > /runtime/runtime-packages.txt; \
    test -s /runtime/runtime-packages.txt; \
    du -sh /runtime/opt/samba /runtime/usr/local/bin; \
    cat /runtime/runtime-packages.txt

# ---------- Stage 4: slim production runtime ----------
FROM ubuntu:24.04 AS runtime
ENV DEBIAN_FRONTEND=noninteractive

COPY --from=build-runtime /runtime/runtime-packages.txt /tmp/runtime-packages.txt
RUN apt-get update \
    && xargs -r apt-get install -y --no-install-recommends < /tmp/runtime-packages.txt \
    && rm -rf /var/lib/apt/lists/* /tmp/runtime-packages.txt \
    && command -v flock >/dev/null \
    && command -v jq >/dev/null \
    && command -v mktemp >/dev/null \
    && command -v stat >/dev/null

COPY --from=build-runtime /runtime/opt/samba/ /opt/samba/
COPY --from=build-runtime /runtime/usr/local/bin/ /usr/local/bin/

EXPOSE 445
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
