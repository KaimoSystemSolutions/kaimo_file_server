<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Kaimo_File_Server.Smb</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kaimo_File_Server.Core\Kaimo_File_Server.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose the internal SMB bridge types (KaimoFileStore, KaimoFileHandle, …) to the test project. -->
    <InternalsVisibleTo Include="Kaimo_File_Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SMB-Server" Version="2.0.0" />
  </ItemGroup>

</Project>
