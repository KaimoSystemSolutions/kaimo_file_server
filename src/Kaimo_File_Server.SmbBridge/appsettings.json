{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "Storage": {
    "ApplicationDataPath": "/data/kaimo-system",
    "RootPath": "/data/storage",
    "VersioningPath": "/data/kaimo-system/.versions"  
  },
  "ControlPlane": {
    "Tls": {
      "ServerCertificatePath": "/run/secrets/kaimo-control-plane/server.crt",
      "ServerKeyPath": "/run/secrets/kaimo-control-plane/server.key",
      "ClientCaCertificatePath": "/run/secrets/kaimo-control-plane/ca.crt"
    },
    "HashExportRateLimit": {
      "PermitLimit": 2,
      "WindowSeconds": 60
    }
  },
  "Snapshots": {
    "Cache": {
      "//": "Startup-validated policy. RootPath must be absolute/outside every share and match Samba. TTL: 1 min-365 days; sweep: 1 min-24 h; cap: 1 MiB-100 TiB/share.",
      "RootPath": "/data/kaimo-system/.kaimo-snapshots",
      "TtlHours": 24,
      "MaxBytesPerShare": 5368709120,
      "SweepMinutes": 30
    },
    "Materialization": {
      "MaxFilesPerRequest": 10000,
      "MaxBytesPerRequest": 1073741824,
      "MaxConcurrentRequests": 2,
      "MaxDurationSeconds": 25
    }
  }
}
