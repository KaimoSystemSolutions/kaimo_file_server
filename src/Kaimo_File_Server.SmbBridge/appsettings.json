{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Grpc": "Information"
    }
  },
  "Storage": {
    "RootPath": "/data/storage"
  },
  "Snapshots": {
    "Cache": {
      "//": "Eviction bounds for the in-share @GMT materialization cache (.kaimo-snapshots).",
      "TtlHours": 24,
      "MaxBytesPerShare": 5368709120,
      "SweepMinutes": 30
    }
  }
}
