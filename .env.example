# Copy this file to .env to override the defaults from docker-compose.yml.
# All values below are optional for the local development stack.

# Images built by the main Compose project
KAIMO_HOST_IMAGE=kaimofileserver
KAIMO_WEB_IMAGE=kaimofileserverweb
KAIMO_SAMBA_IMAGE=kaimosamba
KAIMO_SMB_BRIDGE_IMAGE=kaimosmbbridge
KAIMO_PKI_IMAGE=kaimosmbpki

# Host paths
LOCATION_STORAGE_01=./tests/data/storage/pool01
LOCATION_APP_DATA=./tests/data/kaimo-system
LOCATION_LOGS=./tests/data/logs
LOCATION_DB=./tests/data/postgres
LOCATION_GDRIVE_CREDENTIALS=./tests/data/logins/google-service-account.json
KAIMO_SMB_CONTROL_PKI=./secrets/smb-control-plane

# Published ports and container versions
SAMBA_PORT=445
WEB_HTTP_PORT=8081
WEB_HTTPS_PORT=8443
POSTGRES_PORT=5432
ADMINER_PORT=8080
POSTGRES_VERSION=17-alpine
ADMINER_VERSION=latest
TZ=Europe/Berlin

# Local database. Use strong, unique values for every real deployment.
POSTGRES_DB=kaimo_file_server
POSTGRES_USER=kaimo_test_user
POSTGRES_PASSWORD=change_me

# Production secrets intentionally have no public default. The development
# override supplies clearly marked local-only fallbacks when these stay empty.
JWT_SECRET=
NT_HASH_ENCRYPTION_KEY=

# Optional fixed log-level override: Debug, Information, Warning, or Error.
# Leave unset so the value configured in the application UI remains effective.
# KAIMO_LOG_LEVEL=Information

# File log rotation
KAIMO_LOG_ARCHIVE_MAX_FILE_BYTES=10485760
KAIMO_LOG_ARCHIVE_RETENTION_DAYS=14
KAIMO_LOG_ARCHIVE_MAX_SOURCE_BYTES=262144000

# Snapshot projection cache
KAIMO_SNAPSHOT_CACHE_ROOT=/data/kaimo-system/.kaimo-snapshots
KAIMO_SNAPSHOT_CACHE_TTL_HOURS=24
KAIMO_SNAPSHOT_CACHE_MAX_BYTES_PER_SHARE=5368709120
KAIMO_SNAPSHOT_CACHE_SWEEP_MINUTES=30
KAIMO_SNAPSHOT_MAX_FILES=10000
KAIMO_SNAPSHOT_MAX_REQUEST_BYTES=1073741824
KAIMO_SNAPSHOT_MAX_CONCURRENT_REQUESTS=2
KAIMO_SNAPSHOT_MAX_DURATION_SECONDS=25
KAIMO_SNAPSHOT_OPENAT=1

# Samba authorization sidecar and VFS timeouts
KAIMO_AUTHZ_FAILOPEN=0
KAIMO_AUTHD_WORKERS=16
KAIMO_AUTHD_QUEUE_CAPACITY=64
KAIMO_AUTHD_IO_TIMEOUT_MS=2000
KAIMO_VFS_AUTH_TIMEOUT_MS=6000
KAIMO_VFS_SNAPSHOT_TIMEOUT_MS=32000
KAIMO_VFS_EVENT_TIMEOUT_MS=250
KAIMO_AUTHD_CACHE_MAX_ENTRIES=10000
KAIMO_AUTHD_CACHE_MAX_BYTES=8388608
KAIMO_AUTHD_CACHE_TTL_MS=3000

# Durable lifecycle-event delivery
KAIMO_EVENT_MAX_PENDING=100000
KAIMO_EVENT_MAX_DEAD=10000
KAIMO_EVENT_MAX_ATTEMPTS=20
KAIMO_EVENT_RETRY_BASE_MS=1000
KAIMO_EVENT_RETRY_MAX_MS=60000
KAIMO_EVENT_RECEIPT_RETENTION_DAYS=30

# User/share/config reconciliation
KAIMO_USER_SYNC_INTERVAL_SECONDS=60
KAIMO_SHARE_SYNC_INTERVAL_SECONDS=2
KAIMO_CONFIG_SYNC_INTERVAL_SECONDS=2
KAIMO_SYNC_HEALTH_MAX_AGE_SECONDS=180
