# Copy this file to .env to override the defaults from docker-compose.yml.
# All values below are optional for the local development stack.

# Local development only: also load the dev settings (Development environment,
# demo data, public DevOnly keys) on a plain `docker compose up`. Visual Studio
# loads docker-compose.dev.yml on its own. Never set this on a real deployment.
# The path separator is ":" on Linux/macOS and ";" on Windows.
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# Optional tools (Adminer, Mailpit) only start with the "tools" profile.
# COMPOSE_PROFILES=tools

# Images built by the main Compose project
KAIMO_HOST_IMAGE=kaimofileserver
KAIMO_WEB_IMAGE=kaimofileserverweb
KAIMO_SAMBA_IMAGE=kaimosamba
KAIMO_SMB_BRIDGE_IMAGE=kaimosmbbridge

# Host paths
LOCATION_STORAGE_01=./data/storage/pool01
LOCATION_STORAGE_02=./data/storage/pool02
LOCATION_APP_DATA=./data/kaimo-system
LOCATION_LOGS=./data/logs
LOCATION_DB=./data/postgres
LOCATION_BACKUP=./data/backups
LOCATION_ES=./data/elasticsearch
LOCATION_SAMBA_EVENT_SPOOL=./data/samba-event-spool
KAIMO_SMB_CONTROL_PKI=./data/smb-control-plane

# Published ports and container versions
SAMBA_PORT=445
WEB_HTTP_PORT=8081
WEB_HTTPS_PORT=8443
POSTGRES_PORT=5432
ADMINER_PORT=8080
POSTGRES_VERSION=17-alpine
ADMINER_VERSION=latest
TZ=Europe/Berlin

# Local database. Use strong, unique values for every real deployment.
POSTGRES_DB=kaimo_file_server
POSTGRES_USER=kaimo_test_user
POSTGRES_PASSWORD=change_me

# One-shot database restore on startup. Set this to the FILE NAME of a backup
# that lives in the backup folder (LOCATION_BACKUP, mounted at /data/kaimo-backups
# in the container), e.g. kaimo_20260820-0300_manual.dump. The Host restores it
# once on the next start. After a successful restore a "<file>.done" marker is
# written next to it so the same file is NOT restored again on later starts.
# The ".dump" extension is optional and a full container path also works. If the
# file cannot be found the Host stops with an error that lists the available
# backups instead of starting normally. Leave empty for normal operation.
KAIMO_DB_RESTORE_FROM=

# Production secrets intentionally have no public default. docker-compose.dev.yml
# supplies clearly marked local-only fallbacks when these stay empty.
JWT_SECRET=
NT_HASH_ENCRYPTION_KEY=

# Optional fixed log-level override: Debug, Information, Warning, or Error.
# Leave unset so the value configured in the application UI remains effective.
# KAIMO_LOG_LEVEL=Information

# Tuning values (timeouts, caches, retention, log rotation, sync intervals) are
# not read from this file: the services use their built-in defaults. To change
# one, add it to the service's environment in docker-compose.yml; the variables
# and their defaults are listed in example/OPTIONAL_ENVIRONMENT_VARIABLES.md.
