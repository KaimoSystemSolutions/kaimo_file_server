# Storage directory, where all the data ist stored
STORAGE_LOCATION=/data/fileserver/storage
STORAGE_DB=/data/fileserver/postgres
STORAGE_ES=/data/fileserver/elastic_search

# Absolute path inside both bridge/Samba containers; keep outside every SMB share.
KAIMO_SNAPSHOT_CACHE_ROOT=/data/storage/.kaimo-snapshots

# Host directory containing the generated/private SMB control-plane PKI.
# Local certificates are generated automatically on the first Compose start.
# Production may pre-populate bridge/ and samba/ with externally managed PKI.
KAIMO_SMB_CONTROL_PKI=./secrets/smb-control-plane

# Bounded Samba authorization sidecar concurrency (P1-01).
KAIMO_AUTHD_WORKERS=16
KAIMO_AUTHD_QUEUE_CAPACITY=64
KAIMO_AUTHD_IO_TIMEOUT_MS=2000

# Strict end-to-end VFS-side local socket budgets (P1-05).
KAIMO_VFS_AUTH_TIMEOUT_MS=6000
KAIMO_VFS_SNAPSHOT_TIMEOUT_MS=32000
KAIMO_VFS_EVENT_TIMEOUT_MS=250

# Bounded authorization-decision LRU (P1-02). The TTL is the maximum
# revocation delay for a decision already cached by authd.
KAIMO_AUTHD_CACHE_MAX_ENTRIES=10000
KAIMO_AUTHD_CACHE_MAX_BYTES=8388608
KAIMO_AUTHD_CACHE_TTL_MS=3000
