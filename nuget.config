<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="vs-offline" value="C:\Program Files (x86)\Microsoft SDKs\NuGetPackages\" />
    <!-- Local feed for the self-written SMB library (Smb.*). Repacked from
         B:\A_TRUENAS_MIGRATION\claude_mempages\SmbServer via `dotnet pack`. -->
  </packageSources>
  <!-- Route Smb.* exclusively to the local feed; everything else from nuget.org / VS offline.
       Prevents accidentally pulling an unrelated public package named Smb.* . -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="vs-offline">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
