<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Single source of truth: nuget.org. The <clear/> drops any machine-level sources
       (e.g. the Windows "vs-offline" folder) so restore is identical on every dev box and CI. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
