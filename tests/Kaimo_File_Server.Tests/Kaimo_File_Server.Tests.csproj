<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Tasks.Git">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- Match the Web project: the transitive AspNetCore.OpenApi 10.0.x source generator
         targets the 2.x API, and 2.12.2 is patched for NU1903 (GHSA-v5pm-xwqc-g5wc). -->
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Moq" />
    <!-- In-memory relational DB for seeder tests (Sqlite supports TPC inheritance) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Pin up the vulnerable native SQLite bundle pulled in transitively by EF Sqlite
         (NU1903, GHSA-2m69-gcr7-jv3q on SQLitePCLRaw.lib.e_sqlite3 2.1.11). 3.0.3 brings a
         patched SQLite native library and is API-compatible with EF Core's provider. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Grpc.Core.Api" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referenz auf dein Hauptprojekt anpassen: -->
    <ProjectReference Include="..\..\src\Kaimo_File_Server.Core\Kaimo_File_Server.Core.csproj" />
	<ProjectReference Include="..\..\src\Kaimo_File_Server.Infrastructure\Kaimo_File_Server.Infrastructure.csproj" />
	<ProjectReference Include="..\..\src\Kaimo_File_Server.Web\Kaimo_File_Server.Web.csproj" />
	<ProjectReference Include="..\..\src\Kaimo_File_Server.SmbBridge\Kaimo_File_Server.SmbBridge.csproj" />
  </ItemGroup>

</Project>
